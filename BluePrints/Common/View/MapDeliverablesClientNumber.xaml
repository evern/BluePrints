<UserControl x:Class="BluePrints.Views.MapDeliverablesClientNumber" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:custom="clr-namespace:BaseModel.Misc;assembly=BaseModel" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" x:Name="userControl">
    <dxlc:LayoutControl Orientation="Vertical">
        <dxlc:LayoutGroup Height="100" Width="600" Orientation="Horizontal" View="Group">
            <dxlc:LayoutItem Height="100">
                <TextBlock TextWrapping="WrapWithOverflow">
                    Copy two columns from excel with the left being internal number and the right being client number<LineBreak /><LineBreak />Then paste it in here<LineBreak /><LineBreak />This list will automatically align internal number and match it with the client number
                </TextBlock>
            </dxlc:LayoutItem>
        </dxlc:LayoutGroup>
        <dxlc:LayoutGroup Header="Edit Value" Name="LayoutGroupMain" Orientation="Vertical" View="Group">
            <dxlc:LayoutGroup Name="LayoutGroupContent" Orientation="Horizontal" View="Group">
                <dxlc:LayoutItem Height="600">
                    <dxg:GridControl x:Name="GridControl" ItemsSource="{Binding SourceObjects}" SelectionMode="Row">
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn FieldName="INTERNAL_NUM" ReadOnly="True" />
                            <dxg:GridColumn FieldName="CLIENT_NUM" />
                        </dxg:GridControl.Columns>
                        <dxg:GridControl.TotalSummary>
                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" Alignment="Right" SummaryType="Count" />
                        </dxg:GridControl.TotalSummary>
                        <dxg:GridControl.View>
                            <dxg:TableView x:Name="tableView" AutoWidth="True" ShowGroupPanel="False" ShowGroupedColumns="False">
                                <dxmvvm:Interaction.Behaviors>
                                    <dxmvvm:EventToCommand Command="{Binding PastingFromClipboardCommand}" EventName="PastingFromClipboard" PassEventArgsToCommand="True" />
                                </dxmvvm:Interaction.Behaviors>
                            </dxg:TableView>
                        </dxg:GridControl.View>
                    </dxg:GridControl>
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>
        </dxlc:LayoutGroup>
    </dxlc:LayoutControl>
</UserControl>