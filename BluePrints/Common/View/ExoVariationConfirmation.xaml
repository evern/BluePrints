<UserControl x:Class="BluePrints.Views.ExoVariationConfirmation" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:custom="clr-namespace:BaseModel.Misc;assembly=BaseModel" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" x:Name="userControl" Width="600" Height="600">
    <dxlc:LayoutControl Orientation="Vertical">
        <dxlc:LayoutGroup Header="Edit Value" Name="LayoutGroupMain" Orientation="Vertical" View="Group">
            <dxlc:LayoutGroup Name="LayoutGroupContent" Height="500" Orientation="Vertical" View="Group">
                <dxlc:LayoutItem Height="50">
                    <TextBlock TextWrapping="Wrap" Text="{Binding Message}" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Height="400">
                    <dxg:GridControl x:Name="GridControl" dx:DXSerializer.SerializationID="GridControlList" dx:DXSerializer.StoreLayoutMode="All" ItemsSource="{Binding SourceObjects}" SelectionMode="Row">
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn Header="Sub Job" FieldName="SubJobCode" ReadOnly="True" IsSmart="True" />
                            <dxg:GridColumn Header="Cost Group" FieldName="DisciplineCode" ReadOnly="True" IsSmart="True" />
                            <dxg:GridColumn Header="Cost Type" FieldName="CommodityCode" ReadOnly="True" IsSmart="True" />
                            <dxg:GridColumn Header="Variation" FieldName="VariationCode" ReadOnly="True" IsSmart="True" />
                        </dxg:GridControl.Columns>
                        <dxg:GridControl.TotalSummary>
                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" Alignment="Right" SummaryType="Count" />
                        </dxg:GridControl.TotalSummary>
                        <dxg:GridControl.View>
                            <dxg:TableView x:Name="tableView" ShowGroupPanel="False" ShowGroupedColumns="False" AutoWidth="True" />
                        </dxg:GridControl.View>
                    </dxg:GridControl>
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>
        </dxlc:LayoutGroup>
    </dxlc:LayoutControl>
</UserControl>