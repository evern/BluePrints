<UserControl x:Class="BluePrints.View.SyncScreen" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:common="clr-namespace:BluePrints.Common" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxg="clr-namespace:DevExpress.Xpf.Grid;assembly=DevExpress.Xpf.Grid.v19.2" xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:viewmodel="clr-namespace:BluePrints.ViewModels" Width="950" Height="800" mc:Ignorable="d">
    <Grid x:Name="LayoutRoot">
        <dxmvvm:Interaction.Behaviors>
            <dx:DXMessageBoxService />
        </dxmvvm:Interaction.Behaviors>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1.2*" />
        </Grid.ColumnDefinitions>
        <Grid x:Name="Content_Area" Grid.Column="0">
            <dxg:GridControl x:Name="GridControl" ItemsSource="{Binding SyncInfos}">
                <dxg:GridControl.Columns>
                    <dxg:GridColumn FieldName="Database" Header="Database" />
                    <dxg:GridColumn FieldName="LocalProgress" Header="Local %">
                        <dxg:GridColumn.EditSettings>
                            <dxe:ProgressBarEditSettings ContentDisplayMode="Value" DisplayFormat="p2" Maximum="1" Minimum="0" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="RemoteProgress" Header="Remote %">
                        <dxg:GridColumn.EditSettings>
                            <dxe:ProgressBarEditSettings ContentDisplayMode="Value" DisplayFormat="p2" Maximum="1" Minimum="0" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                </dxg:GridControl.Columns>
                <dxg:GridControl.TotalSummary>
                    <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" Alignment="Right" SummaryType="Count" />
                </dxg:GridControl.TotalSummary>
                <dxg:GridControl.GroupSummary>
                    <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" SummaryType="Count" />
                </dxg:GridControl.GroupSummary>
                <dxg:GridControl.View>
                    <dxg:TableView x:Name="tableView" AllowEditing="False" NewItemRowPosition="None" ShowGroupPanel="False" />
                </dxg:GridControl.View>
            </dxg:GridControl>
        </Grid>
        <Grid Grid.Column="1">
            <dxg:GridControl x:Name="GridControlDetails" ItemsSource="{Binding SyncReport}" SelectionMode="Row">
                <dxg:GridControl.Columns>
                    <dxg:GridColumn FieldName="TableName" Header="Table" IsSmart="True" ReadOnly="True" />
                    <dxg:GridColumn FieldName="Properties" Header="Properties" IsSmart="True" ReadOnly="True" />
                    <dxg:GridColumn FieldName="Project" Header="Project" IsSmart="True" ReadOnly="True" />
                    <dxg:GridColumn FieldName="Destination" Header="Destination" IsSmart="True" ReadOnly="True" />
                    <dxg:GridColumn FieldName="Action" Header="Action" IsSmart="True" ReadOnly="True" />
                </dxg:GridControl.Columns>
                <dxg:GridControl.TotalSummary>
                    <dxg:GridSummaryItem Alignment="Right" SummaryType="Count" />
                </dxg:GridControl.TotalSummary>
                <dxg:GridControl.GroupSummary>
                    <dxg:GridSummaryItem Alignment="Right" SummaryType="Count" />
                </dxg:GridControl.GroupSummary>
                <dxg:GridControl.View>
                    <dxg:TableView ShowGroupPanel="True" ShowTotalSummary="True" />
                </dxg:GridControl.View>
            </dxg:GridControl>
        </Grid>
    </Grid>
</UserControl>
