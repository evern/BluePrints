<UserControl x:Class="BluePrints.Views.BookTimeDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:baseView="clr-namespace:BaseModel.View;assembly=BaseModel" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" x:Name="userControl" Width="300" Height="500">
    <UserControl.Resources>
        <ResourceDictionary>
            <dxmvvm:BooleanNegationConverter x:Key="BooleanNegationConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <dxlc:LayoutControl Orientation="Vertical">
        <dxlc:LayoutGroup Name="LayoutGroupMain" Header="Edit Value" Orientation="Vertical" View="Group">
            <dxlc:LayoutGroup Name="LayoutGroupResource" Height="50" Orientation="Horizontal" View="Group">
                <dxlc:LayoutItem Height="50" Label="Resource:">
                    <dxe:ComboBoxEdit EditValue="{Binding Selected_Resource, Mode=TwoWay}" AllowDrop="{Binding AllowResourceEdit}" DisplayMember="Name" IsReadOnly="{Binding AllowResourceEdit, Converter={StaticResource BooleanNegationConverter}}" ItemsSource="{Binding PRESOURCECollection}" ShowEditorButtons="{Binding AllowResourceEdit}" />
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Name="LayoutGroupDate" Height="50" Orientation="Horizontal" View="Group">
                <dxlc:LayoutItem Height="50" Label="Book Date:">
                    <dxe:DateEdit EditValue="{Binding BookDate, Mode=TwoWay}" />
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Name="LayoutGroupSubjob" Height="50" Orientation="Horizontal" View="Group">
                <dxlc:LayoutItem Height="50" Label="Sub Job:">
                    <dxe:ComboBoxEdit EditValue="{Binding Selected_SubJob, Mode=TwoWay}" DisplayMember="Code" EditValuePostMode="Immediate" ItemsSource="{Binding PSUBJOBCollection}" />
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Name="LayoutGroupDiscipline" Height="50" Orientation="Horizontal" View="Group">
                <dxlc:LayoutItem Height="50" Label="Discipline:">
                    <dxe:ComboBoxEdit EditValue="{Binding Selected_Discipline, Mode=TwoWay}" DisplayMember="Name" EditValuePostMode="Immediate" ItemsSource="{Binding PDISCIPLINECollection}" />
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>
            <dxlc:LayoutItem Height="50" Label="Commodity:">
                <dxe:ComboBoxEdit EditValue="{Binding Selected_CommodityCode, Mode=TwoWay}" EditValuePostMode="Immediate" ItemsSource="{Binding COMMODITYCODECollection}" />
            </dxlc:LayoutItem>
        </dxlc:LayoutGroup>
        <dxlc:LayoutGroup Name="LayoutGroupCommodity" Height="50" Orientation="Horizontal" View="Group">
            <dxlc:LayoutItem Height="50" Label="Hours:">
                <dxe:SpinEdit x:Name="hoursEdit" EditValue="{Binding BookHours, Mode=TwoWay}" Increment="1" MinValue="0" />
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Height="50" Label="Stock Code:">
                <dxe:ComboBoxEdit EditValue="{Binding Selected_Commodity, Mode=TwoWay}" DisplayMember="StockCode" EditValuePostMode="Immediate" ItemsSource="{Binding PCOMMODITYCollection}" />
            </dxlc:LayoutItem>
        </dxlc:LayoutGroup>
        <dxlc:LayoutGroup Name="LayoutGroupVariationCode" Height="50" Orientation="Horizontal" View="Group">
            <dxlc:LayoutItem Height="50" Label="Variation Code:">
                <dxe:ComboBoxEdit EditValue="{Binding Selected_VariationCode, Mode=TwoWay}" AutoComplete="True" ItemsSource="{Binding VariationCodes}" />
            </dxlc:LayoutItem>
        </dxlc:LayoutGroup>
        <dxlc:LayoutGroup Name="LayoutGroupNarratives" Height="50" Orientation="Horizontal" View="Group">
            <dxlc:LayoutItem Height="50" Label="Narratives:">
                <dxe:ComboBoxEdit EditValue="{Binding Selected_Narrative, Mode=TwoWay}" AutoComplete="True" ItemsSource="{Binding Narratives}" />
            </dxlc:LayoutItem>
        </dxlc:LayoutGroup>
        <dxlc:LayoutGroup Name="LayoutGroupButtons" Height="50" HorizontalAlignment="Right" Orientation="Horizontal" View="Group" />
    </dxlc:LayoutControl>
</UserControl>