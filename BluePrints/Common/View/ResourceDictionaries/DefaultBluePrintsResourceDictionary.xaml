<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:collections="clr-namespace:System.Collections;assembly=mscorlib" xmlns:common="clr-namespace:BluePrints.Common" xmlns:custom="clr-namespace:BaseModel.Misc;assembly=BaseModel" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" xmlns:local="clr-namespace:BluePrints.Views">
    <collections:ArrayList x:Key="RibbonDefaultGridButtons">
        <dxb:BarButtonItem Content="Delete Row" ToolTip="Delete selected rows" Command="{Binding BulkDeleteCommand}" LargeGlyph="{dx:DXImage Image=Delete_32x32.png}" Glyph="{dx:DXImage Image=Delete_16x16.png}" />
        <dxb:BarButtonItem Content="Refresh" ToolTip="Refresh table with updated data. Also clears any undo redo entries" Command="{Binding DataContext.FullRefreshCommand, ElementName=userControl}" LargeGlyph="{dx:DXImage Image=Refresh_32x32.png}" Glyph="{dx:DXImage Image=Refresh_16x16.png}" />
        <dxb:BarButtonItem Content="Undo" ToolTip="Undo last action" Command="{Binding UndoCommand}" LargeGlyph="{dx:DXImage Image=Undo_32x32.png}" Glyph="{dx:DXImage Image=Undo_16x16.png}" />
        <dxb:BarButtonItem Content="Redo" ToolTip="Redo undone action" Command="{Binding RedoCommand}" LargeGlyph="{dx:DXImage Image=Redo_32x32.png}" Glyph="{dx:DXImage Image=Redo_16x16.png}" />
        <dxb:BarButtonItem Content="Copy" ToolTip="Ctrl + C" Command="{Binding KeyboardCopyCommand}" LargeGlyph="{dx:DXImage Image=Copy_32x32.png}" Glyph="{dx:DXImage Image=Copy_16x16.png}" />
        <dxb:BarButtonItem Content="Paste" ToolTip="Ctrl + V" Command="{Binding KeyboardPasteCommand}" LargeGlyph="{dx:DXImage Image=Paste_32x32.png}" Glyph="{dx:DXImage Image=Paste_16x16.png}" />
        <dxb:BarCheckItem Content="Cell Selection" ToolTip="Change selection to cells instead of row" IsChecked="{Binding IsPasteCellLevel, Mode=TwoWay}" LargeGlyph="{dxc:DXImage Image=SplitTableCells_32x32.png}" Glyph="{dxc:DXImage Image=SplitTableCells_16x16.png}" />
        <dxb:BarButtonItem Content="Export" ToolTip="Export current view to excel.Includes grouping, sorting and column visibility preferences" Command="{Binding DataContext.ExportToExcelCommand, ElementName=userControl}" LargeGlyph="{dx:DXImage Image=ExportToXLSX_32x32.png}" Glyph="{dx:DXImage Image=ExportToXLSX_16x16.png}" />
    </collections:ArrayList>
    <collections:ArrayList x:Key="RibbonDefaultLayoutButtons">
        <dxb:BarButtonItem Content="Save Layout" ToolTip="Save current table filters, sorting, grouping and expanded group" Command="{Binding DataContext.SaveLayoutCommand, ElementName=userControl}" LargeGlyph="{dx:DXImage Image=Save_32x32.png}" Glyph="{dx:DXImage Image=Save_16x16.png}" />
        <dxb:BarButtonItem Content="Reset Layout" ToolTip="Reset layout to default. Please reopen current view for default layout to take effect" Command="{Binding DataContext.ResetLayoutCommand, ElementName=userControl}" LargeGlyph="{dx:DXImage Image=SaveAndClose_32x32.png}" Glyph="{dx:DXImage Image=SaveAndClose_16x16.png}" />
    </collections:ArrayList>
    <collections:ArrayList x:Key="RibbonDefaultReportingButtons">
        <dxb:BarButtonItem Content="Edit Report" ToolTip="Redesign the current report layout" Command="{Binding DataContext.EditReportCommand, ElementName=userControl}" LargeGlyph="{dx:DXImage Image=Edit_32x32.png}" Glyph="{dx:DXImage Image=Edit_16x16.png}" />
        <dxb:BarButtonItem Content="View Report" ToolTip="View report of the deliverables list. Report will be sorted and filtered according to what is shown in this table" Command="{Binding DataContext.ViewReportCommand, ElementName=userControl}" LargeGlyph="{dx:DXImage Image=Report_32x32.png}" Glyph="{dx:DXImage Image=Report_16x16.png}" />
    </collections:ArrayList>
    <collections:ArrayList x:Key="ContextMenuDefaultHeaderButtons">
        <dxb:BarButtonItem Content="Copy With Headers" ToolTip="Copy selected rows along with header" Command="{Binding DataContext.CopyWithHeaderCommand, ElementName=userControl}" Glyph="{dx:DXImageOffice2013 Image=AlignHorizontalTop_16x16.png}" Name="contextMenuCopyWithHeader" />
        <dxb:BarButtonItem Content="Copy" ToolTip="Ctrl + C" Command="{Binding View.DataContext.KeyboardCopyCommand}" LargeGlyph="{dx:DXImage Image=Copy_32x32.png}" Glyph="{dx:DXImage Image=Copy_16x16.png}" />
        <dxb:BarButtonItem Content="Paste" ToolTip="Ctrl + V" Command="{Binding View.DataContext.KeyboardPasteCommand}" LargeGlyph="{dx:DXImage Image=Paste_32x32.png}" Glyph="{dx:DXImage Image=Paste_16x16.png}" />
        <dxb:BarButtonItem Content="Bulk Edit" ToolTip="Change column values for selected rows" Command="{Binding View.DataContext.BulkColumnEditCommand}" Glyph="{dx:DXImageOffice2013 Image=CustomizeGrid_16x16.png}" Name="contextMenuBulkEdit" CommandParameter="{Binding RelativeSource={RelativeSource Self}}" />
        <dxb:BarButtonItem Content="Fill Up" ToolTip="Replicate column values for selected rows starting from last selection" Command="{Binding View.DataContext.FillUpCommand}" Glyph="{dx:DXImageOffice2013 Image=MoveUp_16x16.png}" Name="contextMenuFillUp" CommandParameter="{Binding RelativeSource={RelativeSource Self}}" />
        <dxb:BarButtonItem Content="Fill Down" ToolTip="Replicate column values for selected rows starting from first selection" Command="{Binding View.DataContext.FillDownCommand}" Glyph="{dx:DXImageOffice2013 Image=MoveDown_16x16.png}" Name="contextMenuFillDown" CommandParameter="{Binding RelativeSource={RelativeSource Self}}" />
    </collections:ArrayList>
    <collections:ArrayList x:Key="ContextMenuDefaultPopulateReplaceButtons">
        <dxb:BarButtonItem Content="Populate" ToolTip="Auto generate selected column values based on known variables" Command="{Binding DataContext.AutoPopulateCommand, ElementName=userControl}" Glyph="{dx:DXImageOffice2013 Image=PictureShapeFillColor_16x16.png}" Name="contextMenuPopulate" CommandParameter="{Binding RelativeSource={RelativeSource Self}}" />
        <dxb:BarButtonItem Content="Find and Replace" ToolTip="Replace characters found in selected columns to new values" Command="{Binding DataContext.FindReplaceCommand, ElementName=userControl}" Glyph="{dx:DXImageOffice2013 Image=Replace_16x16.png}" Name="contextFindReplace" CommandParameter="{Binding RelativeSource={RelativeSource Self}}" />
    </collections:ArrayList>
    <collections:ArrayList x:Key="ContextMenuDuplicateInsertButtons">
        <dxb:BarButtonItem Content="Duplicate" ToolTip="Duplicate selected deliverables and assign the same internal number" Command="{Binding DataContext.DuplicateCommand, ElementName=userControl}" Glyph="{dx:DXImageOffice2013 Image=Paste_16x16.png}" x:Name="contextMenuDuplicate" />
        <dxb:BarButtonItem Content="Insert" ToolTip="Insert new deliverables with continuing internal number affix. Also renames deliverables with internal number larger than the largest internal number affix to continue from the newly inserted deliverables" Command="{Binding DataContext.InsertCommand, ElementName=userControl}" Glyph="{dx:DXImageOffice2013 Image=Paste_16x16.png}" x:Name="contextMenuInsert" />
    </collections:ArrayList>
    <collections:ArrayList x:Key="ContextMenuDefaultFooterButtons">
        <dxb:BarButtonItem Content="Delete Row" ToolTip="Delete selected rows" Command="{Binding View.DataContext.BulkDeleteCommand}" Glyph="{dx:DXImage Image=Delete_16x16.png}" />
        <dxb:BarButtonItem Content="Refresh" ToolTip="Refresh current table with updated data. Also clears any undo redo entries" Command="{Binding DataContext.FullRefreshCommand, ElementName=userControl}" Glyph="{dx:DXImage Image=Refresh_16x16.png}" />
    </collections:ArrayList>
</ResourceDictionary>