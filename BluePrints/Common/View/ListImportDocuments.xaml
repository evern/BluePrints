<UserControl
    x:Class="BluePrints.Views.ListImportDocuments"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" 
    xmlns:services="clr-namespace:BaseModel.ViewModel.Services;assembly=BaseModel"
    xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon" 
    xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" 
    xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking" 
    xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core"
    Width="1000" Height="700">
    <Grid>
        <dxmvvm:Interaction.Behaviors>
            <services:TableViewService x:Name="DefaultTableViewService" TableView="{Binding ElementName=tableView}" />
            <services:GridControlService x:Name="DefaultGridControlService" GridControl="{Binding ElementName=GridControl}" />
            <dxmvvm:OpenFileDialogService Title="Select Document" Multiselect="True" />
            <dxc:CurrentDialogService />
        </dxmvvm:Interaction.Behaviors>
        <dxb:BarManager>
            <dxb:BarManager.Items>
                <dxb:BarButtonItem x:Name="biManualAdd" Command="{Binding ManualAddFileCommand}" Content="Add Empty Row" ToolTip="Manually add new file" LargeGlyph="{dx:DXImage Image=AddItem_32x32.png}" Glyph="{dx:DXImage Image=AddItem_16x16.png}" />
                <dxb:BarButtonItem x:Name="biImportFiles" Command="{Binding ImportFilesCommand}" Content="Import Files" ToolTip="Import references and attachments" LargeGlyph="{dx:DXImage Image=Find_32x32.png}" Glyph="{dx:DXImage Image=Find_16x16.png}" />
                <dxb:BarButtonItem x:Name="biDeleteFiles" Command="{Binding DeleteFilesCommand}" Content="Delete Files" ToolTip="Delete selected references" LargeGlyph="{dx:DXImage Image=DeleteTableRows_32x32.png}" Glyph="{dx:DXImage Image=DeleteTableRows_16x16.png}" />
            </dxb:BarManager.Items>
            <DockPanel>
                <dxr:RibbonControl DockPanel.Dock="Top" ApplicationButtonText="" ToolbarShowMode="Hide" RibbonHeaderVisibility="Collapsed" RibbonStyle="TabletOffice">
                    <dxr:RibbonDefaultPageCategory MergeType="Replace" Caption="defaultCategory">
                        <dxr:RibbonPage MergeType="Replace" Caption="">
                            <dxr:RibbonPageGroup MergeType="Replace" Caption="Grid" >
                                <dxb:BarButtonItemLink BarItemName="biManualAdd" />
                                <dxb:BarButtonItemLink BarItemName="biImportFiles" />
                                <dxb:BarButtonItemLink BarItemName="biDeleteFiles" />
                            </dxr:RibbonPageGroup>
                        </dxr:RibbonPage>
                    </dxr:RibbonDefaultPageCategory>
                </dxr:RibbonControl>
                <dxdo:DockLayoutManager Name="dockLayoutManager" Margin="0" Padding="0" BorderThickness="0" FloatingMode="Desktop" MDIMergeStyle="WhenChildActivated">
                    <dxdo:LayoutGroup Margin="0" Padding="0" BorderThickness="0" ItemHeight="*" Orientation="Vertical">
                        <dxdo:LayoutPanel>
                            <dxg:GridControl x:Name="GridControl" ItemsSource="{Binding SourceObjects}" SelectedItems="{Binding SelectedEntities, Mode=TwoWay}" CurrentItem="{Binding SelectedEntity}" SelectionMode="Row">
                                <dxg:GridControl.Columns>
                                    <dxg:GridColumn Header="Name" FixedWidth="True" Width="250" FieldName="AttachmentName" />
                                    <dxg:GridColumn Header="Path" FieldName="AttachmentPath" />
                                </dxg:GridControl.Columns>
                                <dxg:GridControl.TotalSummary>
                                    <dxg:GridSummaryItem Alignment="Right" SummaryType="Count" />
                                </dxg:GridControl.TotalSummary>
                                <dxg:GridControl.View>
                                    <dxg:TableView x:Name="tableView" AutoScrollOnSorting="False" NewItemRowPosition="None" ShowFixedTotalSummary="True" AutoWidth="True" VerticalScrollbarVisibility="Auto" ShowGroupPanel="False" ShowGroupedColumns="False" />
                                </dxg:GridControl.View>
                            </dxg:GridControl>
                        </dxdo:LayoutPanel>
                    </dxdo:LayoutGroup>
                </dxdo:DockLayoutManager>
            </DockPanel>
        </dxb:BarManager>
    </Grid>
</UserControl>