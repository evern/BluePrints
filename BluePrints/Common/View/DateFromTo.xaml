<UserControl x:Class="BluePrints.Views.DateFromTo" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" x:Name="userControl" Width="500" Height="150">
    <dxlc:LayoutControl Orientation="Vertical">
        <dxlc:LayoutGroup Name="LayoutGroupMain" Header="Edit Value" Orientation="Vertical" View="Group">
            <dxlc:LayoutGroup Name="LayoutGroupContent" Height="50" Orientation="Horizontal" View="Group">
                <dxlc:LayoutItem Height="50" Label="From:">
                    <dxe:DateEdit x:Name="dateFrom" Mask="dd-MMM-yy" MaskUseAsDisplayFormat="True" Text="{Binding DateFrom, Mode=TwoWay}" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Height="50" Label="To:">
                    <dxe:DateEdit x:Name="dateTo" Mask="dd-MMM-yy" MaskUseAsDisplayFormat="True" Text="{Binding DateTo, Mode=TwoWay}" />
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Name="LayoutGroupButtons" Height="30" HorizontalAlignment="Right" Orientation="Horizontal" View="Group" />
        </dxlc:LayoutGroup>
    </dxlc:LayoutControl>
</UserControl>