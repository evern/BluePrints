<UserControl
    x:Name="userControl"
    x:Class="BluePrints.Views.EarnedDataDateRealignment"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:custom="clr-namespace:BaseModel.Misc;assembly=BaseModel">
    <dxlc:LayoutControl Orientation="Vertical">
        <dxlc:LayoutGroup View="Group" VerticalAlignment="Top" HorizontalAlignment="Center" Orientation="Vertical">
            <dxlc:LayoutItem LabelHorizontalAlignment="Center" Label="{Binding Label}" FontSize="15" VerticalAlignment="Center"  />
            <dxlc:LayoutItem LabelHorizontalAlignment="Center" Label="Do you wish to move the units on current date forward or backward?" FontSize="15" VerticalAlignment="Center"  />
        </dxlc:LayoutGroup>
        <dxlc:LayoutGroup Name="LayoutGroupMain" View="Group" Header="Edit Value" Orientation="Vertical">
            <dxlc:LayoutGroup Name="LayoutGroupContent" View="Group" Orientation="Vertical">
                <dxlc:LayoutItem Height="500" >
                    <dxg:GridControl x:Name="GridControl" dx:DXSerializer.SerializationID="GridControlEarnedReassignment" dx:DXSerializer.StoreLayoutMode="All" ItemsSource="{Binding SourceObjects}" SelectionMode="Row">
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn Header="Units" ReadOnly="True" FieldName="EarnedUnits" />
                            <dxg:GridColumn Header="Backward Date" ReadOnly="True" FieldName="BackwardEarnedDate" />
                            <dxg:GridColumn Header="Earned Date" ReadOnly="True" FieldName="CurrentEarnedDate" SortIndex="1" />
                            <dxg:GridColumn Header="Forward Date" ReadOnly="True" FieldName="ForwardEarnedDate" />
                        </dxg:GridControl.Columns>
                        <dxg:GridControl.TotalSummary>
                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" SummaryType="Count" Alignment="Right" />
                        </dxg:GridControl.TotalSummary>
                        <dxg:GridControl.View>
                            <dxg:TableView x:Name="tableView" ShowGroupedColumns="False" ShowGroupPanel="False"/>
                        </dxg:GridControl.View>
                    </dxg:GridControl>
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>
        </dxlc:LayoutGroup>
    </dxlc:LayoutControl>
</UserControl>