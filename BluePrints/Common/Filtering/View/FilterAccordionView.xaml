<UserControl x:Name="filterControl" x:Class="BluePrints.Common.Filtering.FilterAccordionView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:dxa="http://schemas.devexpress.com/winfx/2008/xaml/accordion"
        xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
        xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" 
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:viewmodel="clr-namespace:BluePrints.Common.Filtering"
        xmlns:dxat="http://schemas.devexpress.com/winfx/2008/xaml/accordion/themekeys"
        xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
        mc:Ignorable="d"
        d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Resources>
    </UserControl.Resources>
    <dxa:AccordionControl 
            x:Name="accordion" 
            SelectionMode="Single"
            SelectionUnit="SubItem"
            CollapsedItemClickAction="Select"
            SummaryItemHeader="All Filters"
            SummaryItemGlyph="{dx:DXImage Image=Technology_16x16.png}"
            SelectedItem="{Binding SelectedItem, Mode=TwoWay}" 
            AutoExpandAllItems="True"
            IsCollapseButtonVisible="True"
            ShowSearchControl="True"
            Margin="1" >
        <dxa:AccordionItem ItemDisplayMode="Header" Height="30" ShowInCollapsedMode="False" ExpandButtonPosition="None" IsExpanded="True">
            <dxa:AccordionItem.Header>
                <Button Command="{Binding DataContext.CreateCustomFilterCommand, ElementName=filterControl}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{dxc:DXImage Image=QuickFilter_16x16.png}" Width="16" Height="16" Margin="0, 0, 3, 0" />
                        <TextBlock Text="Save" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </dxa:AccordionItem.Header>
        </dxa:AccordionItem>
        <dxa:AccordionItem ItemDisplayMode="Header" ShowInCollapsedMode="False" ExpandButtonPosition="None" IsExpanded="True">
            <dxa:AccordionItem.Header>
                <Button Command="{Binding DataContext.ClearFiltersCommand, ElementName=filterControl}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{dxc:DXImage Image=ClearFilter_16x16.png}" Width="16" Height="16" Margin="0, 0, 3, 0" />
                        <TextBlock Text="Clear" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </dxa:AccordionItem.Header>
        </dxa:AccordionItem>
        <dxa:AccordionItem Header="Custom Filters" ExpandButtonPosition="None" IsExpanded="True" ItemsSource="{Binding CustomFilters}" >
            <dxa:AccordionItem.ItemContainerStyle>
                <Style TargetType="dxa:AccordionItem">
                    <Setter Property="ShowInCollapsedMode" Value="True" />
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Glyph" Value="{dxc:DXImage Image=QuickFilter_16x16.png}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="False">
                            <Setter Property="Glyph" Value="{dxc:DXImage Image=Filter_16x16.png}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </dxa:AccordionItem.ItemContainerStyle>
            <dxa:AccordionItem.ItemTemplate>
                <DataTemplate DataType="{x:Type viewmodel:FilterItem}">
                    <TextBlock Text="{Binding DisplayText}" TextTrimming="WordEllipsis"
                               Tag="{Binding DataContext, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type dxa:AccordionView}}}" >
                        <TextBlock.ContextMenu>
                            <ContextMenu Name="menu">
                                <MenuItem Header="Delete Custom Filter" Command="{Binding Path=PlacementTarget.Tag.DeleteCustomFilterCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                            </ContextMenu>
                        </TextBlock.ContextMenu>
                    </TextBlock>
                </DataTemplate>
            </dxa:AccordionItem.ItemTemplate>
        </dxa:AccordionItem>
    </dxa:AccordionControl>
</UserControl>