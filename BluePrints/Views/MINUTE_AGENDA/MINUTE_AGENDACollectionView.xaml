                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="Entity.RAISE_DATE" Header="Raise Date" ReadOnly="True">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:DateEditSettings />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="Entity.NUMBER" Header="Number" />
                                    <dxg:GridColumn FieldName="Entity.GUID" Header="KEY" Visible="False" />
                                    <dxg:GridColumn FieldName="Entity.GUID_MINUTE_TITLE" Header="PARENTKEY" Visible="False" />
                                </dxg:GridControl.Columns>
                                <dxg:GridControl.DetailDescriptor>
                                    <dxg:DataControlDetailDescriptor ItemsSourceBinding="{Binding DetailEntities}">
                                        <dxg:GridControl x:Name="gridControl" Style="{StaticResource DefaultDetailGridControlTemplate}">
                                            <i:Interaction.Behaviors>
                                                <behavior:DetailSyncBehavior />
                                            </i:Interaction.Behaviors>
