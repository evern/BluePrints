<UserControl 
             x:Name="userControl" 
             x:Class="BluePrints.Views.ESTIMATION_DIRECT_ITEMCollectionView"
             xmlns:view="clr-namespace:BluePrints.Views"
             xmlns="http://schemas.microsoft.com/netfx/2009/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxa="http://schemas.devexpress.com/winfx/2008/xaml/accordion"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon"
             xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxrudex="http://schemas.devexpress.com/winfx/2008/xaml/reports/userdesignerextensions"
             xmlns:converters="clr-namespace:BluePrints.Common.ViewModel.Converters"
             xmlns:custom="clr-namespace:BaseModel.Misc;assembly=BaseModel"
             xmlns:common="clr-namespace:BluePrints.Common"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:helper="clr-namespace:BluePrints.Common.Helpers"
             xmlns:viewmodel="clr-namespace:BluePrints.ViewModels"
             xmlns:local="clr-namespace:BluePrints.Views"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300"
             DataContext="{dxmvvm:ViewModelSource viewmodel:ESTIMATION_DIRECT_ITEMCollectionViewModelWrapper}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BaseModel;component/View/ResourceDictionaries/DefaultControlResourceDictionary.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/ConverterResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/CustomControlResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Style="{StaticResource CollectionView.RootContainer}">
        <dxmvvm:Interaction.Behaviors>
            <dx:DialogService x:Name="StockCodeDialogService">
                <dx:DialogService.DialogStyle>
                    <Style TargetType="dx:DXDialogWindow">
                        <Setter Property="SizeToContent" Value="WidthAndHeight" />
                    </Style>
                </dx:DialogService.DialogStyle>
            </dx:DialogService>
        </dxmvvm:Interaction.Behaviors>
        <Grid DataContext="{Binding MainViewModel}">
            <DockPanel>
                <dxr:RibbonControl RibbonStyle="Office2010" DockPanel.Dock="Top" AllowCustomization="False"
                                   MDIMergeStyle="Always">
                    <dxr:RibbonDefaultPageCategory Caption="defaultCategory">
                        <dxr:RibbonPage Caption="Home">
                            <dxr:RibbonPageGroup Caption="BASELINE ITEM Tasks">
                                <dxb:BarButtonItem Content="Delete Row" Command="{Binding BulkDeleteCommand}"
                                                   LargeGlyph="{dx:DXImage Image=Delete_32x32.png}"
                                                   Glyph="{dx:DXImage Image=Delete_16x16.png}" />
                                <dxb:BarButtonItem Content="Refresh" Command="{Binding DataContext.FullRefreshCommand, ElementName=userControl}"
                                                   LargeGlyph="{dx:DXImage Image=Refresh_32x32.png}"
                                                   Glyph="{dx:DXImage Image=Refresh_16x16.png}" />
                                <dxb:BarButtonItem Content="Undo" Command="{Binding UndoCommand}"
                                                   LargeGlyph="{dx:DXImage Image=Undo_32x32.png}"
                                                   Glyph="{dx:DXImage Image=Undo_16x16.png}" />
                                <dxb:BarButtonItem Content="Redo" Command="{Binding RedoCommand}"
                                                   LargeGlyph="{dx:DXImage Image=Redo_32x32.png}"
                                                   Glyph="{dx:DXImage Image=Redo_16x16.png}" />
                                <dxb:BarButtonItem Content="Save Layout"
                                                   Command="{Binding DataContext.SaveLayoutCommand, ElementName=userControl}"
                                                   LargeGlyph="{dx:DXImage Image=Save_32x32.png}"
                                                   Glyph="{dx:DXImage Image=Save_16x16.png}" />
                                <dxb:BarButtonItem Content="Reset Layout"
                                                   Command="{Binding DataContext.ResetLayoutCommand, ElementName=userControl}"
                                                   LargeGlyph="{dx:DXImage Image=SaveAndClose_32x32.png}"
                                                   Glyph="{dx:DXImage Image=SaveAndClose_16x16.png}" />
                                <dxb:BarCheckItem Content="Cell Selection" IsChecked="{Binding IsPasteCellLevel, Mode=TwoWay}" Glyph="{dx:DXImage Image=SplitTableCells_16x16.png}" LargeGlyph="{dx:DXImage Image=SplitTableCells_32x32.png}" />
                                <dxb:BarItemSeparator />
                                <dxb:BarButtonItem Content="Export"
                                                   Command="{Binding DataContext.ExportToExcelCommand, ElementName=userControl}"
                                                   LargeGlyph="{dx:DXImage Image=ExportToXLSX_32x32.png}"
                                                   Glyph="{dx:DXImage Image=ExportToXLSX_16x16.png}" />
                            </dxr:RibbonPageGroup>
                        </dxr:RibbonPage>
                    </dxr:RibbonDefaultPageCategory>
                </dxr:RibbonControl>
                <dxr:RibbonStatusBarControl DockPanel.Dock="Bottom">
                    <dxr:RibbonStatusBarControl.LeftItems>
                        <dxb:BarStaticItem
                            Content="{Binding Entities.Count, Converter={dxmvvm:FormatStringConverter FormatString='RECORDS: {0}'}}" />
                    </dxr:RibbonStatusBarControl.LeftItems>
                </dxr:RibbonStatusBarControl>
                <Grid>
                    <custom:GridControlEx x:Name="GridControl" dx:DXSerializer.SerializationID="GridControlESTIMATION_DIRECT_ITEM" dx:DXSerializer.StoreLayoutMode="All" Style="{StaticResource DefaultGridControlTemplate}">
                        <dxg:GridControl.Bands>
                            <dxg:GridControlBand Name="bandGeneral" Header="General">
                                <dxg:GridColumn Name="colWORKPACK" FieldName="Entity.Entity.GUID_WORKPACK" Header="WORKPACK" ReadOnly="True">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings
                                        ItemsSource="{Binding DataContext.WORKPACKCollection, ElementName=userControl}"
                                        IsTextEditable="True" AutoComplete="True" DisplayMember="INTERNAL_NAME1"
                                        ValueMember="GUID" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn Name="colAREA" FieldName="Entity.Entity.GUID_AREA" Header="AREA">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings
                                        ItemsSource="{Binding DataContext.AREACollection, ElementName=userControl}"
                                        IsTextEditable="True" AutoComplete="True" DisplayMember="INTERNAL_NUM"
                                        ValueMember="GUID" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn Name="colSUBAREA" FieldName="Entity.Entity.SubAreaGuid" Header="SUBAREA" ColumnFilterMode="DisplayText">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:ComboBoxEdit 
                                                  x:Name="PART_Editor"
                                                  ItemsSource="{Binding RowData.Row.Entity.Entity.SubAreaCollection}"
                                                  DisplayMember="INTERNAL_NUM" 
                                                  ValueMember="GUID"
                                                  ValidateOnTextInput="True"
                                                  ValidateOnEnterKeyPressed="True"
                                                  IncrementalFiltering="True"
                                                  NullValueButtonPlacement="Popup"
                                                  ImmediatePopup="True">
                                            </dxe:ComboBoxEdit>
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                    <!--For Filtering-->
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings NullValueButtonPlacement="EditBox"
                                                              ItemsSource="{Binding DataContext.SUBAREACollection, ElementName=userControl}"
                                                              IsTextEditable="True" AutoComplete="True"
                                                              DisplayMember="INTERNAL_NUM" ValueMember="GUID" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn Name="colSTOCK_CODE" FieldName="Entity.StockCodeGuid" Header="STOCK CODE">
                                    <dxg:GridColumn.EditSettings>
                                        <!--took this out because stock code is no longer filtered by discipline-->
                                        <!--ItemsSource="{Binding RowData.Row.StockCodeCollection}"-->
                                        <dxg:LookUpEditSettings
                                            Name="PART_Editor"
                                            AutoComplete="True"
                                            ValueMember="GUID"
                                            DisplayMember="CODE"
                                            IsTextEditable="true"
                                            PopupMinWidth="1500"
                                            AutoPopulateColumns="False"
                                            NullValueButtonPlacement="None"
                                            ItemsSource="{Binding DataContext.STOCK_CODECollection, ElementName=userControl}">
                                            <dxg:LookUpEditSettings.StyleSettings>
                                                <dxg:SearchLookUpEditStyleSettings/>
                                            </dxg:LookUpEditSettings.StyleSettings>
                                            <dxg:LookUpEditSettings.PopupContentTemplate>
                                                <ControlTemplate TargetType="ContentControl">
                                                    <dxg:GridControl x:Name="PART_GridControl" ShowBorder="False" SelectionMode="Row">
                                                        <dxg:GridControl.Columns>
                                                            <dxg:GridColumn FieldName="CODE" ReadOnly="True" />
                                                            <dxg:GridColumn FieldName="ProjectNumber" ReadOnly="True" />
                                                            <dxg:GridColumn FieldName="NAME" ReadOnly="True" />
                                                            <dxg:GridColumn FieldName="TYPE" ReadOnly="True" />
                                                            <dxg:GridColumn FieldName="SPEC" ReadOnly="True" />
                                                            <dxg:GridColumn FieldName="DESCRIPTION" ReadOnly="True" />
                                                            <dxg:GridColumn FieldName="UOM" ReadOnly="True" />
                                                            <dxg:GridColumn FieldName="RATE_SUPPLY" ReadOnly="True">
                                                                <dxg:GridColumn.EditSettings>
                                                                    <dxe:SpinEditSettings MinValue="0" MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"
                                                                    Increment="10" />
                                                                </dxg:GridColumn.EditSettings>
                                                            </dxg:GridColumn>
                                                            <dxg:GridColumn FieldName="HOURS_INSTALL" ReadOnly="True">
                                                                <dxg:GridColumn.EditSettings>
                                                                    <dxe:SpinEditSettings MinValue="0" MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"
                                                                    Increment="10" />
                                                                </dxg:GridColumn.EditSettings>
                                                            </dxg:GridColumn>
                                                        </dxg:GridControl.Columns>
                                                        <dxg:GridControl.View>
                                                            <dxg:TableView
                                                            ShowSelectionRectangle="True"
                                                            ShowFocusedRectangle="True"
                                                            ShowSearchPanelMode="Always"
                                                            ShowGroupPanel="True"
                                                            RowStyle="{StaticResource SelectionBackgroundStyle}"
                                                            ShowSearchPanelNavigationButtons="True"/>
                                                        </dxg:GridControl.View>
                                                    </dxg:GridControl>
                                                </ControlTemplate>
                                            </dxg:LookUpEditSettings.PopupContentTemplate>
                                        </dxg:LookUpEditSettings>
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn Header="COMMODITY CODE" FieldName="Entity.Entity.GUID_COMMODITY_CODE">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings ItemsSource="{Binding DataContext.COMMODITY_CODECollection, ElementName=userControl}" DisplayMember="CODE" ValueMember="GUID" ValidateOnTextInput="True" ValidateOnEnterKeyPressed="True" IncrementalFiltering="True" NullValueButtonPlacement="Popup" ImmediatePopup="True"></dxe:ComboBoxEditSettings>
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn Name="colDISCIPLINE" FieldName="Entity.Entity.GUID_DISCIPLINE"
                                            Header="DISCIPLINE">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings
                                        ItemsSource="{Binding DataContext.DISCIPLINECollection, ElementName=userControl}"
                                        IsTextEditable="True" AutoComplete="True" DisplayMember="NAME"
                                        ValueMember="GUID" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn Name="colDISCIPLINE_NUM" FieldName="Entity.Entity.DISCIPLINE_NUM"
                                            Header="DISC. NUM">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:SpinEditSettings IsTextEditable="True" IsFloatValue="False"
                                                                      Increment="1" MinValue="1" MaxValue="99"
                                                                      MaskType="Numeric" Mask="n0"
                                                                      MaskUseAsDisplayFormat="True" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn Name="colNAME" FieldName="Entity.Entity.NAME" Header="NAME" />
                                <dxg:GridColumn Name="colCOMMENTS" FieldName="Entity.Entity.COMMENTS" Header="COMMENTS" />
                                <dxg:GridColumn Name="colESTIMATED_QUANTITY" FieldName="Entity.Entity.ESTIMATED_QUANTITY" Header="QTY">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="15" />
                                                    <ColumnDefinition Width="15" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Image
                                                    Source="{Binding Source=DevExpress.Xpf.Core.Editors.Images.info.png, Converter={StaticResource EmbeddedResourceImageConverter}}"
                                                    ToolTip="Cannot reduce anymore because these quantity has already been earned" Grid.Column="0">
                                                    <Image.Visibility>
                                                        <MultiBinding
                                                            Converter="{StaticResource NumericCompareToVisibilityConverter}"
                                                            FallbackValue="Hidden">
                                                            <MultiBinding.ConverterParameter>
                                                                <sys:Boolean>False</sys:Boolean>
                                                            </MultiBinding.ConverterParameter>
                                                            <Binding ElementName="PART_Editor" Path="MinValue" />
                                                            <Binding ElementName="PART_Editor" Path="EditValue" />
                                                        </MultiBinding>
                                                    </Image.Visibility>
                                                </Image>
                                                <Image
                                                    Source="{Binding Source=DevExpress.Xpf.Core.Editors.Images.info.png, Converter={StaticResource EmbeddedResourceImageConverter}}"
                                                    ToolTip="Maximum possible units, please reduce other deliverable units to increase this" Grid.Column="1">
                                                    <Image.Visibility>
                                                        <MultiBinding
                                                            Converter="{StaticResource NumericCompareToVisibilityConverter}"
                                                            FallbackValue="Hidden">
                                                            <MultiBinding.ConverterParameter>
                                                                <sys:Boolean>False</sys:Boolean>
                                                            </MultiBinding.ConverterParameter>
                                                            <Binding ElementName="PART_Editor" Path="MaxValue" />
                                                            <Binding ElementName="PART_Editor" Path="EditValue" />
                                                        </MultiBinding>
                                                    </Image.Visibility>
                                                </Image>
                                                <dxe:SpinEdit Name="PART_Editor" MaskType="Numeric" Mask="n"
                                                              MaskUseAsDisplayFormat="True" Increment="1"
                                                              MinValue="{Binding RowData.Row.MinEstimateQuantity}"
                                                              Grid.Column="2">
                                                    <!--<dxe:SpinEdit.MaxValue>
                                                        <MultiBinding Converter="{StaticResource IReportableStatsMaximumUnitsConverter}">
                                                            <Binding ElementName="userControl" Path="DataContext.TotalAllowedUnits" />
                                                            <Binding ElementName="userControl" Path="DataContext.DisplayEntities" />
                                                            <Binding Path="RowData.Row" />
                                                        </MultiBinding>
                                                    </dxe:SpinEdit.MaxValue>-->
                                                </dxe:SpinEdit>
                                            </Grid>
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn Name="colDC_QUANTITY" FieldName="Entity.Entity.DC_QUANTITY" Header="VAR. QTY" ReadOnly="True" />
                                <dxg:GridColumn Name="colTRUCK_PERCENTAGE" FieldName="Entity.Entity.TRUCK_PERCENTAGE" Header="TRUCK % PER QTY">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:SpinEditSettings IsTextEditable="True" IsFloatValue="True"
                                                                      Increment="0.1" MinValue="0" MaxValue="1"
                                                                      MaskType="Numeric" Mask="p0"
                                                                      MaskUseAsDisplayFormat="True" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                            </dxg:GridControlBand>
                            <dxg:GridControlBand Name="bandProgressSpecification" Header="Progress Specifications">
                                <dxg:GridColumn Header="STOCK GROUP" FieldName="Entity.Entity.GUID_STOCK_GROUP">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:ComboBoxEdit 
                                                  x:Name="PART_Editor"
                                                  ItemsSource="{Binding DataContext.STOCK_GROUPCollection, ElementName=userControl}"
                                                  DisplayMember="CODE" 
                                                  ValueMember="GUID"
                                                  ValidateOnTextInput="True"
                                                  ValidateOnEnterKeyPressed="True"
                                                  IncrementalFiltering="True"
                                                  NullValueButtonPlacement="Popup"
                                                  ImmediatePopup="True">
                                            </dxe:ComboBoxEdit>
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn Name="colPROGRESS_TYPE" FieldName="Entity.Entity.PROGRESS_TYPE" Header="PROGRESS_TYPE">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings IsTextEditable="True" AutoComplete="True"
                                                              ItemsSource="{dxe:EnumItemsSource EnumType={x:Type common:Estimation_DirectProgressType}}" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                            </dxg:GridControlBand>
                            <dxg:GridControlBand Name="bandTotals" Header="Totals">
                                <dxg:GridColumn Header="INSTALL HOURS" FieldName="Total_Install_Hours" ReadOnly="True">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings MaskType="Numeric" Mask="n" MaskUseAsDisplayFormat="True" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn Header="FREIGHT COST" FieldName="Total_Freight_Cost" ReadOnly="True">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings MaskType="Numeric" Mask="c" MaskUseAsDisplayFormat="True" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn Header="SUPPLY COST" FieldName="Total_Supply_Cost" ReadOnly="True">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings MaskType="Numeric" Mask="c" MaskUseAsDisplayFormat="True" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn Header="INSTALL COST" FieldName="Total_Install_Cost" ReadOnly="True">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings MaskType="Numeric" Mask="c" MaskUseAsDisplayFormat="True" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn Header="TOTAL COST" FieldName="Total_Cost" ReadOnly="True">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings MaskType="Numeric" Mask="c" MaskUseAsDisplayFormat="True" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                            </dxg:GridControlBand>
                            <dxg:GridControlBand Name="bandCustomization" Header="Stock Code Customization">
                                <dxg:GridColumn Header="SUPPLY RATE" FieldName="Entity.STOCK_CODE.RATE_SUPPLY">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:SpinEditSettings MinValue="0" MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True" Increment="10" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn Header="INSTALL HOURS" FieldName="Entity.STOCK_CODE.HOURS_INSTALL">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:SpinEditSettings MinValue="0" MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True" Increment="1" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                            </dxg:GridControlBand>
                            <dxg:GridControlBand Name="bandStock" Header="Stock Code Details">
                                <dxg:GridColumn Header="UOM"  FieldName="Entity.STOCK_CODE.UOM" ReadOnly="True" />
                                <dxg:GridColumn Header="NAME" FieldName="Entity.STOCK_CODE.NAME" ReadOnly="True" />
                                <dxg:GridColumn Header="TYPE" FieldName="Entity.STOCK_CODE.TYPE" ReadOnly="True" />
                                <dxg:GridColumn Header="SPEC" FieldName="Entity.STOCK_CODE.SPEC" ReadOnly="True" />
                                <dxg:GridColumn Header="DESCRIPTION" FieldName="Entity.STOCK_CODE.DESCRIPTION" ReadOnly="True" />
                            </dxg:GridControlBand>
                        </dxg:GridControl.Bands>
                        <dxg:GridControl.GroupSummary>
                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" FieldName="Entity.Entity.COMMENTS" SummaryType="Count"
                                                 ShowInColumn="Entity.Entity.COMMENTS" DisplayFormat="Total {0} Records" />
                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" FieldName="Entity.Entity.ESTIMATED_QUANTITY" SummaryType="Sum"
                                                 ShowInColumn="Entity.Entity.ESTIMATED_QUANTITY"
                                                 DisplayFormat="Total: {0:n}" />
                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" FieldName="Entity.Entity.DC_QUANTITY" SummaryType="Sum"
                                                 ShowInColumn="Entity.Entity.DC_QUANTITY"
                                                 DisplayFormat="Total: {0:n}" />
                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" FieldName="Total_Install_Hours" SummaryType="Sum"
                                                 ShowInColumn="Total_Install_Hours"
                                                 DisplayFormat="Total: {0:n}" />
                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" FieldName="Total_Supply_Cost" SummaryType="Sum"
                                                 ShowInColumn="Total_Supply_Cost"
                                                 DisplayFormat="Total: {0:c}" />
                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" FieldName="Total_Install_Cost" SummaryType="Sum"
                                                 ShowInColumn="Total_Install_Cost"
                                                 DisplayFormat="Total: {0:c}" />
                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" FieldName="Total_Freight_Cost" SummaryType="Sum"
                                                 ShowInColumn="ETotal_Freight_Cost"
                                                 DisplayFormat="Total: {0:c}" />
                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" FieldName="Total_Cost" SummaryType="Sum"
                                                 ShowInColumn="Total_Cost"
                                                 DisplayFormat="Total: {0:c}" />
                        </dxg:GridControl.GroupSummary>
                        <dxg:GridControl.TotalSummary>
                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" FieldName="Entity.Entity.COMMENTS" SummaryType="Count"
                                                 ShowInColumn="Entity.Entity.COMMENTS" DisplayFormat="Total {0} Records" />
                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" FieldName="Entity.Entity.ESTIMATED_QUANTITY" SummaryType="Sum"
                                                 ShowInColumn="Entity.Entity.ESTIMATED_QUANTITY"
                                                 DisplayFormat="Total: {0:n}" />
                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" FieldName="Entity.Entity.DC_QUANTITY" SummaryType="Sum"
                                                 ShowInColumn="Entity.Entity.DC_QUANTITY"
                                                 DisplayFormat="Total: {0:n}" />
                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" FieldName="Total_Install_Hours" SummaryType="Sum"
                                                 ShowInColumn="Total_Install_Hours"
                                                 DisplayFormat="Total: {0:n}" />
                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" FieldName="Total_Supply_Cost" SummaryType="Sum"
                                                 ShowInColumn="Total_Supply_Cost"
                                                 DisplayFormat="Total: {0:c}" />
                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" FieldName="Total_Install_Cost" SummaryType="Sum"
                                                 ShowInColumn="Total_Install_Cost"
                                                 DisplayFormat="Total: {0:c}" />
                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" FieldName="Total_Freight_Cost" SummaryType="Sum"
                                                 ShowInColumn="ETotal_Freight_Cost"
                                                 DisplayFormat="Total: {0:c}" />
                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" FieldName="Total_Cost" SummaryType="Sum"
                                                 ShowInColumn="Total_Cost"
                                                 DisplayFormat="Total: {0:c}" />
                        </dxg:GridControl.TotalSummary>
                        <dxg:GridControl.View>
                            <dxg:TableView x:Name="tableView" Style="{StaticResource DefaultTableViewTemplate}" >
                                <dxg:TableView.RowCellMenuCustomizations>
                                    <dxb:BarButtonItem Name="contextMenuBulkEdit" Content="Bulk Edit"
                                                       Command="{Binding View.DataContext.BulkColumnEditCommand}"
                                                       CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                                                       Glyph="{dx:DXImageOffice2013 Image=CustomizeGrid_16x16.png}" />
                                    <dxb:BarButtonItem Name="contextMenuFillUp" Content="Fill Up"
                                                       Glyph="{dx:DXImageOffice2013 Image=MoveUp_16x16.png}"
                                                       Command="{Binding View.DataContext.FillUpCommand}"
                                                       CommandParameter="{Binding RelativeSource={RelativeSource Self}}" />
                                    <dxb:BarButtonItem Name="contextMenuFillDown" Content="Fill Down"
                                                       Glyph="{dx:DXImageOffice2013 Image=MoveDown_16x16.png}"
                                                       Command="{Binding View.DataContext.FillDownCommand}"
                                                       CommandParameter="{Binding RelativeSource={RelativeSource Self}}" />
                                    <dxb:BarButtonItem x:Name="contextMenuDuplicate" Content="Duplicate"
                                                       Command="{Binding DataContext.DuplicateCommand, ElementName=userControl}"
                                                       Glyph="{dx:DXImageOffice2013 Image=Paste_16x16.png}" />
                                    <dxb:BarSubItem x:Name="contextMenuDuplicateMulti" Content="Duplicate Multiple"
                                                    Glyph="{dx:DXImageOffice2013 Image=Parameters_16x16.png}">
                                        <dxb:BarEditItem x:Name="contextMenuDuplicateMultiCount" Content="Count"
                                                         EditValue="2">
                                            <dxb:BarEditItem.EditSettings>
                                                <dxe:SpinEditSettings IsTextEditable="True" IsFloatValue="False"
                                                                      Increment="1" MinValue="2" MaxValue="99"
                                                                      MaskType="Numeric" Mask="n0"
                                                                      MaskUseAsDisplayFormat="True">
                                                    <dxe:SpinEditSettings.Buttons>
                                                        <dxe:ButtonInfo x:Name="contextMenuDuplicateMultiCountBtn"
                                                                        GlyphKind="Apply">
                                                            <dxmvvm:Interaction.Behaviors>
                                                                <dxmvvm:EventToCommand
                                                                    Command="{Binding DataContext.DuplicateMultipleCommand, ElementName=userControl}"
                                                                    CommandParameter="{Binding ElementName=contextMenuDuplicateMultiCount}"
                                                                    EventName="Click" />
                                                            </dxmvvm:Interaction.Behaviors>
                                                        </dxe:ButtonInfo>
                                                    </dxe:SpinEditSettings.Buttons>
                                                </dxe:SpinEditSettings>
                                            </dxb:BarEditItem.EditSettings>
                                        </dxb:BarEditItem>
                                    </dxb:BarSubItem>
                                    <dxb:BarButtonItem Content="Delete Row"
                                                       Command="{Binding View.DataContext.BulkDeleteCommand}"
                                                       Glyph="{dx:DXImage Image=Delete_16x16.png}" />
                                    <dxb:BarButtonItem Content="Refresh"
                                                       Command="{Binding DataContext.FullRefreshCommand, ElementName=userControl}"
                                                       Glyph="{dx:DXImage Image=Refresh_16x16.png}" />
                                </dxg:TableView.RowCellMenuCustomizations>
                            </dxg:TableView>
                        </dxg:GridControl.View>
                    </custom:GridControlEx>
                </Grid>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
