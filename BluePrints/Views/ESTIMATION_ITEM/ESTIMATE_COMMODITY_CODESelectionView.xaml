<UserControl
    x:Name="userControl"
    x:Class="BluePrints.Views.ESTIMATE_COMMODITY_CODESelectionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:custom="clr-namespace:BaseModel.Misc;assembly=BaseModel"
    Height="100" Width="300">
    <dxlc:LayoutControl Orientation="Vertical">
        <dxlc:LayoutGroup Name="LayoutGroupMain" View="Group" Header="Edit Value" Orientation="Vertical">
            <dxlc:LayoutGroup Height="40" Name="LayoutGroupContent" View="Group" Orientation="Horizontal">
                <dxlc:LayoutItem Height="25" Label="Commodity Code:">
                    <dxg:LookUpEdit
                        Name="LookUpCOMMODITY_CODE"
                        AutoComplete="True"
                        DisplayMember="COMMODITY_CODE.FULLCODE"
                        IsTextEditable="true"
                        PopupMinWidth="1000"
                        AutoPopulateColumns="False"
                        NullValueButtonPlacement="None"
                        SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                        ItemsSource="{Binding SourceObjects}">
                        <dxg:LookUpEdit.PopupContentTemplate>
                            <ControlTemplate TargetType="ContentControl">
                                <custom:GridControlEx x:Name="PART_GridControl" ShowBorder="False" SelectionMode="Row">
                                    <dxg:GridControl.Columns>
                                        <dxg:GridColumn FieldName="GUID_PROJECT"
                                                                            Header="PROJECT" VisibleIndex="10">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:ComboBoxEditSettings
                                                                        ItemsSource="{Binding DataContext.PROJECTCollection, ElementName=userControl}"
                                                                        IsTextEditable="False" DisplayMember="NUMBER"
                                                                        ValueMember="GUID" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn FieldName="DESCRIPTION"
                                                                            Header="DESCRIPTION" VisibleIndex="20" />
                                        <dxg:GridColumn FieldName="FULLCODE"
                                                                            Header="FULLCODE" VisibleIndex="30" />
                                        <dxg:GridColumn Name="colDISCIPLINE" Header="DISCIPLINE"
                                                                            FieldName="GUID_DISCIPLINE"
                                                                            VisibleIndex="40">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:ComboBoxEditSettings
                                                                        ItemsSource="{Binding DataContext.DISCIPLINECollection, ElementName=userControl}"
                                                                        IsTextEditable="False" DisplayMember="NAME"
                                                                        ValueMember="GUID" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn FieldName="TYPE"
                                                                            Header="TYPE" VisibleIndex="50" />
                                        <dxg:GridColumn FieldName="SPEC"
                                                                            Header="SPEC" VisibleIndex="60" />
                                        <dxg:GridColumn FieldName="UOM" Header="UOM"
                                                                            VisibleIndex="70" AllowEditing="True">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:ComboBoxEditSettings
                                                                        ItemsSource="{Binding DataContext.UOMCollection, ElementName=userControl}"
                                                                        AutoComplete="True" DisplayMember="UOM1"
                                                                        ValueMember="UOM1" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn x:Name="colRATE_SUPPLY"
                                                                            FieldName="RATE_SUPPLY"
                                                                            Header="SUPPLY RATE" VisibleIndex="80">
                                            <dxg:GridColumn.CellTemplate>
                                                <DataTemplate>
                                                    <dxe:SpinEdit Name="PART_Editor"
                                                                                      MaskType="Numeric" Mask="c"
                                                                                      MinValue="0" Increment="10"
                                                                                      MaskUseAsDisplayFormat="True"
                                                                                      IsEnabled="False" />
                                                </DataTemplate>
                                            </dxg:GridColumn.CellTemplate>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn x:Name="colHOURS_INSTALL"
                                                                            FieldName="HOURS_INSTALL"
                                                                            Header="INSTALL HOURS" VisibleIndex="90">
                                            <dxg:GridColumn.CellTemplate>
                                                <DataTemplate>
                                                    <dxe:SpinEdit Name="PART_Editor"
                                                                                      MaskType="Numeric" Mask="n"
                                                                                      MinValue="0" Increment="1"
                                                                                      MaskUseAsDisplayFormat="True"
                                                                                      IsEnabled="False" />
                                                </DataTemplate>
                                            </dxg:GridColumn.CellTemplate>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn x:Name="colRATE_FREIGHT"
                                                                            FieldName="RATE_FREIGHT"
                                                                            Header="FREIGHT RATE" VisibleIndex="100">
                                            <dxg:GridColumn.CellTemplate>
                                                <DataTemplate>
                                                    <dxe:SpinEdit Name="PART_Editor"
                                                                                      MaskType="Numeric" Mask="c"
                                                                                      MinValue="0" Increment="10"
                                                                                      MaskUseAsDisplayFormat="True"
                                                                                      IsEnabled="False" />
                                                </DataTemplate>
                                            </dxg:GridColumn.CellTemplate>
                                        </dxg:GridColumn>
                                    </dxg:GridControl.Columns>
                                    <dxg:GridControl.View>
                                        <dxg:TreeListView x:Name="treeListView1"
                                                                              ShowAutoFilterRow="True"
                                                                              ShowSelectionRectangle="True"
                                                                              ShowFocusedRectangle="True"
                                                                              ShowSearchPanelMode="Always"
                                                                              TreeDerivationMode="Selfreference"
                                                                              KeyFieldName="Temp_Id"
                                                                              ParentFieldName="Temp_Parent_Id" />
                                    </dxg:GridControl.View>
                                </custom:GridControlEx>
                            </ControlTemplate>
                        </dxg:LookUpEdit.PopupContentTemplate>
                    </dxg:LookUpEdit>
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Height="25" HorizontalAlignment="Right" Name="LayoutGroupButtons" View="Group"
                              Orientation="Horizontal" />
        </dxlc:LayoutGroup>
    </dxlc:LayoutControl>
</UserControl>