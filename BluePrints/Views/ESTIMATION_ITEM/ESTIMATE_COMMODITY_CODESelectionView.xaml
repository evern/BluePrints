<UserControl
    x:Name="userControl"
    x:Class="BluePrints.Views.ESTIMATE_COMMODITY_CODESelectionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:custom="clr-namespace:BaseModel.Misc;assembly=BaseModel"
    Height="100" Width="300">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/GridColumnResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <dxlc:LayoutControl Orientation="Vertical">
        <dxlc:LayoutGroup Name="LayoutGroupMain" View="Group" Header="Edit Value" Orientation="Vertical">
            <dxlc:LayoutGroup Height="50" Name="LayoutGroupContent" View="Group" Orientation="Vertical">
                <dxlc:LayoutItem Height="25" Label="Commodity Code:">
                    <dxg:LookUpEdit
                        Name="LookUpCOMMODITY_CODE"
                        AutoComplete="True"
                        DisplayMember="FULLCODE"
                        IsTextEditable="true"
                        PopupMinWidth="1000"
                        AutoPopulateColumns="False"
                        NullValueButtonPlacement="None"
                        SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                        ItemsSource="{Binding SourceObjects}">
                        <dxg:LookUpEdit.PopupContentTemplate>
                            <ControlTemplate TargetType="ContentControl">
                                <custom:GridControlEx x:Name="PART_GridControl" ShowBorder="False" SelectionMode="Row" ColumnsSource="{StaticResource COMMODITY_CODEColumns}">
                                    <dxg:GridControl.Columns>
                                        
                                    </dxg:GridControl.Columns>
                                    <dxg:GridControl.View>
                                        <dxg:TreeListView x:Name="treeListView1"
                                                ShowAutoFilterRow="True"
                                                ShowSelectionRectangle="True"
                                                ShowFocusedRectangle="True"
                                                ShowSearchPanelMode="Always"
                                                TreeDerivationMode="Selfreference"
                                                KeyFieldName="Temp_Id"
                                                ParentFieldName="Temp_Parent_Id" />
                                    </dxg:GridControl.View>
                                </custom:GridControlEx>
                            </ControlTemplate>
                        </dxg:LookUpEdit.PopupContentTemplate>
                    </dxg:LookUpEdit>
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Height="25" HorizontalAlignment="Right" Name="LayoutGroupButtons" View="Group"
                              Orientation="Horizontal" />
        </dxlc:LayoutGroup>
    </dxlc:LayoutControl>
</UserControl>