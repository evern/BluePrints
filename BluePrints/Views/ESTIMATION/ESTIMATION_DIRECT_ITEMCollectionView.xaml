<UserControl x:Name="userControl"
             x:Class="BluePrints.Views.ESTIMATION_DIRECT_ITEMCollectionView"
             xmlns="http://schemas.microsoft.com/netfx/2009/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxrudex="http://schemas.devexpress.com/winfx/2008/xaml/reports/userdesignerextensions"
             xmlns:common="clr-namespace:BluePrints.Common"
             xmlns:viewmodel="clr-namespace:BluePrints.ViewModels"
             mc:Ignorable="d" d:DesignHeight="400" d:DesignWidth="600"
             DataContext="{dxmvvm:ViewModelSource viewmodel:ESTIMATION_DIRECT_ITEMSViewModelWrapper}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Views/BluePrintsResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <dxmvvm:Interaction.Behaviors>
        <dx:DXMessageBoxService />
        <dxmvvm:EventToCommand Event="Loaded" Command="{Binding OnLoadedCommand}" />
        <dx:WindowedDocumentUIService YieldToParent="True" />
        <dx:DialogService x:Name="BulkColumnEditService">
            <dx:DialogService.DialogStyle>
                <Style TargetType="dx:DXDialogWindow">
                    <Setter Property="SizeToContent" Value="WidthAndHeight" />
                    <Setter Property="MinWidth" Value="500" />
                    <Setter Property="MinHeight" Value="370" />
                </Style>
            </dx:DialogService.DialogStyle>
        </dx:DialogService>
    </dxmvvm:Interaction.Behaviors>
    <Grid dx:DXSerializer.StoreLayoutMode="UI">
        <dxmvvm:Interaction.Behaviors>
            <dxmvvm:LayoutSerializationService />
        </dxmvvm:Interaction.Behaviors>
        <Grid DataContext="{Binding MainViewModel}">
            <DockPanel>
                <dxr:RibbonControl RibbonStyle="Office2010" DockPanel.Dock="Top" AllowCustomization="False"
                                   MDIMergeStyle="Always">
                    <dxr:RibbonDefaultPageCategory Caption="defaultCategory">
                        <dxr:RibbonPage Caption="Home">
                            <dxr:RibbonPageGroup Caption="ESTIMATION ITEM Tasks">
                                <dxb:BarButtonItem Content="Delete"
                                                   Command="{Binding DataContext.BulkDeleteCommand, ElementName=userControl}"
                                                   LargeGlyph="{dx:DXImage Image=Delete_32x32.png}"
                                                   Glyph="{dx:DXImage Image=Delete_16x16.png}" />
                                <dxb:BarButtonItem Content="Refresh" Command="{Binding RefreshCommand}"
                                                   LargeGlyph="{dx:DXImage Image=Refresh_32x32.png}"
                                                   Glyph="{dx:DXImage Image=Refresh_16x16.png}" />
                                <dxb:BarButtonItem Content="Undo" Command="{Binding UndoCommand}"
                                                   LargeGlyph="{dx:DXImage Image=Undo_32x32.png}"
                                                   Glyph="{dx:DXImage Image=Undo_16x16.png}" />
                                <dxb:BarButtonItem Content="Redo" Command="{Binding RedoCommand}"
                                                   LargeGlyph="{dx:DXImage Image=Redo_32x32.png}"
                                                   Glyph="{dx:DXImage Image=Redo_16x16.png}" />
                                <dxb:BarButtonItem Content="Save Layout"
                                                   Command="{Binding DataContext.SaveLayoutCommand, ElementName=userControl}"
                                                   LargeGlyph="{dx:DXImage Image=Save_32x32.png}"
                                                   Glyph="{dx:DXImage Image=Save_16x16.png}" />
                                <dxb:BarButtonItem Content="Reset Layout"
                                                   Command="{Binding DataContext.ResetLayoutCommand, ElementName=userControl}"
                                                   LargeGlyph="{dx:DXImage Image=SaveAndClose_32x32.png}"
                                                   Glyph="{dx:DXImage Image=SaveAndClose_16x16.png}" />
                                <dxb:BarItemSeparator />
                                <dxb:BarButtonItem Content="Edit Report"
                                                   Command="{Binding DataContext.EditReportCommand, ElementName=userControl}"
                                                   LargeGlyph="{dx:DXImage Image=Edit_32x32.png}"
                                                   Glyph="{dx:DXImage Image=Edit_16x16.png}" />
                                <dxb:BarButtonItem Content="View Report"
                                                   Command="{Binding DataContext.ViewReportCommand, ElementName=userControl}"
                                                   LargeGlyph="{dx:DXImage Image=Report_32x32.png}"
                                                   Glyph="{dx:DXImage Image=Report_16x16.png}" />
                            </dxr:RibbonPageGroup>
                        </dxr:RibbonPage>
                    </dxr:RibbonDefaultPageCategory>
                </dxr:RibbonControl>
                <dxr:RibbonStatusBarControl DockPanel.Dock="Bottom">
                    <dxr:RibbonStatusBarControl.LeftItems>
                        <dxb:BarStaticItem
                            Content="{Binding Entities.Count, Converter={dxmvvm:FormatStringConverter FormatString='RECORDS: {0}'}}" />
                    </dxr:RibbonStatusBarControl.LeftItems>
                </dxr:RibbonStatusBarControl>
                <Grid>
                    <dxg:GridControl Name="gridControl"
                                     dx:DXSerializer.SerializationID="ESTIMATION_DIRECT_ITEMSGrid"
                                     ItemsSource="{Binding DataContext.DisplayEntities, ElementName=userControl}"
                                     CurrentItem="{Binding DataContext.SelectedEntity, Mode=TwoWay, ElementName=userControl}"
                                     SelectedItems="{Binding DataContext.SelectedEntities, Mode=TwoWay, ElementName=userControl}"
                                     SelectionMode="Row">
                        <dxmvvm:Interaction.Behaviors>
                            <dxmvvm:EventToCommand
                                Command="{Binding DataContext.MasterRowExpandedCommand, ElementName=userControl}"
                                PassEventArgsToCommand="True" EventName="MasterRowExpanded" />
                            <dxmvvm:EventToCommand
                                Command="{Binding DataContext.MasterRowCollapsedCommand, ElementName=userControl}"
                                PassEventArgsToCommand="True" EventName="MasterRowCollapsed" />
                        </dxmvvm:Interaction.Behaviors>
                        <dxg:GridControl.Bands>
                            <dxg:GridControlBand Name="bandGeneral" Header="General">
                                <dxg:GridColumn Name="colSUPPLYWORKPACK"
                                                FieldName="ESTIMATION_DIRECT_ITEM.GUID_SUPPLYWORKPACK"
                                                Header="SUPPLY WORKPACK" AllowSearchPanel="False" VisibleIndex="0">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings Name="PART_Editor_SupplyWORKPACK"
                                                                  ItemsSource="{Binding DataContext.WORKPACKCollection, ElementName=userControl}"
                                                                  IsTextEditable="True" AutoComplete="True"
                                                                  DisplayMember="INTERNAL_NAME1" ValueMember="GUID" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn Name="colINSTALLWORKPACK"
                                                FieldName="ESTIMATION_DIRECT_ITEM.GUID_INSTALLWORKPACK"
                                                Header="INSTALL WORKPACK" AllowSearchPanel="False" VisibleIndex="10">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings Name="PART_Editor_InstallWORKPACK"
                                                                  ItemsSource="{Binding DataContext.WORKPACKCollection, ElementName=userControl}"
                                                                  IsTextEditable="True" AutoComplete="True"
                                                                  DisplayMember="INTERNAL_NAME1" ValueMember="GUID" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn Name="colCOMMODITY_CODE" FieldName="COMMODITY_GROUP_CODE_SELECTION"
                                                Header="COMMODITY CODE" VisibleIndex="20">
                                    <dxg:GridColumn.EditSettings>
                                        <dxg:LookUpEditSettings
                                            Name="LookUpCOMMODITY_GROUP"
                                            AutoComplete="True"
                                            ValueMember="COMMODITY_GROUP_CODE_SELECTION"
                                            DisplayMember="COMMODITY_CODE.FULLCODE"
                                            IsTextEditable="true"
                                            PopupMinWidth="1000"
                                            AutoPopulateColumns="False"
                                            NullValueButtonPlacement="None"
                                            dx:DXSerializer.StoreLayoutMode="None"
                                            ItemsSource="{Binding DataContext.COMMODITY_GROUP_MasterDetailDisplayCollection, ElementName=userControl}">
                                            <dxg:LookUpEditSettings.PopupContentTemplate>
                                                <ControlTemplate TargetType="ContentControl">
                                                    <dxg:GridControl x:Name="PART_GridControl" ShowBorder="False"
                                                                     SelectionMode="Row">
                                                        <dxg:GridControl.Columns>
                                                            <dxg:GridColumn FieldName="COMMODITY_CODE.GUID_PROJECT"
                                                                            Header="PROJECT" VisibleIndex="10">
                                                                <dxg:GridColumn.EditSettings>
                                                                    <dxe:ComboBoxEditSettings
                                                                        ItemsSource="{Binding DataContext.PROJECTCollection, ElementName=userControl}"
                                                                        IsTextEditable="False" DisplayMember="NUMBER"
                                                                        ValueMember="GUID" />
                                                                </dxg:GridColumn.EditSettings>
                                                            </dxg:GridColumn>
                                                            <dxg:GridColumn FieldName="COMMODITY_CODE.FULLCODE"
                                                                            Header="FULLCODE" VisibleIndex="20" />
                                                            <dxg:GridColumn
                                                                FieldName="COMMODITY_CODE.COMMODITY_GROUP_DIRECT_ID"
                                                                Header="GROUP_ID" VisibleIndex="25" />
                                                            <dxg:GridColumn Name="colDISCIPLINE" Header="DISCIPLINE"
                                                                            FieldName="COMMODITY_CODE.GUID_DISCIPLINE"
                                                                            VisibleIndex="50">
                                                                <dxg:GridColumn.EditSettings>
                                                                    <dxe:ComboBoxEditSettings
                                                                        ItemsSource="{Binding DataContext.DISCIPLINECollection, ElementName=userControl}"
                                                                        IsTextEditable="False" DisplayMember="NAME"
                                                                        ValueMember="GUID" />
                                                                </dxg:GridColumn.EditSettings>
                                                            </dxg:GridColumn>
                                                            <dxg:GridColumn FieldName="COMMODITY_CODE.TYPE"
                                                                            Header="TYPE" VisibleIndex="70" />
                                                            <dxg:GridColumn FieldName="COMMODITY_CODE.SPEC"
                                                                            Header="SPEC" VisibleIndex="80" />
                                                            <dxg:GridColumn FieldName="COMMODITY_CODE.DESCRIPTION"
                                                                            Header="DESCRIPTION" VisibleIndex="90" />
                                                            <dxg:GridColumn FieldName="COMMODITY_CODE.UOM" Header="UOM"
                                                                            VisibleIndex="100" AllowEditing="True">
                                                                <dxg:GridColumn.EditSettings>
                                                                    <dxe:ComboBoxEditSettings
                                                                        ItemsSource="{Binding DataContext.UOMCollection, ElementName=userControl}"
                                                                        AutoComplete="True" DisplayMember="UOM1"
                                                                        ValueMember="UOM1" />
                                                                </dxg:GridColumn.EditSettings>
                                                            </dxg:GridColumn>
                                                            <dxg:GridColumn x:Name="colRATE_SUPPLY"
                                                                            FieldName="COMMODITY_CODE.RATE_SUPPLY"
                                                                            Header="SUPPLY RATE" VisibleIndex="120">
                                                                <dxg:GridColumn.CellTemplate>
                                                                    <DataTemplate>
                                                                        <dxe:SpinEdit Name="PART_Editor"
                                                                                      MaskType="Numeric" Mask="c"
                                                                                      MinValue="0" Increment="10"
                                                                                      MaskUseAsDisplayFormat="True"
                                                                                      IsEnabled="{Binding RowData.Row.ISQUANTIFIABLE, UpdateSourceTrigger=PropertyChanged }" />
                                                                    </DataTemplate>
                                                                </dxg:GridColumn.CellTemplate>
                                                            </dxg:GridColumn>
                                                            <dxg:GridColumn x:Name="colHOURS_INSTALL"
                                                                            FieldName="COMMODITY_CODE.HOURS_INSTALL"
                                                                            Header="INSTALL HOURS" VisibleIndex="130">
                                                                <dxg:GridColumn.CellTemplate>
                                                                    <DataTemplate>
                                                                        <dxe:SpinEdit Name="PART_Editor"
                                                                                      MaskType="Numeric" Mask="n"
                                                                                      MinValue="0" Increment="1"
                                                                                      MaskUseAsDisplayFormat="True"
                                                                                      IsEnabled="{Binding RowData.Row.ISQUANTIFIABLE, UpdateSourceTrigger=PropertyChanged}" />
                                                                    </DataTemplate>
                                                                </dxg:GridColumn.CellTemplate>
                                                            </dxg:GridColumn>
                                                            <dxg:GridColumn x:Name="colRATE_FREIGHT"
                                                                            FieldName="COMMODITY_CODE.RATE_FREIGHT"
                                                                            Header="FREIGHT RATE" VisibleIndex="140">
                                                                <dxg:GridColumn.CellTemplate>
                                                                    <DataTemplate>
                                                                        <dxe:SpinEdit Name="PART_Editor"
                                                                                      MaskType="Numeric" Mask="c"
                                                                                      MinValue="0" Increment="10"
                                                                                      MaskUseAsDisplayFormat="True"
                                                                                      IsEnabled="{Binding RowData.Row.ISQUANTIFIABLE, UpdateSourceTrigger=PropertyChanged}" />
                                                                    </DataTemplate>
                                                                </dxg:GridColumn.CellTemplate>
                                                            </dxg:GridColumn>
                                                        </dxg:GridControl.Columns>
                                                        <dxg:GridControl.View>
                                                            <dxg:TreeListView x:Name="treeListView1"
                                                                              ShowAutoFilterRow="True"
                                                                              ShowSelectionRectangle="True"
                                                                              ShowFocusedRectangle="True"
                                                                              ShowSearchPanelMode="Always"
                                                                              TreeDerivationMode="Selfreference"
                                                                              KeyFieldName="GUID"
                                                                              ParentFieldName="GUID_PARENT" />
                                                        </dxg:GridControl.View>
                                                    </dxg:GridControl>
                                                </ControlTemplate>
                                            </dxg:LookUpEditSettings.PopupContentTemplate>
                                        </dxg:LookUpEditSettings>
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn Name="colCOMMODITYGROUPID"
                                                FieldName="ESTIMATION_DIRECT_ITEM.COMMODITY_GROUP_DIRECT_ID"
                                                Header="GROUP ID" AllowSearchPanel="False" ReadOnly="True"
                                                VisibleIndex="25" />
                                <dxg:GridColumn Name="colDISCIPLINE" FieldName="ESTIMATION_DIRECT_ITEM.GUID_DISCIPLINE"
                                                Header="DISCIPLINE" AllowSearchPanel="False" VisibleIndex="30">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings
                                            ItemsSource="{Binding DataContext.DISCIPLINECollection, ElementName=userControl}"
                                            IsTextEditable="True" AutoComplete="True" DisplayMember="NAME"
                                            ValueMember="GUID" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn Name="colCOMMENT" FieldName="ESTIMATION_DIRECT_ITEM.COMMENTS"
                                                Header="COMMENTS" AllowSearchPanel="False" VisibleIndex="40" />
                            </dxg:GridControlBand>
                            <dxg:GridControlBand Name="bandQuantity" Header="Quantity">
                                <dxg:GridColumn Name="colESTIMATED_QUANTITY"
                                                FieldName="ESTIMATION_DIRECT_ITEM.ESTIMATED_QUANTITY"
                                                Header="ESTIMATED_QUANTITY" AllowSearchPanel="False" VisibleIndex="50">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:SpinEditSettings MaskType="Numeric" Mask="n" MinValue="0" Increment="1"
                                                              MaskUseAsDisplayFormat="True" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn Name="colVAR_QUANTITY" FieldName="ESTIMATION_DIRECT_ITEM.VAR_QUANTITY"
                                                Header="VAR_QUANTITY" AllowSearchPanel="False" VisibleIndex="60">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:SpinEdit Name="PART_Editor" MaskType="Numeric" Mask="n" MinValue="0"
                                                          Increment="10" MaskUseAsDisplayFormat="True"
                                                          IsEnabled="False" />
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                            </dxg:GridControlBand>
                            <dxg:GridControlBand Name="bandRate" Header="Rate">
                                <dxg:GridColumn Name="colSUPPLY_RATE" FieldName="ESTIMATION_DIRECT_ITEM.RATE_SUPPLY"
                                                Header="SUPPLY RATE" AllowSearchPanel="False" VisibleIndex="70">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:SpinEdit Name="PART_Editor" MaskType="Numeric" Mask="c" MinValue="0"
                                                          Increment="10" MaskUseAsDisplayFormat="True"
                                                          IsEnabled="{Binding RowData.Row.ISQUANTIFIABLE, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn Name="colFREIGHT_RATE" FieldName="ESTIMATION_DIRECT_ITEM.RATE_FREIGHT"
                                                Header="FREIGHT RATE" AllowSearchPanel="False" VisibleIndex="100">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:SpinEdit Name="PART_Editor" MaskType="Numeric" Mask="c" MinValue="0"
                                                          Increment="10" MaskUseAsDisplayFormat="True"
                                                          IsEnabled="{Binding RowData.Row.ISQUANTIFIABLE, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn Name="colINSTALL_RATE" FieldName="RATE_INSTALL" Header="INSTALL RATE"
                                                AllowSearchPanel="False" VisibleIndex="110">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:SpinEdit Name="PART_Editor" MaskType="Numeric" Mask="c" MinValue="0"
                                                          Increment="10" MaskUseAsDisplayFormat="True"
                                                          IsEnabled="False" />
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn Name="colINSTALL_HOURS"
                                                FieldName="ESTIMATION_DIRECT_ITEM.HOURS_INSTALL" Header="INSTALL HOURS"
                                                AllowSearchPanel="False" VisibleIndex="120">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:SpinEdit Name="PART_Editor" MaskType="Numeric" Mask="n" MinValue="0"
                                                          Increment="1" MaskUseAsDisplayFormat="True"
                                                          IsEnabled="{Binding RowData.Row.ISQUANTIFIABLE, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                            </dxg:GridControlBand>
                            <dxg:GridControlBand Name="bandCost" Header="Total Cost">
                                <dxg:GridColumn Name="colTOTAL_SUPPLY_COSTS" FieldName="TOTAL_SUPPLY_COSTS"
                                                Header="TOTAL SUPPLY COSTS" AllowSearchPanel="False" VisibleIndex="110">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:SpinEdit Name="PART_Editor" MaskType="Numeric" Mask="c" MinValue="0"
                                                          Increment="10" MaskUseAsDisplayFormat="True"
                                                          IsEnabled="False" />
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn Name="colTOTAL_FREIGHT_COSTS" FieldName="TOTAL_FREIGHT_COSTS"
                                                Header="TOTAL FREIGHT COSTS" AllowSearchPanel="False"
                                                VisibleIndex="130">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:SpinEdit Name="PART_Editor" MaskType="Numeric" Mask="c" MinValue="0"
                                                          Increment="10" MaskUseAsDisplayFormat="True"
                                                          IsEnabled="False" />
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn Name="colTOTAL_INSTALL_COSTS" FieldName="TOTAL_INSTALL_COSTS"
                                                Header="TOTAL INSTALL COSTS" AllowSearchPanel="False"
                                                VisibleIndex="120">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:SpinEdit Name="PART_Editor" MaskType="Numeric" Mask="c" MinValue="0"
                                                          Increment="10" MaskUseAsDisplayFormat="True"
                                                          IsEnabled="False" />
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                            </dxg:GridControlBand>
                        </dxg:GridControl.Bands>
                        <dxg:GridControl.DetailDescriptor>
                            <dxg:DataControlDetailDescriptor
                                ItemsSourceBinding="{Binding CHILD_ESTIMATION_DIRECT_ITEM}">
                                <dxg:GridControl Name="gridControlChild"
                                                 CurrentItem="{Binding DataContext.SelectedEntity, Mode=TwoWay, ElementName=userControl}"
                                                 SelectedItems="{Binding DataContext.SelectedEntities, Mode=TwoWay, ElementName=userControl}">
                                    <dxg:GridControl.Bands>
                                        <dxg:GridControlBand Name="bandChildGeneral" Header="General">
                                            <dxg:GridColumn Name="colChildSUPPLYWORKPACK"
                                                            FieldName="ESTIMATION_DIRECT_ITEM.GUID_SUPPLYWORKPACK"
                                                            Header="SUPPLY WORKPACK" AllowSearchPanel="False"
                                                            VisibleIndex="0">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:ComboBoxEditSettings Name="PART_Editor_ChildSupplyWORKPACK"
                                                                              ItemsSource="{Binding DataContext.WORKPACKCollection, ElementName=userControl}"
                                                                              IsTextEditable="True" AutoComplete="True"
                                                                              DisplayMember="INTERNAL_NAME1"
                                                                              ValueMember="GUID" />
                                                </dxg:GridColumn.EditSettings>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn Name="colChildINSTALLWORKPACK"
                                                            FieldName="ESTIMATION_DIRECT_ITEM.GUID_INSTALLWORKPACK"
                                                            Header="INSTALL WORKPACK" AllowSearchPanel="False"
                                                            VisibleIndex="10">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:ComboBoxEditSettings Name="PART_Editor_ChildInstallWORKPACK"
                                                                              ItemsSource="{Binding DataContext.WORKPACKCollection, ElementName=userControl}"
                                                                              IsTextEditable="True" AutoComplete="True"
                                                                              DisplayMember="INTERNAL_NAME1"
                                                                              ValueMember="GUID" />
                                                </dxg:GridColumn.EditSettings>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn Name="colChildCOMMODITY_CODE"
                                                            FieldName="COMMODITY_GROUP_CODE_SELECTION"
                                                            Header="COMMODITY_CODE" AllowSearchPanel="False"
                                                            VisibleIndex="20">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxg:LookUpEditSettings
                                                        Name="LookUpChildCOMMODITY_GROUP"
                                                        AutoComplete="True"
                                                        ValueMember="COMMODITY_GROUP_CODE_SELECTION"
                                                        DisplayMember="COMMODITY_CODE.FULLCODE"
                                                        IsTextEditable="true"
                                                        PopupMinWidth="1000"
                                                        AutoPopulateColumns="False"
                                                        NullValueButtonPlacement="None"
                                                        dx:DXSerializer.StoreLayoutMode="None"
                                                        ItemsSource="{Binding DataContext.COMMODITY_GROUP_MasterDetailFlatProjectSpecificDisplayCollection, ElementName=userControl}">
                                                        <dxg:LookUpEditSettings.PopupContentTemplate>
                                                            <ControlTemplate TargetType="ContentControl">
                                                                <dxg:GridControl x:Name="PART_GridControl"
                                                                                 ShowBorder="False" SelectionMode="Row">
                                                                    <dxg:GridControl.Columns>
                                                                        <dxg:GridColumn
                                                                            FieldName="COMMODITY_CODE.GUID_PROJECT"
                                                                            Header="PROJECT" VisibleIndex="10">
                                                                            <dxg:GridColumn.EditSettings>
                                                                                <dxe:ComboBoxEditSettings
                                                                                    ItemsSource="{Binding DataContext.PROJECTCollection, ElementName=userControl}"
                                                                                    IsTextEditable="False"
                                                                                    DisplayMember="NUMBER"
                                                                                    ValueMember="GUID" />
                                                                            </dxg:GridColumn.EditSettings>
                                                                        </dxg:GridColumn>
                                                                        <dxg:GridColumn
                                                                            FieldName="COMMODITY_CODE.FULLCODE"
                                                                            Header="FULLCODE" VisibleIndex="20" />
                                                                        <dxg:GridColumn
                                                                            FieldName="COMMODITY_CODE.COMMODITY_GROUP_DIRECT_ID"
                                                                            Header="GROUP_ID" VisibleIndex="25" />
                                                                        <dxg:GridColumn Name="colDISCIPLINE"
                                                                                        Header="DISCIPLINE"
                                                                                        FieldName="COMMODITY_CODE.GUID_DISCIPLINE"
                                                                                        VisibleIndex="50">
                                                                            <dxg:GridColumn.EditSettings>
                                                                                <dxe:ComboBoxEditSettings
                                                                                    ItemsSource="{Binding DataContext.DISCIPLINECollection, ElementName=userControl}"
                                                                                    IsTextEditable="False"
                                                                                    DisplayMember="NAME"
                                                                                    ValueMember="GUID" />
                                                                            </dxg:GridColumn.EditSettings>
                                                                        </dxg:GridColumn>
                                                                        <dxg:GridColumn FieldName="COMMODITY_CODE.TYPE"
                                                                                        Header="TYPE" VisibleIndex="70" />
                                                                        <dxg:GridColumn FieldName="COMMODITY_CODE.SPEC"
                                                                                        Header="SPEC" VisibleIndex="80" />
                                                                        <dxg:GridColumn
                                                                            FieldName="COMMODITY_CODE.DESCRIPTION"
                                                                            Header="DESCRIPTION" VisibleIndex="90" />
                                                                        <dxg:GridColumn FieldName="COMMODITY_CODE.UOM"
                                                                                        Header="UOM" VisibleIndex="100"
                                                                                        AllowEditing="True">
                                                                            <dxg:GridColumn.EditSettings>
                                                                                <dxe:ComboBoxEditSettings
                                                                                    ItemsSource="{Binding DataContext.UOMCollection, ElementName=userControl}"
                                                                                    AutoComplete="True"
                                                                                    DisplayMember="UOM1"
                                                                                    ValueMember="UOM1" />
                                                                            </dxg:GridColumn.EditSettings>
                                                                        </dxg:GridColumn>
                                                                        <dxg:GridColumn x:Name="colRATE_SUPPLY"
                                                                                        FieldName="COMMODITY_CODE.RATE_SUPPLY"
                                                                                        Header="SUPPLY RATE"
                                                                                        VisibleIndex="120">
                                                                            <dxg:GridColumn.CellTemplate>
                                                                                <DataTemplate>
                                                                                    <dxe:SpinEdit Name="PART_Editor"
                                                                                                  MaskType="Numeric"
                                                                                                  Mask="c" MinValue="0"
                                                                                                  Increment="10"
                                                                                                  MaskUseAsDisplayFormat="True"
                                                                                                  IsEnabled="{Binding RowData.Row.ISQUANTIFIABLE, UpdateSourceTrigger=PropertyChanged }" />
                                                                                </DataTemplate>
                                                                            </dxg:GridColumn.CellTemplate>
