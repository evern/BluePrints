<UserControl x:Class="BluePrints.Views.DesignTimesheetEntryCollectionView" xmlns:dxci="http://schemas.devexpress.com/winfx/2008/xaml/core/internal" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:custom="clr-namespace:BaseModel.Misc;assembly=BaseModel" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon" xmlns:dxrudex="http://schemas.devexpress.com/winfx/2008/xaml/reports/userdesignerextensions" xmlns:filter="clr-namespace:BluePrints.Common.Filtering" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:view="clr-namespace:BluePrints.Views" xmlns:viewmodel="clr-namespace:BluePrints.ViewModels" x:Name="userControl" d:DesignHeight="400" d:DesignWidth="600" DataContext="{dxmvvm:ViewModelSource viewmodel:DesignTimesheetEntryCollectionViewModelWrapper}" mc:Ignorable="d">
    <dxmvvm:Interaction.Behaviors>
        <dxc:DialogService x:Name="DateFromToDialogService">
            <dxc:DialogService.DialogStyle>
                <Style TargetType="dx:DXDialogWindow">
                    <Setter Property="SizeToContent" Value="WidthAndHeight" />
                </Style>
            </dxc:DialogService.DialogStyle>
        </dxc:DialogService>
    </dxmvvm:Interaction.Behaviors>
    <UserControl.Resources>
        <ResourceDictionary>
            <DataTemplate x:Key="TextEditor">
                <dxe:TextEdit x:Name="PART_Editor" IsReadOnly="True" />
            </DataTemplate>
            <DataTemplate x:Key="DeliverableCollectionEditor">
                <dxg:LookUpEdit Name="PART_Editor" AutoComplete="True" AutoPopulateColumns="False" DisplayMember="INTERNAL_NUM" IncrementalFiltering="True" IsTextEditable="true" ItemsSource="{Binding RowData.Row.DeliverableCollection}" NullValueButtonPlacement="Popup" PopupWidth="1000" ValueMember="INTERNAL_NUM">
                    <dxg:LookUpEdit.StyleSettings>
                        <dxg:SearchLookUpEditStyleSettings />
                    </dxg:LookUpEdit.StyleSettings>
                    <dxg:LookUpEdit.PopupContentTemplate>
                        <ControlTemplate TargetType="ContentControl">
                            <dxg:GridControl x:Name="PART_GridControl" SelectionMode="Row" ShowBorder="False">
                                <dxg:GridControl.Columns>
                                    <dxg:GridColumn FieldName="INTERNAL_NUM" Width="150" Header="Name" ReadOnly="True" />
                                    <dxg:GridColumn FieldName="PRIMARY_TITLE" Width="250" Header="Primary Title" />
                                    <dxg:GridColumn FieldName="SECONDARY_TITLE" Header="Secondary Title" />
                                    <dxg:GridColumn FieldName="COMMENTS" Width="150" Header="Comments" />
                                    <dxg:GridColumn FieldName="GUID_DEPARTMENT" Header="Department" ReadOnly="True">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding View.DataContext.DEPARTMENTCollection}" ValueMember="GUID" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="GUID_DOCTYPE" Header="Document Type" ReadOnly="True">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding View.DataContext.DOCTYPECollection}" ValueMember="GUID" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                </dxg:GridControl.Columns>
                                <dxg:GridControl.View>
                                    <dxg:TableView RowStyle="{StaticResource SelectionBackgroundStyle}" ShowFilterPanelMode="ShowAlways" ShowFocusedRectangle="True" ShowGroupPanel="False" ShowSelectionRectangle="True" />
                                </dxg:GridControl.View>
                            </dxg:GridControl>
                        </ControlTemplate>
                    </dxg:LookUpEdit.PopupContentTemplate>
                </dxg:LookUpEdit>
            </DataTemplate>
            <DataTemplate x:Key="MasterJobNoAuthorisedCollection">
                <dxe:ComboBoxEdit x:Name="PART_Editor" AutoComplete="True" IsTextEditable="False" DisplayMember="JOBCODE" ValueMember="JOBNO" ItemsSource="{Binding View.DataContext.AuthorisedJobCollection}" IsReadOnly="{Binding RowData.Row.CanSubmit, Converter={dxmvvm:BooleanNegationConverter}}" />
            </DataTemplate>
            <DataTemplate x:Key="CostGroupAuthorisedCollection">
                <dxe:ComboBoxEdit x:Name="PART_Editor" AutoComplete="True" IsTextEditable="False" ItemsSource="{Binding RowData.Row.CostGroupCollection}" DisplayMember="SHORTCODE" ValueMember="SEQNO" IsReadOnly="{Binding RowData.Row.CanSubmit, Converter={dxmvvm:BooleanNegationConverter}}" />
            </DataTemplate>
            <DataTemplate x:Key="AreaAuthorisedCollection">
                <dxe:ComboBoxEdit x:Name="PART_Editor" NullValueButtonPlacement="Popup" AutoComplete="True" IsTextEditable="False" ItemsSource="{Binding RowData.Row.AreaCollection}" IsReadOnly="{Binding RowData.Row.CanSubmit, Converter={dxmvvm:BooleanNegationConverter}}" />
            </DataTemplate>
            <DataTemplate x:Key="CostTypeAuthorisedCollection">
                <dxg:LookUpEdit Name="PART_Editor" AutoComplete="True" AutoPopulateColumns="False" DisplayMember="COSTDESC" IncrementalFiltering="True" IsTextEditable="False" ItemsSource="{Binding RowData.Row.TaggedValidJOB_COSTTYPES}"  IsReadOnly="{Binding RowData.Row.CanSubmit, Converter={dxmvvm:BooleanNegationConverter}}" PopupMinWidth="700" ValueMember="SEQNO">
                    <dxg:LookUpEdit.StyleSettings>
                        <dxg:SearchLookUpEditStyleSettings />
                    </dxg:LookUpEdit.StyleSettings>
                    <dxg:LookUpEdit.PopupContentTemplate>
                        <ControlTemplate TargetType="ContentControl">
                            <dxg:GridControl x:Name="PART_GridControl" SelectionMode="Row" ShowBorder="False" FilterString="[IsValid] = 'True'">
                                <dxg:GridControl.Columns>
                                    <dxg:GridColumn Width="*" FieldName="COSTDESC" Header="Code" ReadOnly="True" />
                                </dxg:GridControl.Columns>
                                <dxg:GridControl.View>
                                    <dxg:TableView RowStyle="{StaticResource SelectionBackgroundStyle}" ShowFocusedRectangle="True" ShowGroupPanel="False" ShowSelectionRectangle="True" />
                                </dxg:GridControl.View>
                            </dxg:GridControl>
                        </ControlTemplate>
                    </dxg:LookUpEdit.PopupContentTemplate>
                </dxg:LookUpEdit>
            </DataTemplate>
            <DataTemplate x:Key="WeekStartDateHeaderTemplate">
                <dxe:DateEdit EditValue="{Binding DataContext.WeekBeginningDate, ElementName=userControl}" />
            </DataTemplate>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/DefaultBluePrintsResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/BaseModel;component/View/ResourceDictionaries/DefaultControlResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/CustomControlResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/ConverterResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Style="{StaticResource CollectionView.RootContainer}">
        <dxb:BarManager>
            <dxb:BarManager.Items>
                <dxb:BarSubItem ItemLinksSource="{StaticResource RibbonDefaultGridButtons}" />
            </dxb:BarManager.Items>
            <DockPanel>
                <dxr:RibbonControl Style="{StaticResource DefaultRibbonControlStyle}">
                    <dxr:RibbonDefaultPageCategory MergeType="Replace" Caption="defaultCategory">
                        <dxr:RibbonPage MergeType="Replace" Caption="Grid">
                            <dxr:RibbonPageGroup MergeType="Replace" Caption="Grid">
                                <dxb:BarButtonItemLink BarItemName="biFullRefresh1" />
                                <dxb:BarButtonItemLink BarItemName="biBulkDelete1" />
                                <dxb:BarButtonItemLink BarItemName="biUndo1" />
                                <dxb:BarButtonItemLink BarItemName="biRedo1" />
                                <dxb:BarButtonItemLink BarItemName="biKeyboardCopy1"/>
                                <dxb:BarButtonItemLink BarItemName="biKeyboardPaste1" />
                                <dxb:BarCheckItemLink BarItemName="biCellSelection1" />
                                <dxb:BarButtonItemLink BarItemName="biSaveLayout1" />
                                <dxb:BarButtonItemLink BarItemName="biResetLayout1" />
                                <dxb:BarEditItem x:Name="biHideOnStartup" EditValue="{Binding IsRemoteEXODb, Mode=TwoWay, NotifyOnSourceUpdated=True}" IsEnabled="{Binding IsLoading, Converter={StaticResource BooleanNegationConverter}}" Content="Database" ToolTip="Toggle exo timesheet database" Glyph="{dxc:DXImage Images/Data/ManageDatasource_16x16.png}" LargeGlyph="{dxc:DXImage Images/Data/ManageDatasource_16x16.png}">
                                    <dxb:BarEditItem.EditSettings>
                                        <dxe:ToggleSwitchEditSettings IsThreeState="False" UncheckedStateContent="Perth" CheckedStateContent="Canada" ContentPlacement="Both" />
                                    </dxb:BarEditItem.EditSettings>
                                </dxb:BarEditItem>
                            </dxr:RibbonPageGroup>
                            <dxr:RibbonPageGroup MergeType="Replace" Caption="Tools">
                                <dxb:BarButtonItemLink BarItemName="biShowValidJobLines" />
                                <dxb:BarButtonItemLink BarItemName="biCommitToExo" />
                            </dxr:RibbonPageGroup>
                        </dxr:RibbonPage>
                    </dxr:RibbonDefaultPageCategory>
                </dxr:RibbonControl>
                <dxlc:LayoutGroup Name="LayoutGroupMain" Orientation="Horizontal" View="Group">
                    <dxlc:LayoutGroup>
                        <dxg:GridControl x:Name="GridControl" dxc:DXSerializer.SerializationID="GridControlDesignTimesheet" Style="{StaticResource DefaultGridControlTemplate}">
                            <dxg:GridControl.Columns>
                                <dxg:GridColumn FieldName="Timesheet.STAFFNO" AllowBestFit="false" Width="150" Header="Resource" ReadOnly="True" Visible="{Binding IsReview}">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings AutoComplete="True" IsTextEditable="True" ItemsSource="{Binding JOBCOST_RESOURCECollection}" DisplayMember="RESOURCENAME" ValueMember="SEQNO" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="MasterJobNo" AllowBestFit="false" Width="50" Header="Project Number" ReadOnly="{Binding IsReview}">
                                    <dxg:GridColumn.CellTemplateSelector>
                                        <viewmodel:DesignTimesheetEditorTemplateSelector />
                                    </dxg:GridColumn.CellTemplateSelector>
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings AutoComplete="True" IsTextEditable="False" ItemsSource="{Binding JOBCOST_HDRCollection}" DisplayMember="JOBCODE" ValueMember="JOBNO" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="CostGroupNo" CopyValueAsDisplayText="True" AllowBestFit="false" Width="50" Header="Discipline" ReadOnly="{Binding IsReview}">
                                    <dxg:GridColumn.CellTemplateSelector>
                                        <viewmodel:DesignTimesheetEditorTemplateSelector />
                                    </dxg:GridColumn.CellTemplateSelector>
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings AutoComplete="True" IsTextEditable="False" ItemsSource="{Binding JOB_COSTGROUPCollection}" DisplayMember="SHORTCODE" ValueMember="SEQNO" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="AreaCode" AllowBestFit="false" Width="50" Header="Area" ReadOnly="{Binding IsReview}">
                                    <dxg:GridColumn.CellTemplateSelector>
                                        <viewmodel:DesignTimesheetEditorTemplateSelector />
                                    </dxg:GridColumn.CellTemplateSelector>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="PhaseCode" AllowBestFit="false" Width="50" Header="Phase" ReadOnly="{Binding IsReview}">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings AutoComplete="True" IsTextEditable="False" NullValueButtonPlacement="Popup" ItemsSource="{Binding PHASECollection}" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="DeliverableInternalName" AllowBestFit="false" Width="*" Header="Deliverable" ReadOnly="{Binding IsReview}">
                                    <dxg:GridColumn.CellTemplateSelector>
                                        <viewmodel:DesignTimesheetEditorTemplateSelector />
                                    </dxg:GridColumn.CellTemplateSelector>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="COST_TYPE" AllowBestFit="false" Width="150" Header="Cost Type" ReadOnly="{Binding IsReview}">
                                    <dxg:GridColumn.CellTemplateSelector>
                                        <viewmodel:DesignTimesheetEditorTemplateSelector />
                                    </dxg:GridColumn.CellTemplateSelector>
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="COSTDESC" ValueMember="SEQNO" IsTextEditable="False" ItemsSource="{Binding JOB_COSTTYPESCollection}" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="Timesheet.X_VARIATIONCODE" AllowBestFit="false" Width="100" Header="Variation Code" ReadOnly="{Binding IsReview}">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:ComboBoxEdit x:Name="PART_Editor" AutoComplete="True" IsTextEditable="True" ItemsSource="{Binding RowData.Row.VariationCodeCollection}" IsReadOnly="{Binding RowData.Row.CanSubmit, Converter={dxmvvm:BooleanNegationConverter}}" />
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="Day1" AllowBestFit="false" Width="100" HeaderTemplate="{StaticResource WeekStartDateHeaderTemplate}" ReadOnly="{Binding IsReview}">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:SpinEdit x:Name="PART_Editor" Mask="n2" MinValue="0" MaskType="Numeric" MaskUseAsDisplayFormat="True" IsReadOnly="{Binding RowData.Row.CanSubmit, Converter={dxmvvm:BooleanNegationConverter}}" />
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="Day2" AllowBestFit="false" Width="70" Header="{Binding WeekDateDay2}" ReadOnly="{Binding IsReview}">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:SpinEdit x:Name="PART_Editor" Mask="n2" MinValue="0" MaskType="Numeric" MaskUseAsDisplayFormat="True" IsReadOnly="{Binding RowData.Row.CanSubmit, Converter={dxmvvm:BooleanNegationConverter}}" />
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="Day3" AllowBestFit="false" Width="70" Header="{Binding WeekDateDay3}" ReadOnly="{Binding IsReview}">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:SpinEdit x:Name="PART_Editor" Mask="n2" MinValue="0" MaskType="Numeric" MaskUseAsDisplayFormat="True" IsReadOnly="{Binding RowData.Row.CanSubmit, Converter={dxmvvm:BooleanNegationConverter}}" />
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="Day4" AllowBestFit="false" Width="70" Header="{Binding WeekDateDay4}" ReadOnly="{Binding IsReview}">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:SpinEdit x:Name="PART_Editor" Mask="n2" MinValue="0" MaskType="Numeric" MaskUseAsDisplayFormat="True" IsReadOnly="{Binding RowData.Row.CanSubmit, Converter={dxmvvm:BooleanNegationConverter}}" />
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="Day5" AllowBestFit="false" Width="70" Header="{Binding WeekDateDay5}" ReadOnly="{Binding IsReview}">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:SpinEdit x:Name="PART_Editor" Mask="n2" MinValue="0" MaskType="Numeric" MaskUseAsDisplayFormat="True" IsReadOnly="{Binding RowData.Row.CanSubmit, Converter={dxmvvm:BooleanNegationConverter}}" />
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="Day6" AllowBestFit="false" Width="70" Header="{Binding WeekDateDay6}" ReadOnly="{Binding IsReview}">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:SpinEdit x:Name="PART_Editor" Mask="n2" MinValue="0" MaskType="Numeric" MaskUseAsDisplayFormat="True" IsReadOnly="{Binding RowData.Row.CanSubmit, Converter={dxmvvm:BooleanNegationConverter}}" />
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="Day7" AllowBestFit="false" Width="70" Header="{Binding WeekDateDay7}" ReadOnly="{Binding IsReview}">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:SpinEdit x:Name="PART_Editor" Mask="n2" MinValue="0" MaskType="Numeric" MaskUseAsDisplayFormat="True" IsReadOnly="{Binding RowData.Row.CanSubmit, Converter={dxmvvm:BooleanNegationConverter}}" />
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="TotalHours" AllowBestFit="false" Width="70" ReadOnly="True" Header="Total Hours">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:SpinEditSettings x:Name="PART_Editor" Mask="n2" MinValue="0" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn AllowEditing="False" FieldName="UNBOUND_SUBMIT" Header="Cancel" AllowBestFit="false" Width="80" HeaderToolTip="Submit this line, submitted timesheets cannot be altered or deleted" ReadOnly="True" UnboundType="Boolean">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Height="18" Command="{Binding View.DataContext.ToggleTimesheetSubmitCommand}" CommandParameter="{Binding RowData.Row}" IsEnabled="{Binding RowData.Row.CanSubmit}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Margin="0,0,3,0" Source="{Binding Path=RowData.Row.IsSubmitted, Converter={StaticResource BoolToImageConverter}}" />
                                                    <TextBlock VerticalAlignment="Center" Text="{Binding Path=RowData.Row.SubmitButtonText}" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                            </dxg:GridControl.Columns>
                            <dxg:GridControl.View>
                                <dxg:TableView x:Name="tableView" Style="{StaticResource DefaultTableViewTemplate}" NewItemRowPosition="{Binding NewItemRowPosition}">
                                    <dxg:TableView.RowCellMenuCustomizations>
                                        <dxb:BarButtonItemLink BarItemName="biCopyWithHeader1" />
                                        <dxb:BarButtonItemLink BarItemName="biBulkDelete1" />
                                        <dxb:BarButtonItemLink BarItemName="biKeyboardCopy1" />
                                        <dxb:BarButtonItemLink BarItemName="biKeyboardPaste1" />
                                        <dxb:BarItemLinkSeparator />
                                        <dxb:BarButtonItemLink BarItemName="biFullRefresh1" />
                                    </dxg:TableView.RowCellMenuCustomizations>
                                </dxg:TableView>
                            </dxg:GridControl.View>
                        </dxg:GridControl>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutGroup>
            </DockPanel>
        </dxb:BarManager>
    </Grid>
</UserControl>
