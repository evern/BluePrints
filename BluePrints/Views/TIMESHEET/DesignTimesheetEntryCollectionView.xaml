<UserControl x:Class="BluePrints.Views.DesignTimesheetEntryCollectionView" xmlns:dxci="http://schemas.devexpress.com/winfx/2008/xaml/core/internal" xmlns:view1="clr-namespace:BluePrints.Common.ViewModel.Misc" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:custom="clr-namespace:BaseModel.Misc;assembly=BaseModel" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon" xmlns:dxrudex="http://schemas.devexpress.com/winfx/2008/xaml/reports/userdesignerextensions" xmlns:filter="clr-namespace:BluePrints.Common.Filtering" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:view="clr-namespace:BluePrints.Views" xmlns:viewmodel="clr-namespace:BluePrints.ViewModels" x:Name="userControl" d:DesignHeight="400" d:DesignWidth="600" DataContext="{dxmvvm:ViewModelSource viewmodel:DesignTimesheetEntryCollectionViewModelWrapper}" mc:Ignorable="d">
    <dxmvvm:Interaction.Behaviors>
        <dxc:DialogService x:Name="DateFromToDialogService">
            <dxc:DialogService.DialogStyle>
                <Style TargetType="dx:DXDialogWindow">
                    <Setter Property="SizeToContent" Value="WidthAndHeight" />
                </Style>
            </dxc:DialogService.DialogStyle>
        </dxc:DialogService>
    </dxmvvm:Interaction.Behaviors>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/DefaultBluePrintsResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/BaseModel;component/View/ResourceDictionaries/DefaultControlResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/ConverterResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Style="{StaticResource CollectionView.RootContainer}">
        <dxb:BarManager>
            <dxb:BarManager.Items>
                <dxb:BarSubItem ItemLinksSource="{StaticResource RibbonDefaultGridButtons}" />
            </dxb:BarManager.Items>
            <DockPanel>
                <dxr:RibbonControl Style="{StaticResource DefaultRibbonControlStyle}">
                    <dxr:RibbonDefaultPageCategory MergeType="Replace" Caption="defaultCategory">
                        <dxr:RibbonPage MergeType="Replace" Caption="Grid">
                            <dxr:RibbonPageGroup MergeType="Replace" Caption="Grid">
                                <dxb:BarButtonItemLink BarItemName="biFullRefresh1" />
                                <dxb:BarButtonItemLink BarItemName="biBulkDelete1" />
                                <dxb:BarButtonItemLink BarItemName="biUndo1" />
                                <dxb:BarButtonItemLink BarItemName="biRedo1" />
                                <dxb:BarButtonItemLink BarItemName="biKeyboardCopy1"/>
                                <dxb:BarButtonItemLink BarItemName="biKeyboardPaste1" />
                                <dxb:BarCheckItemLink BarItemName="biCellSelection1" />
                                <dxb:BarButtonItemLink BarItemName="biSaveLayout1" />
                                <dxb:BarButtonItemLink BarItemName="biResetLayout1" />
                            </dxr:RibbonPageGroup>
                            <dxr:RibbonPageGroup MergeType="Replace" Caption="Tools">
                                <dxb:BarButtonItemLink BarItemName="biShowValidJobLines" />
                                <dxb:BarButtonItemLink BarItemName="biCommitToExo" />
                            </dxr:RibbonPageGroup>
                        </dxr:RibbonPage>
                    </dxr:RibbonDefaultPageCategory>
                </dxr:RibbonControl>
                <dxlc:LayoutControl DockPanel.Dock="Right">
                    <dxlc:LayoutGroup.LayoutTransform>
                        <RotateTransform Angle="90" />
                    </dxlc:LayoutGroup.LayoutTransform>
                    <dxlc:LayoutGroup IsCollapsible="True" View="Group">
                        <Grid>
                            <Grid.LayoutTransform>
                                <RotateTransform Angle="-90" />
                            </Grid.LayoutTransform>
                            <filter:FilterAccordionView DataContext="{Binding FilterTreeViewModel}" />
                        </Grid>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutControl>
                <dxlc:LayoutGroup Name="LayoutGroupMain" Orientation="Horizontal" View="Group">
                    <dxlc:LayoutGroup>
                        <dxg:GridControl x:Name="GridControl" dxc:DXSerializer.SerializationID="GridControl" dxc:DXSerializer.StoreLayoutMode="All" Style="{StaticResource DefaultGridControlTemplate}">
                            <dxg:GridControl.Columns>
                                <dxg:GridColumn FieldName="GUID_AREA" AllowBestFit="false" Width="50" Header="Job Number">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="INTERNAL_NUM" IsTextEditable="True" ItemsSource="{Binding AREACollection}" ValueMember="GUID" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                            </dxg:GridControl.Columns>
                            <dxg:GridControl.View>
                                <dxg:TableView x:Name="tableView" Style="{StaticResource DefaultTableViewTemplate}">
                                    <dxg:TableView.RowCellMenuCustomizations>
                                    </dxg:TableView.RowCellMenuCustomizations>
                                    <dxg:TableView.FormatConditions>
                                    </dxg:TableView.FormatConditions>
                                </dxg:TableView>
                            </dxg:GridControl.View>
                        </dxg:GridControl>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutGroup>
            </DockPanel>
        </dxb:BarManager>
    </Grid>
</UserControl>
