<UserControl x:Class="BluePrints.Views.TimesheetEntryCollectionView" xmlns:dxci="http://schemas.devexpress.com/winfx/2008/xaml/core/internal" xmlns:view1="clr-namespace:BluePrints.Common.ViewModel.Misc" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:custom="clr-namespace:BaseModel.Misc;assembly=BaseModel" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon" xmlns:dxrudex="http://schemas.devexpress.com/winfx/2008/xaml/reports/userdesignerextensions" xmlns:filter="clr-namespace:BluePrints.Common.Filtering" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:view="clr-namespace:BluePrints.Views" xmlns:viewmodel="clr-namespace:BluePrints.ViewModels" x:Name="userControl" d:DesignHeight="400" d:DesignWidth="600" DataContext="{dxmvvm:ViewModelSource viewmodel:TimesheetEntryCollectionViewModelWrapper}" mc:Ignorable="d">
    <dxmvvm:Interaction.Behaviors>
        <dxc:DialogService x:Name="DateFromToDialogService">
            <dxc:DialogService.DialogStyle>
                <Style TargetType="dx:DXDialogWindow">
                    <Setter Property="SizeToContent" Value="WidthAndHeight" />
                </Style>
            </dxc:DialogService.DialogStyle>
        </dxc:DialogService>
    </dxmvvm:Interaction.Behaviors>
    <UserControl.Resources>
        <ResourceDictionary>
            <view1:ColumnTemplateSelector x:Key="ColumnTemplateSelector"/>
            <DataTemplate x:Key="DefaultColumnTemplate">
                <ContentControl>
                    <dxg:GridColumn AllowBestFit="False" FieldName="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).FieldName, RelativeSource={RelativeSource Self}}" 
                        Header="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Header, RelativeSource={RelativeSource Self}}" 
                        Width="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Width, RelativeSource={RelativeSource Self}}"
                        Fixed="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Fixed, RelativeSource={RelativeSource Self}}"
                        ReadOnly="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).ReadOnly, RelativeSource={RelativeSource Self}}"
                        Visible="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Visible, RelativeSource={RelativeSource Self}, Mode=TwoWay}"
                        HeaderToolTip="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).HeaderToolTip, RelativeSource={RelativeSource Self}}"/>
                </ContentControl>
            </DataTemplate>
            <DataTemplate x:Key="NumberColumnTemplate">
                <ContentControl>
                    <dxg:GridColumn AllowBestFit="False" ColumnFilterMode="Value" FieldName="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).FieldName, RelativeSource={RelativeSource Self}}" 
                        Header="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Header, RelativeSource={RelativeSource Self}}" 
                        Width="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Width, RelativeSource={RelativeSource Self}}"
                        Fixed="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Fixed, RelativeSource={RelativeSource Self}}"
                        ReadOnly="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).ReadOnly, RelativeSource={RelativeSource Self}}"
                        Visible="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Visible, RelativeSource={RelativeSource Self}, Mode=TwoWay}"
                        HeaderToolTip="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).HeaderToolTip, RelativeSource={RelativeSource Self}}" >
                        <dxg:GridColumn.EditSettings>
                            <dxe:SpinEditSettings Mask="{Binding Mask}" MaskType="Numeric" Increment="{Binding Increment}" MaskUseAsDisplayFormat="True" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                </ContentControl>
            </DataTemplate>
            <DataTemplate x:Key="UnboundColumnTemplate">
                <ContentControl>
                    <dxg:GridColumn AllowBestFit="False" UnboundType="Boolean" 
                        FieldName="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).FieldName, RelativeSource={RelativeSource Self}}" 
                        Header="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Header, RelativeSource={RelativeSource Self}}" 
                        Width="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Width, RelativeSource={RelativeSource Self}}"
                        Fixed="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Fixed, RelativeSource={RelativeSource Self}}"
                        ReadOnly="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).ReadOnly, RelativeSource={RelativeSource Self}}"
                        Visible="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Visible, RelativeSource={RelativeSource Self}, Mode=TwoWay}"
                        HeaderToolTip="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).HeaderToolTip, RelativeSource={RelativeSource Self}}"/>
                </ContentControl>
            </DataTemplate>
            <DataTemplate x:Key="TextColumnTemplate">
                <ContentControl>
                    <dxg:GridColumn AllowBestFit="False" FieldName="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).FieldName, RelativeSource={RelativeSource Self}}" 
                        Header="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Header, RelativeSource={RelativeSource Self}}" 
                        Width="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Width, RelativeSource={RelativeSource Self}}"
                        Fixed="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Fixed, RelativeSource={RelativeSource Self}}"
                        ReadOnly="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).ReadOnly, RelativeSource={RelativeSource Self}}"
                        Visible="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Visible, RelativeSource={RelativeSource Self}, Mode=TwoWay}"
                        HeaderToolTip="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).HeaderToolTip, RelativeSource={RelativeSource Self}}">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings NullText="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).NullText, RelativeSource={RelativeSource Self}}" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                </ContentControl>
            </DataTemplate>
            <DataTemplate x:Key="CollectionColumnTemplate">
                <ContentControl>
                    <dxg:GridColumn AllowBestFit="False" UnboundType="Object" FieldName="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).FieldName, RelativeSource={RelativeSource Self}}" 
                        Header="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Header, RelativeSource={RelativeSource Self}}" 
                        Width="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Width, RelativeSource={RelativeSource Self}}"
                        Fixed="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Fixed, RelativeSource={RelativeSource Self}}"
                        ReadOnly="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).ReadOnly, RelativeSource={RelativeSource Self}}"
                        Visible="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Visible, RelativeSource={RelativeSource Self}, Mode=TwoWay}"
                        HeaderToolTip="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).HeaderToolTip, RelativeSource={RelativeSource Self}}" >
                        <dxg:GridColumn.EditSettings>
                            <dxe:ComboBoxEditSettings AutoComplete="True" IsTextEditable="True" ItemsSource="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).ItemsSource, RelativeSource={RelativeSource Self}}" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                </ContentControl>
            </DataTemplate>
            <DataTemplate x:Key="DisplayMemberCollectionColumnTemplate">
                <ContentControl>
                    <dxg:GridColumn AllowBestFit="False" UnboundType="Object" FieldName="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).FieldName, RelativeSource={RelativeSource Self}}" 
                        Header="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Header, RelativeSource={RelativeSource Self}}" 
                        Width="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Width, RelativeSource={RelativeSource Self}}"
                        Fixed="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Fixed, RelativeSource={RelativeSource Self}}"
                        ReadOnly="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).ReadOnly, RelativeSource={RelativeSource Self}}"
                        Visible="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Visible, RelativeSource={RelativeSource Self}, Mode=TwoWay}"
                        HeaderToolTip="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).HeaderToolTip, RelativeSource={RelativeSource Self}}" >
                        <dxg:GridColumn.EditSettings>
                            <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).DisplayMember, RelativeSource={RelativeSource Self}}" IsTextEditable="True" ItemsSource="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).ItemsSource, RelativeSource={RelativeSource Self}}" ValueMember="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).ValueMember, RelativeSource={RelativeSource Self}}" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                </ContentControl>
            </DataTemplate>
            <DataTemplate x:Key="SummaryTemplate">
                <ContentControl>
                    <dxg:GridSummaryItem FieldName="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).FieldName, RelativeSource={RelativeSource Self}}"
                                         SummaryType="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Type, RelativeSource={RelativeSource Self}}"
                                         DisplayFormat="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).DisplayFormat, RelativeSource={RelativeSource Self}}"/>
                </ContentControl>
            </DataTemplate>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/DefaultBluePrintsResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/BaseModel;component/View/ResourceDictionaries/DefaultControlResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/ConverterResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Style="{StaticResource CollectionView.RootContainer}">
        <dxb:BarManager>
            <dxb:BarManager.Items>
                <dxb:BarSubItem ItemLinksSource="{StaticResource RibbonDefaultGridButtons}" />
                <dxb:BarButtonItem x:Name="biCopyWithHeader1" Command="{Binding CopyWithHeaderCommand}" Content="Copy With Headers" Glyph="{dx:DXImageOffice2013 Image=AlignHorizontalTop_16x16.png}" RibbonStyle="SmallWithText" ToolTip="Copy selected rows along with header" />
                <dxb:BarButtonItem x:Name="biCommitToExo" Command="{Binding CommitToExoCommand}" Content="Submit to Exo" Glyph="{dx:DXImage Image=DoubleNext_16x16.png}" LargeGlyph="{dx:DXImage Image=DoubleNext_32x32.png}" ToolTip="Commit current table data to exo timesheet" />
                <dxb:BarButtonItem x:Name="biShowValidJobLines" Command="{Binding ShowValidJobLinesCommand}" Content="Show Valid Jobs" Glyph="{dx:DXImage Image=RowIndex_16x16.png}" LargeGlyph="{dx:DXImage Image=RowIndex_32x32.png}" ToolTip="Clear current table entries and populate with valid job lines" />
            </dxb:BarManager.Items>
            <DockPanel>
                <dxr:RibbonControl Style="{StaticResource DefaultRibbonControlStyle}">
                    <dxr:RibbonDefaultPageCategory MergeType="Replace" Caption="defaultCategory">
                        <dxr:RibbonPage MergeType="Replace" Caption="Grid">
                            <dxr:RibbonPageGroup MergeType="Replace" Caption="Grid">
                                <dxb:BarButtonItemLink BarItemName="biFullRefresh1" />
                                <dxb:BarButtonItemLink BarItemName="biBulkDelete1" />
                                <dxb:BarButtonItemLink BarItemName="biUndo1" />
                                <dxb:BarButtonItemLink BarItemName="biRedo1" />
                                <dxb:BarButtonItemLink BarItemName="biKeyboardCopy1"/>
                                <dxb:BarButtonItemLink BarItemName="biKeyboardPaste1" />
                                <dxb:BarCheckItemLink BarItemName="biCellSelection1" />
                                <dxb:BarButtonItemLink BarItemName="biSaveLayout1" />
                                <dxb:BarButtonItemLink BarItemName="biResetLayout1" />
                            </dxr:RibbonPageGroup>
                            <dxr:RibbonPageGroup MergeType="Replace" Caption="Tools">
                                <dxb:BarButtonItemLink BarItemName="biShowValidJobLines" />
                                <dxb:BarButtonItemLink BarItemName="biCommitToExo" />
                            </dxr:RibbonPageGroup>
                        </dxr:RibbonPage>
                    </dxr:RibbonDefaultPageCategory>
                </dxr:RibbonControl>
                <dxlc:LayoutControl DockPanel.Dock="Right">
                    <dxlc:LayoutGroup.LayoutTransform>
                        <RotateTransform Angle="90" />
                    </dxlc:LayoutGroup.LayoutTransform>
                    <dxlc:LayoutGroup IsCollapsible="True" View="Group">
                        <Grid>
                            <Grid.LayoutTransform>
                                <RotateTransform Angle="-90" />
                            </Grid.LayoutTransform>
                            <filter:FilterAccordionView DataContext="{Binding FilterTreeViewModel}" />
                        </Grid>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutControl>
                <dxlc:LayoutGroup Name="LayoutGroupMain" Orientation="Horizontal" View="Group">
                    <dxlc:LayoutGroup>
                        <dxg:GridControl x:Name="GridControl" TotalSummarySource="{Binding SummaryDescriptors}"
                                    TotalSummaryGeneratorTemplate="{StaticResource SummaryTemplate}"
                                    GroupSummarySource="{Binding SummaryDescriptors}"
                                    GroupSummaryGeneratorTemplate="{StaticResource SummaryTemplate}" 
                                    ColumnGeneratorTemplateSelector="{StaticResource ColumnTemplateSelector}" ColumnsSource="{Binding ColumnDescriptors}" LayoutTransform="{Binding Zoom, Mode=OneWay}" dxc:DXSerializer.SerializationID="GridControlTimesheetEntry" dxc:DXSerializer.StoreLayoutMode="All" AutoGenerateColumns="None" ClipboardCopyMode="ExcludeHeader" CurrentItem="{Binding SelectedDataRow, Mode=TwoWay}" SelectedItems="{Binding SelectedDataRows, Mode=TwoWay}" ItemsSource="{Binding DataPointsTable}" SelectionMode="{Binding SelectMode}" ShowLoadingPanel="{Binding IsTimesheetLoaded, Converter={dxmvvm:BooleanNegationConverter}}">
                            <dxmvvm:Interaction.Behaviors>
                                <dxmvvm:EventToCommand Command="{Binding CustomUnboundColumnDataCommand}" EventName="CustomUnboundColumnData" PassEventArgsToCommand="True" />
                            </dxmvvm:Interaction.Behaviors>
                            <dxg:GridControl.View>
                                <dxg:TableView x:Name="tableView" GroupSummaryDisplayMode="AlignByColumns" NewItemRowPosition="Top" ShowAutoFilterRow="True" ShowCriteriaInAutoFilterRow="True" ShowTotalSummary="True" ScrollBarAnnotationMode="None" Style="{StaticResource DefaultMinimalTableViewTemplate}" >
                                    <dxmvvm:Interaction.Behaviors>
                                        <dxmvvm:EventToCommand Command="{Binding ValidateCellCommand}" EventName="ValidateCell" PassEventArgsToCommand="True" />
                                        <dxmvvm:EventToCommand Command="{Binding ValidateRowCommand}" EventName="ValidateRow" PassEventArgsToCommand="True" />
                                        <dxmvvm:EventToCommand Command="{Binding PastingFromClipboardCommand}" EventName="PastingFromClipboard" PassEventArgsToCommand="True" />
                                        <dxmvvm:EventToCommand Command="{Binding TimeSheetCellValueChangedCommand}" EventName="CellValueChanged" PassEventArgsToCommand="True" />
                                    </dxmvvm:Interaction.Behaviors>
                                    <dxg:TableView.RowCellMenuCustomizations>
                                        <dxb:BarButtonItemLink BarItemName="biCopyWithHeader1" />
                                        <dxb:BarButtonItemLink BarItemName="biBulkDelete1" />
                                        <dxb:BarButtonItemLink BarItemName="biKeyboardCopy1" />
                                        <dxb:BarButtonItemLink BarItemName="biKeyboardPaste1" />
                                        <dxb:BarItemLinkSeparator />
                                        <dxb:BarButtonItemLink BarItemName="biFullRefresh1" />
                                    </dxg:TableView.RowCellMenuCustomizations>
                                    <dxg:TableView.FormatConditions>
                                        <dxg:UniqueDuplicateRuleFormatCondition FieldName="UniqueCode" ApplyToRow="True">
                                            <dxc:Format Background="#FFFF9B98" />
                                        </dxg:UniqueDuplicateRuleFormatCondition>
                                    </dxg:TableView.FormatConditions>
                                </dxg:TableView>
                            </dxg:GridControl.View>
                        </dxg:GridControl>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutGroup>
            </DockPanel>
        </dxb:BarManager>
    </Grid>
</UserControl>
