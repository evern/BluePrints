<UserControl x:Name="userControl"
             x:Class="BluePrints.Views.COMMODITY_CODEMasterDetailCollectionView"
             xmlns="http://schemas.microsoft.com/netfx/2009/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxrudex="http://schemas.devexpress.com/winfx/2008/xaml/reports/userdesignerextensions"
             xmlns:common="clr-namespace:BluePrints.Common"
             xmlns:viewmodel="clr-namespace:BluePrints.ViewModels"
             mc:Ignorable="d" d:DesignHeight="400" d:DesignWidth="600"
             DataContext="{dxmvvm:ViewModelSource viewmodel:COMMODITY_CODEMasterDetailViewModelWrapper}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Views/BluePrintsResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <dxmvvm:Interaction.Behaviors>
        <dx:DXMessageBoxService />
        <dxmvvm:EventToCommand Event="Loaded" Command="{Binding OnLoadedCommand}" />
        <dx:WindowedDocumentUIService YieldToParent="True" />
        <dx:DialogService x:Name="BulkColumnEditService">
            <dx:DialogService.DialogStyle>
                <Style TargetType="dx:DXDialogWindow">
                    <Setter Property="SizeToContent" Value="WidthAndHeight" />
                    <Setter Property="MinWidth" Value="500" />
                    <Setter Property="MinHeight" Value="370" />
                </Style>
            </dx:DialogService.DialogStyle>
        </dx:DialogService>
    </dxmvvm:Interaction.Behaviors>
    <Grid dx:DXSerializer.StoreLayoutMode="UI">
        <dxmvvm:Interaction.Behaviors>
            <dxmvvm:LayoutSerializationService />
        </dxmvvm:Interaction.Behaviors>
        <Grid DataContext="{Binding MainViewModel}">
            <DockPanel>
                <dxr:RibbonControl RibbonStyle="Office2010" DockPanel.Dock="Top" AllowCustomization="False"
                                   MDIMergeStyle="Always">
                    <dxr:RibbonDefaultPageCategory Caption="defaultCategory">
                        <dxr:RibbonPage Caption="Home">
                            <dxr:RibbonPageGroup Caption="COMMODITY CODE ITEM Tasks">
                                <dxb:BarButtonItem Content="Delete"
                                                   Command="{Binding DataContext.BulkDeleteCommand, ElementName=userControl}"
                                                   LargeGlyph="{dx:DXImage Image=Delete_32x32.png}"
                                                   Glyph="{dx:DXImage Image=Delete_16x16.png}" />

                                <dxb:BarButtonItem Content="Refresh" Command="{Binding RefreshCommand}"
                                                   LargeGlyph="{dx:DXImage Image=Refresh_32x32.png}"
                                                   Glyph="{dx:DXImage Image=Refresh_16x16.png}" />
                                <dxb:BarButtonItem Content="Undo" Command="{Binding UndoCommand}"
                                                   LargeGlyph="{dx:DXImage Image=Undo_32x32.png}"
                                                   Glyph="{dx:DXImage Image=Undo_16x16.png}" />
                                <dxb:BarButtonItem Content="Redo" Command="{Binding RedoCommand}"
                                                   LargeGlyph="{dx:DXImage Image=Redo_32x32.png}"
                                                   Glyph="{dx:DXImage Image=Redo_16x16.png}" />
                                <dxb:BarButtonItem Content="Save Layout"
                                                   Command="{Binding DataContext.SaveLayoutCommand, ElementName=userControl}"
                                                   LargeGlyph="{dx:DXImage Image=Save_32x32.png}"
                                                   Glyph="{dx:DXImage Image=Save_16x16.png}" />
                                <dxb:BarButtonItem Content="Reset Layout"
                                                   Command="{Binding DataContext.ResetLayoutCommand, ElementName=userControl}"
                                                   LargeGlyph="{dx:DXImage Image=SaveAndClose_32x32.png}"
                                                   Glyph="{dx:DXImage Image=SaveAndClose_16x16.png}" />
                            </dxr:RibbonPageGroup>
                        </dxr:RibbonPage>
                    </dxr:RibbonDefaultPageCategory>
                </dxr:RibbonControl>
                <dxr:RibbonStatusBarControl DockPanel.Dock="Bottom">
                    <dxr:RibbonStatusBarControl.LeftItems>
                        <dxb:BarStaticItem
                            Content="{Binding Entities.Count, Converter={dxmvvm:FormatStringConverter FormatString='RECORDS: {0}'}}" />
                    </dxr:RibbonStatusBarControl.LeftItems>
                </dxr:RibbonStatusBarControl>
                <Grid>
                    <dxg:GridControl Name="gridControl"
                                     dx:DXSerializer.SerializationID="COMMODITY_CODEGrid"
                                     ItemsSource="{Binding DataContext.DisplayEntities, ElementName=userControl}"
                                     CurrentItem="{Binding DataContext.SelectedEntity, Mode=TwoWay, ElementName=userControl}"
                                     SelectedItems="{Binding DataContext.SelectedEntities, Mode=TwoWay, ElementName=userControl}"
                                     SelectionMode="Row">
                        <dxmvvm:Interaction.Behaviors>
                            <dxmvvm:EventToCommand
                                Command="{Binding DataContext.MasterRowExpandedCommand, ElementName=userControl}"
                                PassEventArgsToCommand="True" EventName="MasterRowExpanded" />
                            <dxmvvm:EventToCommand
                                Command="{Binding DataContext.MasterRowCollapsedCommand, ElementName=userControl}"
                                PassEventArgsToCommand="True" EventName="MasterRowCollapsed" />
                        </dxmvvm:Interaction.Behaviors>
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn FieldName="COMMODITY_CODE.GUID_PROJECT" Header="PROJECT" VisibleIndex="10">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings
                                        ItemsSource="{Binding DataContext.PROJECTCollection, ElementName=userControl}"
                                        IsTextEditable="False" DisplayMember="NUMBER" ValueMember="GUID" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="COMMODITY_CODE.FULLCODE" Header="FULLCODE" VisibleIndex="20" />
                            <dxg:GridColumn FieldName="ProjectionType" ReadOnly="True" VisibleIndex="25">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings IsTextEditable="True" AutoComplete="True"
                                                              ItemsSource="{dxe:EnumItemsSource EnumType={x:Type common:COMMODITY_CODEProjectionType}}" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="COMMODITY_CODE.COMMODITY_GROUP_DIRECT_ID" VisibleIndex="25" />
                            <dxg:GridColumn Name="colDEPARTMENT" Header="DEPARTMENT"
                                            FieldName="COMMODITY_CODE.GUID_DEPARTMENT" VisibleIndex="40">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings
                                        ItemsSource="{Binding DataContext.DEPARTMENTCollection, ElementName=userControl}"
                                        IsTextEditable="False" DisplayMember="NAME" ValueMember="GUID" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Name="colDISCIPLINE" Header="DISCIPLINE"
                                            FieldName="COMMODITY_CODE.GUID_DISCIPLINE" VisibleIndex="50">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings
                                        ItemsSource="{Binding DataContext.DISCIPLINECollection, ElementName=userControl}"
                                        IsTextEditable="False" DisplayMember="NAME" ValueMember="GUID" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Name="colINDIRECT_TYPE" Header="INDIRECT TYPE"
                                            FieldName="GUID_INDIRECTTYPE" VisibleIndex="60">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings
                                        ItemsSource="{Binding DataContext.INDIRECT_TYPECollection, ElementName=userControl}"
                                        IsTextEditable="False" DisplayMember="NAME" ValueMember="GUID" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="COMMODITY_CODE.TYPE" Header="TYPE" VisibleIndex="70" />
                            <dxg:GridColumn FieldName="COMMODITY_CODE.SPEC" Header="SPEC" VisibleIndex="80" />
                            <dxg:GridColumn FieldName="COMMODITY_CODE.DESCRIPTION" Header="DESCRIPTION"
                                            VisibleIndex="90" />
                            <dxg:GridColumn FieldName="COMMODITY_CODE.UOM" Header="UOM" VisibleIndex="100"
                                            AllowEditing="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings
                                        ItemsSource="{Binding DataContext.UOMCollection, ElementName=userControl}"
                                        AutoComplete="True" DisplayMember="UOM1" ValueMember="UOM1" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn x:Name="colRATE_SUPPLY" FieldName="COMMODITY_CODE.RATE_SUPPLY"
                                            Header="SUPPLY RATE" VisibleIndex="120">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <dxe:SpinEdit Name="PART_Editor" MaskType="Numeric" Mask="c" MinValue="0"
                                                      Increment="10" MaskUseAsDisplayFormat="True"
                                                      IsEnabled="{Binding RowData.Row.IsEditable, UpdateSourceTrigger=PropertyChanged }" />
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                            <dxg:GridColumn x:Name="colHOURS_INSTALL" FieldName="COMMODITY_CODE.HOURS_INSTALL"
                                            Header="INSTALL HOURS" VisibleIndex="130">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <dxe:SpinEdit Name="PART_Editor" MaskType="Numeric" Mask="n" MinValue="0"
                                                      Increment="1" MaskUseAsDisplayFormat="True"
                                                      IsEnabled="{Binding RowData.Row.IsEditable, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                            <dxg:GridColumn x:Name="colRATE_FREIGHT" FieldName="COMMODITY_CODE.RATE_FREIGHT"
                                            Header="FREIGHT RATE" VisibleIndex="140">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <dxe:SpinEdit Name="PART_Editor" MaskType="Numeric" Mask="c" MinValue="0"
                                                      Increment="10" MaskUseAsDisplayFormat="True"
                                                      IsEnabled="{Binding RowData.Row.IsEditable, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                            <dxg:GridColumn x:Name="colRATE_PLANT" FieldName="COMMODITY_CODE.RATE_PLANT"
                                            Header="PLANT RATE" VisibleIndex="150">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <dxe:SpinEdit Name="PART_Editor" MaskType="Numeric" Mask="c" MinValue="0"
                                                      Increment="10" MaskUseAsDisplayFormat="True"
                                                      IsEnabled="{Binding RowData.Row.IsEditable, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                        </dxg:GridControl.Columns>
                        <dxg:GridControl.DetailDescriptor>
                            <dxg:DataControlDetailDescriptor ItemsSourceBinding="{Binding CHILD_COMMODITY_CODES}">
                                <dxg:GridControl Name="gridControlChild"
                                                 CurrentItem="{Binding DataContext.SelectedEntity, Mode=TwoWay, ElementName=userControl}"
                                                 SelectedItems="{Binding DataContext.SelectedEntities, Mode=TwoWay, ElementName=userControl}">
                                    <dxg:GridControl.Columns>
                                        <dxg:GridColumn Header="FULLCODE" FieldName="COMMODITY_CODE.FULLCODE"
                                                        VisibleIndex="20" />
                                        <dxg:GridColumn Name="colChildDEPARTMENT" Header="DEPARTMENT"
                                                        FieldName="COMMODITY_CODE.GUID_DEPARTMENT" VisibleIndex="40">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:ComboBoxEditSettings
                                                    ItemsSource="{Binding DataContext.DEPARTMENTCollection, ElementName=userControl}"
                                                    IsTextEditable="False" DisplayMember="NAME" ValueMember="GUID" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn Name="colChildDISCIPLINE" Header="DISCIPLINE"
                                                        FieldName="COMMODITY_CODE.GUID_DISCIPLINE" VisibleIndex="50">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:ComboBoxEditSettings
                                                    ItemsSource="{Binding DataContext.DISCIPLINECollection, ElementName=userControl}"
                                                    IsTextEditable="False" DisplayMember="NAME" ValueMember="GUID" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn Name="colChildINDIRECT_TYPE" Header="INDIRECT TYPE"
                                                        FieldName="GUID_INDIRECTTYPE" VisibleIndex="60">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:ComboBoxEditSettings
                                                    ItemsSource="{Binding DataContext.INDIRECT_TYPECollection, ElementName=userControl}"
                                                    IsTextEditable="False" DisplayMember="NAME" ValueMember="GUID" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn FieldName="COMMODITY_CODE.TYPE" Header="TYPE" VisibleIndex="70" />
                                        <dxg:GridColumn FieldName="COMMODITY_CODE.SPEC" Header="SPEC" VisibleIndex="80" />
                                        <dxg:GridColumn FieldName="COMMODITY_CODE.DESCRIPTION" Header="DESCRIPTION"
                                                        VisibleIndex="90" />
                                        <dxg:GridColumn FieldName="COMMODITY_CODE.UOM" Header="UOM" VisibleIndex="100"
                                                        AllowEditing="True">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:ComboBoxEditSettings
                                                    ItemsSource="{Binding DataContext.UOMCollection, ElementName=userControl}"
                                                    AutoComplete="True" DisplayMember="UOM1" ValueMember="UOM1" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn x:Name="colChildRATE_SUPPLY"
                                                        FieldName="COMMODITY_CODE.RATE_SUPPLY" Header="SUPPLY RATE"
                                                        VisibleIndex="120">
                                            <dxg:GridColumn.CellTemplate>
                                                <DataTemplate>
                                                    <dxe:SpinEdit Name="PART_Editor" MaskType="Numeric" Mask="c"
                                                                  MinValue="0" Increment="10"
                                                                  MaskUseAsDisplayFormat="True"
                                                                  IsEnabled="{Binding RowData.Row.IsEditable, UpdateSourceTrigger=PropertyChanged }" />
                                                </DataTemplate>
                                            </dxg:GridColumn.CellTemplate>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn x:Name="colChildHOURS_INSTALL"
                                                        FieldName="COMMODITY_CODE.HOURS_INSTALL" Header="INSTALL HOURS"
                                                        VisibleIndex="130">
                                            <dxg:GridColumn.CellTemplate>
                                                <DataTemplate>
                                                    <dxe:SpinEdit Name="PART_Editor" MaskType="Numeric" Mask="n"
                                                                  MinValue="0" Increment="1"
                                                                  MaskUseAsDisplayFormat="True"
                                                                  IsEnabled="{Binding RowData.Row.IsEditable, UpdateSourceTrigger=PropertyChanged}" />
                                                </DataTemplate>
                                            </dxg:GridColumn.CellTemplate>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn x:Name="colChildRATE_FREIGHT"
                                                        FieldName="COMMODITY_CODE.RATE_FREIGHT" Header="FREIGHT RATE"
                                                        VisibleIndex="140">
                                            <dxg:GridColumn.CellTemplate>
                                                <DataTemplate>
                                                    <dxe:SpinEdit Name="PART_Editor" MaskType="Numeric" Mask="c"
                                                                  MinValue="0" Increment="10"
                                                                  MaskUseAsDisplayFormat="True"
                                                                  IsEnabled="{Binding RowData.Row.IsEditable, UpdateSourceTrigger=PropertyChanged}" />
                                                </DataTemplate>
                                            </dxg:GridColumn.CellTemplate>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn x:Name="colChildRATE_PLANT"
                                                        FieldName="COMMODITY_CODE.RATE_PLANT" Header="PLANT RATE"
                                                        VisibleIndex="150">
                                            <dxg:GridColumn.CellTemplate>
                                                <DataTemplate>
                                                    <dxe:SpinEdit Name="PART_Editor" MaskType="Numeric" Mask="c"
                                                                  MinValue="0" Increment="10"
                                                                  MaskUseAsDisplayFormat="True"
                                                                  IsEnabled="{Binding RowData.Row.IsEditable, UpdateSourceTrigger=PropertyChanged}" />
                                                </DataTemplate>
                                            </dxg:GridColumn.CellTemplate>
                                        </dxg:GridColumn>
                                    </dxg:GridControl.Columns>
                                    <dxg:GridControl.View>
                                        <dxg:TableView Name="tableView1"
                                                       Style="{StaticResource DisplayEntitiesChildTableViewTemplate}"
                                                       NewItemRowPosition="None" />
                                    </dxg:GridControl.View>
                                </dxg:GridControl>
                            </dxg:DataControlDetailDescriptor>
                        </dxg:GridControl.DetailDescriptor>
                        <dxg:GridControl.View>
                            <dxg:TableView Name="tableView" IsDetailButtonVisibleBinding="{Binding Row.HAS_CHILDREN}"
                                           Style="{StaticResource DefaultTableViewTemplate}" ShowTotalSummary="True"
                                           ShowFixedTotalSummary="True" GroupSummaryDisplayMode="AlignByColumns"
                                           NewItemRowPosition="None">
                                <dxmvvm:Interaction.Behaviors>
                                    <dxmvvm:EventToCommand
                                        Command="{Binding DataContext.CellValueChangingCommand, ElementName=userControl}"
                                        PassEventArgsToCommand="True" EventName="CellValueChanging" />
                                </dxmvvm:Interaction.Behaviors>
                                <dxg:TableView.RowCellMenuCustomizations>
                                    <dxb:BarButtonItem Content="Delete"
                                                       Command="{Binding DataContext.BulkDeleteCommand, ElementName=userControl}"
                                                       CommandParameter="{Binding View.DataContext.SelectedEntities}"
                                                       Glyph="{dx:DXImage Image=Delete_16x16.png}" />

                                    <dxb:BarButtonItem Content="Refresh"
                                                       Command="{Binding View.DataContext.RefreshCommand}"
                                                       Glyph="{dx:DXImage Image=Refresh_16x16.png}" />
                                </dxg:TableView.RowCellMenuCustomizations>
                            </dxg:TableView>
                        </dxg:GridControl.View>
                    </dxg:GridControl>
                </Grid>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>