<UserControl x:Class="BluePrints.Views.COMMODITY_CODECollectionView" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/presentation" xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:common="clr-namespace:BluePrints.Common" xmlns:custom="clr-namespace:BaseModel.Misc;assembly=BaseModel" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon" xmlns:dxrudex="http://schemas.devexpress.com/winfx/2008/xaml/reports/userdesignerextensions" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:view="clr-namespace:BluePrints.Views" xmlns:viewmodel="clr-namespace:BluePrints.ViewModels" x:Name="userControl" d:DesignHeight="400" d:DesignWidth="600" DataContext="{dxmvvm:ViewModelSource viewmodel:COMMODITY_CODECollectionViewModelWrapper}" mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/DefaultBluePrintsResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/BaseModel;component/View/ResourceDictionaries/DefaultControlResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/GridColumnResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Style="{StaticResource CollectionView.RootContainer}">
        <dxb:BarManager>
            <dxb:BarManager.Items>
                <dxb:BarSubItem ItemLinksSource="{StaticResource RibbonDefaultGridButtons}" />
            </dxb:BarManager.Items>
            <DockPanel>
                <dxr:RibbonControl Style="{StaticResource DefaultRibbonControlStyle}">
                    <dxr:RibbonDefaultPageCategory MergeType="Replace" Caption="defaultCategory">
                        <dxr:RibbonPage MergeType="Replace" Caption="Grid">
                            <dxr:RibbonPageGroup MergeType="Replace" Caption="Grid" >
                                <dxb:BarButtonItemLink BarItemName="biFullRefresh1" />
                                <dxb:BarButtonItemLink BarItemName="biBulkDelete1" />
                                <dxb:BarButtonItemLink BarItemName="biUndo1" />
                                <dxb:BarButtonItemLink BarItemName="biRedo1" />
                                <dxb:BarButtonItemLink BarItemName="biKeyboardCopy1"/>
                                <dxb:BarButtonItemLink BarItemName="biKeyboardPaste1" />
                                <dxb:BarCheckItemLink BarItemName="biCellSelection1" />
                                <dxb:BarButtonItemLink BarItemName="biSaveLayout1" />
                                <dxb:BarButtonItemLink BarItemName="biResetLayout1" />
                                <dxb:BarButtonItemLink BarItemName="biExpandAllGroups1" />
                                <dxb:BarButtonItemLink BarItemName="biCollapseAllGroups1" />
                                <dxb:BarButtonItemLink BarItemName="biExportToExcel1" />
                                <dxb:BarButtonItemLink BarItemName="biExportToPDF1" />
                            </dxr:RibbonPageGroup>
                        </dxr:RibbonPage>
                    </dxr:RibbonDefaultPageCategory>
                </dxr:RibbonControl>
                <Grid>
                    <dxmvvm:Interaction.Behaviors>
                        <dxmvvm:LayoutSerializationService />
                    </dxmvvm:Interaction.Behaviors>
                    <dxg:GridControl x:Name="GridControl" dx:DXSerializer.SerializationID="GridControlCOMMODITY_CODE" MouseUp="GridControl_MouseUp" dx:DXSerializer.StoreLayoutMode="All" Style="{StaticResource DefaultGridControlTemplate}">
                        <dxmvvm:Interaction.Behaviors>
                            <dxmvvm:EventToCommand Command="{Binding CustomUnboundColumnDataCommand}" EventName="CustomUnboundColumnData" PassEventArgsToCommand="True" />
                        </dxmvvm:Interaction.Behaviors>
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn FieldName="Entity.PHASE_TYPE" AllowBestFit="false" Width="100" Header="Phase" HeaderToolTip="Phase">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings AutoComplete="True" IsTextEditable="True" ItemsSource="{dxe:EnumItemsSource EnumType={x:Type common:PhaseType}}" NullValueButtonPlacement="Popup" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Entity.CODE" Header="Code" AllowBestFit="false" Width="50" HeaderToolTip="An identifier for the commodity code. Must be unique" />
                            <dxg:GridColumn FieldName="Entity.NAME" Header="Name" AllowBestFit="false" Width="300" HeaderToolTip="Name" />
                            <dxg:GridColumn FieldName="Entity.GUID_DISCIPLINE" AllowBestFit="false" Width="50" Header="Discipline">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="CODE" IsTextEditable="True" ItemsSource="{Binding DISCIPLINECollection}" ValueMember="GUID" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Entity.DESCRIPTION" AllowBestFit="false" Width="450" Header="Description" />
                            <dxg:GridColumn FieldName="Entity.UOM" Header="UOM" AllowBestFit="false" Width="50" HeaderToolTip="Unit of measure" />
                            <dxg:GridColumn FieldName="Entity.DEFAULT_COSTGROUP" AllowBestFit="false" Width="50" Header="Discipline Code (Auto)" >
                                <dxg:GridColumn.EditSettings>
                                    <!--Leave comments in header so that when user copy it doesn't copy the nulltext-->
                                    <!--<dxe:TextEditSettings NullText="Leave empty to autogenerate" />-->
                                    <dxe:TextEditSettings />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Entity.DEFAULT_STOCKCODE" AllowBestFit="false" Width="75" Header="Stock Code (Auto)" >
                                <dxg:GridColumn.EditSettings>
                                    <!--Leave comments in header so that when user copy it doesn't copy the nulltext-->
                                    <!--<dxe:TextEditSettings NullText="Leave empty to autogenerate" />-->
                                    <dxe:TextEditSettings />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Entity.IS_STANDARD" Header="Is Standard" AllowBestFit="false" Width="60" HeaderToolTip="Standard codes will be added to new project on creation">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:CheckEditSettings />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="ErrorMessage" Header="Error Message (Read Only)" AllowBestFit="false" Width="*" UnboundType="String" ReadOnly="True" />
                        </dxg:GridControl.Columns>
                        <dxg:GridControl.TotalSummary>
                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" Alignment="Right" SummaryType="Count" />
                        </dxg:GridControl.TotalSummary>
                        <dxg:GridControl.GroupSummary>
                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" SummaryType="Count" />
                        </dxg:GridControl.GroupSummary>
                        <dxg:GridControl.View>
                            <dxg:TableView x:Name="tableView" Style="{StaticResource DefaultTableViewTemplate}">
                                <dxg:TableView.RowCellMenuCustomizations>
                                    <dxb:BarLinkContainerItem ItemLinksSource="{StaticResource ContextMenuDefaultHeaderButtons}" />
                                    <dxb:BarItemLinkSeparator />
                                    <dxb:BarButtonItemLink BarItemName="biBulkDelete1" />
                                    <dxb:BarButtonItemLink BarItemName="biFullRefresh1" />
                                </dxg:TableView.RowCellMenuCustomizations>
                                <dxg:TableView.FormatConditions>
                                    <dxg:FormatCondition Expression="Not IsNullOrEmpty([ErrorMessage])" ApplyToRow="True" FieldName="Entity.PHASE_TYPE">
                                        <dxc:Format Background="#FFFF9B98" />
                                    </dxg:FormatCondition>
                                </dxg:TableView.FormatConditions>
                            </dxg:TableView>
                        </dxg:GridControl.View>
                    </dxg:GridControl>
                </Grid>
            </DockPanel>
        </dxb:BarManager>
    </Grid>
</UserControl>
