<UserControl x:Class="BluePrints.Views.VARIATION_CONSTRUCTIONCollectionView" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/presentation" xmlns:ExtraLayout="clr-namespace:BaseModel.View.ExtraLayout;assembly=BaseModel" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:common="clr-namespace:BluePrints.Common" xmlns:custom="clr-namespace:BaseModel.Misc;assembly=BaseModel" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon" xmlns:dxrudex="http://schemas.devexpress.com/winfx/2008/xaml/reports/userdesignerextensions" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:view="clr-namespace:BluePrints.Views" xmlns:viewmodel="clr-namespace:BluePrints.ViewModels" x:Name="userControl" d:DesignHeight="400" d:DesignWidth="600" DataContext="{dxmvvm:ViewModelSource viewmodel:VARIATION_CONSTRUCTIONCollectionViewModelWrapper}" mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BaseModel;component/View/ResourceDictionaries/DefaultControlResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/GridColumnResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/DefaultBluePrintsResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Style="{StaticResource CollectionView.RootContainer}">
        <dxmvvm:Interaction.Behaviors>
            <dx:DialogService x:Name="ConfirmationDialogService">
                <dx:DialogService.DialogStyle>
                    <Style TargetType="dx:DXDialogWindow">
                        <Setter Property="SizeToContent" Value="WidthAndHeight" />
                        <Setter Property="MinWidth" Value="600" />
                        <Setter Property="MinHeight" Value="600" />
                    </Style>
                </dx:DialogService.DialogStyle>
            </dx:DialogService>
        </dxmvvm:Interaction.Behaviors>
        <dxb:BarManager>
            <dxb:BarManager.Items>
                <dxb:BarSubItem ItemLinksSource="{StaticResource RibbonDefaultGridButtons}" />
                <!--<dxb:BarCheckItem Content="Auto Refresh" IsChecked="{Binding DoNotAutoRefresh, Converter={dxmvvm:BooleanNegationConverter}}" Glyph="{dx:DXImageOffice2013 Image=Refresh_16x16.png}" />-->
                <dxb:BarButtonItem x:Name="biEdit" Content="Edit" Command="{Binding EditCommand}" LargeGlyph="{dx:DXImage Image=Edit_32x32.png}" Glyph="{dx:DXImage Image=Edit_16x16.png}" />
                <dxb:BarButtonItem x:Name="biEditReport1" Command="{Binding EditReportCommand}" Content="Edit Report" Glyph="{dx:DXImage Image=Edit_16x16.png}" LargeGlyph="{dx:DXImage Image=Edit_32x32.png}" RibbonStyle="SmallWithText" ToolTip="Redesign the variation report layout" />
                <dxb:BarButtonItem x:Name="biViewReport1" Command="{Binding ViewReportCommand}" Content="View Report" Glyph="{dx:DXImage Image=Report_16x16.png}" LargeGlyph="{dx:DXImage Image=Report_32x32.png}" RibbonStyle="SmallWithText" ToolTip="View selected variation in report format" />
                <dxb:BarButtonItem x:Name="biExportSelected" Command="{Binding ExportSelectedCommand}" Content="Export Selected" Glyph="{dx:DXImage Image=PrintViaPDF_16x16.png}" LargeGlyph="{dx:DXImage Image=PrintViaPDF_32x32.png}" RibbonStyle="SmallWithText" ToolTip="Export selected variation" />
            </dxb:BarManager.Items>
            <DockPanel>
                <dxr:RibbonControl Style="{StaticResource DefaultRibbonControlStyle}">
                    <dxr:RibbonDefaultPageCategory MergeType="Replace" Caption="defaultCategory">
                        <dxr:RibbonPage MergeType="Replace" Caption="Grid">
                            <dxr:RibbonPageGroup MergeType="Replace" Caption="Grid" >
                                <dxb:BarButtonItemLink BarItemName="biFullRefresh1" />
                                <dxb:BarButtonItemLink BarItemName="biBulkDelete1" />
                                <dxb:BarButtonItemLink BarItemName="biUndo1" />
                                <dxb:BarButtonItemLink BarItemName="biRedo1" />
                                <dxb:BarButtonItemLink BarItemName="biKeyboardCopy1"/>
                                <dxb:BarButtonItemLink BarItemName="biKeyboardPaste1" />
                                <dxb:BarCheckItemLink BarItemName="biCellSelection1" />
                                <dxb:BarButtonItemLink BarItemName="biSaveLayout1" />
                                <dxb:BarButtonItemLink BarItemName="biResetLayout1" />
                                <dxb:BarButtonItemLink BarItemName="biExpandAllGroups1" />
                                <dxb:BarButtonItemLink BarItemName="biCollapseAllGroups1" />
                            </dxr:RibbonPageGroup>
                            <dxr:RibbonPageGroup MergeType="Replace" Caption="Tools">
                                <dxb:BarButtonItemLink BarItemName="biEdit" />
                            </dxr:RibbonPageGroup>
                            <dxr:RibbonPageGroup MergeType="Replace" Caption="Reporting">
                                <dxb:BarButtonItemLink BarItemName="biEditReport1" />
                                <dxb:BarButtonItemLink BarItemName="biViewReport1" />
                                <dxb:BarButtonItemLink BarItemName="biExportSelected" />
                            </dxr:RibbonPageGroup>
                        </dxr:RibbonPage>
                    </dxr:RibbonDefaultPageCategory>
                </dxr:RibbonControl>
                <custom:GridControlEx x:Name="GridControl" dx:DXSerializer.SerializationID="GridControlVARIATION_CONSTRUCTION" Style="{StaticResource DefaultGridControlTemplate}">
                    <dxmvvm:Interaction.Behaviors>
                        <dxmvvm:EventToCommand Command="{Binding EditCommand}" EventName="MouseDoubleClick" MarkRoutedEventsAsHandled="True" PassEventArgsToCommand="True">
                            <dxmvvm:EventToCommand.EventArgsConverter>
                                <dx:EventArgsToDataRowConverter />
                            </dxmvvm:EventToCommand.EventArgsConverter>
                        </dxmvvm:EventToCommand>
                    </dxmvvm:Interaction.Behaviors>
                    <custom:GridControlEx.Columns>
                        <dxg:GridColumn FieldName="SUBMISSION_DATE" Header="Date" AllowBestFit="False" Width="75">
                            <dxg:GridColumn.EditSettings>
                                <dxe:DateEditSettings NullValueButtonPlacement="Popup" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="CLIENT_NUMBER" AllowBestFit="False" Width="100" Header="Client Variation Number" />
                        <dxg:GridColumn FieldName="NUMBER" AllowBestFit="False" Width="100" Header="PRIMERO Variation Number" />
                        <dxg:GridColumn FieldName="DESCRIPTION" AllowBestFit="False" Width="*" Header="Description" />
                        <dxg:GridColumn FieldName="TYPE" Header="Type" AllowBestFit="False" Width="50" >
                            <dxg:GridColumn.EditSettings>
                                <dxe:ComboBoxEditSettings AutoComplete="True" IsTextEditable="True" ItemsSource="{dxe:EnumItemsSource EnumType={x:Type common:VariationConstructionType}}" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <!--<dxg:GridColumn Header="Impacts" AllowBestFit="false" Width="150" SortMode="DisplayText" FieldName="MultipleAssignedImpactObject">
                            <dxg:GridColumn.EditSettings>
                                <dxe:ComboBoxEditSettings
                                                ItemsSource="{Binding AllVARIATION_CONSTRUCTION_IMPACTCollection}" 
                                                ValidateOnTextInput="True"
                                                ValidateOnEnterKeyPressed="True"
                                                IncrementalFiltering="True"
                                                AllowDefaultButton="True"
                                                DisplayMember="ImpactDescription"
                                                ImmediatePopup="True">
                                    <dxe:ComboBoxEditSettings.StyleSettings>
                                        <dxe:CheckedTokenComboBoxStyleSettings NewTokenPosition="Far" EnableTokenWrapping="True" ShowTokenButtons="True" AllowEditTokens="False" />
                                    </dxe:ComboBoxEditSettings.StyleSettings>
                                </dxe:ComboBoxEditSettings>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>-->
                        <dxg:GridColumn FieldName="STATUS" Header="Status" AllowBestFit="False" Width="75">
                            <dxg:GridColumn.EditSettings>
                                <dxe:ComboBoxEditSettings AutoComplete="True" IsTextEditable="True" ItemsSource="{dxe:EnumItemsSource EnumType={x:Type common:VariationConstructionStatus}}" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="APPROVED_VALUE" Header="Revenue Amount">
                            <dxg:GridColumn.EditSettings>
                                <dxe:SpinEditSettings Increment="10" Mask="c2" MaskType="Numeric" MaskUseAsDisplayFormat="True" MinValue="0" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="ManagementTotal" Header="Management Total" AllowBestFit="false" Width="90" ReadOnly="True">
                            <dxg:GridColumn.EditSettings>
                                <dxe:SpinEditSettings Increment="10" Mask="c2" MaskType="Numeric" MaskUseAsDisplayFormat="True" MinValue="0" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="EngineeringTotal" Header="Engineering Total" AllowBestFit="false" Width="90" ReadOnly="True">
                            <dxg:GridColumn.EditSettings>
                                <dxe:SpinEditSettings Increment="10" Mask="c2" MaskType="Numeric" MaskUseAsDisplayFormat="True" MinValue="0" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="TradesAndLabourTotal" Header="Trades and Labour Total" AllowBestFit="false" Width="90" ReadOnly="True">
                            <dxg:GridColumn.EditSettings>
                                <dxe:SpinEditSettings Increment="10" Mask="c2" MaskType="Numeric" MaskUseAsDisplayFormat="True" MinValue="0" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="EquipmentTotal" Header="Equipment Total" AllowBestFit="false" Width="90" ReadOnly="True">
                            <dxg:GridColumn.EditSettings>
                                <dxe:SpinEditSettings Increment="10" Mask="c2" MaskType="Numeric" MaskUseAsDisplayFormat="True" MinValue="0" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="MaterialTotal" Header="Material Total" AllowBestFit="false" Width="90" ReadOnly="True">
                            <dxg:GridColumn.EditSettings>
                                <dxe:SpinEditSettings Increment="10" Mask="c2" MaskType="Numeric" MaskUseAsDisplayFormat="True" MinValue="0" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="TotalEstimatedValue" Header="Total Estimated Value" AllowBestFit="false" Width="90" ReadOnly="True">
                            <dxg:GridColumn.EditSettings>
                                <dxe:SpinEditSettings Increment="10" Mask="c2" MaskType="Numeric" MaskUseAsDisplayFormat="True" MinValue="0" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                    </custom:GridControlEx.Columns>
                <dxg:GridControl.TotalSummary>
                    <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" Alignment="Right" SummaryType="Count" />
                </dxg:GridControl.TotalSummary>
                <dxg:GridControl.GroupSummary>
                    <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" SummaryType="Count" />
                </dxg:GridControl.GroupSummary>
                <dxg:GridControl.View>
                    <dxg:TableView x:Name="tableView" Style="{StaticResource DefaultTableViewTemplate}">
                            <dxg:TableView.RowCellMenuCustomizations>
                                <dxb:BarLinkContainerItem ItemLinksSource="{StaticResource ContextMenuDefaultHeaderButtons}" />
                                <dxb:BarItemLinkSeparator />
                                <dxb:BarButtonItemLink BarItemName="biEdit" />
                                <dxb:BarItemLinkSeparator />
                                <dxb:BarButtonItemLink BarItemName="biBulkDelete1" />
                                <dxb:BarButtonItemLink BarItemName="biFullRefresh1" />
                            </dxg:TableView.RowCellMenuCustomizations>
                    </dxg:TableView>
                </dxg:GridControl.View>
                </custom:GridControlEx>
            </DockPanel>
        </dxb:BarManager>
    </Grid>
</UserControl>
