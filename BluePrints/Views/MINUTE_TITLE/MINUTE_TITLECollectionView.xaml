<UserControl
        x:Name="userControl"
        x:Class="BluePrints.Views.MINUTE_TITLECollectionView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:custom="clr-namespace:BaseModel.Misc;assembly=BaseModel"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
        xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon"
        xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
        xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
        xmlns:dxrudex="http://schemas.devexpress.com/winfx/2008/xaml/reports/userdesignerextensions"
        xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
        xmlns:viewmodel="clr-namespace:BluePrints.ViewModels"
        xmlns:customControl="clr-namespace:BaseModel.Misc;assembly=BaseModel"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignHeight="400" d:DesignWidth="600" DataContext="{dxmvvm:ViewModelSource viewmodel:MINUTE_TITLECollectionViewModelWrapper}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BaseModel;component/View/ResourceDictionaries/DefaultControlResourceDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Style="{StaticResource CollectionView.RootContainer}">
        <Grid DataContext="{Binding MainViewModel}">
            <DockPanel>
                <dxr:RibbonControl RibbonStyle="Office2010" DockPanel.Dock="Top" AllowCustomization="False"
                                    MDIMergeStyle="Always">
                    <dxr:RibbonDefaultPageCategory Caption="defaultCategory">
                        <dxr:RibbonPage Caption="Home">
                            <dxr:RibbonPageGroup Caption="WBS Tasks">
                                <dxb:BarButtonItem Content="Insert Before"
                                                   Command="{Binding DataContext.AddRowBeforeCommand, ElementName=userControl}"
                                                   LargeGlyph="{dx:DXImageOffice2013 Image=Insert_32x32.png}"
                                                   Glyph="{dx:DXImageOffice2013 Image=Insert_16x16.png}" />
                                <dxb:BarButtonItem Content="Insert After"
                                                   Command="{Binding DataContext.AddRowAfterCommand, ElementName=userControl}"
                                                   LargeGlyph="{dx:DXImageOffice2013 Image=Insert_32x32.png}"
                                                   Glyph="{dx:DXImageOffice2013 Image=Insert_16x16.png}" />
                                <dxb:BarButtonItem Content="Delete Row" Command="{Binding BulkDeleteCommand}"
                                                    LargeGlyph="{dx:DXImage Image=Delete_32x32.png}"
                                                    Glyph="{dx:DXImage Image=Delete_16x16.png}" />
                                <dxb:BarButtonItem Content="Refresh" Command="{Binding DataContext.FullRefreshCommand, ElementName=userControl}"
                                                    LargeGlyph="{dx:DXImage Image=Refresh_32x32.png}"
                                                    Glyph="{dx:DXImage Image=Refresh_16x16.png}" />
                                <dxb:BarButtonItem Content="Undo" Command="{Binding UndoCommand}"
                                                    LargeGlyph="{dx:DXImage Image=Undo_32x32.png}"
                                                    Glyph="{dx:DXImage Image=Undo_16x16.png}" />
                                <dxb:BarButtonItem Content="Redo" Command="{Binding RedoCommand}"
                                                    LargeGlyph="{dx:DXImage Image=Redo_32x32.png}"
                                                    Glyph="{dx:DXImage Image=Redo_16x16.png}" />
                                <dxb:BarButtonItem Content="Save Layout"
                                                    Command="{Binding DataContext.SaveLayoutCommand, ElementName=userControl}"
                                                    LargeGlyph="{dx:DXImage Image=Save_32x32.png}"
                                                    Glyph="{dx:DXImage Image=Save_16x16.png}" />
                                <dxb:BarButtonItem Content="Reset Layout"
                                                    Command="{Binding DataContext.ResetLayoutCommand, ElementName=userControl}"
                                                    LargeGlyph="{dx:DXImage Image=SaveAndClose_32x32.png}"
                                                    Glyph="{dx:DXImage Image=SaveAndClose_16x16.png}" />
                                <dxb:BarCheckItem Content="Cell Selection" IsChecked="{Binding IsPasteCellLevel, Mode=TwoWay}" Glyph="{dx:DXImage Image=SplitTableCells_16x16.png}" LargeGlyph="{dx:DXImage Image=SplitTableCells_32x32.png}" />
                            </dxr:RibbonPageGroup>
                        </dxr:RibbonPage>
                    </dxr:RibbonDefaultPageCategory>
                </dxr:RibbonControl>
                <dxr:RibbonStatusBarControl DockPanel.Dock="Bottom">
                    <dxr:RibbonStatusBarControl.LeftItems>
                        <dxb:BarStaticItem
                            Content="{Binding Entities.Count, Converter={dxmvvm:FormatStringConverter FormatString='RECORDS: {0}'}}" />
                    </dxr:RibbonStatusBarControl.LeftItems>
                </dxr:RibbonStatusBarControl>
                <dxlc:LayoutGroup Name="LayoutGroupMain" View="Group" Orientation="Horizontal">
                    <dxlc:LayoutGroup>
                        <dxg:TreeListControl Name="treeListControl" dx:DXSerializer.SerializationID="ROLETree" MaxHeight="2000" MouseUp="treeListControl_MouseUp" SelectionMode="Cell"
                                         Style="{StaticResource DefaultTreeListControlTemplate}">
                            <dxmvvm:Interaction.Behaviors>
                                <dxg:TreeListDragDropManager x:Name="dragDropManager" >
                                    <dxmvvm:Interaction.Behaviors>
                                        <dxmvvm:EventToCommand EventName="Drop" Command="{Binding DataContext.DragDropManager_DropCommand, ElementName=userControl}" PassEventArgsToCommand="True"/>
                                        <dxmvvm:EventToCommand EventName="Dropped" Command="{Binding DataContext.DragDropManager_DroppedCommand, ElementName=userControl}" PassEventArgsToCommand="True"/>
                                    </dxmvvm:Interaction.Behaviors>
                                </dxg:TreeListDragDropManager>
                            </dxmvvm:Interaction.Behaviors>
                            <dxg:TreeListControl.Columns>
                                <dxg:TreeListColumn FieldName="NUMBER" Header="NUMBER" VisibleIndex="10" />
                                <dxg:TreeListColumn FieldName="NAME" Header="NAME" VisibleIndex="20" />
                                <dxg:TreeListColumn FieldName="SORTORDER" Header="SORTORDER" VisibleIndex="30" />
                            </dxg:TreeListControl.Columns>
                            <dxg:TreeListControl.View>
                                <dxg:TreeListView x:Name="treeListView" AllowSorting="True" 
                                              ParentFieldName="ParentEntityKey" ExpandStateFieldName="IsExpanded" KeyFieldName="EntityKey" >
                                    <dxmvvm:Interaction.Behaviors>
                                        <dxmvvm:EventToCommand PassEventArgsToCommand="True"
                                                           Command="{Binding TreelistExistingRowAddUndoAndSaveCommand}"
                                                           EventName="CellValueChanged" />
                                        <dxmvvm:EventToCommand PassEventArgsToCommand="True"
                                                           Command="{Binding ValidateCellCommand}"
                                                           EventName="ValidateCell" />
                                        <dxmvvm:EventToCommand PassEventArgsToCommand="True"
                                                           Command="{Binding ValidateRowCommand}"
                                                           EventName="ValidateRow" />
                                        <dxmvvm:KeyToCommand KeyGesture="CTRL+Z" Command="{Binding UndoCommand}" />
                                        <dxmvvm:KeyToCommand KeyGesture="CTRL+Y" Command="{Binding RedoCommand}" />
                                    </dxmvvm:Interaction.Behaviors>
                                    <dxg:TreeListView.RowCellMenuCustomizations>
                                        <dxb:BarButtonItem Content="Insert Before"
                                                       Glyph="{dx:DXImageOffice2013 Image=Insert_32x32.png}"
                                                       Command="{Binding DataContext.AddRowBeforeCommand, ElementName=userControl}" />
                                        <dxb:BarButtonItem Content="Insert After"
                                                       Glyph="{dx:DXImageOffice2013 Image=Insert_32x32.png}"
                                                       Command="{Binding DataContext.AddRowAfterCommand, ElementName=userControl}" />
                                        <dxb:BarButtonItem Content="Delete Row"
                                                       Command="{Binding View.DataContext.BulkDeleteCommand}"
                                                       Glyph="{dx:DXImage Image=Delete_16x16.png}" />
                                    </dxg:TreeListView.RowCellMenuCustomizations>
                                </dxg:TreeListView>
                            </dxg:TreeListControl.View>
                        </dxg:TreeListControl>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutGroup>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>