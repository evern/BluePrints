<UserControl x:Class="BluePrints.Views.PROJECTView" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:common="clr-namespace:BluePrints.Common" xmlns:converter="clr-namespace:BluePrints.Common.ViewModel.Converters" xmlns:custom="clr-namespace:BaseModel.Misc;assembly=BaseModel" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/charts" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dxi="http://schemas.devexpress.com/winfx/2008/xaml/core/internal" xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:services="clr-namespace:BaseModel.ViewModel.Services;assembly=BaseModel" xmlns:viewmodel="clr-namespace:BluePrints.ViewModels" x:Name="userControl" d:DesignHeight="1920" d:DesignWidth="1080" DataContext="{dxmvvm:ViewModelSource viewmodel:PROJECTViewModelWrapper}" mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <converter:StringToImageConverter x:Key="StringToImageConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BaseModel;component/View/ResourceDictionaries/DefaultControlResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/BaseModel;component/View/ResourceDictionaries/NestedControlResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/ConverterResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/ChartResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/GridColumnResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/CustomControlResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/DefaultBluePrintsResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:OpenFileDialogService Title="Select Document" Multiselect="False" />
    </dxmvvm:Interaction.Behaviors>
    <Grid Style="{StaticResource CollectionView.RootContainer}">
        <Grid Style="{StaticResource DashboardView.RootContainer}">
            <dxmvvm:Interaction.Behaviors>
                <dx:DialogService x:Name="ProjectIssueDialog">
                    <dx:DialogService.DialogStyle>
                        <Style TargetType="dx:DXDialogWindow">
                            <Setter Property="SizeToContent" Value="WidthAndHeight" />
                            <Setter Property="MinWidth" Value="800" />
                            <Setter Property="MinHeight" Value="600" />
                        </Style>
                    </dx:DialogService.DialogStyle>
                </dx:DialogService>
                <dx:DialogService x:Name="ActivityIdDialog">
                    <dx:DialogService.DialogStyle>
                        <Style TargetType="dx:DXDialogWindow">
                            <Setter Property="SizeToContent" Value="WidthAndHeight" />
                            <Setter Property="MinWidth" Value="600" />
                            <Setter Property="MinHeight" Value="600" />
                        </Style>
                    </dx:DialogService.DialogStyle>
                </dx:DialogService>
                <services:ChartControlService x:Name="DefaultChartControlService" ChartControl="{Binding ElementName=ChartControl}" />
            </dxmvvm:Interaction.Behaviors>
            <dxb:BarManager>
                <dxb:BarManager.Items>
                    <dxb:BarSubItem ItemLinksSource="{StaticResource RibbonDefaultGridButtons}" />
                    <dxb:BarButtonItem x:Name="biRefreshFromP6" Command="{Binding Refresh_From_P6Command}" IsEnabled="{Binding IsLoading, Converter={dxmvvm:BooleanNegationConverter}}" Content="Refresh" Glyph="{dx:DXImage Image=Reset2_16x16.png}" LargeGlyph="{dx:DXImage Image=Reset2_32x32.png}" ToolTip="Recalculate stats from P6. Must be performed after pressing F9 in P6" />
                    <dxb:BarEditItem x:Name="beDesignDataDate" IsReadOnly="True" Content="Data Date" IsEnabled="{Binding IsLoading, Converter={dxmvvm:BooleanNegationConverter}}" EditValue="{Binding DesignDataDate, Mode=OneWay}" >
                        <dxb:BarEditItem.EditSettings>
                            <dxe:TextEditSettings />
                        </dxb:BarEditItem.EditSettings>
                    </dxb:BarEditItem>
                    <dxb:BarButtonItem x:Name="biExportPlanned" Content="Export Planned" ToolTip="Export planned datapoints to excel" Command="{Binding ExportPlannedCommand}" LargeGlyph="{dx:DXImage Image=ExportToXLSX_32x32.png}" Glyph="{dx:DXImage Image=ExportToXLSX_16x16.png}" />
                    <dxb:BarButtonItem x:Name="biExportCurrent" Content="Export Current" ToolTip="Export current (planned including variation) datapoints to excel" Command="{Binding ExportCurrentCommand}" LargeGlyph="{dx:DXImage Image=ExportToXLSX_32x32.png}" Glyph="{dx:DXImage Image=ExportToXLSX_16x16.png}" />
                    <dxb:BarButtonItem x:Name="biExportEarned" Content="Export Earned" ToolTip="Export earned datapoints to excel" Command="{Binding ExportEarnedCommand}" LargeGlyph="{dx:DXImage Image=ExportToXLSX_32x32.png}" Glyph="{dx:DXImage Image=ExportToXLSX_16x16.png}" />
                    <dxb:BarButtonItem x:Name="biExportRemaining" Content="Export Remaining" ToolTip="Export remaining datapoints to excel" Command="{Binding ExportRemainingCommand}" LargeGlyph="{dx:DXImage Image=ExportToXLSX_32x32.png}" Glyph="{dx:DXImage Image=ExportToXLSX_16x16.png}" />
                    <dxb:BarButtonItem x:Name="biHealthCheck" Command="{Binding ProjectHealthCheckCommand}" CommandParameter="{Binding Mode=OneWay, RelativeSource={RelativeSource Self}}" Content="Health Check" ToolTip="Check S-Curve accuracy">
                        <dxb:BarButtonItem.GlyphTemplate>
                            <DataTemplate>
                                <Image Source="{Binding HealthCheckIconName, Converter={StaticResource StringToImageConverter}}">
                                    <Image.RenderTransform>
                                        <TranslateTransform x:Name="transTransform1" X="0" Y="0" />
                                    </Image.RenderTransform>
                                </Image>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Animate}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard Name="bounce">
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation AutoReverse="True" BeginTime="0:0:3" RepeatBehavior="3x" SpeedRatio="15" Storyboard.TargetName="transTransform1" Storyboard.TargetProperty="Y" From="0" To="-3" Duration="0:0:1" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="bounce" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </dxb:BarButtonItem.GlyphTemplate>
                    </dxb:BarButtonItem>
                    <dxb:BarButtonItem x:Name="biEditReport1" Command="{Binding EditReportCommand}" Content="Edit Report" Glyph="{dx:DXImage Image=Edit_16x16.png}" LargeGlyph="{dx:DXImage Image=Edit_32x32.png}" RibbonStyle="SmallWithText" ToolTip="Redesign the current report layout" />
                    <dxb:BarButtonItem x:Name="biViewReport1" Command="{Binding ViewReportCommand}" Content="View Report" Glyph="{dx:DXImage Image=Report_16x16.png}" LargeGlyph="{dx:DXImage Image=Report_32x32.png}" RibbonStyle="SmallWithText" ToolTip="View report. Report will be sorted and filtered according to what is shown in this table" />
                    <dxb:BarButtonItem x:Name="biCheckUnits" Command="{Binding ChangeStatsTypeCommand}" CommandParameter="{Binding Mode=OneWay, RelativeSource={RelativeSource Self}}" Content="Units" Glyph="{dx:DXImageOffice2013 Image=Time_16x16.png}" LargeGlyph="{dx:DXImageOffice2013 Image=Time_32x32.png}" ToolTip="S-Curve shows by units" />
                    <dxb:BarButtonItem x:Name="biCheckCosts" Command="{Binding ChangeStatsTypeCommand}" CommandParameter="{Binding Mode=OneWay, RelativeSource={RelativeSource Self}}" Content="Costs" Glyph="{dx:DXImageOffice2013 Image=Currency_32x32.png}" LargeGlyph="{dx:DXImageOffice2013 Image=Currency_32x32.png}" ToolTip="S-Curve shows by costs" />
                    <dxb:BarButtonItem x:Name="biCheckQty" Command="{Binding ChangeStatsTypeCommand}" CommandParameter="{Binding Mode=OneWay, RelativeSource={RelativeSource Self}}" Content="Qty" Glyph="{dx:DXImage Image=Number_16x16.png}" LargeGlyph="{dx:DXImage Image=Number_32x32.png}" ToolTip="S-Curve shows by quantity" />
                    <dxb:BarCheckItem x:Name="biCheckPercent" Command="{Binding ChangeStatsPercentageTypeCommand}" CommandParameter="{Binding Mode=OneWay, RelativeSource={RelativeSource Self}}" IsEnabled="{Binding IsLoading, Converter={dxmvvm:BooleanNegationConverter}}" Content="Percentage" Glyph="{dx:DXImage Image=Percentage_16x16.png}" IsChecked="True" LargeGlyph="{dx:DXImageOffice2013 Image=Percentage_32x32.png}" ToolTip="S-Curve shows cumulative as percentage" />
                    <dxb:BarCheckItem x:Name="biCheckCumulativeUC" Command="{Binding ChangeStatsPercentageTypeCommand}" CommandParameter="{Binding Mode=OneWay, RelativeSource={RelativeSource Self}}" IsEnabled="{Binding IsLoading, Converter={dxmvvm:BooleanNegationConverter}}" Content="Absolute" Glyph="{dx:DXImage Image=FormatNumberDecimal_16x16.png}" IsChecked="{Binding ElementName=biCheckPercent, Path=IsChecked, Converter={StaticResource BooleanNegationConverter}}" LargeGlyph="{dx:DXImageOffice2013 Image=FormatNumberDecimal_32x32.png}" ToolTip="S-Curve shows cumulative absolutes only" />
                    <dxb:BarCheckItem x:Name="biSelectAll" Command="{Binding SelectAllCommand}" Content="All" Glyph="{dx:DXImage Image=BODepartment_16x16.png}" IsChecked="{Binding IsAllSelected, Mode=OneWay}" IsEnabled="{Binding IsLoading, Converter={dxmvvm:BooleanNegationConverter}}" LargeGlyph="{dx:DXImage Image=BODepartment_32x32.png}" ToolTip="Selects all subjobs. S-Curve will also be construction only" />
                    <dxb:BarCheckItem x:Name="biSelectConstruct" Command="{Binding SelectSubjobCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Self}}" Content="Construct" Glyph="{dx:DXImage Image=BOEmployee_16x16.png}" IsEnabled="{Binding IsLoading, Converter={dxmvvm:BooleanNegationConverter}}" IsChecked="{Binding IsAllConstructSelected, Mode=OneWay}" LargeGlyph="{dx:DXImage Image=BOEmployee_32x32.png}" ToolTip="Selects construction subjobs. S-Curve will also be construction only" />
                    <dxb:BarCheckItem x:Name="biSelectDesign" Command="{Binding SelectSubjobCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Self}}" Content="Design" Glyph="{dx:DXImage Image=BOPerson_16x16.png}" IsEnabled="{Binding IsLoading, Converter={dxmvvm:BooleanNegationConverter}}" IsChecked="{Binding IsAllDesignSelected, Mode=OneWay}" LargeGlyph="{dx:DXImage Image=BOPerson_32x32.png}" ToolTip="Selects design subjobs. S-Curve will also be construction only" />
                    <!--<dxb:BarCheckItem Content="Auto Refresh" IsChecked="{Binding DoNotAutoRefresh, Converter={dxmvvm:BooleanNegationConverter}}" Glyph="{dx:DXImageOffice2013 Image=Refresh_16x16.png}" />-->
                    <dxb:BarButtonItem x:Name="biShowP6Errors" Command="{Binding ShowP6ErrorsCommand}" Content="P6 Issues" Glyph="{dx:DXImageOffice2013 Image=BugReport_16x16.png}" LargeGlyph="{dx:DXImage Image=BugReport_32x32.png}" ToolTip="Shows any invalid mappings because activity isn't found on P6" />
                    <dxb:BarButtonItem x:Name="biShowExoErrors" Command="{Binding ShowExoErrorsCommand}" Content="Exo Issues" Glyph="{dx:DXImageOffice2013 Image=BugReport_16x16.png}" LargeGlyph="{dx:DXImage Image=BugReport_32x32.png}" ToolTip="Shows any subjobs in exo that isn't available in blueprints" />
                    <dxb:BarButtonItem x:Name="biEditArea" Command="{Binding EditAreaCommand}" Content="Areas" Glyph="{dx:DXImage Image=Web_16x16.png}" LargeGlyph="{dx:DXImage Image=Web_32x32.png}" ToolTip="View all project areas" />
                    <dxb:BarButtonItem x:Name="biEditBaseline" Command="{Binding EditBaselineCommand}" Content="Design Baseline Revisions" Glyph="{dx:DXImage Image=Information_16x16.png}" LargeGlyph="{dx:DXImage Image=Information_32x32.png}" ToolTip="View all revisions of project baseline" />
                    <dxb:BarButtonItem x:Name="biEditEstimate" Command="{Binding EditEstimateCommand}" Content="Construction Baseline Revisions" Glyph="{dx:DXImage Image=Cube_16x16.png}" LargeGlyph="{dx:DXImage Image=Cube_32x32.png}" ToolTip="View all revisions of project estimate" />
                    <dxb:BarButtonItem x:Name="biEditProgress" Command="{Binding EditProgressCommand}" Content="Progress Revision" Glyph="{dx:DXImage Image=Date&amp;Time_16x16.png}" LargeGlyph="{dx:DXImage Image=Date&amp;Time_32x32.png}" ToolTip="View all revisions of project progress" />
                    <dxb:BarButtonItem x:Name="biLocalExportToExcel" Command="{Binding ExportToExcelCommand}" Content="Export All" Glyph="{dx:DXImage Image=ExportToXLSX_16x16.png}" LargeGlyph="{dx:DXImage Image=ExportToXLSX_32x32.png}" RibbonStyle="SmallWithText" ToolTip="Export all datapoints to excel" />
                </dxb:BarManager.Items>
                <DockPanel>
                    <dxr:RibbonControl Style="{StaticResource DefaultRibbonControlStyle}">
                        <dxr:RibbonDefaultPageCategory MergeType="Replace" Caption="defaultCategory">
                            <dxr:RibbonPage MergeType="Replace" Caption="Grid">
                                <dxr:RibbonPageGroup MergeType="Replace" Caption="Refresh">
                                    <dxb:BarButtonItemLink BarItemName="biRefreshFromP6" />
                                </dxr:RibbonPageGroup>
                                <dxr:RibbonPageGroup MergeType="Replace" Caption="Layout" >
                                    <dxb:BarButtonItemLink BarItemName="biSaveLayout1" />
                                    <dxb:BarButtonItemLink BarItemName="biResetLayout1" />
                                </dxr:RibbonPageGroup>
                                <dxr:RibbonPageGroup MergeType="Replace" Caption="Report" >
                                    <dxb:BarButtonItemLink BarItemName="biEditReport1" />
                                    <dxb:BarButtonItemLink BarItemName="biViewReport1" />
                                </dxr:RibbonPageGroup>
                                <dxr:RibbonPageGroup MergeType="Replace" Caption="Data Date">
                                    <dxb:BarEditItemLink BarItemName="beDesignDataDate" />
                                </dxr:RibbonPageGroup>
                                <dxr:RibbonPageGroup MergeType="Replace" Caption="Chart">
                                    <dxb:BarButtonItemLink BarItemName="biCheckUnits" />
                                    <dxb:BarButtonItemLink BarItemName="biCheckCosts" />
                                    <dxb:BarButtonItemLink BarItemName="biCheckQty" />
                                    <dxb:BarCheckItemLink BarItemName="biCheckPercent" />
                                    <dxb:BarCheckItemLink BarItemName="biCheckCumulativeUC" />
                                    <dxb:BarCheckItemLink BarItemName="biSelectAll" />
                                    <dxb:BarCheckItemLink BarItemName="biSelectConstruct" />
                                    <dxb:BarCheckItemLink BarItemName="biSelectDesign" />
                                </dxr:RibbonPageGroup>
                            </dxr:RibbonPage>
                            <dxr:RibbonPage MergeType="Replace" Caption="Detailed Export">
                                <dxr:RibbonPageGroup MergeType="Replace" Caption="Project Details">
                                    <dxb:BarButtonItemLink BarItemName="biLocalExportToExcel" />
                                    <dxb:BarButtonItemLink BarItemName="biExportPlanned" />
                                    <dxb:BarButtonItemLink BarItemName="biExportCurrent" />
                                    <dxb:BarButtonItemLink BarItemName="biExportEarned" />
                                    <dxb:BarButtonItemLink BarItemName="biExportRemaining" />
                                </dxr:RibbonPageGroup>
                            </dxr:RibbonPage>
                            <dxr:RibbonPage MergeType="Replace" Caption="Troubleshooting">
                                <dxr:RibbonPageGroup MergeType="Replace" Caption="Troubleshooting">
                                    <dxb:BarButtonItemLink BarItemName="biShowP6Errors" />
                                    <dxb:BarButtonItemLink BarItemName="biShowExoErrors" />
                                    <dxb:BarButtonItemLink BarItemName="biHealthCheck" />
                                </dxr:RibbonPageGroup>
                            </dxr:RibbonPage>
                            <dxr:RibbonPage MergeType="Replace" Caption="Project Detail">
                                <dxr:RibbonPageGroup MergeType="Replace" Caption="Project Detail">
                                    <dxb:BarButtonItemLink BarItemName="biEditArea" />
                                    <dxb:BarButtonItemLink BarItemName="biEditBaseline" />
                                    <dxb:BarButtonItemLink BarItemName="biEditEstimate" />
                                    <dxb:BarButtonItemLink BarItemName="biEditProgress" />
                                </dxr:RibbonPageGroup>
                            </dxr:RibbonPage>
                        </dxr:RibbonDefaultPageCategory>
                    </dxr:RibbonControl>
                    <dxr:RibbonStatusBarControl DockPanel.Dock="Bottom" />
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="0" />
                        </Grid.RowDefinitions>
                        <custom:GridControlEx x:Name="GridControlExcelExport" Grid.Row="0" dx:DXSerializer.Enabled="False" ItemsSource="{Binding ExcelExportData}" Visibility="Collapsed">
                            <dxg:GridControl.Columns>
                                <dxg:GridColumn FieldName="Type" ReadOnly="True" />
                                <dxg:GridColumn FieldName="Subjob_Name" ReadOnly="True" />
                                <dxg:GridColumn FieldName="Discipline_Name" ReadOnly="True" />
                                <dxg:GridColumn FieldName="Commodity_Code" ReadOnly="True" />
                                <dxg:GridColumn FieldName="Internal_Name" Visible="{Binding IsExportInternalNameVisible}" ReadOnly="True" />
                                <dxg:GridColumn FieldName="Data_Date" ReadOnly="True" />
                                <dxg:GridColumn FieldName="Units" ReadOnly="True" />
                                <dxg:GridColumn FieldName="Costs" ReadOnly="True" />
                                <dxg:GridColumn FieldName="Actual_Costs" ReadOnly="True" />
                            </dxg:GridControl.Columns>
                            <dxg:GridControl.View>
                                <!--  need to set tableView name here for export to work  -->
                                <dxg:TableView Name="tableView" />
                            </dxg:GridControl.View>
                        </custom:GridControlEx>
                    </Grid>
                    <dxlc:LayoutControl x:Name="layoutControl" Orientation="Vertical">
                        <dxlc:LayoutGroup Name="LayoutGroupGrid" Height="300" dxlc:LayoutControl.AllowVerticalSizing="True" Orientation="Vertical" View="Group">
                            <custom:GridControlEx x:Name="GridControl" dx:DXSerializer.SerializationID="GridControlSingleProjectDashboard" IsFilterEnabled="False" ItemsSource="{Binding SingleProjectDashboards}" SelectedItems="{Binding Selected_Dashboards, Mode=TwoWay}" Style="{StaticResource SingleProjectGridControlTemplate}">
                                <dxmvvm:Interaction.Behaviors>
                                    <dxmvvm:EventToCommand Command="{Binding CustomSummaryCommand}" EventName="CustomSummary" PassEventArgsToCommand="True" />
                                </dxmvvm:Interaction.Behaviors>
                                <dxg:GridControl.Bands>
                                    <dxg:GridControlBand Header="General">
                                        <!--<dxg:GridColumn FieldName="IsManaged" Header="Managed" VisibleIndex="5" />-->
                                        <dxg:GridColumn Width="150" FieldName="SubjobCode" Header="Subjob" VisibleIndex="10" />
                                        <dxg:GridColumn Width="75" FieldName="PhaseCode" Header="Phase" VisibleIndex="20" />
                                        <dxg:GridColumn Width="75" FieldName="AreaCode" Header="Area" VisibleIndex="30" />
                                        <dxg:GridColumn Width="75" FieldName="SubAreaCode" Header="Sub Area" VisibleIndex="40" />
                                        <!--<dxg:GridColumn FieldName="AreaCode" Header="Area" VisibleIndex="20" />-->
                                        <dxg:GridColumn Header="Department" FieldName="DepartmentCode"  VisibleIndex="45" />
                                        <dxg:GridColumn FieldName="DisciplineCode" Header="Discipline" VisibleIndex="50" />
                                        <dxg:GridColumn FieldName="CommodityCode" Header="Commodity" VisibleIndex="60" />
                                        <!--<dxg:GridColumn FieldName="Variation_Code" Header="Variation" VisibleIndex="45" />-->
                                        <dxg:GridColumn FieldName="{Binding Total_Budgeted}" Header="{Binding Header_Total_Budgeted}" HeaderToolTip="Total budget" VisibleIndex="70">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:SpinEditSettings Mask="{Binding Field_Mask}" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn FieldName="{Binding Total_Current}" Header="{Binding Header_Total_Current}" HeaderToolTip="Total units including variation" VisibleIndex="80">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:SpinEditSettings Mask="{Binding Field_Mask}" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                    </dxg:GridControlBand>
                                    <dxg:GridControlBand Header="Cumulative">
                                        <dxg:GridColumn AllowEditing="False" FieldName="{Binding Cumulative_Tender_Planned_Percentage}" Header="{Binding Header_Cumulative_Tender_Planned_Percentage}" HeaderToolTip="Budget Planned % to Date" ReadOnly="True" VisibleIndex="90">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:SpinEditSettings Mask="p2" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn AllowEditing="False" FieldName="{Binding Cumulative_Current_Planned_Percentage}" Header="{Binding Header_Cumulative_Current_Planned_Percentage}" HeaderToolTip="Current Planned % to Date" ReadOnly="True" VisibleIndex="100">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:SpinEditSettings Mask="p2" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn AllowEditing="False" FieldName="{Binding Cumulative_Budgeted_Earned_Percentage}" Header="{Binding Header_Cumulative_Budgeted_Earned_Percentage}" HeaderToolTip="Budget Earned % to Date" ReadOnly="True" VisibleIndex="110">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:SpinEditSettings Mask="p2" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn AllowEditing="False" FieldName="{Binding Cumulative_Current_Earned_Percentage}" Header="{Binding Header_Cumulative_Current_Earned_Percentage}" HeaderToolTip="Current Earned % to Date" ReadOnly="True" VisibleIndex="120">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:SpinEditSettings Mask="p2" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn AllowEditing="False" FieldName="{Binding Cumulative_Planned_Units}" Header="{Binding Header_Budgeted_ToDate}" HeaderToolTip="Planned budget to Date" ReadOnly="True" VisibleIndex="130">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:SpinEditSettings Mask="{Binding Field_Mask}" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn AllowEditing="False" FieldName="{Binding Cumulative_Current_Units}" Header="{Binding Header_Current_ToDate}" HeaderToolTip="Planned current to Date" ReadOnly="True" VisibleIndex="140">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:SpinEditSettings Mask="{Binding Field_Mask}" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn AllowEditing="False" Visible="False" FieldName="{Binding Cumulative_PlannedLate_Units}" Header="{Binding Header_BudgetedLate_ToDate}" HeaderToolTip="Late planned budget to Date" ReadOnly="True" VisibleIndex="150">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:SpinEditSettings Mask="{Binding Field_Mask}" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn AllowEditing="False" FieldName="{Binding Cumulative_Earned_Units}" Header="{Binding Header_Earned_ToDate}" HeaderToolTip="Earned to Date" ReadOnly="True" VisibleIndex="160">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:SpinEditSettings Mask="{Binding Field_Mask}" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn AllowEditing="False" FieldName="{Binding Cumulative_Burned_Units}" Header="{Binding Header_Burned_ToDate}" HeaderToolTip="Burned to Date" ReadOnly="True" VisibleIndex="170">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:SpinEditSettings Mask="{Binding Field_Mask}" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn AllowEditing="False" FieldName="{Binding Cumulative_Actual_Units}" Header="{Binding Header_Actual_ToDate}" HeaderToolTip="Actual costs to Date" ReadOnly="True" Visible="{Binding IsActualVisible}" VisibleIndex="180">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:SpinEditSettings Mask="{Binding Field_Mask}" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn AllowEditing="False" FieldName="{Binding Cumulative_Remaining_Units}" Header="{Binding Header_Remaining_ToDate}" HeaderToolTip="Remaining to Date" ReadOnly="True" VisibleIndex="190">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:SpinEditSettings Mask="{Binding Field_Mask}" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                    </dxg:GridControlBand>
                                    <dxg:GridControlBand Header="Period">
                                        <dxg:GridColumn AllowEditing="False" FieldName="{Binding Period_Budgeted_Earned_Percentage}" Header="{Binding Header_Period_Budgeted_Earned_Percentage}" HeaderToolTip="Budget Earned % for this period" ReadOnly="True" VisibleIndex="200">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:SpinEditSettings Mask="p2" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn AllowEditing="False" FieldName="{Binding Period_Current_Earned_Percentage}" Header="{Binding Header_Period_Current_Earned_Percentage}" HeaderToolTip="Current Earned % for this period" ReadOnly="True" VisibleIndex="210">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:SpinEditSettings Mask="p2" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn AllowEditing="False" FieldName="{Binding Period_Planned_Units}" Header="{Binding Header_Budgeted_Period}" HeaderToolTip="Planned for this period" ReadOnly="True" VisibleIndex="220">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:SpinEditSettings Mask="{Binding Field_Mask}" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn AllowEditing="False" FieldName="{Binding Period_Current_Units}" Header="{Binding Header_Current_Period}" HeaderToolTip="Planned and variation for this period" ReadOnly="True" VisibleIndex="230">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:SpinEditSettings Mask="{Binding Field_Mask}" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn AllowEditing="False" FieldName="{Binding Period_PlannedLate_Units}" Header="{Binding Header_BudgetedLate_Period}" HeaderToolTip="Late planned for this period" ReadOnly="True" VisibleIndex="240">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:SpinEditSettings Mask="{Binding Field_Mask}" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn AllowEditing="False" FieldName="{Binding Period_Earned_Units}" Header="{Binding Header_Earned_Period}" HeaderToolTip="Earned for this period" ReadOnly="True" VisibleIndex="250">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:SpinEditSettings Mask="{Binding Field_Mask}" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn AllowEditing="False" FieldName="{Binding Period_Burned_Units}" Header="{Binding Header_Burned_Period}" HeaderToolTip="Burned for this period" ReadOnly="True" VisibleIndex="260">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:SpinEditSettings Mask="{Binding Field_Mask}" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn AllowEditing="False" FieldName="{Binding Period_Actual_Units}" Header="{Binding Header_Actual_Period}" HeaderToolTip="Actual costs for this period" ReadOnly="True" Visible="{Binding IsActualVisible}" VisibleIndex="270">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:SpinEditSettings Mask="{Binding Field_Mask}" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                    </dxg:GridControlBand>
                                    <dxg:GridControlBand Header="Performance">
                                        <dxg:GridColumn AllowEditing="False" FieldName="Stats.GrossProfit" Header="Gross Profit" HeaderToolTip="[(Total Earned Costs - Total Actual Costs) / Total Earned Costs]" ReadOnly="True" VisibleIndex="280">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:SpinEditSettings Mask="p2" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn AllowEditing="False" FieldName="Stats.EfficiencyRatio" Header="Efficiency Ratio %" HeaderToolTip="[(Total Earned - Total Burned) / Total Burned]" ReadOnly="True" VisibleIndex="290">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:SpinEditSettings Mask="p2" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn AllowEditing="False" FieldName="Stats.ProgressRatio" Header="Progress Ratio %" HeaderToolTip="[(Total Earned - Total Planned) / Total Planned]" ReadOnly="True" VisibleIndex="300">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:SpinEditSettings Mask="p2" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                    </dxg:GridControlBand>
                                </dxg:GridControl.Bands>
                                <dxg:GridControl.View>
                                    <dxg:TableView custom:GroupChildSelector.Mode="Hierarchical" AllowEditing="False" ScrollBarAnnotationMode="None" NewItemRowPosition="None" ShowTotalSummary="True" Style="{StaticResource DefaultTableViewTemplate}">
                                        <dxg:TableView.RowCellMenuCustomizations>
                                            <dxb:BarButtonItemLink BarItemName="biCopyWithHeader1" />
                                        </dxg:TableView.RowCellMenuCustomizations>
                                    </dxg:TableView>
                                </dxg:GridControl.View>
                            </custom:GridControlEx>
                        </dxlc:LayoutGroup>
                        <dx:LoadingDecorator IsSplashScreenShown="{Binding IsLoading}">
                            <dxlc:LayoutGroup Name="LayoutGroupChart" Orientation="Vertical" View="Group">
                                <dxc:ChartControl x:Name="ChartControl" Grid.Row="2" Margin="0" Padding="0" ToolTipEnabled="False" dx:DXSerializer.Enabled="False" AnimationMode="OnLoad" AutoLayout="False">
                                    <dxc:ChartControl.CrosshairOptions>
                                        <dxc:CrosshairOptions GroupHeaderPattern="{}{A:d}" />
                                    </dxc:ChartControl.CrosshairOptions>
                                    <dxc:XYDiagram2D AllowSeriesBitmapCaching="False" SeriesItemsSource="{StaticResource dashboardXYChartSeries}">
                                        <dxc:XYDiagram2D.AxisX>
                                            <dxc:AxisX2D>
                                                <dxc:AxisX2D.Label>
                                                    <dxc:AxisLabel>
                                                        <dxc:Axis2D.ResolveOverlappingOptions>
                                                            <dxc:AxisLabelResolveOverlappingOptions AllowRotate="True" AllowStagger="True" />
                                                        </dxc:Axis2D.ResolveOverlappingOptions>
                                                    </dxc:AxisLabel>
                                                </dxc:AxisX2D.Label>
                                            </dxc:AxisX2D>
                                        </dxc:XYDiagram2D.AxisX>
                                        <dxc:XYDiagram2D.AxisY>
                                            <dxc:AxisY2D x:Name="primaryAxisY">
                                                <dxc:AxisY2D.Title>
                                                    <dxc:AxisTitle Content="{Binding AxisYPrimaryLabel}" />
                                                </dxc:AxisY2D.Title>
                                            </dxc:AxisY2D>
                                        </dxc:XYDiagram2D.AxisY>
                                        <dxc:XYDiagram2D.SecondaryAxesY>
                                            <dxc:SecondaryAxisY2D x:Name="secondaryAxisY">
                                                <dxc:SecondaryAxisY2D.Title>
                                                    <dxc:AxisTitle Content="{Binding AxisYSecondaryLabel}" />
                                                </dxc:SecondaryAxisY2D.Title>
                                                <dxc:SecondaryAxisY2D.Label>
                                                    <dxc:AxisLabel TextPattern="{Binding AxisYSecondaryTextPattern}" />
                                                </dxc:SecondaryAxisY2D.Label>
                                            </dxc:SecondaryAxisY2D>
                                        </dxc:XYDiagram2D.SecondaryAxesY>
                                    </dxc:XYDiagram2D>
                                    <dxc:ChartControl.Legend>
                                        <dxc:Legend UseCheckBoxes="True" />
                                    </dxc:ChartControl.Legend>
                                </dxc:ChartControl>
                            </dxlc:LayoutGroup>
                        </dx:LoadingDecorator>
                    </dxlc:LayoutControl>
                </DockPanel>
            </dxb:BarManager>
        </Grid>
    </Grid>
</UserControl>
