<UserControl x:Class="BluePrints.Views.PROJECTView" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:common="clr-namespace:BluePrints.Common" xmlns:converter="clr-namespace:BluePrints.Common.ViewModel.Converters" xmlns:custom="clr-namespace:BaseModel.Misc;assembly=BaseModel" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/charts" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dxi="http://schemas.devexpress.com/winfx/2008/xaml/core/internal" xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:services="clr-namespace:BaseModel.ViewModel.Services;assembly=BaseModel" xmlns:viewmodel="clr-namespace:BluePrints.ViewModels" x:Name="userControl" d:DesignHeight="1920" d:DesignWidth="1080" DataContext="{dxmvvm:ViewModelSource viewmodel:PROJECTViewModelWrapper}" mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <converter:StringToImageConverter x:Key="StringToImageConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BaseModel;component/View/ResourceDictionaries/DefaultControlResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/BaseModel;component/View/ResourceDictionaries/NestedControlResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/ConverterResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/ChartResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/GridColumnResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/CustomControlResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/DefaultBluePrintsResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:OpenFileDialogService Title="Select Document" Multiselect="False" />
    </dxmvvm:Interaction.Behaviors>
    <Grid Style="{StaticResource CollectionView.RootContainer}">
        <dxmvvm:Interaction.Behaviors>
            <dx:DialogService x:Name="ProjectIssueDialog">
                <dx:DialogService.DialogStyle>
                    <Style TargetType="dx:DXDialogWindow">
                        <Setter Property="SizeToContent" Value="WidthAndHeight" />
                        <Setter Property="MinWidth" Value="800" />
                        <Setter Property="MinHeight" Value="600" />
                    </Style>
                </dx:DialogService.DialogStyle>
            </dx:DialogService>
        </dxmvvm:Interaction.Behaviors>
        <Grid Style="{StaticResource DashboardView.RootContainer}">
            <dxmvvm:Interaction.Behaviors>
                <services:ChartControlService x:Name="DefaultChartControlService" ChartControl="{Binding ElementName=ChartControl}" />
            </dxmvvm:Interaction.Behaviors>
            <Grid DataContext="{Binding MainViewModel}">
                <DockPanel>
                    <dxr:RibbonControl AllowCustomization="False" DockPanel.Dock="Top" RibbonStyle="OfficeSlim">
                        <dxr:RibbonDefaultPageCategory Caption="defaultCategory">
                            <dxr:RibbonPage Caption="{Binding DataContext.ViewName, ElementName=userControl}">
                                <dxr:RibbonPageGroup Caption="Grid" ItemLinksSource="{StaticResource RibbonDefaultCollapsedGridButtons}" />
                                <dxr:RibbonPageGroup Caption="Report" ItemLinksSource="{StaticResource RibbonDefaultReportingButtons}" />
                                <dxr:RibbonPageGroup Caption="Data Date">
                                    <dxb:BarStaticItem Content="Design" />
                                    <dxb:BarStaticItem Content="{Binding DataContext.DesignDataDate, ElementName=userControl}" ToolTip="Design Data date" />
                                    <dxb:BarStaticItem Content="Construct" />
                                    <dxb:BarStaticItem Content="{Binding DataContext.ConstructDataDate, ElementName=userControl}" ToolTip="Construct Data date" />
                                </dxr:RibbonPageGroup>
                                <dxr:RibbonPageGroup Caption="Export">
                                    <dxb:BarSubItem Content="Detailed Export" Glyph="{dx:DXImage Image=Grid_16x16.png}" LargeGlyph="{dx:DXImage Image=Grid_32x32.png}" RibbonStyle="SmallWithText" ToolTip="Grid interaction tools">
                                        <dxb:BarButtonItem Content="Export Planned" ToolTip="Export planned datapoints to excel" Command="{Binding DataContext.ExportPlannedCommand, ElementName=userControl}" LargeGlyph="{dx:DXImage Image=ExportToXLSX_32x32.png}" Glyph="{dx:DXImage Image=ExportToXLSX_16x16.png}" />
                                        <dxb:BarButtonItem Content="Export Earned" ToolTip="Export earned datapoints to excel" Command="{Binding DataContext.ExportEarnedCommand, ElementName=userControl}" LargeGlyph="{dx:DXImage Image=ExportToXLSX_32x32.png}" Glyph="{dx:DXImage Image=ExportToXLSX_16x16.png}" />
                                        <dxb:BarButtonItem Content="Export Remaining" ToolTip="Export remaining datapoints to excel" Command="{Binding DataContext.ExportRemainingCommand, ElementName=userControl}" LargeGlyph="{dx:DXImage Image=ExportToXLSX_32x32.png}" Glyph="{dx:DXImage Image=ExportToXLSX_16x16.png}" />
                                    </dxb:BarSubItem>
                                </dxr:RibbonPageGroup>
                                <dxr:RibbonPageGroup Caption="Tools" DataContext="{Binding DataContext, ElementName=userControl}">
                                    <dxb:BarButtonItem x:Name="biHealthCheck" Command="{Binding ProjectHealthCheckCommand}" CommandParameter="{Binding Mode=OneWay, RelativeSource={RelativeSource Self}}" Content="Health Check" ToolTip="Check S-Curve accuracy">
                                        <dxb:BarButtonItem.GlyphTemplate>
                                            <DataTemplate>
                                                <Image Source="{Binding HealthCheckIconName, Converter={StaticResource StringToImageConverter}}">
                                                    <Image.RenderTransform>
                                                        <TranslateTransform x:Name="transTransform1" X="0" Y="0" />
                                                    </Image.RenderTransform>
                                                </Image>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Animate}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard Name="bounce">
                                                                <Storyboard RepeatBehavior="Forever">
                                                                    <DoubleAnimation AutoReverse="True" BeginTime="0:0:3" RepeatBehavior="3x" SpeedRatio="15" Storyboard.TargetName="transTransform1" Storyboard.TargetProperty="Y" From="0" To="-3" Duration="0:0:1" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <StopStoryboard BeginStoryboardName="bounce" />
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </dxb:BarButtonItem.GlyphTemplate>
                                    </dxb:BarButtonItem>
                                    <dxb:BarButtonItem x:Name="biCheckUnits" Command="{Binding ChangeStatsTypeCommand}" CommandParameter="{Binding Mode=OneWay, RelativeSource={RelativeSource Self}}" Content="Units" Glyph="{dx:DXImageOffice2013 Image=Time_16x16.png}" LargeGlyph="{dx:DXImageOffice2013 Image=Time_32x32.png}" ToolTip="S-Curve shows by units" />
                                    <dxb:BarButtonItem x:Name="biCheckCosts" Command="{Binding ChangeStatsTypeCommand}" CommandParameter="{Binding Mode=OneWay, RelativeSource={RelativeSource Self}}" Content="Costs" Glyph="{dx:DXImageOffice2013 Image=Currency_32x32.png}" LargeGlyph="{dx:DXImageOffice2013 Image=Currency_32x32.png}" ToolTip="S-Curve shows by costs" />
                                    <dxb:BarButtonItem x:Name="biCheckQty" Command="{Binding ChangeStatsTypeCommand}" CommandParameter="{Binding Mode=OneWay, RelativeSource={RelativeSource Self}}" Content="Qty" Glyph="{dx:DXImage Image=Number_16x16.png}" LargeGlyph="{dx:DXImage Image=Number_32x32.png}" ToolTip="S-Curve shows by quantity" />
                                    <dxb:BarCheckItem x:Name="biCheckPercent" Command="{Binding ChangeStatsPercentageTypeCommand}" CommandParameter="{Binding Mode=OneWay, RelativeSource={RelativeSource Self}}" Content="Percentage" Glyph="{dx:DXImage Image=Percentage_16x16.png}" IsChecked="True" LargeGlyph="{dx:DXImageOffice2013 Image=Percentage_32x32.png}" ToolTip="S-Curve shows cumulative as percentage" />
                                    <dxb:BarCheckItem x:Name="biCheckCumulativeUC" Command="{Binding ChangeStatsPercentageTypeCommand}" CommandParameter="{Binding Mode=OneWay, RelativeSource={RelativeSource Self}}" Content="Absolute" Glyph="{dx:DXImage Image=FormatNumberDecimal_16x16.png}" IsChecked="{Binding ElementName=biCheckPercent, Path=IsChecked, Converter={StaticResource BooleanNegationConverter}}" LargeGlyph="{dx:DXImageOffice2013 Image=FormatNumberDecimal_32x32.png}" ToolTip="S-Curve shows cumulative absolutes only" />
                                    <dxb:BarButtonItem Command="{Binding Refresh_From_P6Command}" Content="Calculate Stats" Glyph="{dx:DXImage Image=Reset2_16x16.png}" LargeGlyph="{dx:DXImage Image=Reset2_32x32.png}" ToolTip="Recalculate stats from P6. Must be performed after pressing F9 in P6" />
                                    <dxb:BarCheckItem Command="{Binding SelectAllCommand}" Content="All" Glyph="{dx:DXImage Image=BODepartment_16x16.png}" IsChecked="{Binding IsAllSelected, Mode=OneWay}" LargeGlyph="{dx:DXImage Image=BODepartment_32x32.png}" ToolTip="Selects all subjobs. S-Curve will also be construction only" />
                                    <dxb:BarCheckItem Command="{Binding SelectSubjobCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Self}}" Content="Construct" Glyph="{dx:DXImage Image=BOEmployee_16x16.png}" IsChecked="{Binding IsAllConstructSelected, Mode=OneWay}" LargeGlyph="{dx:DXImage Image=BOEmployee_32x32.png}" ToolTip="Selects construction subjobs. S-Curve will also be construction only" />
                                    <dxb:BarCheckItem Command="{Binding SelectSubjobCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Self}}" Content="Design" Glyph="{dx:DXImage Image=BOPerson_16x16.png}" IsChecked="{Binding IsAllDesignSelected, Mode=OneWay}" LargeGlyph="{dx:DXImage Image=BOPerson_32x32.png}" ToolTip="Selects design subjobs. S-Curve will also be construction only" />
                                    <!--<dxb:BarCheckItem Content="Auto Refresh" IsChecked="{Binding DoNotAutoRefresh, Converter={dxmvvm:BooleanNegationConverter}}" Glyph="{dx:DXImageOffice2013 Image=Refresh_16x16.png}" />-->
                                    <dxb:BarButtonItem Command="{Binding ShowP6ErrorsCommand}" Content="P6 Issues" Glyph="{dx:DXImageOffice2013 Image=BugReport_16x16.png}" LargeGlyph="{dx:DXImage Image=BugReport_32x32.png}" ToolTip="Shows any invalid mappings because activity isn't found on P6" />
                                    <dxb:BarButtonItem Command="{Binding ShowExoErrorsCommand}" Content="Exo Issues" Glyph="{dx:DXImageOffice2013 Image=BugReport_16x16.png}" LargeGlyph="{dx:DXImage Image=BugReport_32x32.png}" ToolTip="Shows any subjobs in exo that isn't available in blueprints" />
                                    <!--<dxb:BarButtonItem Content="Export" ToolTip="Export selected rows S-Curve to PDF" Command="{Binding ExportToPDFCommand}" LargeGlyph="{dx:DXImage Image=ExportToPDF_32x32.png}" Glyph="{dx:DXImage Image=ExportToPDF_16x16.png}" />-->
                                </dxr:RibbonPageGroup>
                                <dxr:RibbonPageGroup Caption="Data">
                                    <dxb:BarButtonItem Command="{Binding DataContext.EditAreaCommand, ElementName=userControl}" Content="Area" Glyph="{dx:DXImage Image=Web_16x16.png}" LargeGlyph="{dx:DXImage Image=Web_32x32.png}" ToolTip="View all project areas" />
                                    <dxb:BarButtonItem Command="{Binding DataContext.EditRateCommand, ElementName=userControl}" Content="Rate" Glyph="{dx:DXImage Image=Financial_16x16.png}" LargeGlyph="{dx:DXImage Image=Financial_32x32.png}" ToolTip="View all project rates" />
                                    <dxb:BarButtonItem Command="{Binding DataContext.EditBaselineCommand, ElementName=userControl}" Content="Baselines" Glyph="{dx:DXImage Image=Information_16x16.png}" LargeGlyph="{dx:DXImage Image=Information_32x32.png}" ToolTip="View all revisions of project baseline" />
                                    <dxb:BarButtonItem Command="{Binding DataContext.EditEstimateCommand, ElementName=userControl}" Content="Estimates" Glyph="{dx:DXImage Image=Cube_16x16.png}" LargeGlyph="{dx:DXImage Image=Cube_32x32.png}" ToolTip="View all revisions of project estimate" />
                                    <dxb:BarButtonItem Command="{Binding DataContext.EditProgressCommand, ElementName=userControl}" Content="Progresses" Glyph="{dx:DXImage Image=Date&amp;Time_16x16.png}" LargeGlyph="{dx:DXImage Image=Date&amp;Time_32x32.png}" ToolTip="View all revisions of project progress" />
                                </dxr:RibbonPageGroup>
                            </dxr:RibbonPage>
                        </dxr:RibbonDefaultPageCategory>
                    </dxr:RibbonControl>
                    <dxr:RibbonStatusBarControl DockPanel.Dock="Bottom" />
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="0" />
                        </Grid.RowDefinitions>
                        <custom:GridControlEx x:Name="GridControlExcelExport" Grid.Row="0" dx:DXSerializer.Enabled="False" ItemsSource="{Binding DataContext.ExcelExportData, ElementName=userControl}" Visibility="Collapsed">
                            <dxg:GridControl.Columns>
                                <dxg:GridColumn FieldName="Type" ReadOnly="True" />
                                <dxg:GridColumn FieldName="Subjob_Name" ReadOnly="True" />
                                <dxg:GridColumn FieldName="Discipline_Name" ReadOnly="True" />
                                <dxg:GridColumn FieldName="Commodity_Code" ReadOnly="True" />
                                <dxg:GridColumn FieldName="Internal_Name" Visible="{Binding DataContext.IsExportInternalNameVisible, ElementName=userControl}" ReadOnly="True" />
                                <dxg:GridColumn FieldName="Data_Date" ReadOnly="True" />
                                <dxg:GridColumn FieldName="Units" ReadOnly="True" />
                                <dxg:GridColumn FieldName="Costs" ReadOnly="True" />
                                <dxg:GridColumn FieldName="Actual_Costs" ReadOnly="True" />
                            </dxg:GridControl.Columns>
                            <dxg:GridControl.View>
                                <!--  need to set tableView name here for export to work  -->
                                <dxg:TableView Name="tableView" />
                            </dxg:GridControl.View>
                        </custom:GridControlEx>
                    </Grid>
                    <dxlc:LayoutControl x:Name="layoutControl" Orientation="Vertical">
                        <dxlc:LayoutGroup Name="LayoutGroupGrid" Height="300" dxlc:LayoutControl.AllowVerticalSizing="True" Orientation="Vertical" View="Group">
                            <custom:GridControlEx x:Name="GridControl" dx:DXSerializer.SerializationID="GridControlSingleProjectDashboard" IsFilterEnabled="False" ItemsSource="{Binding DataContext.SingleProjectDashboards, ElementName=userControl}" SelectedItems="{Binding DataContext.Selected_Dashboards, Mode=TwoWay, ElementName=userControl}" Style="{StaticResource SingleProjectGridControlTemplate}">
                                <dxmvvm:Interaction.Behaviors>
                                    <dxmvvm:EventToCommand Command="{Binding DataContext.CustomSummaryCommand, ElementName=userControl}" EventName="CustomSummary" PassEventArgsToCommand="True" />
                                </dxmvvm:Interaction.Behaviors>
                                <dxg:GridControl.Bands>
                                    <dxg:GridControlBand Header="General">
                                        <dxg:GridColumn Width="150" FieldName="SubjobCode" Header="Subjob" VisibleIndex="10" />
                                        <dxg:GridColumn FieldName="AreaCode" Header="Area" VisibleIndex="20" />
                                        <!--<dxg:GridColumn Header="Department" FieldName="DepartmentCode" />-->
                                        <dxg:GridColumn FieldName="DisciplineCode" Header="Discipline" VisibleIndex="30" />
                                        <dxg:GridColumn FieldName="CommodityCode" Header="Commodity" VisibleIndex="40" />
                                        <dxg:GridColumn FieldName="Variation_Code" Header="Variation" VisibleIndex="45" />
                                        <dxg:GridColumn FieldName="{Binding DataContext.Total_Budgeted, ElementName=userControl}" Header="{Binding DataContext.Header_Total_Budgeted, ElementName=userControl}" HeaderToolTip="Total budget" VisibleIndex="40">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings Mask="{Binding DataContext.Field_Mask, ElementName=userControl}" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn FieldName="{Binding DataContext.Total_Current, ElementName=userControl}" Header="{Binding DataContext.Header_Total_Current, ElementName=userControl}" HeaderToolTip="Total units including variation" VisibleIndex="50">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings Mask="{Binding DataContext.Field_Mask, ElementName=userControl}" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                    </dxg:GridControlBand>
                                    <dxg:GridControlBand Header="Cumulative">
                                        <dxg:GridColumn AllowEditing="False" FieldName="{Binding DataContext.Cumulative_Budgeted_Earned_Percentage, ElementName=userControl}" Header="{Binding DataContext.Header_Cumulative_Budgeted_Earned_Percentage, ElementName=userControl}" HeaderToolTip="Budget Earned % to date" ReadOnly="True" VisibleIndex="80">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings Mask="p2" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn AllowEditing="False" FieldName="{Binding DataContext.Cumulative_Current_Earned_Percentage, ElementName=userControl}" Header="{Binding DataContext.Header_Cumulative_Current_Earned_Percentage, ElementName=userControl}" HeaderToolTip="Current Earned % to date" ReadOnly="True" VisibleIndex="80">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings Mask="p2" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn AllowEditing="False" FieldName="{Binding DataContext.Cumulative_Planned_Units, ElementName=userControl}" Header="{Binding DataContext.Header_Budgeted_ToDate, ElementName=userControl}" HeaderToolTip="Schedule planned to date" ReadOnly="True" VisibleIndex="90">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings Mask="{Binding DataContext.Field_Mask, ElementName=userControl}" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn AllowEditing="False" FieldName="{Binding DataContext.Cumulative_Current_Units, ElementName=userControl}" Header="{Binding DataContext.Header_Current_ToDate, ElementName=userControl}" HeaderToolTip="Schedule planned and variation to date" ReadOnly="True" VisibleIndex="90">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings Mask="{Binding DataContext.Field_Mask, ElementName=userControl}" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn AllowEditing="False" FieldName="{Binding DataContext.Cumulative_PlannedLate_Units, ElementName=userControl}" Header="{Binding DataContext.Header_BudgetedLate_ToDate, ElementName=userControl}" HeaderToolTip="Schedule late planned to date" ReadOnly="True" VisibleIndex="90">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings Mask="{Binding DataContext.Field_Mask, ElementName=userControl}" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn AllowEditing="False" FieldName="{Binding DataContext.Cumulative_Earned_Units, ElementName=userControl}" Header="{Binding DataContext.Header_Earned_ToDate, ElementName=userControl}" HeaderToolTip="Earned to date" ReadOnly="True" VisibleIndex="100">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings Mask="{Binding DataContext.Field_Mask, ElementName=userControl}" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn AllowEditing="False" FieldName="{Binding DataContext.Cumulative_Burned_Units, ElementName=userControl}" Header="{Binding DataContext.Header_Burned_ToDate, ElementName=userControl}" HeaderToolTip="Burned to date" ReadOnly="True" VisibleIndex="110">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings Mask="{Binding DataContext.Field_Mask, ElementName=userControl}" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn AllowEditing="False" FieldName="{Binding DataContext.Cumulative_Actual_Units, ElementName=userControl}" Header="{Binding DataContext.Header_Actual_ToDate, ElementName=userControl}" HeaderToolTip="Actual costs to date" ReadOnly="True" Visible="{Binding DataContext.IsActualVisible, ElementName=userControl}" VisibleIndex="120">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings Mask="{Binding DataContext.Field_Mask, ElementName=userControl}" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn AllowEditing="False" FieldName="{Binding DataContext.Cumulative_Remaining_Units, ElementName=userControl}" Header="{Binding DataContext.Header_Remaining_ToDate, ElementName=userControl}" HeaderToolTip="Remaining to date" ReadOnly="True" VisibleIndex="125">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings Mask="{Binding DataContext.Field_Mask, ElementName=userControl}" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                    </dxg:GridControlBand>
                                    <dxg:GridControlBand Header="Period">
                                        <dxg:GridColumn AllowEditing="False" FieldName="{Binding DataContext.Period_Budgeted_Earned_Percentage, ElementName=userControl}" Header="{Binding DataContext.Header_Period_Budgeted_Earned_Percentage, ElementName=userControl}" HeaderToolTip="Budget Earned % for this period" ReadOnly="True" VisibleIndex="130">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings Mask="p2" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn AllowEditing="False" FieldName="{Binding DataContext.Period_Current_Earned_Percentage, ElementName=userControl}" Header="{Binding DataContext.Header_Period_Current_Earned_Percentage, ElementName=userControl}" HeaderToolTip="Current Earned % for this period" ReadOnly="True" VisibleIndex="130">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings Mask="p2" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn AllowEditing="False" FieldName="{Binding DataContext.Period_Planned_Units, ElementName=userControl}" Header="{Binding DataContext.Header_Budgeted_Period, ElementName=userControl}" HeaderToolTip="Planned for this period" ReadOnly="True" VisibleIndex="140">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings Mask="{Binding DataContext.Field_Mask, ElementName=userControl}" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn AllowEditing="False" FieldName="{Binding DataContext.Period_Current_Units, ElementName=userControl}" Header="{Binding DataContext.Header_Current_Period, ElementName=userControl}" HeaderToolTip="Planned and variation for this period" ReadOnly="True" VisibleIndex="140">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings Mask="{Binding DataContext.Field_Mask, ElementName=userControl}" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn AllowEditing="False" FieldName="{Binding DataContext.Period_PlannedLate_Units, ElementName=userControl}" Header="{Binding DataContext.Header_BudgetedLate_Period, ElementName=userControl}" HeaderToolTip="Late planned for this period" ReadOnly="True" VisibleIndex="140">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings Mask="{Binding DataContext.Field_Mask, ElementName=userControl}" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn AllowEditing="False" FieldName="{Binding DataContext.Period_Earned_Units, ElementName=userControl}" Header="{Binding DataContext.Header_Earned_Period, ElementName=userControl}" HeaderToolTip="Earned for this period" ReadOnly="True" VisibleIndex="150">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings Mask="{Binding DataContext.Field_Mask, ElementName=userControl}" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn AllowEditing="False" FieldName="{Binding DataContext.Period_Burned_Units, ElementName=userControl}" Header="{Binding DataContext.Header_Burned_Period, ElementName=userControl}" HeaderToolTip="Burned for this period" ReadOnly="True" VisibleIndex="160">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings Mask="{Binding DataContext.Field_Mask, ElementName=userControl}" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn AllowEditing="False" FieldName="{Binding DataContext.Period_Actual_Units, ElementName=userControl}" Header="{Binding DataContext.Header_Actual_Period, ElementName=userControl}" HeaderToolTip="Actual costs for this period" ReadOnly="True" Visible="{Binding DataContext.IsActualVisible, ElementName=userControl}" VisibleIndex="170">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings Mask="{Binding DataContext.Field_Mask, ElementName=userControl}" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                    </dxg:GridControlBand>
                                    <dxg:GridControlBand Header="Performance">
                                        <dxg:GridColumn AllowEditing="False" FieldName="Stats.GrossProfit" Header="Gross Profit" HeaderToolTip="[(Total Earned Costs - Total Actual Costs) / Total Earned Costs]" ReadOnly="True" VisibleIndex="15">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings Mask="p2" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn AllowEditing="False" FieldName="Stats.EfficiencyRatio" Header="Efficiency Ratio %" HeaderToolTip="[(Total Earned - Total Burned) / Total Burned]" ReadOnly="True" VisibleIndex="16">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings Mask="p2" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn AllowEditing="False" FieldName="Stats.ProgressRatio" Header="Progress Ratio %" HeaderToolTip="[(Total Earned - Total Planned) / Total Planned]" ReadOnly="True" VisibleIndex="17">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings Mask="p2" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                    </dxg:GridControlBand>
                                </dxg:GridControl.Bands>
                                <dxg:GridControl.View>
                                    <dxg:TableView custom:GroupChildSelector.Mode="Hierarchical" AllowEditing="False" NewItemRowPosition="None" ShowTotalSummary="True" Style="{StaticResource DefaultTableViewTemplate}">
                                        <dxg:TableView.RowCellMenuCustomizations>
                                            <dxb:BarButtonItem Name="contextMenuCopyWithHeader" Command="{Binding DataContext.CopyWithHeaderCommand, ElementName=userControl}" Content="Copy With Headers" Glyph="{dx:DXImageOffice2013 Image=AlignHorizontalTop_16x16.png}" ToolTip="Copy selected rows along with header" />
                                        </dxg:TableView.RowCellMenuCustomizations>
                                    </dxg:TableView>
                                </dxg:GridControl.View>
                            </custom:GridControlEx>
                        </dxlc:LayoutGroup>
                        <dx:LoadingDecorator IsSplashScreenShown="{Binding DataContext.IsLoading, ElementName=userControl}">
                            <dxlc:LayoutGroup Name="LayoutGroupChart" DataContext="{Binding DataContext, ElementName=userControl, Mode=OneWay, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}" Orientation="Vertical" View="Group">
                                <dxc:ChartControl x:Name="ChartControl" Grid.Row="2" Margin="0" Padding="0" dx:DXSerializer.Enabled="False" AnimationMode="OnLoad" AutoLayout="False" DataContext="{Binding DataContext, ElementName=userControl, Mode=OneWay, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}">
                                    <dxc:XYDiagram2D AllowSeriesBitmapCaching="False" SeriesItemsSource="{StaticResource dashboardXYChartSeries}">
                                        <dxc:XYDiagram2D.AxisX>
                                            <dxc:AxisX2D>
                                                <dxc:AxisX2D.Label>
                                                    <dxc:AxisLabel>
                                                        <dxc:Axis2D.ResolveOverlappingOptions>
                                                            <dxc:AxisLabelResolveOverlappingOptions AllowRotate="True" AllowStagger="True" />
                                                        </dxc:Axis2D.ResolveOverlappingOptions>
                                                    </dxc:AxisLabel>
                                                </dxc:AxisX2D.Label>
                                            </dxc:AxisX2D>
                                        </dxc:XYDiagram2D.AxisX>
                                        <dxc:XYDiagram2D.AxisY>
                                            <dxc:AxisY2D x:Name="primaryAxisY">
                                                <dxc:AxisY2D.Title>
                                                    <dxc:AxisTitle Content="{Binding DataContext.AxisYPrimaryLabel, ElementName=userControl}" />
                                                </dxc:AxisY2D.Title>
                                            </dxc:AxisY2D>
                                        </dxc:XYDiagram2D.AxisY>
                                        <dxc:XYDiagram2D.SecondaryAxesY>
                                            <dxc:SecondaryAxisY2D x:Name="secondaryAxisY">
                                                <dxc:SecondaryAxisY2D.Title>
                                                    <dxc:AxisTitle Content="{Binding DataContext.AxisYSecondaryLabel, ElementName=userControl}" />
                                                </dxc:SecondaryAxisY2D.Title>
                                                <dxc:SecondaryAxisY2D.Label>
                                                    <dxc:AxisLabel TextPattern="{Binding DataContext.AxisYSecondaryTextPattern, ElementName=userControl}" />
                                                </dxc:SecondaryAxisY2D.Label>
                                            </dxc:SecondaryAxisY2D>
                                        </dxc:XYDiagram2D.SecondaryAxesY>
                                    </dxc:XYDiagram2D>
                                    <dxc:ChartControl.Legend>
                                        <dxc:Legend UseCheckBoxes="True" />
                                    </dxc:ChartControl.Legend>
                                </dxc:ChartControl>
                            </dxlc:LayoutGroup>
                        </dx:LoadingDecorator>
                    </dxlc:LayoutControl>
                </DockPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
