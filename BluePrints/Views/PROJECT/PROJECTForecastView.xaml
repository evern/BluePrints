                                                </dxlc:LayoutItem>
                                                <dxlc:LayoutItem Label="EAC %" LabelPosition="Left">
                                                    <dxe:TextEdit IsReadOnly="True" Mask="p2" MaskType="Numeric" MaskUseAsDisplayFormat="True" Foreground="Black" Background="{Binding ForecastSummary.OriginalEAC_Margin_Percent_Background}" Text="{Binding ForecastSummary.OriginalEAC_Margin_Percent, Mode=OneWay}" />
                                                </dxlc:LayoutItem>
                                            </dxlc:LayoutGroup>
                                            <dxlc:LayoutGroup Header="PF Influenced" View="GroupBox" Orientation="Vertical">
                                                <dxlc:LayoutItem Label="EAC Cost" LabelPosition="Left" ToolTip="Actuals + Commitments + Uncommitted Forecasts">
                                                    <dxe:TextEdit IsReadOnly="True" Mask="c0" MaskType="Numeric" MaskUseAsDisplayFormat="True" Text="{Binding ForecastSummary.CurrentEstimateAtCompletion, Mode=OneWay}" />
                                                </dxlc:LayoutItem>
                                                <dxlc:LayoutItem Label="EAC Margin" LabelPosition="Left">
                                                    <dxe:TextEdit IsReadOnly="True" Mask="c0" MaskType="Numeric" MaskUseAsDisplayFormat="True" Foreground="Black" Background="{Binding ForecastSummary.CurrentEAC_Margin_Background}" Text="{Binding ForecastSummary.CurrentEAC_Margin, Mode=OneWay}" />
                                                </dxlc:LayoutItem>
                                                <dxlc:LayoutItem Label="EAC %" LabelPosition="Left">
                                                    <dxe:TextEdit IsReadOnly="True" Mask="p2" MaskType="Numeric" MaskUseAsDisplayFormat="True" Foreground="Black" Background="{Binding ForecastSummary.CurrentEAC_Margin_Percent_Background}" Text="{Binding ForecastSummary.CurrentEAC_Margin_Percent, Mode=OneWay}" />
                                                </dxlc:LayoutItem>
                                            </dxlc:LayoutGroup>
                                        </dxlc:LayoutGroup>
                                        <dxlc:LayoutGroup Orientation="Vertical" Header="Previous" View="GroupBox" >
