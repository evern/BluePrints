                                                <dxe:TextEdit IsReadOnly="True" Mask="c0" MaskType="Numeric" MaskUseAsDisplayFormat="True" Text="{Binding ForecastSummary.Prev_EAC_Revenue, Mode=OneWay}" />
                                            </dxlc:LayoutItem>
                                            <dxlc:LayoutItem Label="EAC Cost" LabelPosition="Left" ToolTip="Actuals + Commitments + Uncommitted Forecasts">
                                                <dxe:TextEdit IsReadOnly="True" Mask="c0" MaskType="Numeric" MaskUseAsDisplayFormat="True" Text="{Binding ForecastSummary.Prev_Total_EAC, Mode=OneWay}" />
                                            </dxlc:LayoutItem>
                                            <dxlc:LayoutItem Label="EAC Margin" LabelPosition="Left">
                                                <dxe:TextEdit IsReadOnly="True" Mask="c0" MaskType="Numeric" MaskUseAsDisplayFormat="True" Text="{Binding ForecastSummary.Prev_EAC_Margin, Mode=OneWay}" />
                                            </dxlc:LayoutItem>
                                            <dxlc:LayoutItem Label="EAC %" LabelPosition="Left">
                                                <dxe:TextEdit IsReadOnly="True" Mask="p2" MaskType="Numeric" MaskUseAsDisplayFormat="True" Foreground="Black" Text="{Binding ForecastSummary.Prev_EAC_Margin_Percent, Mode=OneWay}" />
                                            </dxlc:LayoutItem>
                                        </dxlc:LayoutGroup>
                                        <dxlc:LayoutGroup Orientation="Vertical" Header="Claims" View="GroupBox">
