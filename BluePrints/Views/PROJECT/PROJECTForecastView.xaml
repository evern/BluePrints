                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:TextEditSettings Mask="c0" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                                </dxg:GridColumn.EditSettings>
                                            </dxg:GridColumn>
                                            <!--<dxg:GridColumn FieldName="Entity.Invoiced" Fixed="Left" Header="Invoiced" HeaderToolTip="Actual Revenue is amount paid to Primero to date" ReadOnly="True" Visible="True" VisibleIndex="85">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings Mask="c0" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>-->
                                            <dxg:GridColumn Width="40" AllowBestFit="False" FieldName="Entity.PctComplete" Fixed="Left" Header="% Complete" HeaderToolTip="(Budgeted Units - Remaining Units)/ Budgeted Units" ReadOnly="True" VisibleIndex="87">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:TextEditSettings Mask="p0" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                                </dxg:GridColumn.EditSettings>
                                            </dxg:GridColumn>
