                                            </dxlc:LayoutItem>
                                            <dxlc:LayoutItem Label="EAC %" LabelPosition="Left">
                                                <dxe:TextEdit IsReadOnly="True" Mask="p0" MaskType="Numeric" MaskUseAsDisplayFormat="True" Background="{Binding DataContext.ForecastSummary.EAC_Margin_Percent_Background, ElementName=userControl}" Text="{Binding DataContext.ForecastSummary.EAC_Margin_Percent, ElementName=userControl, Mode=OneWay}" />
                                            </dxlc:LayoutItem>
