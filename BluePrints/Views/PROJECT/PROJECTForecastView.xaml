                                            <dxlc:LayoutItem Label="Total Claims less Total Costs" LabelPosition="Left">
                                                <dxe:TextEdit IsReadOnly="True" Mask="c0" MaskType="Numeric" MaskUseAsDisplayFormat="True" Foreground="Black" Background="{Binding ForecastSummary.UnderOverClaim_Background}" Text="{Binding ForecastSummary.UnderOverClaim, Mode=OneWay}" />
                                            </dxlc:LayoutItem>
                                        </dxlc:LayoutGroup>
                                        <dxlc:LayoutGroup Orientation="Vertical" Header="Total Unapproved Variation" View="GroupBox">
                                            <dxlc:LayoutItem Label="Total Unapproved Variation" LabelPosition="Left">
                                                <dxe:SpinEdit Style="{StaticResource SingleObjectView.SpinEditControlContainer}" NullValueButtonPlacement="EditBox" Tag="TOTAL_UNAPPROVED_VAR_REVENUE" Mask="c0" MaskType="Numeric" MaskUseAsDisplayFormat="True" EditValue="{Binding ForecastSummary.Total_Unapproved_Var_Revenue, Mode=OneWay}" />
                                            </dxlc:LayoutItem>
                                            <dxlc:LayoutItem>
                                                <dxe:CheckEdit Content="Manual" IsChecked="{Binding IsManualRevisedVariationRevenue, Mode=OneWay}" ToolTip="Total unapproved variation is manual" />
                                            </dxlc:LayoutItem>
                                        </dxlc:LayoutGroup>
                                    </dxlc:LayoutControl>
                                </dx:LoadingDecorator>
                            </dxdo:LayoutPanel>
                        </dxdo:LayoutGroup>
                    </dxdo:LayoutGroup>
                </dxdo:DockLayoutManager>
            </DockPanel>
        </dxb:BarManager>
