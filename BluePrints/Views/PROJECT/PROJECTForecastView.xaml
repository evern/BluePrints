                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:TextEditSettings Mask="c0" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                                </dxg:GridColumn.EditSettings>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn Width="50" AllowBestFit="False" FieldName="Entity.ActualUnits" Fixed="Left" Header="Actual Units" HeaderToolTip="Actual units to date" ReadOnly="True" VisibleIndex="75">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:TextEditSettings Mask="n0" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                                </dxg:GridColumn.EditSettings>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn Width="50" AllowBestFit="False" FieldName="Entity.P6RemainingUnits" Fixed="Left" Header="P6 Remaining Units" HeaderToolTip="P6 remaining units" ReadOnly="True" VisibleIndex="76">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:TextEditSettings Mask="n0" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                                </dxg:GridColumn.EditSettings>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn Width="50" AllowBestFit="False" FieldName="Entity.P6RemainingUnitsOverride" Fixed="Left" Header="P6 Override" HeaderToolTip="P6 remaining units" ReadOnly="True" VisibleIndex="77">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:TextEditSettings Mask="n0" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                                </dxg:GridColumn.EditSettings>
                                            </dxg:GridColumn>
