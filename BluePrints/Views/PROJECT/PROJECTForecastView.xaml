                                <dxb:BarButtonItem Command="{Binding DataContext.ImportSheetCommand, ElementName=userControl}" Content="Import" Glyph="{dx:DXImage Image=SaveTo_16x16.png}" LargeGlyph="{dx:DXImage Image=SaveTo_32x32.png}" ToolTip="Import the spreadsheet that was exported from here" />
                                <!--<dxb:BarButtonItem Command="{Binding DataContext.ExportToPDFCommand, ElementName=userControl}" Content="Export" Glyph="{dx:DXImage Image=ExportToPDF_16x16.png}" LargeGlyph="{dx:DXImage Image=ExportToPDF_32x32.png}" RibbonStyle="SmallWithText" ToolTip="Export current view to PDF.Includes grouping, sorting and column visibility preferences" />-->
                                <dxb:BarButtonItem Command="{Binding DataContext.SaveEACCommand, ElementName=userControl}" Content="Save EAC" Glyph="{dxc:DXImage Image=Save_16x16.png}" LargeGlyph="{dxc:DXImage Image=Save_32x32.png}" ToolTip="Save current EAC to compare next time" />
                                <dxb:BarStaticItem Content="Start Date" Glyph="{dxc:DXImage Image=AlignVerticalLeft2_16x16.png}" LargeGlyph="{dxc:DXImage Image=AlignVerticalLeft2_32x32.png}" />
