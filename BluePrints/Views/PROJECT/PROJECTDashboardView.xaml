<UserControl x:Class="BluePrints.Views.PROJECTDashboardView" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:common="clr-namespace:BluePrints.Common" xmlns:converter="clr-namespace:BluePrints.Common.ViewModel.Converters" xmlns:custom="clr-namespace:BaseModel.Misc;assembly=BaseModel" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/charts" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon" xmlns:dxrudex="http://schemas.devexpress.com/winfx/2008/xaml/reports/userdesignerextensions" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:services="clr-namespace:BaseModel.ViewModel.Services;assembly=BaseModel" xmlns:viewmodel="clr-namespace:BluePrints.ViewModels" x:Name="userControl" d:DesignHeight="1200" d:DesignWidth="1200" DataContext="{dxmvvm:ViewModelSource viewmodel:PROJECTDashboardViewModelWrapper}" mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <dxmvvm:BooleanNegationConverter x:Key="BooleanNegationConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BaseModel;component/View/ResourceDictionaries/DefaultControlResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/ChartResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/GridColumnResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/CustomControlResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/DefaultBluePrintsResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Style="{StaticResource DashboardView.RootContainer}">
        <Grid DataContext="{Binding MainViewModel}">
            <dxb:BarManager>
                <dxb:BarManager.Items>
                    <dxb:BarButtonItem x:Name="biCheckUnits" Command="{Binding DataContext.ChangeStatsTypeCommand, ElementName=userControl}" CommandParameter="{Binding Mode=OneWay, RelativeSource={RelativeSource Self}}" Content="Units" Glyph="{dx:DXImageOffice2013 Image=Time_16x16.png}" LargeGlyph="{dx:DXImageOffice2013 Image=Time_32x32.png}" ToolTip="S-Curve shows by units" />
                    <dxb:BarButtonItem x:Name="biCheckCosts" Command="{Binding DataContext.ChangeStatsTypeCommand, ElementName=userControl}" CommandParameter="{Binding Mode=OneWay, RelativeSource={RelativeSource Self}}" Content="Costs" Glyph="{dx:DXImageOffice2013 Image=Currency_32x32.png}" LargeGlyph="{dx:DXImageOffice2013 Image=Currency_32x32.png}" ToolTip="S-Curve shows by costs" />
                    <dxb:BarButtonItem x:Name="biCheckQty" Command="{Binding DataContext.ChangeStatsTypeCommand, ElementName=userControl}" CommandParameter="{Binding Mode=OneWay, RelativeSource={RelativeSource Self}}" Content="Qty" Glyph="{dx:DXImage Image=Number_16x16.png}" LargeGlyph="{dx:DXImage Image=Number_32x32.png}" ToolTip="S-Curve shows by quantity" />
                    <dxb:BarButtonItem x:Name="biRefreshFromP6" Command="{Binding DataContext.Refresh_From_P6Command, ElementName=userControl}" Content="Calculate Stats" Glyph="{dx:DXImage Image=Reset2_16x16.png}" LargeGlyph="{dx:DXImage Image=Reset2_32x32.png}" ToolTip="Recalculate stats from P6. Must be performed after pressing F9 in P6" />
                    <dxb:BarButtonItem x:Name="biShowP6Error" Command="{Binding DataContext.ShowP6ErrorsCommand, ElementName=userControl}" Content="P6 Issues" Glyph="{dx:DXImageOffice2013 Image=BugReport_16x16.png}" LargeGlyph="{dx:DXImage Image=BugReport_32x32.png}" ToolTip="Shows any invalid mappings because activity isn't found on P6" />
                    <dxb:BarButtonItem x:Name="biShowExoError" Command="{Binding DataContext.ShowExoErrorsCommand, ElementName=userControl}" Content="Exo Issues" Glyph="{dx:DXImageOffice2013 Image=BugReport_16x16.png}" LargeGlyph="{dx:DXImage Image=BugReport_32x32.png}" ToolTip="Shows any subjobs in exo that isn't available in blueprints" />
                </dxb:BarManager.Items>
                <DockPanel>
                    <dxr:RibbonControl MDIMergeStyle="WhenChildActivated" AllowCustomization="False" DockPanel.Dock="Top" RibbonStyle="OfficeSlim">
                        <dxr:RibbonDefaultPageCategory MergeType="Replace" Caption="defaultCategory">
                            <dxr:RibbonPage MergeType="Replace" Caption="Grid">
                                <dxr:RibbonPageGroup MergeType="Replace" Caption="Tools">
                                    <dxb:BarButtonItemLink BarItemName="biCheckUnits" />
                                    <dxb:BarButtonItemLink BarItemName="biCheckCosts" />
                                    <dxb:BarButtonItemLink BarItemName="biCheckQty" />
                                    <dxb:BarButtonItemLink BarItemName="biRefreshFromP6" />
                                    <dxb:BarButtonItemLink BarItemName="biShowP6Error" />
                                    <dxb:BarButtonItemLink BarItemName="biShowExoError" />
                                </dxr:RibbonPageGroup>
                            </dxr:RibbonPage>
                        </dxr:RibbonDefaultPageCategory>
                    </dxr:RibbonControl>
                    <dxr:RibbonStatusBarControl DockPanel.Dock="Bottom">
                        <dxr:RibbonStatusBarControl.LeftItems>
                            <dxb:BarStaticItem Content="{Binding DataContext.DisplayEntities.Count, ElementName=userControl, Converter={dxmvvm:FormatStringConverter FormatString='RECORDS: {0}'}}" />
                        </dxr:RibbonStatusBarControl.LeftItems>
                    </dxr:RibbonStatusBarControl>
                    <dxlc:LayoutControl Orientation="Vertical">
                        <dxmvvm:Interaction.Behaviors>
                            <dxmvvm:LayoutSerializationService />
                        </dxmvvm:Interaction.Behaviors>
                        <dxlc:LayoutGroup Name="LayoutGroupGrid" Height="500" dxlc:LayoutControl.AllowVerticalSizing="True" Header="Edit Value" Orientation="Vertical" View="Group">
                            <custom:GridControlEx x:Name="GridControl" dx:DXSerializer.SerializationID="GridControlMultiProjectDashboard" dx:DXSerializer.StoreLayoutMode="All" BandsSource="{StaticResource DashboardBands}" IsFilterEnabled="False" SelectedItems="{Binding DataContext.Selected_Dashboards, Mode=TwoWay, ElementName=userControl}" Style="{StaticResource DefaultGridControlTemplate}">
                                <dxg:GridControl.DetailDescriptor>
                                    <dxg:DataControlDetailDescriptor ItemsSourceBinding="{Binding Subjob_TreeDashboards}">
                                        <dxg:GridControl x:Name="detailSubjobDashboardGridControl" dx:DXSerializer.SerializationID="GridControlDetailSubjobDashboard" BandsSource="{StaticResource DashboardChildBands}" SelectedItems="{Binding DataContext.Selected_Dashboards, Mode=TwoWay, ElementName=userControl}" SelectionMode="Row">
                                            <dxg:GridControl.View>
                                                <dxg:TableView x:Name="detailSubjobDashboardTableView" AllowEditing="False" IsDetailButtonVisibleBinding="{Binding Row.IHave_ChildDashboard}" NewItemRowPosition="None" RowStyle="{StaticResource WBSBackgroundStyle}" ShowGroupPanel="False" />
                                            </dxg:GridControl.View>
                                            <dxg:GridControl.DetailDescriptor>
                                                <dxg:DataControlDetailDescriptor ItemsSourceBinding="{Binding Child_Dashboards}">
                                                    <dxg:GridControl x:Name="detailDepartmentDashboardGridControl" dx:DXSerializer.SerializationID="GridControlDetailDepartmentDashboard" BandsSource="{StaticResource DashboardChildBands}" SelectedItems="{Binding DataContext.Selected_Dashboards, Mode=TwoWay, ElementName=userControl}" SelectionMode="Row">
                                                        <dxg:GridControl.View>
                                                            <dxg:TableView x:Name="detailDepartmentDashboardTableView" AllowEditing="False" IsDetailButtonVisibleBinding="{Binding Row.IHave_ChildDashboard}" NewItemRowPosition="None" RowStyle="{StaticResource WBSBackgroundStyle}" ShowBandsPanel="False" ShowColumnHeaders="False" ShowGroupPanel="False" />
                                                        </dxg:GridControl.View>
                                                        <dxg:GridControl.DetailDescriptor>
                                                            <dxg:DataControlDetailDescriptor ItemsSourceBinding="{Binding Child_Dashboards}">
                                                                <dxg:GridControl x:Name="detailDisciplineDashboardGridControl" dx:DXSerializer.SerializationID="GridControlDetailDisciplineDashboard" BandsSource="{StaticResource DashboardChildBands}" SelectedItems="{Binding DataContext.Selected_Dashboards, Mode=TwoWay, ElementName=userControl}" SelectionMode="Row">
                                                                    <dxg:GridControl.View>
                                                                        <dxg:TableView x:Name="detailDisciplineDashboardTableView" AllowEditing="False" IsDetailButtonVisibleBinding="{Binding Row.IHave_ChildDashboard}" NewItemRowPosition="None" RowStyle="{StaticResource WBSBackgroundStyle}" ShowBandsPanel="False" ShowColumnHeaders="False" ShowGroupPanel="False" />
                                                                    </dxg:GridControl.View>
                                                                    <dxg:GridControl.DetailDescriptor>
                                                                        <dxg:DataControlDetailDescriptor ItemsSourceBinding="{Binding Child_Dashboards}">
                                                                            <dxg:GridControl x:Name="detailCommodityDashboardGridControl" dx:DXSerializer.SerializationID="GridControlDetailCommodityDashboard" BandsSource="{StaticResource DashboardChildBands}" SelectedItems="{Binding DataContext.Selected_Dashboards, Mode=TwoWay, ElementName=userControl}" SelectionMode="Row">
                                                                                <dxg:GridControl.View>
                                                                                    <dxg:TableView x:Name="detailCommodityDashboardTableView" AllowEditing="False" IsDetailButtonVisibleBinding="{Binding Row.IHave_ChildDashboard}" NewItemRowPosition="None" RowStyle="{StaticResource WBSBackgroundStyle}" ShowBandsPanel="False" ShowColumnHeaders="False" ShowGroupPanel="False" />
                                                                                </dxg:GridControl.View>
                                                                            </dxg:GridControl>
                                                                        </dxg:DataControlDetailDescriptor>
                                                                    </dxg:GridControl.DetailDescriptor>
                                                                </dxg:GridControl>
                                                            </dxg:DataControlDetailDescriptor>
                                                        </dxg:GridControl.DetailDescriptor>
                                                    </dxg:GridControl>
                                                </dxg:DataControlDetailDescriptor>
                                            </dxg:GridControl.DetailDescriptor>
                                        </dxg:GridControl>
                                    </dxg:DataControlDetailDescriptor>
                                </dxg:GridControl.DetailDescriptor>
                                <dxg:GridControl.View>
                                    <dxg:TableView x:Name="tableView" AllowEditing="False" ScrollBarAnnotationMode="None" IsDetailButtonVisibleBinding="{Binding Row.IHaveSubjob_Dashboards}" NewItemRowPosition="None" ShowGroupPanel="False" ShowTotalSummary="True" Style="{StaticResource DefaultTableViewTemplate}" UseLightweightTemplates="{x:Null}" />
                                </dxg:GridControl.View>
                                <dxg:GridControl.TotalSummary>
                                    <dxg:GridSummaryItem x:Name="totalSummaryBudgeted" dx:DXSerializer.Enabled="False" DisplayFormat="{}{0:n}" FieldName="Stats.Budgeted.CurrentPeriodCumulativeDataPoint.Units" ShowInColumn="Stats.Budgeted.CurrentPeriodCumulativeDataPoint.Units" SummaryType="Sum" />
                                    <dxg:GridSummaryItem x:Name="totalSummaryCumulativeEarned" dx:DXSerializer.Enabled="False" DisplayFormat="{}{0:n}" FieldName="Stats.Earned.CurrentPeriodCumulativeDataPoint.Units" ShowInColumn="Stats.Earned.CurrentPeriodCumulativeDataPoint.Units" SummaryType="Sum" />
                                    <dxg:GridSummaryItem x:Name="totalSummaryCumulativeBurned" dx:DXSerializer.Enabled="False" DisplayFormat="{}{0:n}" FieldName="Stats.Burned.CurrentPeriodCumulativeDataPoint.Units" ShowInColumn="Stats.Burned.CurrentPeriodCumulativeDataPoint.Units" SummaryType="Sum" />
                                    <dxg:GridSummaryItem x:Name="totalSummaryCumulativeActual" dx:DXSerializer.Enabled="False" DisplayFormat="{}{0:n}" FieldName="Stats.Actual.CurrentPeriodCumulativeDataPoint.Units" ShowInColumn="Stats.Actual.CurrentPeriodCumulativeDataPoint.Units" SummaryType="Sum" Visible="{Binding DataContext.IsActualVisible, ElementName=userControl}" />
                                    <dxg:GridSummaryItem x:Name="totalSummaryPeriodPlanned" dx:DXSerializer.Enabled="False" DisplayFormat="{}{0:n}" FieldName="Stats.Budgeted.CurrentPeriodDataPoint.Units" ShowInColumn="Stats.Budgeted.CurrentPeriodDataPoint.Units" SummaryType="Sum" />
                                    <dxg:GridSummaryItem x:Name="totalSummaryPeriodEarned" dx:DXSerializer.Enabled="False" DisplayFormat="{}{0:n}" FieldName="Stats.Earned.CurrentPeriodDataPoint.Units" ShowInColumn="Stats.Earned.CurrentPeriodDataPoint.Units" SummaryType="Sum" />
                                    <dxg:GridSummaryItem x:Name="totalSummaryPeriodBurned" dx:DXSerializer.Enabled="False" DisplayFormat="{}{0:n}" FieldName="Stats.Burned.CurrentPeriodDataPoint.Units" ShowInColumn="Stats.Burned.CurrentPeriodDataPoint.Units" SummaryType="Sum" />
                                    <dxg:GridSummaryItem x:Name="totalSummaryPeriodActual" dx:DXSerializer.Enabled="False" DisplayFormat="{}{0:n}" FieldName="Stats.Actual.CurrentPeriodDataPoint.Units" ShowInColumn="Stats.Actual.CurrentPeriodDataPoint.Units" SummaryType="Sum" Visible="{Binding DataContext.IsActualVisible, ElementName=userControl}" />
                                </dxg:GridControl.TotalSummary>
                            </custom:GridControlEx>
                        </dxlc:LayoutGroup>
                        <dxlc:LayoutGroup Name="LayoutGroupChart" DataContext="{Binding DataContext, ElementName=userControl, Mode=OneWay, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}" Orientation="Vertical" View="Group">
                            <dxc:ChartControl Name="chartSCurve" Margin="0" Padding="0" dx:DXSerializer.Enabled="False" AutoLayout="False">
                                <dxc:XYDiagram2D SeriesItemsSource="{StaticResource dashboardXYChartSeries}">
                                    <dxc:XYDiagram2D.AxisX>
                                        <dxc:AxisX2D>
                                            <dxc:AxisX2D.Label>
                                                <dxc:AxisLabel>
                                                    <dxc:Axis2D.ResolveOverlappingOptions>
                                                        <dxc:AxisLabelResolveOverlappingOptions AllowRotate="True" AllowStagger="True" />
                                                    </dxc:Axis2D.ResolveOverlappingOptions>
                                                </dxc:AxisLabel>
                                            </dxc:AxisX2D.Label>
                                        </dxc:AxisX2D>
                                    </dxc:XYDiagram2D.AxisX>
                                    <dxc:XYDiagram2D.AxisY>
                                        <dxc:AxisY2D x:Name="primaryAxisY">
                                            <dxc:AxisY2D.Title>
                                                <dxc:AxisTitle Content="{Binding DataContext.AxisYPrimaryLabel, ElementName=userControl}" />
                                            </dxc:AxisY2D.Title>
                                        </dxc:AxisY2D>
                                    </dxc:XYDiagram2D.AxisY>
                                    <dxc:XYDiagram2D.SecondaryAxesY>
                                        <dxc:SecondaryAxisY2D x:Name="secondaryAxisY">
                                            <dxc:SecondaryAxisY2D.Title>
                                                <dxc:AxisTitle Content="{Binding DataContext.AxisYSecondaryLabel, ElementName=userControl}" />
                                            </dxc:SecondaryAxisY2D.Title>
                                            <dxc:SecondaryAxisY2D.Label>
                                                <dxc:AxisLabel TextPattern="{}{V:0%}" />
                                            </dxc:SecondaryAxisY2D.Label>
                                        </dxc:SecondaryAxisY2D>
                                    </dxc:XYDiagram2D.SecondaryAxesY>
                                </dxc:XYDiagram2D>
                                <dxc:ChartControl.Legend>
                                    <dxc:Legend UseCheckBoxes="True" />
                                </dxc:ChartControl.Legend>
                            </dxc:ChartControl>
                        </dxlc:LayoutGroup>
                    </dxlc:LayoutControl>
                </DockPanel>
            </dxb:BarManager>
        </Grid>
    </Grid>
</UserControl>