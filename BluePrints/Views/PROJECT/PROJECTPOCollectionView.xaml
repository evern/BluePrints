                            <dxg:GridColumn FieldName="Costs" Header="Total $" ReadOnly="True" VisibleIndex="100" >
                                <dxg:GridColumn.EditSettings>
                                    <dxe:SpinEditSettings Mask="c0" MaskType="Numeric" MaskUseAsDisplayFormat="True" MinValue="0" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                        </dxg:GridControlBand>
                    </dxg:GridControl.Bands>-->
                    <dxg:GridControl.View>
                        <dxg:TableView x:Name="tableView" GroupSummaryDisplayMode="AlignByColumns" NewItemRowPosition="None" Style="{StaticResource DefaultTableViewTemplate}" >
                            <dxg:TableView.RowCellMenuCustomizations>
                                <dxb:BarButtonItemLink BarItemName="biCopyWithHeader1" />
                                <dxb:BarButtonItem x:Name="biLocalExportToExcel" Command="{Binding ExportToExcelCommand}" Content="Export All" Glyph="{dx:DXImage Image=ExportToXLSX_16x16.png}" LargeGlyph="{dx:DXImage Image=ExportToXLSX_32x32.png}" RibbonStyle="SmallWithText" ToolTip="Export all datapoints to excel" />
