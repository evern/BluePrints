<UserControl x:Class="BluePrints.Views.PROJECTSummaryView" xmlns:dxp="http://schemas.devexpress.com/winfx/2008/xaml/printing" xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/presentation" xmlns:common="clr-namespace:BluePrints.Common" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:behavior="clr-namespace:BaseModel.View.Behaviors;assembly=BaseModel" xmlns:converter="clr-namespace:BluePrints.Common.ViewModel.Converters" xmlns:custom="clr-namespace:BaseModel.Misc;assembly=BaseModel" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon" xmlns:dxrudex="http://schemas.devexpress.com/winfx/2008/xaml/reports/userdesignerextensions" xmlns:filter="clr-namespace:BluePrints.Common.Filtering" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:services="clr-namespace:BaseModel.ViewModel.Services;assembly=BaseModel" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:view="clr-namespace:BluePrints.Views" xmlns:viewmodel="clr-namespace:BluePrints.ViewModels" x:Name="userControl" d:DesignHeight="400" d:DesignWidth="1200" DataContext="{dxmvvm:ViewModelSource viewmodel:PROJECTSummaryViewModelWrapper}" mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <converter:ProjectSummaryCellColorConverter x:Key="ProjectSummaryCellColorConverter" />
            <converter:ProjectSummaryCellReadOnlyConverter x:Key="ProjectSummaryCellReadOnlyConverter" />
            <Style x:Key="BackgroundStyle" BasedOn="{StaticResource {dxgt:GridRowThemeKey ResourceKey=CellStyle}}" TargetType="{x:Type dxg:CellContentPresenter}">
                <Setter Property="Background" >
                    <Setter.Value>
                        <MultiBinding Converter="{StaticResource ProjectSummaryCellColorConverter}">
                            <Binding Path="RowData.Row.Row" />
                            <Binding Path="Column.FieldName" />
                        </MultiBinding>
                    </Setter.Value>
                </Setter>
                <Setter Property="Height" Value="75" />
            </Style>
            <DataTemplate x:Key="projectSummaryCellTemplate">
                <dxe:SpinEdit Name="PART_Editor" Mask="{Binding RowData.Row.Entity.Mask}" MaskType="Numeric" MaskUseAsDisplayFormat="True" Increment="100" MinValue="0" >
                    <dxe:SpinEdit.Background>
                        <MultiBinding Converter="{StaticResource ProjectSummaryCellColorConverter}">
                            <Binding Path="RowData.Row.Row" />
                            <Binding Path="Column.FieldName" />
                        </MultiBinding>
                    </dxe:SpinEdit.Background>
                    <dxe:SpinEdit.IsReadOnly>
                        <MultiBinding Converter="{StaticResource ProjectSummaryCellReadOnlyConverter}">
                            <Binding Path="RowData.Row.Row" />
                            <Binding Path="Column.FieldName" />
                        </MultiBinding>
                    </dxe:SpinEdit.IsReadOnly>
                </dxe:SpinEdit>
            </DataTemplate>
            <converter:DataPointsTableFieldNameConverter x:Key="DataPointsTableFieldNameConverter" />
            <dxmvvm:BooleanNegationConverter x:Key="BooleanNegationConverter" />
            <DataTemplate x:Key="columnHeaderTemplate">
                <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
            </DataTemplate>
            <Style TargetType="{x:Type dxg:RowControl}">
                <Setter Property="Height" Value="75" />
            </Style>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/DefaultBluePrintsResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/BaseModel;component/View/ResourceDictionaries/DefaultControlResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/ConverterResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Style="{StaticResource CollectionView.RootContainer}">
        <dxmvvm:Interaction.Behaviors>
            <dxc:FilteringBehavior x:Name="filteringBehavior" SourceType="{x:Type viewmodel:CostFilteringViewModel}" />
            <dxc:DialogService x:Name="DistributionDialogService">
                <dxc:DialogService.DialogStyle>
                    <Style TargetType="dx:DXDialogWindow">
                        <Setter Property="SizeToContent" Value="WidthAndHeight" />
                    </Style>
                </dxc:DialogService.DialogStyle>
            </dxc:DialogService>
            <dxmvvm:OpenFileDialogService RestorePreviouslySelectedDirectory="True" />
        </dxmvvm:Interaction.Behaviors>
        <Grid DataContext="{Binding MainViewModel}">
            <DockPanel>
                <dxr:RibbonControl Style="{StaticResource DefaultRibbonControlStyle}">
                    <dxr:RibbonDefaultPageCategory MergeType="Replace" Caption="defaultCategory">
                        <dxr:RibbonPage MergeType="Replace" Caption="Grid">
                            <dxr:RibbonPageGroup>
                                <dxb:BarButtonItem Command="{Binding DataContext.FullRefreshCommand, ElementName=userControl}" Content="Refresh" Glyph="{dx:DXImage Image=Refresh_16x16.png}" LargeGlyph="{dx:DXImage Image=Refresh_32x32.png}" ToolTip="Refresh table with updated data. Also clears any undo redo entries" />
                                <dxb:BarButtonItem Command="{Binding DataContext.UndoCommand, ElementName=userControl}" Content="Undo" Glyph="{dx:DXImage Image=Undo_16x16.png}" LargeGlyph="{dx:DXImage Image=Undo_32x32.png}" ToolTip="Undo last action" />
                                <dxb:BarButtonItem Command="{Binding DataContext.RedoCommand, ElementName=userControl}" Content="Redo" Glyph="{dx:DXImage Image=Redo_16x16.png}" LargeGlyph="{dx:DXImage Image=Redo_32x32.png}" ToolTip="Redo undone action" />
                                <dxb:BarButtonItem Command="{Binding DataContext.ExpandAllGroupsCommand, ElementName=userControl}" Content="Expand All" Glyph="{dx:DXImage Image=ExpandFieldPivotTable_16x16.png}" LargeGlyph="{dx:DXImage Image=ExpandFieldPivotTable_32x32.png}" RibbonStyle="SmallWithText" ToolTip="Expand All, only works when grid is grouped" />
                                <dxb:BarButtonItem Command="{Binding DataContext.CollapseAllGroupsCommand, ElementName=userControl}" Content="Collapse All" Glyph="{dx:DXImage Image=CollapseFieldPivotTable_16x16.png}" LargeGlyph="{dx:DXImage Image=CollapseFieldPivotTable_32x32.png}" RibbonStyle="SmallWithText" ToolTip="Collapse All, only works when grid is grouped" />
                                <!--<dxb:BarButtonItem Command="{Binding DataContext.ExpandAllMasterRowsCommand, ElementName=userControl}" Content="Expand All Rows" Glyph="{dx:DXImage Image=ExpandFieldPivotTable_16x16.png}" LargeGlyph="{dx:DXImage Image=ExpandFieldPivotTable_32x32.png}" RibbonStyle="SmallWithText" ToolTip="Expand all rows" />
                                <dxb:BarButtonItem Command="{Binding DataContext.CollapseAllMasterRowsCommand, ElementName=userControl}" Content="Collapse All Rows" Glyph="{dx:DXImage Image=CollapseFieldPivotTable_16x16.png}" LargeGlyph="{dx:DXImage Image=CollapseFieldPivotTable_32x32.png}" RibbonStyle="SmallWithText" ToolTip="Collapse all rows" />-->
                                <dxb:BarButtonItem Command="{Binding KeyboardCopyCommand}" Content="Copy" Glyph="{dx:DXImage Image=Copy_16x16.png}" LargeGlyph="{dx:DXImage Image=Copy_32x32.png}" ToolTip="Ctrl + C" />
                                <dxb:BarButtonItem Command="{Binding KeyboardPasteCommand}" Content="Paste" Glyph="{dx:DXImage Image=Paste_16x16.png}" LargeGlyph="{dx:DXImage Image=Paste_32x32.png}" ToolTip="Ctrl + V" />
                                <dxb:BarButtonItem Command="{Binding DataContext.ExportToExcelCommand, ElementName=userControl}" Content="Export" Glyph="{dx:DXImage Image=ExportToXLSX_16x16.png}" LargeGlyph="{dx:DXImage Image=ExportToXLSX_32x32.png}" RibbonStyle="SmallWithText" ToolTip="Export current view to excel.Includes grouping, sorting and column visibility preferences" />
                                <dxb:BarItemLinkSeparator />
                                <dxb:BarStaticItem Content="Data Date" Glyph="{dxc:DXImage Image=Calendar_16x16.png}" LargeGlyph="{dxc:DXImage Image=Calendar_32x32.png}" />
                                <dxb:BarEditItem EditValue="{Binding DataContext.FixedDataDate, ElementName=userControl}" ToolTip="Data date">
                                    <dxb:BarEditItem.EditSettings>
                                        <dxe:DateEditSettings />
                                    </dxb:BarEditItem.EditSettings>
                                </dxb:BarEditItem>
                            </dxr:RibbonPageGroup>
                            <dxr:RibbonPageGroup MergeType="Replace" Caption="Report" ItemLinksSource="{StaticResource RibbonDefaultReportingButtons}" />
                        </dxr:RibbonPage>
                    </dxr:RibbonDefaultPageCategory>
                </dxr:RibbonControl>
                <dxdo:DockLayoutManager Name="dockLayoutManager" Margin="0" Padding="0" BorderThickness="0" FloatingMode="Desktop" MDIMergeStyle="WhenChildActivated">
                    <dxdo:LayoutGroup Margin="0" Padding="0" BorderThickness="0" ItemHeight="*" Orientation="Horizontal">
                        <dxdo:LayoutGroup Margin="0" Padding="0" BorderThickness="0" ItemHeight="*" Orientation="Vertical">
                            <dxdo:LayoutPanel>
                                <Grid>
                                    <dxmvvm:Interaction.Behaviors>
                                        <dxmvvm:LayoutSerializationService />
                                    </dxmvvm:Interaction.Behaviors>
                                    <dxg:GridControl x:Name="GridControl" dxc:DXSerializer.SerializationID="GridControlForecastSummary" ItemsSource="{Binding DataContext.DataPointsTable, ElementName=userControl}"  SelectedItems="{Binding DataContext.SelectedDataRows, Mode=TwoWay, ElementName=userControl}" ShowLoadingPanel="{Binding DataContext.IsLoadingForecast, ElementName=userControl}">
                                        <dxg:GridControl.Bands>
                                            <dxg:GridControlBand Visible="{Binding DataContext.ShowStats, ElementName=userControl}" Header="Design (Hours Only)">
                                                <!--<dxg:GridColumn Visible="{Binding DataContext.ShowStats, ElementName=userControl}" MaxWidth="75" CellTemplate="{StaticResource projectSummaryCellTemplate}" FieldName="Entity.Design_Budget" Header="Budget at Completion (BAC)" ReadOnly="True" />-->
                                                <dxg:GridColumn Visible="{Binding DataContext.ShowStats, ElementName=userControl}" MaxWidth="75" CellTemplate="{StaticResource projectSummaryCellTemplate}" FieldName="Entity.Design_Earned" Header="Earned Value (EV)" ReadOnly="True" />
                                                <dxg:GridColumn Visible="{Binding DataContext.ShowStats, ElementName=userControl}" MaxWidth="75" CellTemplate="{StaticResource projectSummaryCellTemplate}" FieldName="Entity.Design_Remaining" Header="Remaining Hours" ReadOnly="True" />
                                                <dxg:GridColumn Visible="{Binding DataContext.ShowStats, ElementName=userControl}" MaxWidth="75" CellTemplate="{StaticResource projectSummaryCellTemplate}" FieldName="Entity.Design_Period_Planned" Header="Planned Value (PV)" ReadOnly="True" />
                                            </dxg:GridControlBand>
                                            <dxg:GridControlBand Visible="{Binding DataContext.ShowStats, ElementName=userControl}" Header="Construction (Hours Only)">
                                                <!--<dxg:GridColumn Visible="{Binding DataContext.ShowStats, ElementName=userControl}" MaxWidth="75" CellTemplate="{StaticResource projectSummaryCellTemplate}" FieldName="Entity.Construction_Budget" Header="Budget at Completion (BAC)" />-->
                                                <dxg:GridColumn Visible="{Binding DataContext.ShowStats, ElementName=userControl}" MaxWidth="75" CellTemplate="{StaticResource projectSummaryCellTemplate}" FieldName="Entity.Construction_Earned" Header="Earned Value (EV)" />
                                                <dxg:GridColumn Visible="{Binding DataContext.ShowStats, ElementName=userControl}" MaxWidth="75" CellTemplate="{StaticResource projectSummaryCellTemplate}" FieldName="Entity.Construction_Remaining" Header="Remaining Hours" />
                                                <dxg:GridColumn Visible="{Binding DataContext.ShowStats, ElementName=userControl}" MaxWidth="75" CellTemplate="{StaticResource projectSummaryCellTemplate}" FieldName="Entity.Construction_Period_Planned" Header="Planned Value (PV)"  />
                                            </dxg:GridControlBand>
                                            <dxg:GridControlBand Header="Summary" >
                                                <dxg:GridColumn Width="150" FieldName="Entity.RowType" Header="Phase" ReadOnly="True"  >
                                                    <dxg:GridColumn.EditSettings>
                                                        <dxe:ComboBoxEditSettings AutoComplete="True" IsTextEditable="True" AllowDrop="False" AllowDefaultButton="False" ItemsSource="{dxe:EnumItemsSource EnumType={x:Type common:StaticSummaryRowTypes}, UseNumericEnumValue=False}" />
                                                    </dxg:GridColumn.EditSettings>
                                                </dxg:GridColumn>
                                                <dxg:GridColumn MaxWidth="75" CellTemplate="{StaticResource projectSummaryCellTemplate}" FieldName="Entity.Total_Budget" Header="Budget at Completion Cost (BAC)" />
                                                <dxg:GridColumn MaxWidth="75" CellTemplate="{StaticResource projectSummaryCellTemplate}" FieldName="Entity.Total_Remaining" Header="Total Remaining Hours" />
                                                <dxg:GridColumn MaxWidth="75" CellTemplate="{StaticResource projectSummaryCellTemplate}" FieldName="Entity.Total_Actuals" Header="Actual Hrs / Costs (AC) to Date" ReadOnly="True" />
                                                <dxg:GridColumn MaxWidth="75" CellTemplate="{StaticResource projectSummaryCellTemplate}" FieldName="Entity.EAC" Header="Estimate / Forecast Cost at Completion" ReadOnly="True" />
                                                <dxg:GridColumn MaxWidth="75" CellTemplate="{StaticResource projectSummaryCellTemplate}" FieldName="Entity.Total_Earned" Header="Earned Value (EV)" ReadOnly="True" />
                                                <dxg:GridColumn MaxWidth="75" CellTemplate="{StaticResource projectSummaryCellTemplate}" FieldName="Entity.Total_Period_Planned" Header="Planned Value (PV)" ReadOnly="True" />
                                                <dxg:GridColumn MaxWidth="75" CellTemplate="{StaticResource projectSummaryCellTemplate}" FieldName="Entity.Original_Contract_Value" Header="Original Contract Value" />
                                                <dxg:GridColumn MaxWidth="75" CellTemplate="{StaticResource projectSummaryCellTemplate}" FieldName="Entity.Approved_Variation" Header="Approved Variations" />
                                                <dxg:GridColumn MaxWidth="75" CellTemplate="{StaticResource projectSummaryCellTemplate}" FieldName="Entity.Unapproved_Variation" Header="Unapproved Variation ($ and hours)" />
                                                <dxg:GridColumn MaxWidth="75" FieldName="Entity.Unapproved_EOT" AllowCellMerge="True" Header="Unapproved EOT (Days)" HeaderTemplate="{StaticResource columnHeaderTemplate}">
                                                    <dxg:GridColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <dxe:SpinEdit Name="PART_Editor" Background="LightSalmon" Mask="n0" MaskType="Numeric" MaskUseAsDisplayFormat="True" Increment="10"/>
                                                        </DataTemplate>
                                                    </dxg:GridColumn.CellTemplate>
                                                </dxg:GridColumn>
                                                <dxg:GridColumn MaxWidth="75" FieldName="Entity.Contract_Completion_Date" AllowCellMerge="True" Header="Contract Completion Date (incl approved EOT)" >
                                                    <dxg:GridColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <dxe:DateEdit Name="PART_Editor" Background="LightSalmon" />
                                                        </DataTemplate>
                                                    </dxg:GridColumn.CellTemplate>
                                                </dxg:GridColumn>
                                                <dxg:GridColumn MaxWidth="75" FieldName="Entity.Forecast_Completion_Date" Header="Forecast Completion Date" ReadOnly="True" >
                                                    <dxg:GridColumn.EditSettings>
                                                        <dxe:DateEditSettings />
                                                    </dxg:GridColumn.EditSettings>
                                                </dxg:GridColumn>
                                            </dxg:GridControlBand>
                                        </dxg:GridControl.Bands>
                                        <dxg:GridControl.View>
                                            <!--<dxg:TableView x:Name="tableView" CellStyle="{StaticResource BackgroundStyle}" UseLightweightTemplates="None" NewItemRowPosition="None" ShowTotalSummary="False" >-->
                                            <dxg:TableView x:Name="tableView" ShowGroupPanel="False" NewItemRowPosition="None" ShowTotalSummary="False" >
                                                <dxmvvm:Interaction.Behaviors>
                                                    <dxmvvm:EventToCommand Command="{Binding DataContext.CellValueChangedUpdateCommand, ElementName=userControl}" EventName="CellValueChanged" PassEventArgsToCommand="True" />
                                                </dxmvvm:Interaction.Behaviors>
                                                <dxg:TableView.RowCellMenuCustomizations>
                                                    <dxb:BarButtonItem Command="{Binding DataContext.FullRefreshCommand, ElementName=userControl}" Content="Refresh" Glyph="{dx:DXImage Image=Refresh_16x16.png}" LargeGlyph="{dx:DXImage Image=Refresh_32x32.png}" ToolTip="Refresh table with updated data. Also clears any undo redo entries" />
                                                </dxg:TableView.RowCellMenuCustomizations>
                                            </dxg:TableView>
                                        </dxg:GridControl.View>
                                    </dxg:GridControl>
                                </Grid>
                            </dxdo:LayoutPanel>
                        </dxdo:LayoutGroup>
                    </dxdo:LayoutGroup>
                </dxdo:DockLayoutManager>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
