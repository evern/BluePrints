                                                <dxe:TextEdit IsReadOnly="True" Mask="p2" MaskType="Numeric" MaskUseAsDisplayFormat="True" Foreground="Black" Background="{Binding ForecastSummary.EAC_Margin_Percent_Background}" Text="{Binding ForecastSummary.EAC_Margin_Percent, Mode=OneWay}" />
                                            </dxlc:LayoutItem>
                                            <dxlc:LayoutItem Label="Contingency" LabelPosition="Left">
