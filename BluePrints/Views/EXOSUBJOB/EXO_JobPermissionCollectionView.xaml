<UserControl x:Class="BluePrints.Views.EXO_JobPermissionCollectionView" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:custom="clr-namespace:BaseModel.Misc;assembly=BaseModel" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon" xmlns:dxrudex="http://schemas.devexpress.com/winfx/2008/xaml/reports/userdesignerextensions" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:viewmodel="clr-namespace:BluePrints.ViewModels" x:Name="userControl" d:DesignHeight="400" d:DesignWidth="1600" DataContext="{dxmvvm:ViewModelSource viewmodel:EXO_JobPermissionCollectionViewModelWrapper}" mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BaseModel;component/View/ResourceDictionaries/DefaultControlResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/DefaultBluePrintsResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/CustomControlResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Style="{StaticResource CollectionView.RootContainer}">
        <Grid DataContext="{Binding MainViewModel}">
            <dxb:BarManager>
                <dxb:BarManager.Items>
                    <dxb:BarSubItem ItemLinksSource="{StaticResource RibbonDefaultGridButtons}" />
                    <dxb:BarButtonItem x:Name="biCopyToJobSetup" Command="{Binding DataContext.CopyToJobCommand, ElementName=userControl}" Content="Copy to Job Setup" Glyph="{dx:DXImage Image=ConvertToRange_16x16.png}" LargeGlyph="{dx:DXImage Image=ConvertToRange_32x32.png}" ToolTip="This will copy jobs in exo that doesn't exists in job setup yet, safe to click whenever as it won't create duplicates" />
                    <dxb:BarButtonItem x:Name="biRemoveSelected" Command="{Binding DataContext.RemoveSelectedCommand, ElementName=userControl}" Content="Delete" Glyph="{dx:DXImage Image=Delete_16x16.png}" LargeGlyph="{dx:DXImage Image=Delete_32x32.png}" ToolTip="Delete entry from exo" />
                    <dxb:BarButtonItem x:Name="biPopulateActuals" Command="{Binding DataContext.PopulateActualsCommand, ElementName=userControl}" Content="Get Actuals" Glyph="{dxc:DXImage Images/Function Library/Financial_16x16.png}" LargeGlyph="{dx:DXImage Images/Function Library/Financial_32x32.png}" ToolTip="Get actuals summary by job from EXO and show it in the grid" />
                    <dxb:BarButtonItem x:Name="biSetIndirectFilter" Command="{Binding DataContext.SetIndirectFilterCommand, ElementName=userControl}" Content="Show Indirect Only" Glyph="{dxc:DXImage Images/Business Objects/BODetails_16x16.png}" LargeGlyph="{dxc:DXImage Images/Business Objects/BODetails_32x32.png}" ToolTip="Show indirect jobs only" />
                    <dxb:BarButtonItem x:Name="biSetDesignFilter" Command="{Binding DataContext.SetDesignFilterCommand, ElementName=userControl}" Content="Show Design Only" Glyph="{dxc:DXImage Images/Business Objects/BOPerson_16x16.png}" LargeGlyph="{dxc:DXImage Images/Business Objects/BOPerson_32x32.png}" ToolTip="Show design jobs only" />
                    <dxb:BarButtonItem x:Name="biSetProcurementFilter" Command="{Binding DataContext.SetProcurementFilterCommand, ElementName=userControl}" Content="Show Procurement Only" Glyph="{dxc:DXImage Images/Business Objects/BOProduct_16x16.png}" LargeGlyph="{dxc:DXImage Images/Business Objects/BOProduct_32x32.png}" ToolTip="Show procurement jobs only" />
                    <dxb:BarButtonItem x:Name="biSetConstructionFilter" Command="{Binding DataContext.SetConstructionFilterCommand, ElementName=userControl}" Content="Show Construction Only" Glyph="{dxc:DXImage Images/Business Objects/BOEmployee_16x16.png}" LargeGlyph="{dxc:DXImage Images/Business Objects/BOEmployee_32x32.png}" ToolTip="Show construction jobs only" />
                </dxb:BarManager.Items>
                <DockPanel>
                    <dxr:RibbonControl Style="{StaticResource DefaultRibbonControlStyle}">
                        <dxr:RibbonDefaultPageCategory MergeType="Replace" Caption="defaultCategory">
                            <dxr:RibbonPage MergeType="Replace" Caption="Grid">
                                <dxr:RibbonPageGroup MergeType="Replace" Caption="Grid">
                                    <dxb:BarButtonItemLink BarItemName="biFullRefresh1" />
                                    <dxb:BarButtonItemLink BarItemName="biRemoveSelected" />
                                    <dxb:BarButtonItemLink BarItemName="biKeyboardCopy1"/>
                                    <dxb:BarButtonItemLink BarItemName="biKeyboardPaste1" />
                                    <dxb:BarCheckItemLink BarItemName="biCellSelection1" />
                                    <dxb:BarButtonItemLink BarItemName="biSaveLayout1" />
                                    <dxb:BarButtonItemLink BarItemName="biResetLayout1" />
                                    <dxb:BarButtonItemLink BarItemName="biExpandAllGroups1" />
                                    <dxb:BarButtonItemLink BarItemName="biCollapseAllGroups1" />
                                    <dxb:BarButtonItemLink BarItemName="biExportToExcel1" />
                                    <dxb:BarButtonItemLink BarItemName="biExportToPDF1" />
                                    <dxb:BarButtonItemLink BarItemName="biPopulateActuals" />
                                    <dxb:BarButtonItemLink BarItemName="biSetIndirectFilter" />
                                    <dxb:BarButtonItemLink BarItemName="biSetDesignFilter" />
                                    <dxb:BarButtonItemLink BarItemName="biSetProcurementFilter" />
                                    <dxb:BarButtonItemLink BarItemName="biSetConstructionFilter" />
                                </dxr:RibbonPageGroup>
                                <dxr:RibbonPageGroup MergeType="Replace" Caption="Tools">
                                    <dxb:BarButtonItemLink BarItemName="biCopyToJobSetup" />
                                </dxr:RibbonPageGroup>
                            </dxr:RibbonPage>
                        </dxr:RibbonDefaultPageCategory>
                    </dxr:RibbonControl>
                    <dxr:RibbonStatusBarControl DockPanel.Dock="Bottom">
                        <dxr:RibbonStatusBarControl.LeftItems>
                            <dxb:BarStaticItem Content="{Binding Entities.Count, Converter={dxmvvm:FormatStringConverter FormatString='RECORDS: {0}'}}" />
                        </dxr:RibbonStatusBarControl.LeftItems>
                    </dxr:RibbonStatusBarControl>
                    <dxlc:LayoutControl x:Name="layoutControl" Orientation="Horizontal">
                        <dxlc:LayoutGroup Name="LayoutGroupGrid" Width="700" dxlc:LayoutControl.AllowHorizontalSizing="True" Orientation="Horizontal" View="Group">
                            <dxg:GridControl x:Name="GridControl" dxc:DXSerializer.SerializationID="GridControlEXOSUBJOB" dxc:DXSerializer.StoreLayoutMode="All" FilterCriteria="{Binding DataContext.FilterCriteria, ElementName=userControl, Mode=TwoWay}" Style="{StaticResource DefaultGridControlTemplate}">
                                <dxg:GridControl.Columns>
                                    <dxg:GridColumn FieldName="SubJobCode" Width="250" ReadOnly="True" MaxWidth="250" ColumnFilterMode="DisplayText" Header="Subjob" HeaderToolTip="Sub job code, type in free text">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:ComboBoxEditSettings AutoComplete="False" IsTextEditable="True" ItemsSource="{Binding DataContext.SUBJOBCodeStringCollection, ElementName=userControl}" Mask="{Binding DataContext.SubJobRegex, ElementName=userControl}" MaskType="RegEx" ValidateOnTextInput="False" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="SubJobTitle" Width="*" Header="Subjob Title" HeaderToolTip="Sub job title in exo, type in free text" >
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings NullText="Double click this cell to change title" ShowNullText="True" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                </dxg:GridControl.Columns>
                                <dxg:GridControl.TotalSummary>
                                    <dxg:GridSummaryItem dxc:DXSerializer.Enabled="False" DisplayFormat="Total {0} Records" FieldName="SubJobCode" SummaryType="Count" />
                                    <dxg:GridSummaryItem dxc:DXSerializer.Enabled="False" DisplayFormat="Total: {0:c0}" FieldName="ExoBudget" SummaryType="Sum" />
                                    <dxg:GridSummaryItem dxc:DXSerializer.Enabled="False" DisplayFormat="Total: {0:c0}" FieldName="SubJobActualCostSummary" SummaryType="Sum" />
                                    <dxg:GridSummaryItem dxc:DXSerializer.Enabled="False" DisplayFormat="Total: {0:c0}" FieldName="SubJobMaterialCostSummary" SummaryType="Sum" />
                                    <dxg:GridSummaryItem dxc:DXSerializer.Enabled="False" DisplayFormat="Total: {0:c0}" FieldName="SubJobRemainingPOCostSummary" SummaryType="Sum" />
                                </dxg:GridControl.TotalSummary>
                                <dxg:GridControl.GroupSummary>
                                    <dxg:GridSummaryItem dxc:DXSerializer.Enabled="False" DisplayFormat="Total {0} Records" FieldName="SubJobCode" SummaryType="Count" />
                                    <dxg:GridSummaryItem dxc:DXSerializer.Enabled="False" DisplayFormat="Total: {0:c0}" FieldName="ExoBudget" SummaryType="Sum" />
                                    <dxg:GridSummaryItem dxc:DXSerializer.Enabled="False" DisplayFormat="Total: {0:c0}" FieldName="SubJobActualCostSummary" SummaryType="Sum" />
                                    <dxg:GridSummaryItem dxc:DXSerializer.Enabled="False" DisplayFormat="Total: {0:c0}" FieldName="SubJobMaterialCostSummary" SummaryType="Sum" />
                                    <dxg:GridSummaryItem dxc:DXSerializer.Enabled="False" DisplayFormat="Total: {0:c0}" FieldName="SubJobRemainingPOCostSummary" SummaryType="Sum" />
                                </dxg:GridControl.GroupSummary>
                                <dxg:GridControl.View>
                                    <dxg:TableView x:Name="tableView" ShowTotalSummary="True" MouseUp="tableView1_MouseUp" AutoWidth="False" NewItemRowPosition="None" Style="{StaticResource DefaultMinimalTableViewTemplate}">
                                        <dxmvvm:Interaction.Behaviors>
                                            <dxmvvm:EventToCommand Command="{Binding DataContext.ValidateCellCommand, ElementName=userControl}" EventName="ValidateCell" PassEventArgsToCommand="True" />
                                            <dxmvvm:EventToCommand Command="{Binding DataContext.CellValueChangingCommand, ElementName=userControl}" EventName="CellValueChanging" PassEventArgsToCommand="True" />
                                            <dxmvvm:EventToCommand Command="{Binding DataContext.CellValueChangedCommand, ElementName=userControl}" EventName="CellValueChanged" PassEventArgsToCommand="True" />
                                        </dxmvvm:Interaction.Behaviors>
                                        <dxg:TableView.RowCellMenuCustomizations>
                                            <dxb:BarLinkContainerItem ItemLinksSource="{StaticResource ContextMenuDefaultHeaderButtons}" />
                                            <dxb:BarItemLinkSeparator />
                                            <dxb:BarButtonItemLink BarItemName="biRemoveSelected" />
                                            <dxb:BarButtonItemLink BarItemName="biFullRefresh1" />
                                        </dxg:TableView.RowCellMenuCustomizations>
                                        <!--<dxg:TableView.FormatConditions>
                                            <dxg:FormatCondition ApplyToRow="True" Expression="[IsLineExistsInExo] = 'False'">
                                                <dxc:Format Background="LightSalmon" />
                                            </dxg:FormatCondition>
                                        </dxg:TableView.FormatConditions>-->
                                    </dxg:TableView>
                                </dxg:GridControl.View>
                            </dxg:GridControl>
                        </dxlc:LayoutGroup>
                        <dxc:LoadingDecorator DataContext="{Binding DataContext, ElementName=userControl}" IsSplashScreenShown="{Binding IsPermissionLoading}">
                            <dxlc:LayoutGroup Name="LayoutGroupPermission" Orientation="Horizontal" View="Group">
                                <dxg:GridControl x:Name="GridControlPermission" MaxHeight="2000" dxc:DXSerializer.SerializationID="GridControlExoSubjobUsers" dxc:DXSerializer.StoreLayoutMode="All" IsEnabled="{Binding IsPermissionGridEnabled}" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser, Mode=TwoWay}" FilterCriteria="{Binding UserFilterCriteria, Mode=TwoWay}" SelectionMode="Cell">
                                    <dxg:GridControl.Columns>
                                        <dxg:GridColumn FieldName="IsAssigned" Width="90" Header="Can Book" HeaderToolTip="Indicate whether user have permission to book the selected time in exo">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:CheckEditSettings />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn AllowEditing="False" FieldName="User.NAME" Header="User" SortIndex="1" />
                                        <dxg:GridColumn FieldName="User.SecurityProfileID" Header="Profile" ReadOnly="True">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="PROFILENAME" IsTextEditable="True" ItemsSource="{Binding PROFILECollection}" ValueMember="ID" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn AllowEditing="False" FieldName="User.DEPARTMENT1.NAME" Header="Department" />
                                        <dxg:GridColumn AllowEditing="False" FieldName="User.DISCIPLINE.NAME" Header="Discipline" />
                                        <dxg:GridColumn AllowEditing="False" FieldName="User.TITLE" Header="Title" />
                                        <dxg:GridColumn AllowEditing="False" FieldName="User.DESCRIPTION" Header="Description" />
                                    </dxg:GridControl.Columns>
                                    <dxg:GridControl.TotalSummary>
                                        <dxg:GridSummaryItem dxc:DXSerializer.Enabled="False" Alignment="Right" SummaryType="Count" />
                                    </dxg:GridControl.TotalSummary>
                                    <dxg:GridControl.GroupSummary>
                                        <dxg:GridSummaryItem dxc:DXSerializer.Enabled="False" SummaryType="Count" />
                                    </dxg:GridControl.GroupSummary>
                                    <dxg:GridControl.View>
                                        <dxg:TableView x:Name="tableViewResources" MouseUp="tableView1_MouseUp" AutoWidth="True" NewItemRowPosition="None" Style="{StaticResource DefaultMinimalTableViewTemplate}">
                                            <dxmvvm:Interaction.Behaviors>
                                                <dxmvvm:EventToCommand Command="{Binding PermissionCellValueChangingCommand}" EventName="CellValueChanging" PassEventArgsToCommand="True" />
                                            </dxmvvm:Interaction.Behaviors>
                                        </dxg:TableView>
                                    </dxg:GridControl.View>
                                </dxg:GridControl>
                            </dxlc:LayoutGroup>
                        </dxc:LoadingDecorator>
                    </dxlc:LayoutControl>
                </DockPanel>
            </dxb:BarManager>
        </Grid>
    </Grid>
</UserControl>