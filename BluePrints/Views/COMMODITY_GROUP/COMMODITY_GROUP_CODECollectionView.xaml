<custom:ViewStateRestoreUserControl
    x:Name="userControl"
    x:Class="BluePrints.Views.COMMODITY_GROUP_CODECollectionView"
    xmlns="http://schemas.microsoft.com/netfx/2009/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon"
    xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
    xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
    xmlns:dxrudex="http://schemas.devexpress.com/winfx/2008/xaml/reports/userdesignerextensions"
    xmlns:viewmodel="clr-namespace:BluePrints.ViewModels"
    xmlns:helper="clr-namespace:BluePrints.Common.Helpers"
    xmlns:converters="clr-namespace:BluePrints.Common.ViewModel.Converters"
    xmlns:custom="clr-namespace:BaseModel.Misc;assembly=BaseModel"
    xmlns:common="clr-namespace:BluePrints.Common"
    DataContext="{dxmvvm:ViewModelSource viewmodel:COMMODITY_GROUP_CODECollectionViewModelWrapper}"
    mc:Ignorable="d" d:DesignHeight="400" d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                                <ResourceDictionary Source="pack://application:,,,/BaseModel;component/View/ResourceDictionaries/DefaultControlResourceDictionary.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/CustomControlResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/ConverterResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Style="{StaticResource CollectionView.RootContainer}">
        <Grid DataContext="{Binding MainViewModel}">
            <DockPanel>
                <dxr:RibbonControl RibbonStyle="Office2010" DockPanel.Dock="Top" AllowCustomization="False"
                                   MDIMergeStyle="Always">
                    <dxr:RibbonDefaultPageCategory Caption="defaultCategory">
                        <dxr:RibbonPage Caption="Home">
                            <dxr:RibbonPageGroup Caption="COMMODITY_GROUP_CODE_DIRECT Tasks">
                                <dxb:BarButtonItem Content="Delete" Command="{Binding BulkDeleteCommand}"
                                                   LargeGlyph="{dx:DXImage Image=Delete_32x32.png}"
                                                   Glyph="{dx:DXImage Image=Delete_16x16.png}" />
                                <dxb:BarButtonItem Content="Refresh" Command="{Binding DataContext.FullRefreshCommand, ElementName=userControl}"
                                                   LargeGlyph="{dx:DXImage Image=Refresh_32x32.png}"
                                                   Glyph="{dx:DXImage Image=Refresh_16x16.png}" />
                                <dxb:BarButtonItem Content="Undo" Command="{Binding UndoCommand}"
                                                   LargeGlyph="{dx:DXImage Image=Undo_32x32.png}"
                                                   Glyph="{dx:DXImage Image=Undo_16x16.png}" />
                                <dxb:BarButtonItem Content="Redo" Command="{Binding RedoCommand}"
                                                   LargeGlyph="{dx:DXImage Image=Redo_32x32.png}"
                                                   Glyph="{dx:DXImage Image=Redo_16x16.png}" />
                                <dxb:BarButtonItem Content="Save Layout"
                                                   Command="{Binding DataContext.SaveLayoutCommand, ElementName=userControl}"
                                                   LargeGlyph="{dx:DXImage Image=Save_32x32.png}"
                                                   Glyph="{dx:DXImage Image=Save_16x16.png}" />
                                <dxb:BarButtonItem Content="Reset Layout"
                                                   Command="{Binding DataContext.ResetLayoutCommand, ElementName=userControl}"
                                                   LargeGlyph="{dx:DXImage Image=SaveAndClose_32x32.png}"
                                                   Glyph="{dx:DXImage Image=SaveAndClose_16x16.png}" />
                            </dxr:RibbonPageGroup>
                        </dxr:RibbonPage>
                    </dxr:RibbonDefaultPageCategory>
                </dxr:RibbonControl>
                <dxr:RibbonStatusBarControl DockPanel.Dock="Bottom">
                    <dxr:RibbonStatusBarControl.LeftItems>
                        <dxb:BarStaticItem
                            Content="{Binding Entities.Count, Converter={dxmvvm:FormatStringConverter FormatString='RECORDS: {0}'}}" />
                    </dxr:RibbonStatusBarControl.LeftItems>
                </dxr:RibbonStatusBarControl>
                <Grid>
                    <dxmvvm:Interaction.Behaviors>
                        <dxmvvm:LayoutSerializationService />
                    </dxmvvm:Interaction.Behaviors>
                    <custom:GridControlEx x:Name="GridControl" Style="{StaticResource DefaultGridControlTemplate}"
                                     dx:DXSerializer.SerializationID="GridControlCOMMODITY_GROUP">
                        <dxmvvm:Interaction.Behaviors>
                            <dxg:GridDragDropManager x:Name="dragDropManager" Drop="dragDropManager_Drop" />
                            <dxmvvm:EventToCommand
                                Command="{Binding DataContext.MasterRowExpandedCommand, ElementName=userControl}"
                                PassEventArgsToCommand="True" EventName="MasterRowExpanded" />
                            <dxmvvm:EventToCommand
                                Command="{Binding DataContext.MasterRowCollapsedCommand, ElementName=userControl}"
                                PassEventArgsToCommand="True" EventName="MasterRowCollapsed" />
                        </dxmvvm:Interaction.Behaviors>
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn FieldName="Entity.GUID" Header="GUID" VisibleIndex="10" Visible="False"/>
                            <dxg:GridColumn FieldName="Entity.GUID_PROJECT" Header="PROJECT" VisibleIndex="10">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings
                                        ItemsSource="{Binding DataContext.PROJECTCollection, ElementName=userControl}"
                                        IsTextEditable="False" DisplayMember="NUMBER" ValueMember="GUID" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Entity.FULLCODE" Header="FULLCODE" VisibleIndex="20" />
                            <dxg:GridColumn FieldName="ProjectionType" ReadOnly="True" VisibleIndex="25">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings IsTextEditable="True" AutoComplete="True"
                                                              ItemsSource="{dxe:EnumItemsSource EnumType={x:Type common:COMMODITY_CODEProjectionType}}" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Entity.COMMODITY_GROUP_DIRECT_ID" VisibleIndex="25" />
                            <dxg:GridColumn Name="colDEPARTMENT" Header="DEPARTMENT"
                                            FieldName="Entity.GUID_DEPARTMENT" VisibleIndex="40">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings
                                        ItemsSource="{Binding DataContext.DEPARTMENTCollection, ElementName=userControl}"
                                        IsTextEditable="False" DisplayMember="NAME" ValueMember="GUID" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Name="colDISCIPLINE" Header="DISCIPLINE"
                                            FieldName="Entity.GUID_DISCIPLINE" VisibleIndex="50">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings
                                        ItemsSource="{Binding DataContext.DISCIPLINECollection, ElementName=userControl}"
                                        IsTextEditable="False" DisplayMember="NAME" ValueMember="GUID" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Name="colINDIRECT_TYPE" Header="INDIRECT TYPE"
                                            FieldName="GUID_INDIRECTTYPE" VisibleIndex="60">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings
                                        ItemsSource="{Binding DataContext.INDIRECT_TYPECollection, ElementName=userControl}"
                                        IsTextEditable="False" DisplayMember="NAME" ValueMember="GUID" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Entity.TYPE" Header="TYPE" VisibleIndex="70" />
                            <dxg:GridColumn FieldName="Entity.SPEC" Header="SPEC" VisibleIndex="80" />
                            <dxg:GridColumn FieldName="Entity.DESCRIPTION" Header="DESCRIPTION"
                                            VisibleIndex="90" />
                            <dxg:GridColumn FieldName="Entity.UOM" Header="UOM" VisibleIndex="100"
                                            AllowEditing="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings
                                        ItemsSource="{Binding DataContext.UOMCollection, ElementName=userControl}"
                                        AutoComplete="True" DisplayMember="UOM1" ValueMember="UOM1" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn x:Name="colRATE_SUPPLY" FieldName="Entity.RATE_SUPPLY"
                                            Header="SUPPLY RATE" VisibleIndex="120">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <dxe:SpinEdit Name="PART_Editor" MaskType="Numeric" Mask="c" MinValue="0"
                                                      Increment="10" MaskUseAsDisplayFormat="True"
                                                      IsEnabled="{Binding RowData.Row.IsEditable, UpdateSourceTrigger=PropertyChanged }" />
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                            <dxg:GridColumn x:Name="colHOURS_INSTALL" FieldName="Entity.HOURS_INSTALL"
                                            Header="INSTALL HOURS" VisibleIndex="130">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <dxe:SpinEdit Name="PART_Editor" MaskType="Numeric" Mask="n" MinValue="0"
                                                      Increment="1" MaskUseAsDisplayFormat="True"
                                                      IsEnabled="{Binding RowData.Row.IsEditable, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                            <dxg:GridColumn x:Name="colRATE_FREIGHT" FieldName="Entity.RATE_FREIGHT"
                                            Header="FREIGHT RATE" VisibleIndex="140">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <dxe:SpinEdit Name="PART_Editor" MaskType="Numeric" Mask="c" MinValue="0"
                                                      Increment="10" MaskUseAsDisplayFormat="True"
                                                      IsEnabled="{Binding RowData.Row.IsEditable, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                            <dxg:GridColumn x:Name="colRATE_PLANT" FieldName="Entity.RATE_PLANT"
                                            Header="PLANT RATE" VisibleIndex="150">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <dxe:SpinEdit Name="PART_Editor" MaskType="Numeric" Mask="c" MinValue="0"
                                                      Increment="10" MaskUseAsDisplayFormat="True"
                                                      IsEnabled="{Binding RowData.Row.IsEditable, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                        </dxg:GridControl.Columns>
                        <dxg:GridControl.DetailDescriptor>
                            <dxg:DataControlDetailDescriptor ItemsSourceBinding="{Binding DetailEntities}">
                                <dxg:GridControl x:Name="gridControlChild" Style="{StaticResource DefaultDetailGridControlTemplate}">
                                    <dxg:GridControl.Columns>
                                        <dxg:GridColumn Header="FULLCODE" FieldName="Entity.FULLCODE"
                                                        VisibleIndex="20" />
                                        <dxg:GridColumn Name="colChildDEPARTMENT" Header="DEPARTMENT"
                                                        FieldName="Entity.GUID_DEPARTMENT" VisibleIndex="40">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:ComboBoxEditSettings
                                                    ItemsSource="{Binding DataContext.DEPARTMENTCollection, ElementName=userControl}"
                                                    IsTextEditable="False" DisplayMember="NAME" ValueMember="GUID" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn Name="colChildDISCIPLINE" Header="DISCIPLINE"
                                                        FieldName="Entity.GUID_DISCIPLINE" VisibleIndex="50">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:ComboBoxEditSettings
                                                    ItemsSource="{Binding DataContext.DISCIPLINECollection, ElementName=userControl}"
                                                    IsTextEditable="False" DisplayMember="NAME" ValueMember="GUID" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn Name="colChildINDIRECT_TYPE" Header="INDIRECT TYPE"
                                                        FieldName="GUID_INDIRECTTYPE" VisibleIndex="60">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:ComboBoxEditSettings
                                                    ItemsSource="{Binding DataContext.INDIRECT_TYPECollection, ElementName=userControl}"
                                                    IsTextEditable="False" DisplayMember="NAME" ValueMember="GUID" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn FieldName="Entity.TYPE" Header="TYPE" VisibleIndex="70" />
                                        <dxg:GridColumn FieldName="Entity.SPEC" Header="SPEC" VisibleIndex="80" />
                                        <dxg:GridColumn FieldName="Entity.DESCRIPTION" Header="DESCRIPTION"
                                                        VisibleIndex="90" />
                                        <dxg:GridColumn FieldName="Entity.UOM" Header="UOM" VisibleIndex="100"
                                                        AllowEditing="True">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:ComboBoxEditSettings
                                                    ItemsSource="{Binding DataContext.UOMCollection, ElementName=userControl}"
                                                    AutoComplete="True" DisplayMember="UOM1" ValueMember="UOM1" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn x:Name="colChildRATE_SUPPLY"
                                                        FieldName="Entity.RATE_SUPPLY" Header="SUPPLY RATE"
                                                        VisibleIndex="120">
                                            <dxg:GridColumn.CellTemplate>
                                                <DataTemplate>
                                                    <dxe:SpinEdit Name="PART_Editor" MaskType="Numeric" Mask="c"
                                                                  MinValue="0" Increment="10"
                                                                  MaskUseAsDisplayFormat="True"
                                                                  IsEnabled="{Binding RowData.Row.IsEditable, UpdateSourceTrigger=PropertyChanged }" />
                                                </DataTemplate>
                                            </dxg:GridColumn.CellTemplate>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn x:Name="colChildHOURS_INSTALL"
                                                        FieldName="Entity.HOURS_INSTALL" Header="INSTALL HOURS"
                                                        VisibleIndex="130">
                                            <dxg:GridColumn.CellTemplate>
                                                <DataTemplate>
                                                    <dxe:SpinEdit Name="PART_Editor" MaskType="Numeric" Mask="n"
                                                                  MinValue="0" Increment="1"
                                                                  MaskUseAsDisplayFormat="True"
                                                                  IsEnabled="{Binding RowData.Row.IsEditable, UpdateSourceTrigger=PropertyChanged}" />
                                                </DataTemplate>
                                            </dxg:GridColumn.CellTemplate>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn x:Name="colChildRATE_FREIGHT"
                                                        FieldName="Entity.RATE_FREIGHT" Header="FREIGHT RATE"
                                                        VisibleIndex="140">
                                            <dxg:GridColumn.CellTemplate>
                                                <DataTemplate>
                                                    <dxe:SpinEdit Name="PART_Editor" MaskType="Numeric" Mask="c"
                                                                  MinValue="0" Increment="10"
                                                                  MaskUseAsDisplayFormat="True"
                                                                  IsEnabled="{Binding RowData.Row.IsEditable, UpdateSourceTrigger=PropertyChanged}" />
                                                </DataTemplate>
                                            </dxg:GridColumn.CellTemplate>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn x:Name="colChildRATE_PLANT"
                                                        FieldName="Entity.RATE_PLANT" Header="PLANT RATE"
                                                        VisibleIndex="150">
                                            <dxg:GridColumn.CellTemplate>
                                                <DataTemplate>
                                                    <dxe:SpinEdit Name="PART_Editor" MaskType="Numeric" Mask="c"
                                                                  MinValue="0" Increment="10"
                                                                  MaskUseAsDisplayFormat="True"
                                                                  IsEnabled="{Binding RowData.Row.IsEditable, UpdateSourceTrigger=PropertyChanged}" />
                                                </DataTemplate>
                                            </dxg:GridColumn.CellTemplate>
                                        </dxg:GridColumn>
                                    </dxg:GridControl.Columns>
                                    <dxg:GridControl.View>
                                        <dxg:TableView x:Name="tableView1"
                                                       Style="{StaticResource DefaultDetailTableViewTemplate}">
                                        </dxg:TableView>
                                    </dxg:GridControl.View>
                                </dxg:GridControl>
                            </dxg:DataControlDetailDescriptor>
                        </dxg:GridControl.DetailDescriptor>
                        <dxg:GridControl.TotalSummary>
                            <dxg:GridSummaryItem SummaryType="Count" Alignment="Right" />
                        </dxg:GridControl.TotalSummary>
                        <dxg:GridControl.GroupSummary>
                            <dxg:GridSummaryItem SummaryType="Count" />
                        </dxg:GridControl.GroupSummary>
                        <dxg:GridControl.View>
                            <custom:TableViewEx x:Name="tableView"
                                           Style="{StaticResource DefaultTableViewTemplate}">
                                <custom:TableViewEx.RowCellMenuCustomizations>
                                    <dxb:BarButtonItem Content="Bulk Edit"
                                                       Command="{Binding View.DataContext.BulkColumnEditCommand}"
                                                       CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                                                       Glyph="{dx:DXImageOffice2013 Image=CustomizeGrid_16x16.png}" />
                                    <dxb:BarButtonItem Content="Fill Up"
                                                       Glyph="{dx:DXImageOffice2013 Image=MoveUp_16x16.png}"
                                                       Command="{Binding View.DataContext.FillUpCommand}"
                                                       CommandParameter="{Binding RelativeSource={RelativeSource Self}}" />
                                    <dxb:BarButtonItem Content="Fill Down"
                                                       Glyph="{dx:DXImageOffice2013 Image=MoveDown_16x16.png}"
                                                       Command="{Binding View.DataContext.FillDownCommand}"
                                                       CommandParameter="{Binding RelativeSource={RelativeSource Self}}" />
                                    <dxb:BarButtonItem Content="Delete"
                                                       Command="{Binding View.DataContext.BulkDeleteCommand}"
                                                       Glyph="{dx:DXImage Image=Delete_16x16.png}" />
                                    <dxb:BarButtonItem Content="Refresh"
                                                       Command="{Binding View.DataContext.RefreshCommand}"
                                                       Glyph="{dx:DXImage Image=Refresh_16x16.png}" />
                                </custom:TableViewEx.RowCellMenuCustomizations>
                            </custom:TableViewEx>
                        </dxg:GridControl.View>
                    </custom:GridControlEx>
                </Grid>
            </DockPanel>
        </Grid>
    </Grid>
</custom:ViewStateRestoreUserControl>