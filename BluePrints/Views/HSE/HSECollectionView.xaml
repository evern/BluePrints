<UserControl x:Class="BluePrints.Views.HSECollectionView" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:custom="clr-namespace:BaseModel.Misc;assembly=BaseModel" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxet="http://schemas.devexpress.com/winfx/2008/xaml/editors/themekeys" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" xmlns:dxpg="http://schemas.devexpress.com/winfx/2008/xaml/pivotgrid" xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon" xmlns:dxrudex="http://schemas.devexpress.com/winfx/2008/xaml/reports/userdesignerextensions" xmlns:local="clr-namespace:BluePrints.Views" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:services="clr-namespace:BaseModel.ViewModel.Services;assembly=BaseModel" xmlns:viewmodel="clr-namespace:BluePrints.ViewModels" x:Name="userControl" d:DesignHeight="400" d:DesignWidth="600" DataContext="{dxmvvm:ViewModelSource viewmodel:HSECollectionViewModelWrapper}" mc:Ignorable="d">
    <dxmvvm:Interaction.Behaviors>
        <dxc:DialogService x:Name="DateFromToDialogService">
            <dxc:DialogService.DialogStyle>
                <Style TargetType="dx:DXDialogWindow">
                    <Setter Property="SizeToContent" Value="WidthAndHeight" />
                </Style>
            </dxc:DialogService.DialogStyle>
        </dxc:DialogService>
    </dxmvvm:Interaction.Behaviors>
    <UserControl.Resources>
        <ResourceDictionary>
            <local:ProgressBarBackgroundConverter x:Key="progressBarBackgroundConverter" />
            <local:ProgressBarForegroundConverter x:Key="progressBarForegroundConverter" />
            <ControlTemplate x:Key="{dxet:ProgressBarEditThemeKey ResourceKey=PanelBackgroundHorizontalTemplate}" TargetType="{x:Type ContentControl}">
                <Border Margin="1" CornerRadius="2">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="{Binding Path=(dxe:BaseEdit.OwnerEdit), Converter={StaticResource progressBarBackgroundConverter}}" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </ControlTemplate>
            <ControlTemplate x:Key="{dxet:ProgressBarEditThemeKey ResourceKey=PanelLeftSideHorizontalTemplate}" TargetType="{x:Type ContentControl}">
                <Border Margin="1" CornerRadius="2">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="{Binding Path=(dxe:BaseEdit.OwnerEdit), Converter={StaticResource progressBarForegroundConverter}}" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </ControlTemplate>
            <ControlTemplate x:Key="{dxet:ProgressBarEditStyleThemeKey ResourceKey=PanelTemplateHorizontal, IsThemeIndependent=true}" TargetType="{x:Type dxe:RangeEditBasePanel}">
                <Grid>
                    <Grid x:Name="root">
                        <Grid.Resources>
                            <dxe:GridLengthConverter x:Key="GridLengthConverter" />
                        </Grid.Resources>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="leftColumn" Width="{Binding Path=(dxe:RangeEditBaseInfo.LayoutInfo).LeftSidePosition, Converter={StaticResource GridLengthConverter}}" />
                            <ColumnDefinition x:Name="rightColumn" Width="{Binding Path=(dxe:RangeEditBaseInfo.LayoutInfo).RightSidePosition, Converter={StaticResource GridLengthConverter}}" />
                        </Grid.ColumnDefinitions>
                        <ContentControl x:Name="back" Grid.ColumnSpan="2" Style="{DynamicResource {dxet:ProgressBarEditThemeKey ResourceKey=PanelBackgroundHorizontalStyle}}" />
                        <ContentControl x:Name="left" Grid.Column="0" Style="{DynamicResource {dxet:ProgressBarEditThemeKey ResourceKey=PanelLeftSideHorizontalStyle}}" />
                        <ContentControl x:Name="right" Grid.Column="1" Style="{DynamicResource {dxet:ProgressBarEditThemeKey ResourceKey=PanelRightSideHorizontalStyle}}" />
                        <ContentControl x:Name="foreground" Grid.ColumnSpan="2" Style="{DynamicResource {dxet:ProgressBarEditThemeKey ResourceKey=PanelForegroundStyle}}" />
                    </Grid>
                    <ContentControl x:Name="PART_InnerContent" Grid.ColumnSpan="2" Content="{Binding Path=(dxe:BaseEdit.OwnerEdit).DisplayText}" ContentTemplate="{Binding Path=(dxe:BaseEdit.OwnerEdit).ContentTemplate}" Style="{DynamicResource {dxet:ProgressBarEditThemeKey ResourceKey=ContentStyle}}" />
                </Grid>
            </ControlTemplate>
            <DataTemplate x:Key="NormalCellTemplate">
                <dxe:SpinEdit EditValue="{Binding Path=Value, Mode=OneWay}" EditMode="InplaceInactive" IsReadOnly="True" Mask="n0" MaskUseAsDisplayFormat="True" />
            </DataTemplate>
            <DataTemplate x:Key="HighlightedCellTemplate">
                <ProgressBar Margin="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Foreground="Red" Minimum="0" />
            </DataTemplate>
            <DataTemplate x:Key="PercentageCellTemplate">
                <dxe:ProgressBarEdit EditValue="{Binding Path=Value, Mode=OneWay}" ContentDisplayMode="Value" DisplayFormatString="{}{0}%" EditMode="InplaceInactive" Foreground="#FFFCF5F5" IsReadOnly="True" Maximum="1" Minimum="0" />
            </DataTemplate>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BaseModel;component/View/ResourceDictionaries/DefaultControlResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/DefaultBluePrintsResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <dxmvvm:Interaction.Behaviors>
            <services:PivotGridControlService x:Name="PivotGridControlService" PivotGridControl="{Binding ElementName=pivotGridControl1}" />
        </dxmvvm:Interaction.Behaviors>
        <Grid DataContext="{Binding MainViewModel}">
            <DockPanel>
                <dxr:RibbonControl AllowCustomization="False" DockPanel.Dock="Top" MDIMergeStyle="Always" RibbonStyle="Office2010">
                    <dxr:RibbonDefaultPageCategory Caption="defaultCategory">
                        <dxr:RibbonPage Caption="{Binding DataContext.ViewName, ElementName=userControl}">
                            <dxr:RibbonPageGroup Caption="Tools">
                                <dxb:BarButtonItem Command="{Binding DataContext.ExportToExcelCommand, ElementName=userControl}" Content="Export" Glyph="{dx:DXImage Image=ExportToXLSX_16x16.png}" LargeGlyph="{dx:DXImage Image=ExportToXLSX_32x32.png}" ToolTip="Export current view to excel" />
                                <dxb:BarButtonItem Command="{Binding DataContext.FullRefreshCommand, ElementName=userControl}" Content="Refresh" Glyph="{dx:DXImage Image=Refresh_16x16.png}" LargeGlyph="{dx:DXImage Image=Refresh_32x32.png}" ToolTip="Refresh table with updated data. Also clears any undo redo entries" />
                            </dxr:RibbonPageGroup>
                        </dxr:RibbonPage>
                    </dxr:RibbonDefaultPageCategory>
                </dxr:RibbonControl>
                <dxr:RibbonStatusBarControl DockPanel.Dock="Bottom">
                    <dxr:RibbonStatusBarControl.LeftItems>
                        <dxb:BarStaticItem Content="{Binding Entities.Count, Converter={dxmvvm:FormatStringConverter FormatString='RECORDS: {0}'}}" />
                    </dxr:RibbonStatusBarControl.LeftItems>
                </dxr:RibbonStatusBarControl>
                <Grid DataContext="{Binding DataContext, ElementName=userControl}">
                    <dxmvvm:Interaction.Behaviors>
                        <dxmvvm:LayoutSerializationService />
                    </dxmvvm:Interaction.Behaviors>
                    <dxpg:PivotGridControl Name="pivotGridControl1" CustomFieldValueCells="pivotGridControl1_CustomFieldValueCells" CustomSummary="pivotGridControl1_CustomSummary" DataSource="{Binding DisplayEntities}" FieldCellTemplate="{x:Null}" RowTreeWidth="300" ShowFilterHeaders="False" ShowLoadingPanel="{Binding IsLoading}" ShowRowGrandTotalHeader="False" ShowRowGrandTotals="False">
                        <dxpg:PivotGridControl.FormatConditions>
                            <dxpg:DataBarFormatCondition ColumnName="fieldStatsValue" MaxValue="fieldStatsTarget" MeasureName="fieldStatsValue" MinValue="0" PredefinedFormatName="LightBlueGradientDataBar" RowName="fieldHSEDate" />
                        </dxpg:PivotGridControl.FormatConditions>
                        <dxpg:PivotGridControl.Fields>
                            <dxpg:PivotGridField Area="RowArea" Caption="Group" FieldName="Group" GroupIndex="0" />
                            <dxpg:PivotGridField Area="RowArea" Caption="Name" FieldName="StatsName" GroupIndex="2" />
                            <dxpg:PivotGridField Area="ColumnArea" Caption="Project" FieldName="Project.NUMBER" />
                            <dxpg:PivotGridField Name="fieldHSEDate" Area="ColumnArea" Caption="Month" FieldName="HSEDate" GroupInterval="DateMonthYear" />
                            <dxpg:PivotGridField Name="fieldStatsValue" Area="DataArea" Caption="Value" CellFormat="n2" FieldName="StatsValue" SummaryType="Custom" />
                            <dxpg:PivotGridField Name="fieldStatsTarget" Area="DataArea" Caption="Target" CellFormat="n2" FieldName="StatsTarget" SummaryType="Custom" />
                        </dxpg:PivotGridControl.Fields>
                        <dxpg:PivotGridControl.FieldCellTemplateSelector>
                            <local:CellTemplateSelector />
                        </dxpg:PivotGridControl.FieldCellTemplateSelector>
                    </dxpg:PivotGridControl>
                </Grid>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>