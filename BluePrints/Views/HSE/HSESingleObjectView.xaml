                                    <dxlc:LayoutItem Style="{StaticResource layoutFourthColumnStyle}">
                                        <dxe:TextEdit EditValue="{Binding Entity.INJURIES_REC_LTI_COMMENT}" Tag="Entity.INJURIES_REC_LTI_COMMENT" Style="{StaticResource SingleObjectView.TextEditControlContainer}" />
                                    </dxlc:LayoutItem>
                                </ExtraLayout:ExtraLayoutGroup>
                                <ExtraLayout:ExtraLayoutGroup Style="{StaticResource layoutControlLine}">
