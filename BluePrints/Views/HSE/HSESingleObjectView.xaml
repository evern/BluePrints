                                    <dxlc:LayoutItem FontWeight="Bold" Label="Comment" Style="{StaticResource layoutFourthColumnStyle}" />
                                </ExtraLayout:ExtraLayoutGroup>
                                <ExtraLayout:ExtraLayoutGroup Style="{StaticResource layoutControlLine}">
