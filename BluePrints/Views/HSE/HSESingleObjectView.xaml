                                <ExtraLayout:ExtraLayoutGroup Style="{StaticResource layoutControlLine}">
                                    <dxlc:LayoutItem Label="Non-Work Related Injuries or Illness (NWR)" Style="{StaticResource layoutFirstColumnStyle}">
                                        <dxe:SpinEdit EditValue="{Binding Entity.INJURIES_OTH_NWR}" Tag="Entity.INJURIES_OTH_NWR" Style="{StaticResource SingleObjectView.SpinEditControlContainer}" />
                                    </dxlc:LayoutItem>
                                    <dxlc:LayerSeparator Style="{StaticResource layoutSeparatorStyle}" />
                                    <dxlc:LayoutItem Label="-" Style="{StaticResource layoutSecondColumnStyle}" />
                                    <dxlc:LayerSeparator Style="{StaticResource layoutSeparatorStyle}" />
                                    <dxlc:LayoutItem Style="{StaticResource layoutThirdColumnStyle}" />
                                    <dxlc:LayerSeparator Style="{StaticResource layoutSeparatorStyle}" />
                                    <dxlc:LayoutItem Style="{StaticResource layoutFourthColumnStyle}">
                                        <dxe:TextEdit EditValue="{Binding Entity.INJURIES_OTH_NWR_COMMENT}" Tag="Entity.INJURIES_OTH_NWR_COMMENT" Style="{StaticResource SingleObjectView.TextEditControlContainer}" />
                                    </dxlc:LayoutItem>
