                                <ExtraLayout:ExtraLayoutGroup Style="{StaticResource layoutControlLine}">
                                    <dxlc:LayoutItem Label="Environmental Spill, Damage (ENV)" Style="{StaticResource layoutFirstColumnStyle}">
