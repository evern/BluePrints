                                    <dxlc:LayerSeparator Style="{StaticResource layoutSeparatorStyle}" />
                                    <dxlc:LayoutItem FontWeight="Bold" Label="Criteria" Style="{StaticResource layoutThirdColumnStyle}" />
                                    <dxlc:LayerSeparator Style="{StaticResource layoutSeparatorStyle}" />
                                    <dxlc:LayoutItem FontWeight="Bold" Label="Comment" Style="{StaticResource layoutFourthColumnStyle}" />
                                </ExtraLayout:ExtraLayoutGroup>
                                <ExtraLayout:ExtraLayoutGroup Style="{StaticResource layoutControlLine}">
                                    <dxlc:LayoutItem Label="Lost Time Injuries (LTI)" Style="{StaticResource layoutFirstColumnStyle}">
                                        <dxe:SpinEdit EditValue="{Binding Entity.INJURIES_REC_LTI}" Tag="Entity.INJURIES_REC_LTI" Style="{StaticResource SingleObjectView.SpinEditControlContainer}" />
                                    </dxlc:LayoutItem>
                                    <dxlc:LayerSeparator Style="{StaticResource layoutSeparatorStyle}" />
                                    <dxlc:LayoutItem Label="0" Style="{StaticResource layoutSecondColumnStyle}" />
                                    <dxlc:LayerSeparator Style="{StaticResource layoutSeparatorStyle}" />
