                                    <dxlc:LayerSeparator Style="{StaticResource layoutSeparatorStyle}" />
                                    <dxlc:LayoutItem Style="{StaticResource layoutThirdColumnStyle}" />
                                    <dxlc:LayerSeparator Style="{StaticResource layoutSeparatorStyle}" />
                                    <dxlc:LayoutItem Style="{StaticResource layoutFourthColumnStyle}">
                                        <dxe:TextEdit EditValue="{Binding Entity.INJURIES_OTH_FAI_COMMENT}" Tag="Entity.INJURIES_OTH_FAI_COMMENT" Style="{StaticResource SingleObjectView.TextEditControlContainer}" />
                                    </dxlc:LayoutItem>
