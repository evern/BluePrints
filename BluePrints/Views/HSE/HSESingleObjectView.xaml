<UserControl x:Class="BluePrints.Views.HSESingleObjectView" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ExtraLayout="clr-namespace:BaseModel.View.ExtraLayout;assembly=BaseModel" xmlns:common="clr-namespace:BluePrints.Common" xmlns:converter="clr-namespace:BluePrints.Common.ViewModel.Converters" xmlns:custom="clr-namespace:BaseModel.Misc;assembly=BaseModel" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon" xmlns:dxrudex="http://schemas.devexpress.com/winfx/2008/xaml/reports/userdesignerextensions" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:misc="clr-namespace:BluePrints.Common.ViewModel.Misc" xmlns:viewmodel="clr-namespace:BluePrints.ViewModels" x:Name="userControl" d:DesignHeight="4000" d:DesignWidth="1880" DataContext="{dxmvvm:ViewModelSource viewmodel:HSESingleObjectViewModelWrapper}" mc:Ignorable="d">
    <dxmvvm:Interaction.Behaviors>
        <dx:DialogService x:Name="DateFromToDialogService">
            <dx:DialogService.DialogStyle>
                <Style TargetType="dx:DXDialogWindow">
                    <Setter Property="SizeToContent" Value="WidthAndHeight" />
                </Style>
            </dx:DialogService.DialogStyle>
        </dx:DialogService>
    </dxmvvm:Interaction.Behaviors>
    <UserControl.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <Style x:Key="EntryFieldStyle" TargetType="Grid">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="20,0" />
            </Style>
            <Style x:Key="groupBoxStyle" TargetType="{x:Type dxlc:GroupBox}">
                <Setter Property="TitleVisibility" Value="Collapsed" />
            </Style>
            <Style x:Key="layoutContentStyle" TargetType="{x:Type dxlc:LayoutItem}">
                <Setter Property="Margin" Value="5, 5, 0, 7" />
            </Style>
            <Style x:Key="layoutControlLine" TargetType="{x:Type dxlc:LayoutGroup}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0, -1, 0, 0" />
                <Setter Property="Orientation" Value="Horizontal" />
                <Setter Property="View" Value="GroupBox" />
                <Setter Property="GroupBoxStyle" Value="{StaticResource groupBoxStyle}" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="ItemSpace" Value="0" />
            </Style>
            <Style x:Key="layoutLineLabelStyle" TargetType="dxlc:LayoutItem">
                <Setter Property="LabelStyle">
                    <Setter.Value>
                        <Style TargetType="dxlc:LayoutItemLabel">
                            <Setter Property="FontWeight" Value="Bold" />
                        </Style>
                    </Setter.Value>
                </Setter>
                <Setter Property="ElementSpace" Value="8" />
            </Style>
            <Style x:Key="layoutFirstColumnStyle" TargetType="{x:Type dxlc:LayoutItem}">
                <Setter Property="Margin" Value="0" />
                <Setter Property="Width" Value="350" />
            </Style>
            <Style x:Key="layoutSecondColumnStyle" TargetType="{x:Type dxlc:LayoutItem}">
                <Setter Property="Margin" Value="0" />
            </Style>
            <Style x:Key="layoutThirdColumnStyle" TargetType="{x:Type dxlc:LayoutItem}">
                <Setter Property="Margin" Value="0" />
            </Style>
            <Style x:Key="layoutFourthColumnStyle" TargetType="{x:Type dxlc:LayoutItem}">
                <Setter Property="Margin" Value="0" />
                <Setter Property="Width" Value="350" />
            </Style>
            <Style x:Key="layoutSideColumnStyle" TargetType="{x:Type dxlc:LayoutItem}">
                <Setter Property="Margin" Value="0" />
            </Style>
            <Style x:Key="layoutSeparatorStyle" TargetType="{x:Type dxlc:LayerSeparator}">
                <Setter Property="Width" Value="1" />
                <Setter Property="Margin" Value="1, -12, 5, -12" />
            </Style>
            <Style x:Key="SingleObjectView.SpinEditControlContainer" TargetType="dxe:SpinEdit">
                <Setter Property="dxmvvm:Interaction.BehaviorsTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <ItemsControl>
                                <dxmvvm:EventToCommand Command="{Binding DataContext.EditValueChangedCommand, ElementName=userControl}" EventName="EditValueChanged" MarkRoutedEventsAsHandled="True" PassEventArgsToCommand="True" />
                                <!--<dxmvvm:EventToCommand Command="{Binding DataContext.EditControlPreviewMouseDownCommand, ElementName=userControl}" EventName="PreviewMouseDown" MarkRoutedEventsAsHandled="True" PassEventArgsToCommand="True" />-->
                            </ItemsControl>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="MaskType" Value="Numeric" />
                <Setter Property="Mask" Value="n0" />
                <Setter Property="MaskUseAsDisplayFormat" Value="True" />
                <Setter Property="MinValue" Value="0" />
            </Style>
            <Style x:Key="SingleObjectView.TextEditControlContainer" TargetType="dxe:TextEdit">
                <Setter Property="dxmvvm:Interaction.BehaviorsTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <ItemsControl>
                                <dxmvvm:EventToCommand Command="{Binding DataContext.EditValueChangedCommand, ElementName=userControl}" EventName="EditValueChanged" MarkRoutedEventsAsHandled="True" PassEventArgsToCommand="True" />
                            </ItemsControl>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="AcceptsReturn" Value="True" />
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            </Style>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BaseModel;component/View/ResourceDictionaries/DefaultControlResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/DefaultBluePrintsResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Style="{StaticResource CollectionView.RootContainer}">
        <Grid DataContext="{Binding MainViewModel}">
            <dxb:BarManager>
                <dxb:BarManager.Items>
                    <dxb:BarButtonItem x:Name="biDateBackward" Command="{Binding DataContext.DateBackwardCommand, ElementName=userControl}" Content="Backward" Glyph="{dx:DXImage Image=HistoryItem_16x16.png}" LargeGlyph="{dx:DXImage Image=HistoryItem_32x32.png}" ToolTip="Rewind data date to previous interval" />
                    <!--<dxb:BarStaticItem Content="Data Date" />-->
                    <dxb:BarEditItem x:Name="biDataDate" Content="Data Date" EditValue="{Binding DataContext.DataDate, ElementName=userControl}" ToolTip="Data date">
                        <dxb:BarEditItem.EditSettings>
                            <dxe:DateEditSettings Mask="MMM yyyy" MaskUseAsDisplayFormat="True" />
                        </dxb:BarEditItem.EditSettings>
                    </dxb:BarEditItem>
                    <dxb:BarButtonItem x:Name="biDateForward" Command="{Binding DataContext.DateForwardCommand, ElementName=userControl}" Content="Forward" Glyph="{dx:DXImage Image=HistoryItem_16x16.png}" LargeGlyph="{dx:DXImage Image=HistoryItem_32x32.png}" ToolTip="Forward data date to next interval">
                        <dxb:BarButtonItem.GlyphTemplate>
                            <DataTemplate>
                                <Image RenderTransformOrigin="0.5,0.5" Source="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=dxb:BarItemLinkInfo}, Path=Item.LargeGlyph}">
                                    <Image.RenderTransform>
                                        <ScaleTransform ScaleX="-1" />
                                    </Image.RenderTransform>
                                </Image>
                            </DataTemplate>
                        </dxb:BarButtonItem.GlyphTemplate>
                    </dxb:BarButtonItem>
                    <dxb:BarEditItem x:Name="biDataDate2" Content="Select Month" EditValue="{Binding DataContext.DataDate, ElementName=userControl}">
                        <dxb:BarEditItem.EditSettings>
                            <dxg:LookUpEditSettings AutoPopulateColumns="False" DataContext="{Binding DataContext.MainViewModel, ElementName=userControl}" DisplayMember="Entity.HSE_DATE" IsTextEditable="true" ItemsSource="{Binding Entities}" Mask="MMM yyyy" MaskUseAsDisplayFormat="True" ValueMember="Entity.HSE_DATE">
                                <dxg:LookUpEditSettings.PopupContentTemplate>
                                    <ControlTemplate TargetType="ContentControl">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="30" />
                                                <RowDefinition />
                                            </Grid.RowDefinitions>
                                            <dxb:ToolBarControl Grid.Row="0">
                                                <dxb:BarButtonItem BarItemDisplayMode="ContentAndGlyph" Command="{Binding BulkDeleteCommand}" Content="Delete" Glyph="{dx:DXImage Image=Delete_16x16.png}" />
                                                <dxb:BarButtonItem BarItemDisplayMode="ContentAndGlyph" Command="{Binding RefreshCommand}" Content="Refresh" Glyph="{dx:DXImage Image=Refresh_16x16.png}" />
                                                <dxb:BarButtonItem BarItemDisplayMode="ContentAndGlyph" Command="{Binding UndoCommand}" Content="Undo" Glyph="{dx:DXImage Image=Undo_16x16.png}" />
                                                <dxb:BarButtonItem BarItemDisplayMode="ContentAndGlyph" Command="{Binding RedoCommand}" Content="Redo" Glyph="{dx:DXImage Image=Redo_16x16.png}" />
                                            </dxb:ToolBarControl>
                                            <dxg:GridControl x:Name="PART_GridControl" Grid.Row="1" SelectionMode="Row" ShowBorder="False" Style="{StaticResource AssociateGridControlTemplate}">
                                                <dxg:GridControl.Columns>
                                                    <dxg:GridColumn Width="150" FieldName="Entity.HSE_DATE" Header="Date" ReadOnly="True">
                                                        <dxg:GridColumn.EditSettings>
                                                            <dxe:DateEditSettings Mask="MMM yyyy" MaskUseAsDisplayFormat="True" />
                                                        </dxg:GridColumn.EditSettings>
                                                    </dxg:GridColumn>
                                                </dxg:GridControl.Columns>
                                                <dxg:GridControl.View>
                                                    <dxg:TableView ShowFocusedRectangle="True" ShowGroupPanel="False" ShowSearchPanelMode="Always" ShowSearchPanelNavigationButtons="True" ShowSelectionRectangle="True" Style="{StaticResource AssociateTableViewTemplate}">
                                                        <dxg:TableView.RowCellMenuCustomizations>
                                                            <dxb:BarButtonItem Command="{Binding View.DataContext.UndoCommand}" Content="Undo" Glyph="{dx:DXImage Image=Undo_16x16.png}" LargeGlyph="{dx:DXImage Image=Undo_32x32.png}" ToolTip="Undo last action" />
                                                            <dxb:BarButtonItem Command="{Binding View.DataContext.RedoCommand}" Content="Redo" Glyph="{dx:DXImage Image=Redo_16x16.png}" LargeGlyph="{dx:DXImage Image=Redo_32x32.png}" ToolTip="Redo undone action" />
                                                            <dxb:BarItemLinkSeparator />
                                                            <dxb:BarButtonItem Command="{Binding View.DataContext.BulkDeleteCommand}" Content="Delete Row" Glyph="{dx:DXImage Image=Delete_16x16.png}" ToolTip="Delete selected rows" />
                                                        </dxg:TableView.RowCellMenuCustomizations>
                                                    </dxg:TableView>
                                                </dxg:GridControl.View>
                                            </dxg:GridControl>
                                        </Grid>
                                    </ControlTemplate>
                                </dxg:LookUpEditSettings.PopupContentTemplate>
                            </dxg:LookUpEditSettings>
                        </dxb:BarEditItem.EditSettings>
                    </dxb:BarEditItem>
                </dxb:BarManager.Items>
                <DockPanel>
                    <dxr:RibbonControl MDIMergeStyle="WhenChildActivated" AllowCustomization="False" DockPanel.Dock="Top" RibbonStyle="Office2010">
                        <dxr:RibbonDefaultPageCategory MergeType="Replace" Caption="defaultCategory">
                            <dxr:RibbonPage MergeType="Replace" Caption="Grid">
                                <dxr:RibbonPageGroup MergeType="Replace" Caption="Data Date">
                                    <dxb:BarButtonItemLink BarItemName="biDateBackward" />
                                    <dxb:BarEditItemLink BarItemName="biDataDate" />
                                    <dxb:BarButtonItemLink BarItemName="biDateForward" />
                                    <dxb:BarItemSeparator />
                                    <dxb:BarEditItemLink BarItemName="biDataDate2" />
                                </dxr:RibbonPageGroup>
                            </dxr:RibbonPage>
                        </dxr:RibbonDefaultPageCategory>
                    </dxr:RibbonControl>
                    <dx:LoadingDecorator IsSplashScreenShown="{Binding DataContext.IsLoading, ElementName=userControl}">
                        <Grid DataContext="{Binding DataContext.EditingEntity, ElementName=userControl}">
                            <dxmvvm:Interaction.Behaviors>
                                <dxmvvm:LayoutSerializationService />
                            </dxmvvm:Interaction.Behaviors>
                            <ExtraLayout:ExtraLayoutControl Margin="0" Padding="0" dx:DXSerializer.Enabled="False" ItemSpace="0" Orientation="Horizontal">
                                <ExtraLayout:ExtraLayoutGroup Margin="0" Padding="0" VerticalAlignment="Top" ItemSpace="0" LayoutItemSize="3*" Orientation="Vertical">
                                    <ExtraLayout:ExtraLayoutControl Margin="0" Padding="0" ItemSpace="0" Orientation="Vertical" View="Group">
                                        <ExtraLayout:ExtraLayoutGroup Background="AliceBlue" Style="{StaticResource layoutControlLine}">
                                            <dxlc:LayoutItem FontWeight="Bold" Foreground="Black" Label="1. RECORDABLE INJURIES" Style="{StaticResource layoutFirstColumnStyle}" />
                                            <dxlc:LayerSeparator Style="{StaticResource layoutSeparatorStyle}" />
                                            <dxlc:LayoutItem FontWeight="Bold" Foreground="Black" Label="Target" Style="{StaticResource layoutSecondColumnStyle}" />
                                            <dxlc:LayerSeparator Style="{StaticResource layoutSeparatorStyle}" />
                                            <dxlc:LayoutItem FontWeight="Bold" Foreground="Black" Label="Criteria" Style="{StaticResource layoutThirdColumnStyle}" />
                                            <dxlc:LayerSeparator Style="{StaticResource layoutSeparatorStyle}" />
                                            <dxlc:LayoutItem FontWeight="Bold" Foreground="Black" Label="Comment" Style="{StaticResource layoutFourthColumnStyle}" />
                                        </ExtraLayout:ExtraLayoutGroup>
                                        <ExtraLayout:ExtraLayoutGroup Style="{StaticResource layoutControlLine}">
                                            <dxlc:LayoutItem Label="Lost Time Injuries (LTI)" Style="{StaticResource layoutFirstColumnStyle}">
                                                <dxe:SpinEdit EditValue="{Binding Entity.INJURIES_REC_LTI}" Tag="Entity.INJURIES_REC_LTI" Background="{Binding INJURIES_REC_LTI_Background}" Foreground="Black" Style="{StaticResource SingleObjectView.SpinEditControlContainer}" />
                                            </dxlc:LayoutItem>
                                            <dxlc:LayerSeparator Style="{StaticResource layoutSeparatorStyle}" />
                                            <dxlc:LayoutItem Label="0" Style="{StaticResource layoutSecondColumnStyle}" />
                                            <dxlc:LayerSeparator Style="{StaticResource layoutSeparatorStyle}" />
                                            <dxlc:LayoutItem Label="= Zero" Style="{StaticResource layoutThirdColumnStyle}" />
                                            <dxlc:LayerSeparator Style="{StaticResource layoutSeparatorStyle}" />
                                            <dxlc:LayoutItem Style="{StaticResource layoutFourthColumnStyle}">
                                                <dxe:TextEdit EditValue="{Binding Entity.INJURIES_REC_LTI_COMMENT}" Tag="Entity.INJURIES_REC_LTI_COMMENT" Style="{StaticResource SingleObjectView.TextEditControlContainer}" />
                                            </dxlc:LayoutItem>
                                        </ExtraLayout:ExtraLayoutGroup>
                                        <ExtraLayout:ExtraLayoutGroup Style="{StaticResource layoutControlLine}">
                                            <dxlc:LayoutItem Label="Restricted Work Injuries (RWI)" Style="{StaticResource layoutFirstColumnStyle}">
                                                <dxe:SpinEdit EditValue="{Binding Entity.INJURIES_REC_RWI}" Tag="Entity.INJURIES_REC_RWI" Background="{Binding INJURIES_REC_RWI_Background}" Foreground="Black" Style="{StaticResource SingleObjectView.SpinEditControlContainer}" />
                                            </dxlc:LayoutItem>
                                            <dxlc:LayerSeparator Style="{StaticResource layoutSeparatorStyle}" />
                                            <dxlc:LayoutItem Label="0" Style="{StaticResource layoutSecondColumnStyle}" />
                                            <dxlc:LayerSeparator Style="{StaticResource layoutSeparatorStyle}" />
                                            <dxlc:LayoutItem Label="= Zero" Style="{StaticResource layoutThirdColumnStyle}" />
                                            <dxlc:LayerSeparator Style="{StaticResource layoutSeparatorStyle}" />
                                            <dxlc:LayoutItem Style="{StaticResource layoutFourthColumnStyle}">
                                                <dxe:TextEdit EditValue="{Binding Entity.INJURIES_REC_RWI_COMMENT}" Tag="Entity.INJURIES_REC_RWI_COMMENT" Style="{StaticResource SingleObjectView.TextEditControlContainer}" />
                                            </dxlc:LayoutItem>
                                        </ExtraLayout:ExtraLayoutGroup>
                                        <ExtraLayout:ExtraLayoutGroup Style="{StaticResource layoutControlLine}">
                                            <dxlc:LayoutItem Label="Medical Treatment Injuries (MTI)" Style="{StaticResource layoutFirstColumnStyle}">
                                                <dxe:SpinEdit EditValue="{Binding Entity.INJURIES_REC_MTI}" Tag="Entity.INJURIES_REC_MTI" Background="{Binding INJURIES_REC_MTI_Background}" Foreground="Black" Style="{StaticResource SingleObjectView.SpinEditControlContainer}" />
                                            </dxlc:LayoutItem>
                                            <dxlc:LayerSeparator Style="{StaticResource layoutSeparatorStyle}" />
                                            <dxlc:LayoutItem Label="0" Style="{StaticResource layoutSecondColumnStyle}" />
                                            <dxlc:LayerSeparator Style="{StaticResource layoutSeparatorStyle}" />
                                            <dxlc:LayoutItem Label="= Zero" Style="{StaticResource layoutThirdColumnStyle}" />
                                            <dxlc:LayerSeparator Style="{StaticResource layoutSeparatorStyle}" />
                                            <dxlc:LayoutItem Style="{StaticResource layoutFourthColumnStyle}">
                                                <dxe:TextEdit EditValue="{Binding Entity.INJURIES_REC_MTI_COMMENT}" Tag="Entity.INJURIES_REC_MTI_COMMENT" Style="{StaticResource SingleObjectView.TextEditControlContainer}" />
                                            </dxlc:LayoutItem>
                                        </ExtraLayout:ExtraLayoutGroup>
                                        <ExtraLayout:ExtraLayoutGroup Style="{StaticResource layoutControlLine}">
                                            <dxlc:LayoutItem FontWeight="Bold" Foreground="Black" Label="Total Recordable Injury Frequency Rate (TRIFR)" Style="{StaticResource layoutFirstColumnStyle}">
                                                <dxe:SpinEdit EditValue="{Binding Total_Recordable_Injuries_Frequency_Rate, Mode=OneWay}" HorizontalAlignment="Left" Background="{Binding Total_Recordable_Injuries_Freq_Background}" EditMode="InplaceInactive" Foreground="Black" IsReadOnly="True" Mask="n2" MaskUseAsDisplayFormat="True" ShowEditorButtons="False" />
                                            </dxlc:LayoutItem>
                                            <dxlc:LayerSeparator Style="{StaticResource layoutSeparatorStyle}" />
                                            <dxlc:LayoutItem Style="{StaticResource layoutSecondColumnStyle}">
                                                <dxe:SpinEdit EditValue="{Binding Total_Recordable_Injuries_Target, Mode=OneWay}" HorizontalAlignment="Left" EditMode="InplaceInactive" IsReadOnly="True" Mask="n2" MaskUseAsDisplayFormat="True" ShowEditorButtons="False" />
                                            </dxlc:LayoutItem>
                                            <dxlc:LayerSeparator Style="{StaticResource layoutSeparatorStyle}" />
                                            <dxlc:LayoutItem Label="Less Than 3.5" Style="{StaticResource layoutThirdColumnStyle}" />
                                            <dxlc:LayerSeparator Style="{StaticResource layoutSeparatorStyle}" />
                                            <dxlc:LayoutItem Style="{StaticResource layoutFourthColumnStyle}">
                                                <dxe:TextEdit EditValue="{Binding Entity.INJURIES_REC_TOTAL_COMMENT}" Tag="Entity.INJURIES_REC_TOTAL_COMMENT" Style="{StaticResource SingleObjectView.TextEditControlContainer}" />
                                            </dxlc:LayoutItem>
                                        </ExtraLayout:ExtraLayoutGroup>
                                        <ExtraLayout:ExtraLayoutGroup Background="AliceBlue" Style="{StaticResource layoutControlLine}">
                                            <dxlc:LayoutItem FontWeight="Bold" Foreground="Black" Label="2. OTHER INJURIES" Style="{StaticResource layoutFirstColumnStyle}" />
                                            <dxlc:LayerSeparator Style="{StaticResource layoutSeparatorStyle}" />
                                            <dxlc:LayoutItem FontWeight="Bold" Foreground="Black" Label="Target" Style="{StaticResource layoutSecondColumnStyle}" />
                                            <dxlc:LayerSeparator Style="{StaticResource layoutSeparatorStyle}" />
                                            <dxlc:LayoutItem FontWeight="Bold" Foreground="Black" Label="Criteria" Style="{StaticResource layoutThirdColumnStyle}" />
                                            <dxlc:LayerSeparator Style="{StaticResource layoutSeparatorStyle}" />
                                            <dxlc:LayoutItem FontWeight="Bold" Foreground="Black" Label="Comment" Style="{StaticResource layoutFourthColumnStyle}" />
                                        </ExtraLayout:ExtraLayoutGroup>
                                        <ExtraLayout:ExtraLayoutGroup Style="{StaticResource layoutControlLine}">
                                            <dxlc:LayoutItem Label="First Aid (or no-treatment required) Injuries (FAI)" Style="{StaticResource layoutFirstColumnStyle}">
                                                <dxe:SpinEdit EditValue="{Binding Entity.INJURIES_OTH_FAI}" Tag="Entity.INJURIES_OTH_FAI" Style="{StaticResource SingleObjectView.SpinEditControlContainer}" />
                                            </dxlc:LayoutItem>
                                            <dxlc:LayerSeparator Style="{StaticResource layoutSeparatorStyle}" />
                                            <dxlc:LayoutItem Label="-" Style="{StaticResource layoutSecondColumnStyle}" />
                                            <dxlc:LayerSeparator Style="{StaticResource layoutSeparatorStyle}" />
                                            <dxlc:LayoutItem Style="{StaticResource layoutThirdColumnStyle}" />
                                            <dxlc:LayerSeparator Style="{StaticResource layoutSeparatorStyle}" />
                                            <dxlc:LayoutItem Style="{StaticResource layoutFourthColumnStyle}">
                                                <dxe:TextEdit EditValue="{Binding Entity.INJURIES_OTH_FAI_COMMENT}" Tag="Entity.INJURIES_OTH_FAI_COMMENT" Style="{StaticResource SingleObjectView.TextEditControlContainer}" />
                                            </dxlc:LayoutItem>
                                        </ExtraLayout:ExtraLayoutGroup>
                                        <ExtraLayout:ExtraLayoutGroup Style="{StaticResource layoutControlLine}" Visibility="Collapsed">
                                            <dxlc:LayoutItem FontWeight="Bold" Foreground="Black" Label="All Injury Frequency Rate" Style="{StaticResource layoutFirstColumnStyle}">
                                                <dxe:SpinEdit EditValue="{Binding All_Injuries, Mode=OneWay}" HorizontalAlignment="Left" Background="{Binding All_Injuries_Background}" EditMode="InplaceInactive" Foreground="Black" IsReadOnly="True" Mask="n0" MaskUseAsDisplayFormat="True" ShowEditorButtons="False" />
                                            </dxlc:LayoutItem>
                                            <dxlc:LayerSeparator Style="{StaticResource layoutSeparatorStyle}" />
                                            <dxlc:LayoutItem Style="{StaticResource layoutSecondColumnStyle}">
                                                <dxe:SpinEdit EditValue="{Binding All_Injuries_Target, Mode=OneWay}" HorizontalAlignment="Left" EditMode="InplaceInactive" IsReadOnly="True" Mask="n0" MaskUseAsDisplayFormat="True" ShowEditorButtons="False" />
                                            </dxlc:LayoutItem>
                                            <dxlc:LayerSeparator Style="{StaticResource layoutSeparatorStyle}" />
                                            <dxlc:LayoutItem Label="Less Than 10 Per Million Manhours" Style="{StaticResource layoutThirdColumnStyle}" />
                                            <dxlc:LayerSeparator Style="{StaticResource layoutSeparatorStyle}" />
                                            <dxlc:LayoutItem Style="{StaticResource layoutFourthColumnStyle}">
                                                <dxe:TextEdit EditValue="{Binding Entity.INJURIES_REC_ALL_COMMENT}" Tag="Entity.INJURIES_REC_ALL_COMMENT" Style="{StaticResource SingleObjectView.TextEditControlContainer}" />
                                            </dxlc:LayoutItem>
                                        </ExtraLayout:ExtraLayoutGroup>
                                        <ExtraLayout:ExtraLayoutGroup Style="{StaticResource layoutControlLine}">
                                            <dxlc:LayoutItem Label="Non-Work Related Injuries or Illness (NWR)" Style="{StaticResource layoutFirstColumnStyle}">
                                                <dxe:SpinEdit EditValue="{Binding Entity.INJURIES_OTH_NWR}" Tag="Entity.INJURIES_OTH_NWR" Style="{StaticResource SingleObjectView.SpinEditControlContainer}" />
                                            </dxlc:LayoutItem>
                                            <dxlc:LayerSeparator Style="{StaticResource layoutSeparatorStyle}" />
                                            <dxlc:LayoutItem Label="-" Style="{StaticResource layoutSecondColumnStyle}" />
                                            <dxlc:LayerSeparator Style="{StaticResource layoutSeparatorStyle}" />
                                            <dxlc:LayoutItem Style="{StaticResource layoutThirdColumnStyle}" />
                                            <dxlc:LayerSeparator Style="{StaticResource layoutSeparatorStyle}" />
                                            <dxlc:LayoutItem Style="{StaticResource layoutFourthColumnStyle}">
                                                <dxe:TextEdit EditValue="{Binding Entity.INJURIES_OTH_NWR_COMMENT}" Tag="Entity.INJURIES_OTH_NWR_COMMENT" Style="{StaticResource SingleObjectView.TextEditControlContainer}" />
                                            </dxlc:LayoutItem>
                                        </ExtraLayout:ExtraLayoutGroup>
                                        <ExtraLayout:ExtraLayoutGroup Background="AliceBlue" Style="{StaticResource layoutControlLine}">
                                            <dxlc:LayoutItem FontWeight="Bold" Foreground="Black" Label="3. NON INJURY INCIDENTS" Style="{StaticResource layoutFirstColumnStyle}" />
                                            <dxlc:LayerSeparator Style="{StaticResource layoutSeparatorStyle}" />
                                            <dxlc:LayoutItem FontWeight="Bold" Foreground="Black" Label="Target" Style="{StaticResource layoutSecondColumnStyle}" />
                                            <dxlc:LayerSeparator Style="{StaticResource layoutSeparatorStyle}" />
                                            <dxlc:LayoutItem FontWeight="Bold" Foreground="Black" Label="Criteria" Style="{StaticResource layoutThirdColumnStyle}" />
                                            <dxlc:LayerSeparator Style="{StaticResource layoutSeparatorStyle}" />
                                            <dxlc:LayoutItem FontWeight="Bold" Foreground="Black" Label="Comment" Style="{StaticResource layoutFourthColumnStyle}" />
                                        </ExtraLayout:ExtraLayoutGroup>
                                        <ExtraLayout:ExtraLayoutGroup Style="{StaticResource layoutControlLine}">
                                            <dxlc:LayoutItem Label="Property, Plant, Equipment Damage (DAM)" Style="{StaticResource layoutFirstColumnStyle}">
                                                <dxe:SpinEdit EditValue="{Binding Entity.INCIDENT_DAM}" Tag="Entity.INCIDENT_DAM" Background="{Binding INCIDENT_DAM_Background}" Foreground="Black" Style="{StaticResource SingleObjectView.SpinEditControlContainer}" />
                                            </dxlc:LayoutItem>
                                            <dxlc:LayerSeparator Style="{StaticResource layoutSeparatorStyle}" />
                                            <dxlc:LayoutItem Style="{StaticResource layoutSecondColumnStyle}">
                                                <dxe:SpinEdit EditValue="{Binding Incident_Target, Mode=OneWay}" HorizontalAlignment="Left" EditMode="InplaceInactive" IsReadOnly="True" Mask="n0" MaskUseAsDisplayFormat="True" ShowEditorButtons="False" />
                                            </dxlc:LayoutItem>
                                            <dxlc:LayerSeparator Style="{StaticResource layoutSeparatorStyle}" />
                                            <dxlc:LayoutItem Label="Less Than 10% of Incidents" Style="{StaticResource layoutThirdColumnStyle}" />
                                            <dxlc:LayerSeparator Style="{StaticResource layoutSeparatorStyle}" />
                                            <dxlc:LayoutItem Style="{StaticResource layoutFourthColumnStyle}">
                                                <dxe:TextEdit EditValue="{Binding Entity.INCIDENT_DAM_COMMENT}" Tag="Entity.INCIDENT_DAM_COMMENT" Style="{StaticResource SingleObjectView.TextEditControlContainer}" />
                                            </dxlc:LayoutItem>
                                        </ExtraLayout:ExtraLayoutGroup>
                                        <ExtraLayout:ExtraLayoutGroup Style="{StaticResource layoutControlLine}">
                                            <dxlc:LayoutItem Label="Environmental Spill, Damage (ENV)" Style="{StaticResource layoutFirstColumnStyle}">
                                                <dxe:SpinEdit EditValue="{Binding Entity.INCIDENT_ENV}" Tag="Entity.INCIDENT_ENV" Background="{Binding INCIDENT_PDT_Background}" Foreground="Black" Style="{StaticResource SingleObjectView.SpinEditControlContainer}" />
                                            </dxlc:LayoutItem>
                                            <dxlc:LayerSeparator Style="{StaticResource layoutSeparatorStyle}" />
                                            <dxlc:LayoutItem Style="{StaticResource layoutSecondColumnStyle}">
                                                <dxe:SpinEdit EditValue="{Binding Incident_Target, Mode=OneWay}" HorizontalAlignment="Left" EditMode="InplaceInactive" IsReadOnly="True" Mask="n0" MaskUseAsDisplayFormat="True" ShowEditorButtons="False" />
                                            </dxlc:LayoutItem>
                                            <dxlc:LayerSeparator Style="{StaticResource layoutSeparatorStyle}" />
