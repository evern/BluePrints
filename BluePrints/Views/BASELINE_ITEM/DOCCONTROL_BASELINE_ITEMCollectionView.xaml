<UserControl x:Class="BluePrints.Views.DOCCONTROL_BASELINE_ITEMCollectionView" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:common="clr-namespace:BluePrints.Common" xmlns:converters="clr-namespace:BluePrints.Common.ViewModel.Converters" xmlns:custom="clr-namespace:BaseModel.Misc;assembly=BaseModel" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxa="http://schemas.devexpress.com/winfx/2008/xaml/accordion" xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon" xmlns:dxrudex="http://schemas.devexpress.com/winfx/2008/xaml/reports/userdesignerextensions" xmlns:filter="clr-namespace:BluePrints.Common.Filtering" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:view="clr-namespace:BluePrints.Views" xmlns:viewmodel="clr-namespace:BluePrints.ViewModels" x:Name="userControl" d:DesignHeight="400" d:DesignWidth="600" DataContext="{dxmvvm:ViewModelSource viewmodel:DOCCONTROL_BASELINE_ITEMCollectionViewModelWrapper}" mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <DataTemplate x:Key="glyphTemplate">
                <dxc:DXImage x:Name="glyph" Width="16" Height="16" Margin="3,0,0,0" SnapsToDevicePixels="True" Source="{Binding}" />
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                        <Setter TargetName="glyph" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
            <Style x:Key="accordionItemContainerStyle" TargetType="dxa:AccordionItem">
                <Setter Property="Header" Value="{Binding Name}" />
                <Style.Triggers>
                    <Trigger Property="ItemLevel" Value="1">
                        <Setter Property="ShowInCollapsedMode" Value="{Binding ShowInCollapsedMode}" />
                        <Setter Property="Glyph" Value="{Binding Icon}" />
                        <Setter Property="GlyphTemplate" Value="{StaticResource glyphTemplate}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <common:RowNameConverter x:Key="RowNameConverter" />
            <converters:IReportableStatsMaximumUnitsConverter x:Key="IReportableStatsMaximumUnitsConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/DefaultBluePrintsResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/BaseModel;component/View/ResourceDictionaries/DefaultControlResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/ConverterResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Style="{StaticResource CollectionView.RootContainer}">
        <dxmvvm:Interaction.Behaviors>
            <dx:DialogService x:Name="ReportDialogService">
                <dx:DialogService.DialogStyle>
                    <Style TargetType="dx:DXDialogWindow">
                        <Setter Property="SizeToContent" Value="WidthAndHeight" />
                    </Style>
                </dx:DialogService.DialogStyle>
            </dx:DialogService>
        </dxmvvm:Interaction.Behaviors>
        <dxb:BarManager>
            <dxb:BarManager.Items>
                <dxb:BarSubItem ItemLinksSource="{StaticResource RibbonDefaultGridButtons}" />
                <dxb:BarButtonItem x:Name="biApproveSelectedInternal" Command="{Binding ApproveSelectedInternalNumbersCommand}" Content="Approve Internal Num(s)" Glyph="{dxc:DXImage Image=BOPermission_16x16.png}" LargeGlyph="{dx:DXImage Image=BOPermission_32x32.png}" ToolTip="Lock selected deliverable(s) internal numbers" />
                <dxb:BarButtonItem x:Name="biApproveSelectedClient" Command="{Binding ApproveSelectedClientNumbersCommand}" Content="Approve Client Num(s)" Glyph="{dxc:DXImage Image=BOPermission_16x16.png}" LargeGlyph="{dx:DXImage Image=BOPermission_32x32.png}" ToolTip="Lock selected deliverable(s) client numbers" />
                <dxb:BarButtonItem x:Name="biUnapproveSelectedInternal" Command="{Binding UnapproveSelectedInternalNumbersCommand}" Content="Unapprove Internal Num(s)" Glyph="{dxc:DXImage Image=Edit_16x16.png}" LargeGlyph="{dx:DXImage Image=Edit_32x32.png}" ToolTip="Unlock selected deliverable(s) internal numbers" />
                <dxb:BarButtonItem x:Name="biUnapproveSelectedClient" Command="{Binding UnapproveSelectedClientNumbersCommand}" Content="Unapprove Client Num(s)" Glyph="{dxc:DXImage Image=Edit_16x16.png}" LargeGlyph="{dx:DXImage Image=Edit_32x32.png}" ToolTip="Unlock selected deliverable(s) client numbers" />
                <dxb:BarButtonItem x:Name="biSendEmail" Command="{Binding SendEmailCommand}" Content="Send Approved Notification" Glyph="{dxc:DXImage Image=EmailTemplate_16x16.png}" LargeGlyph="{dx:DXImage Image=EmailTemplate_32x32.png}" ToolTip="Send approved client/internal number email notification" />
            </dxb:BarManager.Items>
            <DockPanel>
                <dxr:RibbonControl Style="{StaticResource DefaultRibbonControlStyle}">
                    <dxr:RibbonDefaultPageCategory MergeType="Replace" Caption="defaultCategory">
                        <dxr:RibbonPage MergeType="Replace" Caption="Grid">
                            <dxr:RibbonPageGroup MergeType="Replace" Caption="Grid" >
                                <dxb:BarButtonItemLink BarItemName="biFullRefresh1" />
                                <dxb:BarButtonItemLink BarItemName="biBulkDelete1" />
                                <dxb:BarButtonItemLink BarItemName="biUndo1" />
                                <dxb:BarButtonItemLink BarItemName="biRedo1" />
                                <dxb:BarCheckItemLink BarItemName="biCellSelection1" />
                                <dxb:BarButtonItemLink BarItemName="biExpandAllGroups1" />
                                <dxb:BarButtonItemLink BarItemName="biCollapseAllGroups1" />
                                <dxb:BarButtonItemLink BarItemName="biSaveLayout1" />
                                <dxb:BarButtonItemLink BarItemName="biResetLayout1" />
                            </dxr:RibbonPageGroup>
                        </dxr:RibbonPage>
                        <dxr:RibbonPage MergeType="Replace" Caption="Doc Control">
                            <dxr:RibbonPageGroup MergeType="Replace" Caption="Doc Control" >
                                <dxb:BarButtonItemLink BarItemName="biApproveSelectedInternal" />
                                <dxb:BarButtonItemLink BarItemName="biApproveSelectedClient" />
                                <dxb:BarButtonItemLink BarItemName="biUnapproveSelectedInternal" />
                                <dxb:BarButtonItemLink BarItemName="biUnapproveSelectedClient" />
                                <dxb:BarButtonItemLink BarItemName="biSendEmail" />
                            </dxr:RibbonPageGroup>
                        </dxr:RibbonPage>
                    </dxr:RibbonDefaultPageCategory>
                </dxr:RibbonControl>
                <dxlc:LayoutControl DockPanel.Dock="Right">
                    <dxlc:LayoutGroup.LayoutTransform>
                        <RotateTransform Angle="90" />
                    </dxlc:LayoutGroup.LayoutTransform>
                    <dxlc:LayoutGroup IsCollapsible="True" View="Group">
                        <Grid>
                            <Grid.LayoutTransform>
                                <RotateTransform Angle="-90" />
                            </Grid.LayoutTransform>
                            <filter:FilterAccordionView DataContext="{Binding FilterTreeViewModel}" />
                        </Grid>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutControl>
                <custom:GridControlEx x:Name="GridControl" dxc:DXSerializer.SerializationID="GridControlBASELINE_ITEM" dxc:DXSerializer.StoreLayoutMode="All" DockPanel.Dock="Right" Style="{StaticResource DefaultGridControlTemplate}">
                    <dxg:GridControl.Columns>
                        <dxg:GridColumn Tag="True;True;Autofill subjob" FieldName="Entity.Entity.BASELINE.PROJECT.NUMBER" GroupIndex="0" Header="Project" ReadOnly="True" />
                        <dxg:GridColumn Tag="True;True;Autofill subjob" FieldName="Entity.Entity.GUID_AREA" Header="Area" ReadOnly="True">
                            <dxg:GridColumn.EditSettings>
                                <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="INTERNAL_NUM" IsTextEditable="True" ItemsSource="{Binding AREACollection}" ValueMember="GUID" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn Tag="True;True;Autofill from subjob" FieldName="Entity.Entity.SubAreaGuid" Header="Sub-Area" ReadOnly="True">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <dxe:ComboBoxEdit x:Name="PART_Editor" DisplayMember="INTERNAL_NUM" ImmediatePopup="True" IncrementalFiltering="True" ItemsSource="{Binding RowData.Row.Entity.Entity.SubAreaCollection}" NullValueButtonPlacement="Popup" ValidateOnEnterKeyPressed="True" ValidateOnTextInput="True" ValueMember="GUID" />
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                            <!--  For Filtering  -->
                            <dxg:GridColumn.EditSettings>
                                <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="INTERNAL_NUM" IsTextEditable="True" ItemsSource="{Binding SUBAREACollection}" NullValueButtonPlacement="EditBox" ValueMember="GUID" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="Entity.Entity.GUID_DISCIPLINE" Header="Discipline" ReadOnly="True">
                            <dxg:GridColumn.EditSettings>
                                <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding DISCIPLINECollection}" ValueMember="GUID" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="Entity.Entity.DISCIPLINE_NUM" Header="Discipline Number" ReadOnly="True">
                            <dxg:GridColumn.EditSettings>
                                <dxe:SpinEditSettings Increment="1" IsFloatValue="False" IsTextEditable="True" Mask="n0" MaskType="Numeric" MaskUseAsDisplayFormat="True" MaxValue="99" MinValue="1" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="Entity.Entity.GUID_DOCTYPE" Header="Document Type" ReadOnly="True">
                            <dxg:GridColumn.EditSettings>
                                <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding DOCTYPECollection}" ValueMember="GUID" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="Entity.Entity.GUID_DEPARTMENT" Header="Department" ReadOnly="True">
                            <dxg:GridColumn.EditSettings>
                                <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding DEPARTMENTCollection}" ValueMember="GUID" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn Tag="True;False;Autofill from area, department, discipline and doc-type" FieldName="Entity.Entity.INTERNAL_NUM" Header="Internal Number" HeaderToolTip="Must be unique">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <!--  Use IsEnabled because when textEdit is invoked the 2nd time IsReadOnly didn't get picked up in the binding  -->
                                    <dxe:TextEdit Name="PART_Editor" IsEnabled="{Binding RowData.Row.IsInternalNumberEditable}" />
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="Entity.Entity.INTERNALNUM_STATUS" Header="Internal Number Status" ReadOnly="True">
                            <dxg:GridColumn.EditSettings>
                                <dxe:ComboBoxEditSettings AutoComplete="True" IsTextEditable="True" ItemsSource="{dxe:EnumItemsSource EnumType={x:Type common:DocumentNumberStatus}}" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="IsInternalNumberEditable" ReadOnly="True" Visible="False" />
                        <dxg:GridColumn FieldName="Entity.Entity.CLIENT_NUM" Header="Client Number">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <!--  Use IsEnabled because when textEdit is invoked the 2nd time IsReadOnly didn't get picked up in the binding  -->
                                    <dxe:TextEdit Name="PART_Editor" IsEnabled="{Binding RowData.Row.IsClientNumberEditable}" />
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="Entity.Entity.CLIENTNUM_STATUS" Header="Client Number Status" ReadOnly="True">
                            <dxg:GridColumn.EditSettings>
                                <dxe:ComboBoxEditSettings AutoComplete="True" IsTextEditable="True" ItemsSource="{dxe:EnumItemsSource EnumType={x:Type common:DocumentNumberStatus}}" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="Entity.Entity.REVISION_NUMBER" Header="Revision Number" ReadOnly="True" />
                        <dxg:GridColumn FieldName="Entity.Entity.DELIVERABLE_TYPE" Header="Deliverable Type" ReadOnly="True">
                            <dxg:GridColumn.EditSettings>
                                <dxe:ComboBoxEditSettings AutoComplete="True" IsTextEditable="True" ItemsSource="{dxe:EnumItemsSource EnumType={x:Type common:DeliverableType}}" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="Entity.Entity.PRIMARY_TITLE" Header="Primary Title" ReadOnly="True" />
                        <dxg:GridColumn FieldName="Entity.Entity.SECONDARY_TITLE" Header="Secondary Title" ReadOnly="True" />
                        <dxg:GridColumn FieldName="Entity.Entity.COMMENTS" Header="Comments" ReadOnly="True" />
                        <dxg:GridColumn FieldName="Entity.Entity.DeliverableStatusGuid" FilterPopupMode="Custom" Header="Status" ReadOnly="True">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <dxe:ComboBoxEdit x:Name="PART_Editor" DisplayMember="NAME" ImmediatePopup="True" IncrementalFiltering="True" ItemsSource="{Binding RowData.Row.Entity.Entity.DeliverableStatusCollection}" NullValueButtonPlacement="Popup" ValidateOnEnterKeyPressed="True" ValidateOnTextInput="True" ValueMember="GUID" />
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                            <!--  For Filtering  -->
                            <dxg:GridColumn.EditSettings>
                                <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding DELIVERABLES_STATUSCollection}" NullValueButtonPlacement="EditBox" ValueMember="GUID" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="Entity.Entity.GUID_USER" Header="Resource" ReadOnly="True">
                            <dxg:GridColumn.EditSettings>
                                <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding USERCollection}" NullValueButtonPlacement="EditBox" ValueMember="GUID" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="Entity.Entity.BY_DURATION" Header="By Duration" ReadOnly="True">
                            <dxg:GridColumn.EditSettings>
                                <dxe:CheckEditSettings />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="Entity.Entity.BUDGET_HOURS" Header="Budget Hours" HeaderToolTip="Baseline hours" ReadOnly="True">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="15" />
                                            <ColumnDefinition Width="15" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Grid.Column="0" Source="{dx:DXImage Image=First_16x16.png}" ToolTip="Cannot reduce anymore because these units has already been earned">
                                            <Image.Visibility>
                                                <MultiBinding Converter="{StaticResource NumericCompareToVisibilityConverter}" FallbackValue="Hidden">
                                                    <MultiBinding.ConverterParameter>
                                                        <sys:Boolean>False</sys:Boolean>
                                                    </MultiBinding.ConverterParameter>
                                                    <Binding ElementName="PART_Editor" Path="MinValue" />
                                                    <Binding ElementName="PART_Editor" Path="EditValue" />
                                                </MultiBinding>
                                            </Image.Visibility>
                                        </Image>
                                        <Image Grid.Column="1" Source="{dx:DXImage Image=Last_16x16.png}" ToolTip="Maximum possible units, please reduce other deliverable units to increase this">
                                            <Image.Visibility>
                                                <MultiBinding Converter="{StaticResource NumericCompareToVisibilityConverter}" FallbackValue="Hidden">
                                                    <MultiBinding.ConverterParameter>
                                                        <sys:Boolean>False</sys:Boolean>
                                                    </MultiBinding.ConverterParameter>
                                                    <Binding ElementName="PART_Editor" Path="MaxValue" />
                                                    <Binding ElementName="PART_Editor" Path="EditValue" />
                                                </MultiBinding>
                                            </Image.Visibility>
                                        </Image>
                                        <dxe:SpinEdit Name="PART_Editor" Grid.Column="2" Increment="1" IsReadOnly="{Binding RowData.Row.Entity.Entity.BY_DURATION}" Mask="n" MaskType="Numeric" MaskUseAsDisplayFormat="True" MinValue="{Binding RowData.Row.MinEstimateUnits}">
                                            <dxe:SpinEdit.MaxValue>
                                                <MultiBinding Converter="{StaticResource IReportableStatsMaximumUnitsConverter}">
                                                    <Binding ElementName="userControl" Path="TotalAllowedUnits" />
                                                    <Binding ElementName="userControl" Path="DisplayEntities" />
                                                    <Binding Path="RowData.Row" />
                                                </MultiBinding>
                                            </dxe:SpinEdit.MaxValue>
                                        </dxe:SpinEdit>
                                    </Grid>
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                            <!--For Filtering-->
                            <dxg:GridColumn.EditSettings>
                                <dxe:SpinEditSettings Mask="n" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="Entity.Entity.TARGET_DATE" Header="Target Date" HeaderToolTip="Due date" ReadOnly="True">
                            <dxg:GridColumn.EditSettings>
                                <dxe:DateEditSettings NullValueButtonPlacement="Popup" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="Variation_Units" Header="Variation Hours" HeaderToolTip="Variation hours have to be added from the variation page and approved to be shown here" ReadOnly="True" >
                            <!--For Filtering-->
                            <dxg:GridColumn.EditSettings>
                                <dxe:SpinEditSettings Mask="n" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="Total_Units" Header="Total Hours" HeaderToolTip="Budget Hours + Variation Hours" ReadOnly="True" >
                            <!--For Filtering-->
                            <dxg:GridColumn.EditSettings>
                                <dxe:SpinEditSettings Mask="n" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn AllowSearchPanel="False" FieldName="Total_Costs" Header="Total Costs" HeaderToolTip="Rate * (Budget Hours + Variation Hours). Rates are located in the rates table and assigned to deliverables by discipline" ReadOnly="True">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <dxe:TextEdit Name="PART_Editor" Mask="c" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                            <!--For Filtering-->
                            <dxg:GridColumn.EditSettings>
                                <dxe:SpinEditSettings Mask="c" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="CanBook" Header="Can Book" HeaderToolTip="Time can be booked in exo" ReadOnly="True" />
                        <dxg:GridColumn FieldName="Entity.Entity.GUID_OFFICE" Header="Office">
                            <dxg:GridColumn.EditSettings>
                                <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding OFFICECollection}" ValueMember="GUID" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="Entity.Entity.GUID_PHASE" Header="Phase" ReadOnly="True">
                            <dxg:GridColumn.EditSettings>
                                <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="INTERNAL_NUM" IsTextEditable="True" ItemsSource="{Binding PHASECollection}" ValueMember="GUID" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn Tag="True;True;Autofill from area and sub-area" FieldName="Entity.Entity.GUID_SUBJOB" Header="Subjob" ReadOnly="True" Visible="true">
                            <dxg:GridColumn.EditSettings>
                                <dxe:ComboBoxEditSettings Name="PART_Editor_InternalName1" AutoComplete="True" DisplayMember="INTERNAL_NAME1" IsTextEditable="True" ItemsSource="{Binding SUBJOBCollection}" ValueMember="GUID" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn Tag="True;True;Autofill from workpack, discipline and discipline number" FieldName="Entity.Entity.GUID_WORKPACK" Header="Workpack" ReadOnly="True" Visible="true">
                            <dxg:GridColumn.EditSettings>
                                <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding WORKPACKCollection}" ValueMember="GUID" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn AllowSearchPanel="False" FieldName="Entity.Entity.CREATED" Header="Created" ReadOnly="True">
                            <dxg:GridColumn.EditSettings>
                                <dxe:DateEditSettings DisplayFormat="dd-MMM-yyyy HH:mm" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn AllowSearchPanel="False" FieldName="Entity.Entity.CREATEDBY" Header="Created By" ReadOnly="True" Visible="False">
                            <dxg:GridColumn.EditSettings>
                                <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding USERCollection}" ValueMember="GUID" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn AllowSearchPanel="False" FieldName="Entity.Entity.UPDATED" Header="Updated" ReadOnly="True">
                            <dxg:GridColumn.EditSettings>
                                <dxe:DateEditSettings DisplayFormat="dd-MMM-yyyy HH:mm" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn AllowSearchPanel="False" FieldName="Entity.Entity.UPDATEDBY" Header="Updated By" ReadOnly="True" Visible="False">
                            <dxg:GridColumn.EditSettings>
                                <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding USERCollection}" ValueMember="GUID" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn AllowSearchPanel="False" FieldName="Entity.Entity.GUID_ORIGINAL" Header="Key" HeaderToolTip="Key to match progress. Can be used to trace original record from previous baseline revisions" ReadOnly="True" Visible="False" />
                        <dxg:GridColumn AllowSearchPanel="False" FieldName="Entity.Entity.Holds" Header="Holds" HeaderToolTip="Holds on deliverable" ReadOnly="True" Visible="True" />
                    </dxg:GridControl.Columns>
                    <dxg:GridControl.GroupSummary>
                        <dxg:GridSummaryItem FieldName="Entity.Entity.BUDGET_HOURS" dxc:DXSerializer.Enabled="False" DisplayFormat="{}{0} Record(s)" SummaryType="Count" />
                        <dxg:GridSummaryItem dxc:DXSerializer.Enabled="False" DisplayFormat="n" FieldName="Entity.Entity.BUDGET_HOURS" ShowInColumn="Entity.Entity.BUDGET_HOURS" SummaryType="Sum" />
                        <dxg:GridSummaryItem dxc:DXSerializer.Enabled="False" DisplayFormat="n" FieldName="Entity.Entity.Total_Units" ShowInColumn="Entity.Entity.Total_Units" SummaryType="Sum" />
                        <dxg:GridSummaryItem dxc:DXSerializer.Enabled="False" DisplayFormat="c2" FieldName="Entity.Total_Costs" ShowInColumn="Entity.Total_Costs" SummaryType="Sum" />
                        <dxg:GridSummaryItem dxc:DXSerializer.Enabled="False" DisplayFormat="n" FieldName="Entity.Entity.DC_HOURS" ShowInColumn="Entity.Entity.DC_HOURS" SummaryType="Sum" />
                    </dxg:GridControl.GroupSummary>
                    <dxg:GridControl.TotalSummary>
                        <dxg:GridSummaryItem FieldName="Entity.Entity.BUDGET_HOURS" dxc:DXSerializer.Enabled="False" DisplayFormat="{}{0} Record(s)" SummaryType="Count" />
                        <dxg:GridSummaryItem dxc:DXSerializer.Enabled="False" DisplayFormat="n" FieldName="Entity.Entity.BUDGET_HOURS" ShowInColumn="Entity.Entity.BUDGET_HOURS" SummaryType="Sum" />
                        <dxg:GridSummaryItem dxc:DXSerializer.Enabled="False" DisplayFormat="n" FieldName="Entity.Entity.Total_Units" ShowInColumn="Entity.Entity.Total_Units" SummaryType="Sum" />
                        <dxg:GridSummaryItem dxc:DXSerializer.Enabled="False" DisplayFormat="c2" FieldName="Entity.Total_Costs" ShowInColumn="Entity.Total_Costs" SummaryType="Sum" />
                        <dxg:GridSummaryItem dxc:DXSerializer.Enabled="False" DisplayFormat="n" FieldName="Entity.Entity.DC_HOURS" ShowInColumn="Entity.Entity.DC_HOURS" SummaryType="Sum" />
                    </dxg:GridControl.TotalSummary>
                    <dxg:GridControl.View>
                        <dxg:TableView x:Name="tableView" Style="{StaticResource DefaultTableViewTemplate}">
                            <dxmvvm:Interaction.Behaviors>
                                <dxmvvm:EventToCommand Command="{Binding CellValueChangedCommand}" EventName="CellValueChanged" PassEventArgsToCommand="True" />
                            </dxmvvm:Interaction.Behaviors>
                            <dxg:TableView.RowCellMenuCustomizations>
                                <dxb:BarLinkContainerItem ItemLinksSource="{StaticResource ContextMenuDefaultHeaderButtons}" />
                                <dxb:BarItemLinkSeparator />
                                <dxb:BarButtonItemLink BarItemName="biApproveSelectedInternal" />
                                <dxb:BarButtonItemLink BarItemName="biApproveSelectedClient" />
                                <dxb:BarButtonItemLink BarItemName="biUnapproveSelectedInternal" />
                                <dxb:BarButtonItemLink BarItemName="biUnapproveSelectedClient" />
                                <dxb:BarItemLinkSeparator />
                                <dxb:BarButtonItemLink BarItemName="biBulkDelete1" />
                                <dxb:BarButtonItemLink BarItemName="biFullRefresh1" />
                            </dxg:TableView.RowCellMenuCustomizations>
                            <dxg:TableView.FormatConditions>
