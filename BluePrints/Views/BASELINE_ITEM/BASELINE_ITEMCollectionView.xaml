<UserControl x:Class="BluePrints.Views.BASELINE_ITEMCollectionView" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:common="clr-namespace:BluePrints.Common" xmlns:converters="clr-namespace:BluePrints.Common.ViewModel.Converters" xmlns:custom="clr-namespace:BaseModel.Misc;assembly=BaseModel" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxa="http://schemas.devexpress.com/winfx/2008/xaml/accordion" xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon" xmlns:dxrudex="http://schemas.devexpress.com/winfx/2008/xaml/reports/userdesignerextensions" xmlns:filter="clr-namespace:BluePrints.Common.Filtering" xmlns:helper="clr-namespace:BluePrints.Common.Helpers" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:view="clr-namespace:BluePrints.Views" xmlns:viewmodel="clr-namespace:BluePrints.ViewModels" x:Name="userControl" d:DesignHeight="400" d:DesignWidth="600" DataContext="{dxmvvm:ViewModelSource viewmodel:BASELINE_ITEMCollectionViewModelWrapper}" mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <DataTemplate x:Key="glyphTemplate">
                <dxc:DXImage x:Name="glyph" Width="16" Height="16" Margin="3,0,0,0" SnapsToDevicePixels="True" Source="{Binding}" />
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                        <Setter TargetName="glyph" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
            <Style x:Key="accordionItemContainerStyle" TargetType="dxa:AccordionItem">
                <Setter Property="Header" Value="{Binding Name}" />
                <Style.Triggers>
                    <Trigger Property="ItemLevel" Value="1">
                        <Setter Property="ShowInCollapsedMode" Value="{Binding ShowInCollapsedMode}" />
                        <Setter Property="Glyph" Value="{Binding Icon}" />
                        <Setter Property="GlyphTemplate" Value="{StaticResource glyphTemplate}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <common:RowNameConverter x:Key="RowNameConverter" />
            <converters:IReportableStatsMaximumUnitsConverter x:Key="IReportableStatsMaximumUnitsConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/DefaultBluePrintsResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/BaseModel;component/View/ResourceDictionaries/DefaultControlResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/ConverterResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Style="{StaticResource CollectionView.RootContainer}">
        <dxmvvm:Interaction.Behaviors>
            <dxc:DialogService x:Name="MapDeliverableDialog">
                <dxc:DialogService.DialogStyle>
                    <Style TargetType="dx:DXDialogWindow">
                        <Setter Property="SizeToContent" Value="WidthAndHeight" />
                        <Setter Property="MinWidth" Value="600" />
                        <Setter Property="MinHeight" Value="600" />
                    </Style>
                </dxc:DialogService.DialogStyle>
            </dxc:DialogService>
        </dxmvvm:Interaction.Behaviors>
        <Grid DataContext="{Binding MainViewModel}">
            <DockPanel>
                <dxr:RibbonControl AllowCustomization="False" DockPanel.Dock="Top" MDIMergeStyle="Always" RibbonStyle="Office2010">
                    <dxr:RibbonDefaultPageCategory Caption="defaultCategory">
                        <dxr:RibbonPage Caption="Live Deliverables">
                            <dxr:RibbonPageGroup Caption="Grid" ItemLinksSource="{StaticResource RibbonDefaultGridButtons}" />
                            <dxr:RibbonPageGroup Caption="Layout" ItemLinksSource="{StaticResource RibbonDefaultLayoutButtons}" />
                            <dxr:RibbonPageGroup Caption="Report" ItemLinksSource="{StaticResource RibbonDefaultReportingButtons}" />
                            <dxr:RibbonPageGroup Caption="Internal Number Mode">
                                <dxb:BarCheckItem Content="Default" ToolTip="Only non-progressed internal number can be edited and auto-generated" IsChecked="{Binding DataContext.InternalNumDefault, ElementName=userControl, Mode=TwoWay}" LargeGlyph="{dx:DXImage Image=CheckButtons_32x32.png}" Glyph="{dxc:DXImage Image=CheckButtons_16x16.png}" />
                                <dxb:BarCheckItem Content="Editable" ToolTip="All internal number can be auto-generated and edited" IsChecked="{Binding DataContext.InternalNumAlwaysEditable, ElementName=userControl, Mode=TwoWay}" LargeGlyph="{dx:DXImage Image=EditName_32x32.png}" Glyph="{dxc:DXImage Image=EditName_16x16.png}" />
                                <dxb:BarCheckItem Content="Manual" ToolTip="Only non-progressed internal number can be manually edited or populated by context menu option" IsChecked="{Binding DataContext.InternalNumManual, ElementName=userControl, Mode=TwoWay}" LargeGlyph="{dx:DXImage Image=BORules_32x32.png}" Glyph="{dxc:DXImage Image=BORules_16x16.png}" />
                            </dxr:RibbonPageGroup>
                            <dxr:RibbonPageGroup Caption="Tools">
                                <dxb:BarCheckItem Content="Lock Baseline" ToolTip="Lock total budget units, so that units assigned to all deliverables cannot exceed the current total units" IsChecked="{Binding DataContext.IsBASELINELocked, ElementName=userControl}" LargeGlyph="{dxc:DXImage Image=ProtectDocument_32x32.png}" Glyph="{dxc:DXImage Image=ProtectDocument_16x16.png}" />
                                <dxb:BarButtonItem Content="Import Client Numbers" ToolTip="Copy 2 columns from excel with the left being internal number and the right being client number, then paste it in here" Command="{Binding DataContext.MapClientNumberCommand, ElementName=userControl}" LargeGlyph="{dxc:DXImage Image=Wizard_32x32.png}" Glyph="{dx:DXImage Image=Wizard_16x16.png}" />
                            </dxr:RibbonPageGroup>
                        </dxr:RibbonPage>
                    </dxr:RibbonDefaultPageCategory>
                </dxr:RibbonControl>
                <dxr:RibbonStatusBarControl DockPanel.Dock="Bottom">
                    <dxr:RibbonStatusBarControl.LeftItems>
                        <dxb:BarStaticItem Content="{Binding Entities.Count, Converter={dxmvvm:FormatStringConverter FormatString='RECORDS: {0}'}}" />
                    </dxr:RibbonStatusBarControl.LeftItems>
                </dxr:RibbonStatusBarControl>
                <dxlc:LayoutControl DockPanel.Dock="Right">
                    <dxlc:LayoutGroup.LayoutTransform>
                        <RotateTransform Angle="90" />
                    </dxlc:LayoutGroup.LayoutTransform>
                    <dxlc:LayoutGroup IsCollapsible="True" View="Group">
                        <Grid>
                            <Grid.LayoutTransform>
                                <RotateTransform Angle="-90" />
                            </Grid.LayoutTransform>
                            <filter:FilterAccordionView DataContext="{Binding DataContext.FilterTreeViewModel, ElementName=userControl}" />
                        </Grid>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutControl>
                <custom:GridControlEx x:Name="GridControl" dxc:DXSerializer.SerializationID="GridControlBASELINE_ITEM" dxc:DXSerializer.StoreLayoutMode="All" DockPanel.Dock="Right" Style="{StaticResource DefaultGridControlTemplate}">
                    <dxg:GridControl.Columns>
                        <custom:GridColumnEx Header="Area" FieldName="Entity.Entity.GUID_AREA" HeaderToolTip="Changing this field may affect subjob and workpack name, see internal number mode default, editable, manual on the ribbon" FilterPopupMode="CheckedList" Tag="True;True;Autofill subjob">
                            <custom:GridColumnEx.EditSettings>
                                <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="INTERNAL_NUM" IsTextEditable="True" ItemsSource="{Binding DataContext.AREACollection, ElementName=userControl}" ValueMember="GUID" />
                            </custom:GridColumnEx.EditSettings>
                        </custom:GridColumnEx>
                        <custom:GridColumnEx Header="Sub-Area" FieldName="Entity.Entity.SubAreaGuid" HeaderToolTip="Changing this field may affect subjob and workpack name, see internal number mode default, editable, manual on the ribbon" ColumnFilterMode="DisplayText" FilterPopupMode="CheckedList" Tag="True;True;Autofill from subjob">
                            <custom:GridColumnEx.CellTemplate>
                                <DataTemplate>
                                    <dxe:ComboBoxEdit x:Name="PART_Editor" DisplayMember="INTERNAL_NUM" ImmediatePopup="True" IncrementalFiltering="True" ItemsSource="{Binding RowData.Row.Entity.Entity.SubAreaCollection}" NullValueButtonPlacement="Popup" ValidateOnEnterKeyPressed="True" ValidateOnTextInput="True" ValueMember="GUID" />
                                </DataTemplate>
                            </custom:GridColumnEx.CellTemplate>
                            <!--  For Filtering  -->
                            <custom:GridColumnEx.EditSettings>
                                <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="INTERNAL_NUM" IsTextEditable="True" ItemsSource="{Binding DataContext.SUBAREACollection, ElementName=userControl}" NullValueButtonPlacement="EditBox" ValueMember="GUID" />
                            </custom:GridColumnEx.EditSettings>
                        </custom:GridColumnEx>
                        <custom:GridColumnEx Header="Document Type" FieldName="Entity.Entity.GUID_DOCTYPE" HeaderToolTip="Changing  this fieldmay affect subjob and workpack name, see internal number mode default, editable, manual on the ribbon" FilterPopupMode="CheckedList">
                            <custom:GridColumnEx.EditSettings>
                                <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding DataContext.DOCTYPECollection, ElementName=userControl}" ValueMember="GUID" />
                            </custom:GridColumnEx.EditSettings>
                        </custom:GridColumnEx>
                        <custom:GridColumnEx Header="Discipline" FieldName="Entity.Entity.GUID_DISCIPLINE" FilterPopupMode="CheckedList">
                            <custom:GridColumnEx.EditSettings>
                                <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding DataContext.DISCIPLINECollection, ElementName=userControl}" ValueMember="GUID" />
                            </custom:GridColumnEx.EditSettings>
                        </custom:GridColumnEx>
                        <custom:GridColumnEx Header="Discipline Number" FieldName="Entity.Entity.DISCIPLINE_NUM" HeaderToolTip="Changing  this fieldmay affect workpack name, see internal number mode default, editable, manual on the ribbon" FilterPopupMode="CheckedList">
                            <custom:GridColumnEx.EditSettings>
                                <dxe:SpinEditSettings Increment="1" IsFloatValue="False" IsTextEditable="True" Mask="n0" MaskType="Numeric" MaskUseAsDisplayFormat="True" MaxValue="99" MinValue="1" />
                            </custom:GridColumnEx.EditSettings>
                        </custom:GridColumnEx>
                        <custom:GridColumnEx Header="Department" FieldName="Entity.Entity.GUID_DEPARTMENT" HeaderToolTip="Default value can be populated by document type selection" FilterPopupMode="CheckedList">
                            <custom:GridColumnEx.EditSettings>
                                <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding DataContext.DEPARTMENTCollection, ElementName=userControl}" ValueMember="GUID" />
                            </custom:GridColumnEx.EditSettings>
                        </custom:GridColumnEx>
                        <custom:GridColumnEx Header="Internal Number" FieldName="Entity.Entity.INTERNAL_NUM" HeaderToolTip="Must be unique" FilterPopupMode="CheckedList" Tag="True;False;Autofill from area, department, discipline and doc-type">
                            <custom:GridColumnEx.CellTemplate>
                                <DataTemplate>
                                    <!--  Use IsEnabled because when textEdit is invoked the 2nd time IsReadOnly didn't get picked up in the binding  -->
                                    <dxe:TextEdit Name="PART_Editor" IsEnabled="{Binding RowData.Row.IsInternalNumberEditable}" />
                                </DataTemplate>
                            </custom:GridColumnEx.CellTemplate>
                        </custom:GridColumnEx>
                        <custom:GridColumnEx Header="Client Number" FieldName="Entity.Entity.CLIENT_NUM" FilterPopupMode="CheckedList" />
                        <custom:GridColumnEx Header="Revision Number" FieldName="Entity.Entity.REVISION_NUMBER" FilterPopupMode="CheckedList" />
                        <custom:GridColumnEx Header="Deliverable Type" FieldName="Entity.Entity.DELIVERABLE_TYPE" FilterPopupMode="CheckedList">
                            <custom:GridColumnEx.EditSettings>
                                <dxe:ComboBoxEditSettings AutoComplete="True" IsTextEditable="True" ItemsSource="{dxe:EnumItemsSource EnumType={x:Type common:DeliverableType}}" />
                            </custom:GridColumnEx.EditSettings>
                        </custom:GridColumnEx>
                        <custom:GridColumnEx Header="Primary Title" FieldName="Entity.Entity.PRIMARY_TITLE" FilterPopupMode="CheckedList" />
                        <custom:GridColumnEx Header="Secondary Title" FieldName="Entity.Entity.SECONDARY_TITLE" FilterPopupMode="CheckedList" />
                        <custom:GridColumnEx Header="Comments" FieldName="Entity.Entity.COMMENTS" FilterPopupMode="CheckedList" />
                        <custom:GridColumnEx Header="Status" FieldName="Entity.Entity.DeliverableStatusGuid" HeaderToolTip="Changing this field may affect progress if [Update % by Status] button is click in progress" ColumnFilterMode="DisplayText" FilterPopupMode="Custom">
                            <custom:GridColumnEx.CellTemplate>
                                <DataTemplate>
                                    <dxe:ComboBoxEdit x:Name="PART_Editor" DisplayMember="NAME" ImmediatePopup="True" IncrementalFiltering="True" ItemsSource="{Binding RowData.Row.Entity.Entity.DeliverableStatusCollection}" NullValueButtonPlacement="Popup" ValidateOnEnterKeyPressed="True" ValidateOnTextInput="True" ValueMember="GUID" />
                                </DataTemplate>
                            </custom:GridColumnEx.CellTemplate>
                            <!--  For Filtering  -->
                            <custom:GridColumnEx.EditSettings>
                                <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding DataContext.DELIVERABLES_STATUSCollection, ElementName=userControl}" NullValueButtonPlacement="EditBox" ValueMember="GUID" />
                            </custom:GridColumnEx.EditSettings>
                        </custom:GridColumnEx>
                        <custom:GridColumnEx Header="Resource" FieldName="Entity.Entity.GUID_USER" FilterPopupMode="CheckedList">
                            <custom:GridColumnEx.EditSettings>
                                <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding DataContext.USERCollection, ElementName=userControl}" NullValueButtonPlacement="EditBox" ValueMember="GUID" />
                            </custom:GridColumnEx.EditSettings>
                        </custom:GridColumnEx>
                        <custom:GridColumnEx Header="By Duration" FieldName="Entity.Entity.BY_DURATION" HeaderToolTip="Check this so that deliverable can be mapped to P6 activity without increasing it's budgeted units" FilterPopupMode="CheckedList">
                            <custom:GridColumnEx.EditSettings>
                                <dxe:CheckEditSettings />
                            </custom:GridColumnEx.EditSettings>
                        </custom:GridColumnEx>
                        <custom:GridColumnEx Header="Budget Hours" FieldName="Entity.Entity.BUDGET_HOURS" HeaderToolTip="Baseline hours" FilterPopupMode="CheckedList">
                            <custom:GridColumnEx.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="15" />
                                            <ColumnDefinition Width="15" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image ToolTip="Cannot reduce anymore because these units has already been earned" Grid.Column="0" Source="{Binding Source=DevExpress.Xpf.Core.Editors.Images.info.png, Converter={StaticResource EmbeddedResourceImageConverter}}">
                                            <Image.Visibility>
                                                <MultiBinding Converter="{StaticResource NumericCompareToVisibilityConverter}" FallbackValue="Hidden">
                                                    <MultiBinding.ConverterParameter>
                                                        <sys:Boolean>False</sys:Boolean>
                                                    </MultiBinding.ConverterParameter>
                                                    <Binding ElementName="PART_Editor" Path="MinValue" />
                                                    <Binding ElementName="PART_Editor" Path="EditValue" />
                                                </MultiBinding>
                                            </Image.Visibility>
                                        </Image>
                                        <Image ToolTip="Maximum possible units, please reduce other deliverable units to increase this" Grid.Column="1" Source="{Binding Source=DevExpress.Xpf.Core.Editors.Images.info.png, Converter={StaticResource EmbeddedResourceImageConverter}}">
                                            <Image.Visibility>
                                                <MultiBinding Converter="{StaticResource NumericCompareToVisibilityConverter}" FallbackValue="Hidden">
                                                    <MultiBinding.ConverterParameter>
                                                        <sys:Boolean>False</sys:Boolean>
                                                    </MultiBinding.ConverterParameter>
                                                    <Binding ElementName="PART_Editor" Path="MaxValue" />
                                                    <Binding ElementName="PART_Editor" Path="EditValue" />
                                                </MultiBinding>
                                            </Image.Visibility>
                                        </Image>
                                        <dxe:SpinEdit Name="PART_Editor" Grid.Column="2" Increment="1" IsReadOnly="{Binding RowData.Row.Entity.Entity.BY_DURATION}" Mask="n" MaskType="Numeric" MaskUseAsDisplayFormat="True" MinValue="{Binding RowData.Row.MinEstimateUnits}">
                                            <dxe:SpinEdit.MaxValue>
                                                <MultiBinding Converter="{StaticResource IReportableStatsMaximumUnitsConverter}">
                                                    <Binding ElementName="userControl" Path="DataContext.TotalAllowedUnits" />
                                                    <Binding ElementName="userControl" Path="DataContext.DisplayEntities" />
                                                    <Binding Path="RowData.Row" />
                                                </MultiBinding>
                                            </dxe:SpinEdit.MaxValue>
                                        </dxe:SpinEdit>
                                    </Grid>
                                </DataTemplate>
                            </custom:GridColumnEx.CellTemplate>
                        </custom:GridColumnEx>
                        <custom:GridColumnEx Header="Target Date" FieldName="Entity.Entity.TARGET_DATE" HeaderToolTip="Due date" FilterPopupMode="CheckedList">
                            <custom:GridColumnEx.EditSettings>
                                <dxe:DateEditSettings NullValueButtonPlacement="Popup" />
                            </custom:GridColumnEx.EditSettings>
                        </custom:GridColumnEx>
                        <custom:GridColumnEx Header="Variation Hours" FieldName="Entity.Entity.DC_HOURS" HeaderToolTip="Variation hours have to be added from the variation page and approved to be shown here" ReadOnly="True" FilterPopupMode="CheckedList" />
                        <custom:GridColumnEx Header="Total Hours" FieldName="Entity.Entity.Total_Units" HeaderToolTip="Estimated Hours + Variation Hours" ReadOnly="True" FilterPopupMode="CheckedList" />
                        <custom:GridColumnEx Header="Total Costs" FieldName="Entity.Total_Costs" HeaderToolTip="Rate * (Estimated Hours + Variation Hours). Rates are located in the rates table and assigned to deliverables by discipline" ReadOnly="True" AllowSearchPanel="False" FilterPopupMode="CheckedList">
                            <custom:GridColumnEx.CellTemplate>
                                <DataTemplate>
                                    <dxe:TextEdit Name="PART_Editor" Mask="c" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                </DataTemplate>
                            </custom:GridColumnEx.CellTemplate>
                        </custom:GridColumnEx>
                        <custom:GridColumnEx Header="Phase" FieldName="Entity.Entity.GUID_PHASE" HeaderToolTip="Automatically assigned field. Changing this will affect subjob and workpack name" FilterPopupMode="CheckedList">
                            <custom:GridColumnEx.EditSettings>
                                <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="INTERNAL_NUM" IsTextEditable="True" ItemsSource="{Binding DataContext.PHASECollection, ElementName=userControl}" ValueMember="GUID" />
                            </custom:GridColumnEx.EditSettings>
                        </custom:GridColumnEx>
                        <custom:GridColumnEx Header="Subjob" FieldName="Entity.Entity.GUID_SUBJOB" HeaderToolTip="Automatically assigned field. Changing this will affect workpack name" FilterPopupMode="CheckedList" Tag="True;True;Autofill from area and sub-area" Visible="true">
                            <custom:GridColumnEx.EditSettings>
                                <dxe:ComboBoxEditSettings Name="PART_Editor_InternalName1" AutoComplete="True" DisplayMember="INTERNAL_NAME1" IsTextEditable="True" ItemsSource="{Binding DataContext.SUBJOBCollection, ElementName=userControl}" ValueMember="GUID" />
                            </custom:GridColumnEx.EditSettings>
                        </custom:GridColumnEx>
                        <custom:GridColumnEx Header="Workpack" FieldName="Entity.Entity.GUID_WORKPACK" HeaderToolTip="Automatically assigned field. Must match Exo subjob to produce a summary of burned" FilterPopupMode="CheckedList" Tag="True;True;Autofill from workpack, discipline and discipline number" Visible="true">
                            <custom:GridColumnEx.EditSettings>
                                <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding DataContext.WORKPACKCollection, ElementName=userControl}" ValueMember="GUID" />
                            </custom:GridColumnEx.EditSettings>
                        </custom:GridColumnEx>
                        <custom:GridColumnEx Header="Created" FieldName="Entity.Entity.CREATED" ReadOnly="True" AllowSearchPanel="False" FilterPopupMode="CheckedList" Visible="False" />
                        <custom:GridColumnEx Header="Created By" FieldName="Entity.Entity.CREATEDBY" ReadOnly="True" AllowSearchPanel="False" FilterPopupMode="CheckedList" Visible="False">
                            <custom:GridColumnEx.EditSettings>
                                <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding DataContext.USERCollection, ElementName=userControl}" ValueMember="GUID" />
                            </custom:GridColumnEx.EditSettings>
                        </custom:GridColumnEx>
                        <custom:GridColumnEx Header="Updated" FieldName="Entity.Entity.UPDATED" ReadOnly="True" AllowSearchPanel="False" FilterPopupMode="CheckedList" Visible="False" />
                        <custom:GridColumnEx Header="Updated By" FieldName="Entity.Entity.UPDATEDBY" ReadOnly="True" AllowSearchPanel="False" FilterPopupMode="CheckedList" Visible="False">
                            <custom:GridColumnEx.EditSettings>
                                <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding DataContext.USERCollection, ElementName=userControl}" ValueMember="GUID" />
                            </custom:GridColumnEx.EditSettings>
                        </custom:GridColumnEx>
                        <custom:GridColumnEx Header="Key" FieldName="Entity.Entity.GUID_ORIGINAL" HeaderToolTip="Key to match progress. Can be used to trace original record from previous baseline revisions" ReadOnly="True" AllowSearchPanel="False" FilterPopupMode="CheckedList" Visible="False" />
                    </dxg:GridControl.Columns>
                    <dxg:GridControl.GroupSummary>
                        <dxg:GridSummaryItem FieldName="Entity.Entity.COMMENTS" dxc:DXSerializer.Enabled="False" DisplayFormat="Total {0} Records" ShowInColumn="Entity.Entity.COMMENTS" SummaryType="Count" />
                        <dxg:GridSummaryItem FieldName="Entity.Entity.BUDGET_HOURS" dxc:DXSerializer.Enabled="False" DisplayFormat="Total: {0}" ShowInColumn="Entity.Entity.BUDGET_HOURS" SummaryType="Sum" />
                        <dxg:GridSummaryItem FieldName="Entity.Total_Costs" dxc:DXSerializer.Enabled="False" DisplayFormat="Total: {0:c2}" ShowInColumn="Entity.Total_Costs" SummaryType="Sum" />
                        <dxg:GridSummaryItem FieldName="Entity.Entity.DC_HOURS" dxc:DXSerializer.Enabled="False" DisplayFormat="Total: {0:n}" ShowInColumn="Entity.Entity.DC_HOURS" SummaryType="Sum" />
                    </dxg:GridControl.GroupSummary>
                    <dxg:GridControl.TotalSummary>
                        <dxg:GridSummaryItem FieldName="Entity.Entity.COMMENTS" dxc:DXSerializer.Enabled="False" DisplayFormat="Total {0} Records" ShowInColumn="Entity.Entity.COMMENTS" SummaryType="Count" />
                        <dxg:GridSummaryItem FieldName="Entity.Entity.BUDGET_HOURS" dxc:DXSerializer.Enabled="False" DisplayFormat="Total: {0}" ShowInColumn="Entity.Entity.BUDGET_HOURS" SummaryType="Sum" />
                        <dxg:GridSummaryItem FieldName="Entity.Total_Costs" dxc:DXSerializer.Enabled="False" DisplayFormat="Total: {0:c2}" ShowInColumn="Entity.Total_Costs" SummaryType="Sum" />
                        <dxg:GridSummaryItem FieldName="Entity.Entity.DC_HOURS" dxc:DXSerializer.Enabled="False" DisplayFormat="Total: {0:n}" ShowInColumn="Entity.Entity.DC_HOURS" SummaryType="Sum" />
                    </dxg:GridControl.TotalSummary>
                    <dxg:GridControl.View>
                        <dxg:TableView x:Name="tableView" ShowGridMenu="tableView_ShowGridMenu" Style="{StaticResource DefaultTableViewTemplate}">
                            <dxmvvm:Interaction.Behaviors>
                                <dxmvvm:EventToCommand Command="{Binding DataContext.CellValueChangedCommand, ElementName=userControl}" EventName="CellValueChanged" PassEventArgsToCommand="True" />
                            </dxmvvm:Interaction.Behaviors>
                            <dxg:TableView.RowCellMenuCustomizations>
                                <dxb:BarLinkContainerItem ItemLinksSource="{StaticResource ContextMenuDefaultHeaderButtons}" />
                                <dxb:BarItemLinkSeparator />
                                <dxb:BarLinkContainerItem ItemLinksSource="{StaticResource ContextMenuDefaultPopulateReplaceButtons}" />
                                <dxb:BarItemLinkSeparator />
                                <dxb:BarLinkContainerItem ItemLinksSource="{StaticResource ContextMenuDuplicateInsertButtons}" />
                                <dxb:BarItemLinkSeparator />
                                <dxb:BarSubItem Content="Duplicate Multiple" ToolTip="Specify number of times to duplicate selected deliverables and assign the same internal number" Glyph="{dx:DXImageOffice2013 Image=Parameters_16x16.png}" x:Name="contextMenuDuplicateMulti">
                                    <dxb:BarEditItem Content="Count" Name="contextMenuDuplicateMultiCount" EditValue="2">
                                        <dxb:BarEditItem.EditSettings>
                                            <dxe:SpinEditSettings Increment="1" IsFloatValue="False" IsTextEditable="True" Mask="n0" MaskType="Numeric" MaskUseAsDisplayFormat="True" MaxValue="99" MinValue="2">
                                                <dxe:SpinEditSettings.Buttons>
                                                    <dxe:ButtonInfo GlyphKind="Apply">
                                                        <dxmvvm:Interaction.Behaviors>
                                                            <dxmvvm:EventToCommand Command="{Binding DataContext.DuplicateMultipleCommand, ElementName=userControl}" CommandParameter="{Binding ElementName=contextMenuDuplicateMultiCount}" EventName="Click" />
                                                        </dxmvvm:Interaction.Behaviors>
                                                    </dxe:ButtonInfo>
                                                </dxe:SpinEditSettings.Buttons>
                                            </dxe:SpinEditSettings>
                                        </dxb:BarEditItem.EditSettings>
                                    </dxb:BarEditItem>
                                </dxb:BarSubItem>
                                <dxb:BarSubItem Content="Insert Multiple" ToolTip="Specify number of times to insert new deliverables with continuing internal number affix. Also renames deliverables with internal number larger than the largest internal number affix to continue from the newly inserted deliverables" Glyph="{dx:DXImageOffice2013 Image=Parameters_16x16.png}" x:Name="contextMenuInsertMulti">
                                    <dxb:BarEditItem Content="Count" Name="contextMenuInsertMultiCount" EditValue="2">
                                        <dxb:BarEditItem.EditSettings>
                                            <dxe:SpinEditSettings Increment="1" IsFloatValue="False" IsTextEditable="True" Mask="n0" MaskType="Numeric" MaskUseAsDisplayFormat="True" MaxValue="99" MinValue="2">
                                                <dxe:SpinEditSettings.Buttons>
                                                    <dxe:ButtonInfo GlyphKind="Apply">
                                                        <dxmvvm:Interaction.Behaviors>
                                                            <dxmvvm:EventToCommand Command="{Binding DataContext.InsertMultipleCommand, ElementName=userControl}" CommandParameter="{Binding ElementName=contextMenuInsertMultiCount}" EventName="Click" />
                                                        </dxmvvm:Interaction.Behaviors>
                                                    </dxe:ButtonInfo>
                                                </dxe:SpinEditSettings.Buttons>
                                            </dxe:SpinEditSettings>
                                        </dxb:BarEditItem.EditSettings>
                                    </dxb:BarEditItem>
                                </dxb:BarSubItem>
                                <dxb:BarItemLinkSeparator />
                                <dxb:BarLinkContainerItem ItemLinksSource="{StaticResource ContextMenuDefaultFooterButtons}" />
                            </dxg:TableView.RowCellMenuCustomizations>
                            <dxg:TableView.FormatConditions>
                                <dxg:UniqueDuplicateRuleFormatCondition FieldName="Entity.Entity.INTERNAL_NUM">
                                    <dxc:Format Background="#FFFF9B98" />
                                </dxg:UniqueDuplicateRuleFormatCondition>
                                <dxg:UniqueDuplicateRuleFormatCondition FieldName="Entity.Entity.GUID_ORIGINAL">
                                    <dxc:Format Background="#FFFF9B98" />
                                </dxg:UniqueDuplicateRuleFormatCondition>
                                <dxg:FormatCondition FieldName="Entity.Total_Costs" Expression="[Entity.Total_Costs] = '0.00'">
                                    <dxc:Format Background="#FFFF9B98" />
                                </dxg:FormatCondition>
                            </dxg:TableView.FormatConditions>
                        </dxg:TableView>
                    </dxg:GridControl.View>
