                                    <dxe:DateEditSettings />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Entity.Entity.START_DATE" Visible="{Binding DataContext.IsTender, ElementName=userControl}" FilterPopupMode="CheckedList" Header="Start" HeaderToolTip="Planned date when the deliverable is going to start, this will override subjob start date, only affects planned S-Curve">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:DateEditSettings NullValueButtonPlacement="Popup" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Entity.Entity.END_DATE" Visible="{Binding DataContext.IsTender, ElementName=userControl}" FilterPopupMode="CheckedList" Header="End" HeaderToolTip="Planned date when the deliverable is going to end, this will override subjob end date, only affects planned S-Curve">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:DateEditSettings NullValueButtonPlacement="Popup" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Entity.Entity.FORECAST_START_DATE" FilterPopupMode="CheckedList" Header="Target Start" HeaderToolTip="Target date when the deliverable is going to start, this will override subjob forecast start date, only affects remaining S-Curve">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:DateEditSettings NullValueButtonPlacement="Popup" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
