<UserControl x:Class="BluePrints.Views.BASELINE_ITEMCollectionView" xmlns:dxrt="http://schemas.devexpress.com/winfx/2008/xaml/ribbon/themekeys" xmlns:local="clr-namespace:BaseModel.Misc;assembly=BaseModel" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:common="clr-namespace:BluePrints.Common" xmlns:converters="clr-namespace:BluePrints.Common.ViewModel.Converters" xmlns:custom="clr-namespace:BaseModel.Misc;assembly=BaseModel" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxa="http://schemas.devexpress.com/winfx/2008/xaml/accordion" xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon" xmlns:dxrudex="http://schemas.devexpress.com/winfx/2008/xaml/reports/userdesignerextensions" xmlns:filter="clr-namespace:BluePrints.Common.Filtering" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:view="clr-namespace:BluePrints.Views" xmlns:viewmodel="clr-namespace:BluePrints.ViewModels" x:Name="userControl" d:DesignHeight="400" d:DesignWidth="600" DataContext="{dxmvvm:ViewModelSource viewmodel:BASELINE_ITEMCollectionViewModelWrapper}" mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ItemsPanelTemplate x:Key="{dxrt:RibbonThemeKey ResourceKey=PageGroupsControlItemsPanelTemplate, IsThemeIndependent=True}">
                <local:CustomRibbonPageGroupsItemsPanel />
            </ItemsPanelTemplate>
            <ItemsPanelTemplate x:Key="{dxrt:RibbonThemeKey ResourceKey=PagesControlItemsPanelTemplate, IsThemeIndependent=True}">
                <local:CustomRibbonPagesItemsPanel />
            </ItemsPanelTemplate>
            <DataTemplate x:Key="glyphTemplate">
                <dxc:DXImage x:Name="glyph" Width="16" Height="16" Margin="3,0,0,0" SnapsToDevicePixels="True" Source="{Binding}" />
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                        <Setter TargetName="glyph" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
            <Style x:Key="accordionItemContainerStyle" TargetType="dxa:AccordionItem">
                <Setter Property="Header" Value="{Binding Name}" />
                <Style.Triggers>
                    <Trigger Property="ItemLevel" Value="1">
                        <Setter Property="ShowInCollapsedMode" Value="{Binding ShowInCollapsedMode}" />
                        <Setter Property="Glyph" Value="{Binding Icon}" />
                        <Setter Property="GlyphTemplate" Value="{StaticResource glyphTemplate}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <common:RowNameConverter x:Key="RowNameConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/DefaultBluePrintsResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/BaseModel;component/View/ResourceDictionaries/DefaultControlResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/CustomControlResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/ConverterResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Style="{StaticResource CollectionView.RootContainer}">
        <dxmvvm:Interaction.Behaviors>
            <dxc:DialogService x:Name="MapDeliverableDialog">
                <dxc:DialogService.DialogStyle>
                    <Style TargetType="dx:DXDialogWindow">
                        <Setter Property="SizeToContent" Value="WidthAndHeight" />
                        <Setter Property="MinWidth" Value="600" />
                        <Setter Property="MinHeight" Value="600" />
                    </Style>
                </dxc:DialogService.DialogStyle>
            </dxc:DialogService>
            <dxc:DialogService x:Name="BookTimeDialog">
                <dxc:DialogService.DialogStyle>
                    <Style TargetType="dx:DXDialogWindow">
                        <Setter Property="SizeToContent" Value="WidthAndHeight" />
                        <Setter Property="MinWidth" Value="300" />
                        <Setter Property="MinHeight" Value="300" />
                    </Style>
                </dxc:DialogService.DialogStyle>
            </dxc:DialogService>
        </dxmvvm:Interaction.Behaviors>
        <Grid DataContext="{Binding MainViewModel}">
            <dxb:BarManager>
                <dxb:BarManager.Items>
                    <dxb:BarSubItem ItemLinksSource="{StaticResource RibbonDefaultGridButtons}" />
                </dxb:BarManager.Items>
                <DockPanel>
                    <dxr:RibbonControl MDIMergeStyle="WhenChildActivated" AllowCustomization="False" DockPanel.Dock="Top" RibbonStyle="Office2010">
                        <dxr:RibbonDefaultPageCategory MergeType="MergeItems" Caption="defaultCategory">
                            <dxr:RibbonPage MergeType="Replace" Caption="Grid">
                                <dxr:RibbonPageGroup MergeType="Replace" Caption="Grid" >
                                    <dxb:BarButtonItemLink BarItemName="biFullRefresh1" />
                                    <dxb:BarButtonItemLink BarItemName="biBulkDelete1" />
                                    <dxb:BarButtonItemLink BarItemName="biUndo1" />
                                    <dxb:BarButtonItemLink BarItemName="biRedo1" />
                                    <dxb:BarButtonItemLink BarItemName="biKeyboardCopy1"/>
                                    <dxb:BarButtonItemLink BarItemName="biKeyboardPaste1" />
                                    <dxb:BarCheckItemLink BarItemName="biCellSelection1" />
                                    <dxb:BarButtonItemLink BarItemName="biExpandAllGroups1" />
                                    <dxb:BarButtonItemLink BarItemName="biCollapseAllGroups1" />
                                    <dxb:BarButtonItemLink BarItemName="biExportToExcel1" />
                                    <dxb:BarButtonItemLink BarItemName="biExportToPDF1" />
                                    <dxb:BarButtonItemLink BarItemName="biEditReport1" />
                                    <dxb:BarButtonItemLink BarItemName="biViewReport1" />
                                </dxr:RibbonPageGroup>
                                <dxr:RibbonPageGroup MergeType="Replace" Caption="Grid" local:CustomRibbonPageGroupsItemsPanel.GroupAlignment="Right">
                                    <dxb:BarCheckItem x:Name="bcShowBookableOnly" Content="Show Bookable Only" Glyph="{dxc:DXImage Image=Date&amp;Time_16x16.png}" IsChecked="{Binding DataContext.ShowBookable, ElementName=userControl}" LargeGlyph="{dxc:DXImage Image=Date&amp;Time_32x32.png}" ToolTip="Show bookable only" />
                                </dxr:RibbonPageGroup>
                                <!--<dxr:RibbonPageGroup MergeType="Replace" Caption="Report" ItemLinksSource="{StaticResource RibbonDefaultReportingButtons}" />-->
                            </dxr:RibbonPage>
                            <dxr:RibbonPage MergeType="Replace" Caption="Doc Control">
                                <dxr:RibbonPageGroup MergeType="Replace" Caption="Doc Control">
                                    <dxb:BarButtonItem x:Name="bbMapClientNumber" Command="{Binding DataContext.MapClientNumberCommand, ElementName=userControl}" Content="Import Client Numbers" Glyph="{dx:DXImage Image=Wizard_16x16.png}" LargeGlyph="{dxc:DXImage Image=Wizard_32x32.png}" ToolTip="Copy 2 columns from excel with the left being internal number and the right being client number, then paste it in here" />
                                    <dxb:BarButtonItem x:Name="biFinaliseInternalNum" Command="{Binding DataContext.FinaliseInternalNumbersCommand, ElementName=userControl}" Content="Finalise Internal Num" Glyph="{dxc:DXImage Image=BOPermission_16x16.png}" LargeGlyph="{dx:DXImage Image=BOPermission_32x32.png}" ToolTip="Lock current list internal numbers" />
                                    <dxb:BarButtonItem x:Name="biFinaliseClientNum" Command="{Binding DataContext.FinaliseClientNumbersCommand, ElementName=userControl}" Content="Finalise Client Num" Glyph="{dxc:DXImage Image=BOPermission_16x16.png}" LargeGlyph="{dx:DXImage Image=BOPermission_32x32.png}" ToolTip="Lock current list client numbers" />
                                    <dxb:BarButtonItem x:Name="biModifyInternalNum" Command="{Binding DataContext.UnapproveSelectedInternalNumbersCommand, ElementName=userControl}" Content="Modify Internal Num(s)" Glyph="{dxc:DXImage Image=Edit_16x16.png}" LargeGlyph="{dx:DXImage Image=Edit_32x32.png}" ToolTip="Unlock selected deliverable(s) internal numbers" />
                                    <dxb:BarButtonItem x:Name="biModifyClientNum" Command="{Binding DataContext.UnapproveSelectedClientNumbersCommand, ElementName=userControl}" Content="Modify Client Num(s)" Glyph="{dxc:DXImage Image=Edit_16x16.png}" LargeGlyph="{dx:DXImage Image=Edit_32x32.png}" ToolTip="Unlock selected deliverable(s) client numbers" />
                                </dxr:RibbonPageGroup>
                                <dxr:RibbonPageGroup x:Name="InternalNumberGroup" MergeType="Replace" Caption="Internal Numbers" local:CustomRibbonPageGroupsItemsPanel.GroupAlignment="Right">
                                    <dxb:BarCheckItem x:Name="bcInternalNumDefault" Content="Default" Glyph="{dxc:DXImage Image=CheckButtons_16x16.png}" IsChecked="{Binding DataContext.InternalNumDefault, ElementName=userControl, Mode=TwoWay}" LargeGlyph="{dx:DXImage Image=CheckButtons_32x32.png}" ToolTip="Only non-progressed internal number can be edited and auto-generated" />
                                    <dxb:BarCheckItem x:Name="bcInternalNumAlwaysEditable" Content="Editable" Glyph="{dxc:DXImage Image=EditName_16x16.png}" IsChecked="{Binding DataContext.InternalNumAlwaysEditable, ElementName=userControl, Mode=TwoWay}" LargeGlyph="{dx:DXImage Image=EditName_32x32.png}" ToolTip="All internal number can be auto-generated and edited" />
                                    <dxb:BarCheckItem x:Name="bcInternalNumManual" Content="Manual" Glyph="{dxc:DXImage Image=BORules_16x16.png}" IsChecked="{Binding DataContext.InternalNumManual, ElementName=userControl, Mode=TwoWay}" LargeGlyph="{dx:DXImage Image=BORules_32x32.png}" ToolTip="Only non-progressed internal number can be manually edited or populated by context menu option" />
                                </dxr:RibbonPageGroup>
                            </dxr:RibbonPage>
                            <dxr:RibbonPage MergeType="Replace" Caption="Baseline">
                                <dxr:RibbonPageGroup MergeType="Replace" Caption="Baseline">
                                    <dxb:BarStaticItem x:Name="bsAvailableUnits" Content="Available Units" />
                                    <dxb:BarEditItem x:Name="beFreeUnits" EditValue="{Binding DataContext.FreeUnits, ElementName=userControl, Mode=OneWay}" IsReadOnly="True" ToolTip="Remaining units to be assigned when baseline is locked">
                                        <dxb:BarEditItem.EditSettings>
                                            <dxe:TextEditSettings NullText="Unlimited" />
                                        </dxb:BarEditItem.EditSettings>
                                    </dxb:BarEditItem>
                                    <dxb:BarCheckItem x:Name="bcLockBaseline" Content="Lock Baseline" Glyph="{dxc:DXImage Image=ProtectDocument_16x16.png}" IsChecked="{Binding DataContext.IsBASELINELocked, ElementName=userControl}" LargeGlyph="{dxc:DXImage Image=ProtectDocument_32x32.png}" ToolTip="Lock total budget units, so that units assigned to all deliverables cannot exceed the current total units" />
                                </dxr:RibbonPageGroup>
                            </dxr:RibbonPage>
                        </dxr:RibbonDefaultPageCategory>
                    </dxr:RibbonControl>
                    <dxr:RibbonStatusBarControl DockPanel.Dock="Bottom">
                        <dxr:RibbonStatusBarControl.LeftItems>
                            <dxb:BarStaticItem x:Name="bsCount" Content="{Binding Entities.Count, Converter={dxmvvm:FormatStringConverter FormatString='RECORDS: {0}'}}" />
                        </dxr:RibbonStatusBarControl.LeftItems>
                    </dxr:RibbonStatusBarControl>
                    <dxlc:LayoutControl DockPanel.Dock="Right">
                        <dxlc:LayoutGroup.LayoutTransform>
                            <RotateTransform Angle="90" />
                        </dxlc:LayoutGroup.LayoutTransform>
                        <dxlc:LayoutGroup IsCollapsible="True" View="Group">
                            <Grid>
                                <Grid.LayoutTransform>
                                    <RotateTransform Angle="-90" />
                                </Grid.LayoutTransform>
                                <filter:FilterAccordionView DataContext="{Binding DataContext.FilterTreeViewModel, ElementName=userControl}" />
                            </Grid>
                        </dxlc:LayoutGroup>
                    </dxlc:LayoutControl>
                    <dxg:GridControl x:Name="GridControl" dxc:DXSerializer.SerializationID="GridControlBASELINE_ITEM" dxc:DXSerializer.StoreLayoutMode="All" DockPanel.Dock="Right" Style="{StaticResource DefaultGridControlTemplate}">
                        <dxmvvm:Interaction.Behaviors>
                            <dxmvvm:EventToCommand Command="{Binding DataContext.CustomColumnDisplayTextCommand, ElementName=userControl}" EventName="CustomColumnDisplayText" PassEventArgsToCommand="True" />
                        </dxmvvm:Interaction.Behaviors>
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn Tag="True;True;Autofill subjob" FieldName="Entity.Entity.GUID_AREA" FilterPopupMode="CheckedList" Header="Area" HeaderToolTip="Changing this field may affect subjob name, see internal number mode default, editable, manual on the ribbon">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="INTERNAL_NUM" IsTextEditable="True" ItemsSource="{Binding DataContext.AREACollection, ElementName=userControl}" ValueMember="GUID" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Tag="True;True;Autofill from subjob" ColumnFilterMode="DisplayText" FieldName="Entity.Entity.SubAreaGuid" FilterPopupMode="CheckedList" Header="Sub-Area" HeaderToolTip="Changing this field may affect subjob name, see internal number mode default, editable, manual on the ribbon">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <dxe:ComboBoxEdit x:Name="PART_Editor" DisplayMember="INTERNAL_NUM" ImmediatePopup="True" IncrementalFiltering="True" ItemsSource="{Binding RowData.Row.Entity.Entity.SubAreaCollection}" NullValueButtonPlacement="Popup" ValidateOnEnterKeyPressed="True" ValidateOnTextInput="True" ValueMember="GUID" />
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                                <!--For Filtering-->
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="INTERNAL_NUM" IsTextEditable="True" ItemsSource="{Binding DataContext.SUBAREACollection, ElementName=userControl}" ValueMember="GUID" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Entity.Entity.GUID_DISCIPLINE" FilterPopupMode="CheckedList" Header="Discipline">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding DataContext.DISCIPLINECollection, ElementName=userControl}" ValueMember="GUID" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Entity.Entity.DISCIPLINE_NUM" FilterPopupMode="CheckedList" Header="Discipline Number" HeaderToolTip="Changing  this field may affect subjob name, see internal number mode default, editable, manual on the ribbon">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:SpinEditSettings Increment="1" IsFloatValue="False" IsTextEditable="True" Mask="n0" MaskType="Numeric" MaskUseAsDisplayFormat="True" MaxValue="99" MinValue="1" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <!--<dxg:GridColumn FieldName="Entity.Entity.GUID_DOCTYPE" FilterPopupMode="CheckedList" Header="Document Type" HeaderToolTip="Changing  this fieldmay affect subjob and workpack name, see internal number mode default, editable, manual on the ribbon">
                            <dxg:GridColumn.EditSettings>
                                <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding DataContext.DOCTYPECollection, ElementName=userControl}" ValueMember="GUID" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>-->
                            <dxg:GridColumn FieldName="Entity.Entity.DELIVERABLE_TYPE" FilterPopupMode="CheckedList" Header="Deliverable Type">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings AutoComplete="True" IsTextEditable="True" ItemsSource="{dxe:EnumItemsSource EnumType={x:Type common:DeliverableType}}" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Entity.Entity.GUID_DOCTYPE" FilterPopupMode="CheckedList" Header="Document Type" HeaderToolTip="Changing  this fieldmay affect subjob name, see internal number mode default, editable, manual on the ribbon">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <dxe:ComboBoxEdit x:Name="PART_Editor" DisplayMember="NAME" AutoComplete="True" ImmediatePopup="True" IncrementalFiltering="True" ItemsSource="{Binding RowData.Row.Entity.Entity.ValidDOCTYPES}" NullValueButtonPlacement="Popup" ValidateOnEnterKeyPressed="True" ValidateOnTextInput="True" ValueMember="GUID" />
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                                <!--  For Filtering  -->
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding DataContext.DOCTYPECollection, ElementName=userControl}" NullValueButtonPlacement="EditBox" ValueMember="GUID" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Entity.Entity.GUID_DEPARTMENT" FilterPopupMode="CheckedList" Header="Department" HeaderToolTip="Default value can be populated by document type selection">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding DataContext.DEPARTMENTCollection, ElementName=userControl}" ValueMember="GUID" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Tag="True;False;Autofill from area, department, discipline and doc-type" FieldName="Entity.Entity.INTERNAL_NUM" FilterPopupMode="CheckedList" Header="Internal Number" HeaderToolTip="Must be unique">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <!--  Use IsEnabled because when textEdit is invoked the 2nd time IsReadOnly didn't get picked up in the binding  -->
                                        <dxe:TextEdit Name="PART_Editor" IsEnabled="{Binding RowData.Row.IsInternalNumberEditable}" />
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                            <!--for checking-->
                            <!--<dxg:GridColumn FieldName="Entity.Entity.DC_HOURS" FilterPopupMode="CheckedList" Header="DC Hours" ReadOnly="True" />-->
                            <dxg:GridColumn FieldName="Entity.Entity.INTERNALNUM_STATUS" FilterPopupMode="CheckedList" Header="Internal Number Status" ReadOnly="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings AutoComplete="True" IsTextEditable="True" ItemsSource="{dxe:EnumItemsSource EnumType={x:Type common:DocumentNumberStatus}}" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="IsInternalNumberEditable" Visible="False" />
                            <dxg:GridColumn FieldName="Entity.Entity.CLIENT_NUM" FilterPopupMode="CheckedList" Header="Client Number">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <!--  Use IsEnabled because when textEdit is invoked the 2nd time IsReadOnly didn't get picked up in the binding  -->
                                        <dxe:TextEdit Name="PART_Editor" IsEnabled="{Binding RowData.Row.IsClientNumberEditable}" />
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Entity.Entity.CLIENTNUM_STATUS" FilterPopupMode="CheckedList" Header="Client Number Status" ReadOnly="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings AutoComplete="True" IsTextEditable="True" ItemsSource="{dxe:EnumItemsSource EnumType={x:Type common:DocumentNumberStatus}}" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Entity.Entity.REVISION_NUMBER" FilterPopupMode="CheckedList" Header="Revision Number" />
                            <dxg:GridColumn FieldName="Entity.Entity.PRIMARY_TITLE" FilterPopupMode="CheckedList" Header="Primary Title" />
                            <dxg:GridColumn FieldName="Entity.Entity.SECONDARY_TITLE" FilterPopupMode="CheckedList" Header="Secondary Title" />
                            <dxg:GridColumn FieldName="Entity.Entity.COMMENTS" FilterPopupMode="CheckedList" Header="Comments" />
                            <dxg:GridColumn ColumnFilterMode="DisplayText" FieldName="Entity.Entity.DeliverableStatusGuid" FilterPopupMode="Custom" Header="Status" HeaderToolTip="Changing this field may affect progress if [Update % by Status] button is click in progress">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <dxe:ComboBoxEdit x:Name="PART_Editor" DisplayMember="NAME" ImmediatePopup="True" IncrementalFiltering="True" ItemsSource="{Binding RowData.Row.Entity.Entity.DeliverableStatusCollection}" NullValueButtonPlacement="Popup" ValidateOnEnterKeyPressed="True" ValidateOnTextInput="True" ValueMember="GUID" />
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                                <!--  For Filtering  -->
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding DataContext.DELIVERABLES_STATUSCollection, ElementName=userControl}" NullValueButtonPlacement="EditBox" ValueMember="GUID" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Tag="" FieldName="Entity.Entity.GUID_USER" ColumnFilterMode="DisplayText" FilterPopupMode="CheckedList" Header="Resource">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <dxg:LookUpEdit Name="PART_Editor" AutoComplete="True" AutoPopulateColumns="False" DisplayMember="Full_Name" IncrementalFiltering="True" IsTextEditable="true" ItemsSource="{Binding DataContext.USERCollection, ElementName=userControl}" NullValueButtonPlacement="Popup" PopupMinWidth="500" ValueMember="GUID">
                                            <dxg:LookUpEdit.StyleSettings>
                                                <dxg:SearchLookUpEditStyleSettings />
                                            </dxg:LookUpEdit.StyleSettings>
                                            <dxg:LookUpEdit.PopupContentTemplate>
                                                <ControlTemplate TargetType="ContentControl">
                                                    <dxg:GridControl x:Name="PART_GridControl" FilterCriteria="{Binding RowData.Row.Entity.Entity.ResourceFilterCriteria, Mode=OneWay}" SelectionMode="Row" ShowBorder="False">
                                                        <dxg:GridControl.Columns>
                                                            <dxg:GridColumn FieldName="Full_Name" Header="Name" ReadOnly="True" />
                                                            <dxg:GridColumn FieldName="GUID_DEPARTMENT" Header="Department" ReadOnly="True">
                                                                <dxg:GridColumn.EditSettings>
                                                                    <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding DataContext.DEPARTMENTCollection, ElementName=userControl}" ValueMember="GUID" />
                                                                </dxg:GridColumn.EditSettings>
                                                            </dxg:GridColumn>
                                                            <dxg:GridColumn FieldName="GUID_DISCIPLINE" Header="Discipline" ReadOnly="True">
                                                                <dxg:GridColumn.EditSettings>
                                                                    <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding DataContext.DISCIPLINECollection, ElementName=userControl}" ValueMember="GUID" />
                                                                </dxg:GridColumn.EditSettings>
                                                            </dxg:GridColumn>
                                                        </dxg:GridControl.Columns>
                                                        <dxg:GridControl.View>
                                                            <dxg:TableView RowStyle="{StaticResource SelectionBackgroundStyle}" ShowFilterPanelMode="ShowAlways" ShowFocusedRectangle="True" ShowGroupPanel="False" ShowSelectionRectangle="True" />
                                                        </dxg:GridControl.View>
                                                    </dxg:GridControl>
                                                </ControlTemplate>
                                            </dxg:LookUpEdit.PopupContentTemplate>
                                        </dxg:LookUpEdit>
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding DataContext.USERCollection, ElementName=userControl}" ValueMember="GUID" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <!--<dxg:GridColumn FieldName="Entity.AssignDeliverablesObject" Header="Deliverables">
                            <dxg:GridColumn.EditSettings>
                                <dxe:ComboBoxEditSettings DisplayMember="INTERNAL_NUM" IncrementalFiltering="True" ItemsSource="{Binding DataContext.BASELINE_ITEMCollection, ElementName=userControl}" Tag="CopyPasteSkip" ValidateOnEnterKeyPressed="True" ValidateOnTextInput="True">
                                    <dxe:ComboBoxEditSettings.StyleSettings>
                                        <dxe:CheckedComboBoxStyleSettings />
                                    </dxe:ComboBoxEditSettings.StyleSettings>
                                </dxe:ComboBoxEditSettings>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>-->
                            <dxg:GridColumn FieldName="Entity.Entity.BY_DURATION" FilterPopupMode="CheckedList" Header="By Duration" HeaderToolTip="Check this so that deliverable can be mapped to P6 activity without increasing it's budgeted units">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:CheckEditSettings />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Entity.Entity.BUDGET_HOURS" FilterPopupMode="CheckedList" Header="Budget Hours" HeaderToolTip="Baseline hours">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="15" />
                                                <ColumnDefinition Width="15" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <dxe:SpinEdit Name="PART_Editor" Grid.Column="2" Increment="1" IsReadOnly="{Binding RowData.Row.Entity.Entity.BY_DURATION}" Mask="n" MaskType="Numeric" MaskUseAsDisplayFormat="True" MinValue="{Binding RowData.Row.MinEstimateUnits}">
                                                <dxe:SpinEdit.MaxValue>
                                                    <MultiBinding Converter="{StaticResource IReportableStatsMaximumUnitsConverter}">
                                                        <Binding ElementName="userControl" Path="DataContext.TotalAllowedUnits" />
                                                        <Binding ElementName="userControl" Path="DataContext.DisplayEntities" />
                                                        <Binding Path="RowData.Row" />
                                                    </MultiBinding>
                                                </dxe:SpinEdit.MaxValue>
                                            </dxe:SpinEdit>
                                            <Image Grid.Column="0" Source="{dx:DXImage Image=First_16x16.png}" ToolTip="Cannot further reduce units because it has been earned or zero">
                                                <Image.Visibility>
                                                    <MultiBinding Converter="{StaticResource NumericCompareToVisibilityConverter}" FallbackValue="Hidden">
                                                        <MultiBinding.ConverterParameter>
                                                            <sys:Boolean>False</sys:Boolean>
                                                        </MultiBinding.ConverterParameter>
                                                        <Binding ElementName="PART_Editor" Path="MinValue" />
                                                        <Binding ElementName="PART_Editor" Path="EditValue" />
                                                    </MultiBinding>
                                                </Image.Visibility>
                                            </Image>
                                            <Image Grid.Column="1" Source="{dx:DXImage Image=Last_16x16.png}" ToolTip="Cannot further increase because baseline is limiting total units">
                                                <Image.Visibility>
                                                    <MultiBinding Converter="{StaticResource NumericCompareToVisibilityConverter}" FallbackValue="Hidden">
                                                        <MultiBinding.ConverterParameter>
                                                            <sys:Boolean>False</sys:Boolean>
                                                        </MultiBinding.ConverterParameter>
                                                        <Binding ElementName="PART_Editor" Path="MaxValue" />
                                                        <Binding ElementName="PART_Editor" Path="EditValue" />
                                                    </MultiBinding>
                                                </Image.Visibility>
                                            </Image>
                                        </Grid>
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Budget_Units" FilterPopupMode="CheckedList" Header="Adjusted Budget" HeaderToolTip="Additional hours added from the variation page and original budget, approved and checked as budget adjustment" ReadOnly="True" />
                            <dxg:GridColumn FieldName="Variation_Units" FilterPopupMode="CheckedList" Header="Variation Hours" HeaderToolTip="Variation hours added from the variation page and approved to be shown here" ReadOnly="True" />
                            <dxg:GridColumn FieldName="Total_Units" FilterPopupMode="CheckedList" Header="Total Hours" HeaderToolTip="Budget Hours + Variation Hours" ReadOnly="True" />
                            <dxg:GridColumn AllowSearchPanel="False" FieldName="Total_Costs" FilterPopupMode="CheckedList" Header="Total Costs" HeaderToolTip="Rate * (Budget Hours + Variation Hours). Rates are located in the rates table and assigned to deliverables by discipline" ReadOnly="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings Mask="c" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <!--<dxg:GridColumn FieldName="StartDate" FilterPopupMode="CheckedList" Header="Start Date" HeaderToolTip="Date obtained from subjob or P6" IsEnabled="False" ReadOnly="True">
                            <dxg:GridColumn.EditSettings>
                                <dxe:DateEditSettings />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="DueDate" FilterPopupMode="CheckedList" Header="Due Date" HeaderToolTip="Date obtained from subjob or P6" IsEnabled="False" ReadOnly="True">
                            <dxg:GridColumn.EditSettings>
                                <dxe:DateEditSettings />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="ForecastDate" FilterPopupMode="CheckedList" Header="Forecast Finish Date" HeaderToolTip="Date obtained from subjob or P6. Calculated by 1.0 productivity by default and can be overridden by Override Productivity column" IsEnabled="False" ReadOnly="True">
                            <dxg:GridColumn.EditSettings>
                                <dxe:DateEditSettings />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>-->
