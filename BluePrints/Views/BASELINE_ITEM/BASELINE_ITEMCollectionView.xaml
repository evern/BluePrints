                                    <dxe:SpinEditSettings Mask="###,##0 hrs" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn x:Name="colFORECAST_EXCL_HOURS" FieldName="Entity.Entity.FORECAST_EXCL_HOURS" AllowBestFit="false" Width="90" Header="Forecast Excl. Hours" HeaderToolTip="Hours to be excluded from forecast" Visible="False">
