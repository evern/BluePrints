<UserControl x:Class="BluePrints.Views.BASELINE_ITEMCollectionView" xmlns:dxrt="http://schemas.devexpress.com/winfx/2008/xaml/ribbon/themekeys" xmlns:local="clr-namespace:BaseModel.Misc;assembly=BaseModel" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:common="clr-namespace:BluePrints.Common" xmlns:converters="clr-namespace:BluePrints.Common.ViewModel.Converters" xmlns:custom="clr-namespace:BaseModel.Misc;assembly=BaseModel" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxa="http://schemas.devexpress.com/winfx/2008/xaml/accordion" xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon" xmlns:dxrudex="http://schemas.devexpress.com/winfx/2008/xaml/reports/userdesignerextensions" xmlns:filter="clr-namespace:BluePrints.Common.Filtering" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:view="clr-namespace:BluePrints.Views" xmlns:viewmodel="clr-namespace:BluePrints.ViewModels" x:Name="userControl" d:DesignHeight="400" d:DesignWidth="600" DataContext="{dxmvvm:ViewModelSource viewmodel:BASELINE_ITEMCollectionViewModelWrapper}" mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ItemsPanelTemplate x:Key="{dxrt:RibbonThemeKey ResourceKey=PageGroupsControlItemsPanelTemplate, IsThemeIndependent=True}">
                <local:CustomRibbonPageGroupsItemsPanel />
            </ItemsPanelTemplate>
            <ItemsPanelTemplate x:Key="{dxrt:RibbonThemeKey ResourceKey=PagesControlItemsPanelTemplate, IsThemeIndependent=True}">
                <local:CustomRibbonPagesItemsPanel />
            </ItemsPanelTemplate>
            <DataTemplate x:Key="glyphTemplate">
                <dxc:DXImage x:Name="glyph" Width="16" Height="16" Margin="3,0,0,0" SnapsToDevicePixels="True" Source="{Binding}" />
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                        <Setter TargetName="glyph" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
            <Style x:Key="accordionItemContainerStyle" TargetType="dxa:AccordionItem">
                <Setter Property="Header" Value="{Binding Name}" />
                <Style.Triggers>
                    <Trigger Property="ItemLevel" Value="1">
                        <Setter Property="ShowInCollapsedMode" Value="{Binding ShowInCollapsedMode}" />
                        <Setter Property="Glyph" Value="{Binding Icon}" />
                        <Setter Property="GlyphTemplate" Value="{StaticResource glyphTemplate}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <common:RowNameConverter x:Key="RowNameConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/DefaultBluePrintsResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/BaseModel;component/View/ResourceDictionaries/DefaultControlResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/CustomControlResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/ConverterResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Style="{StaticResource CollectionView.RootContainer}">
        <dxmvvm:Interaction.Behaviors>
            <dxc:DialogService x:Name="MapDeliverableDialog">
                <dxc:DialogService.DialogStyle>
                    <Style TargetType="dx:DXDialogWindow">
                        <Setter Property="SizeToContent" Value="WidthAndHeight" />
                        <Setter Property="MinWidth" Value="600" />
                        <Setter Property="MinHeight" Value="600" />
                    </Style>
                </dxc:DialogService.DialogStyle>
            </dxc:DialogService>
            <dxc:DialogService x:Name="BookTimeDialog">
                <dxc:DialogService.DialogStyle>
                    <Style TargetType="dx:DXDialogWindow">
                        <Setter Property="SizeToContent" Value="WidthAndHeight" />
                        <Setter Property="MinWidth" Value="300" />
                        <Setter Property="MinHeight" Value="300" />
                    </Style>
                </dxc:DialogService.DialogStyle>
            </dxc:DialogService>
        </dxmvvm:Interaction.Behaviors>
        <dxb:BarManager>
            <dxb:BarManager.Items>
                <dxb:BarSubItem ItemLinksSource="{StaticResource RibbonDefaultGridButtons}" />
                <dxb:BarSubItem ItemLinksSource="{StaticResource ContextMenuDefaultPopulateReplaceButtons}" />
                <dxb:BarSubItem ItemLinksSource="{StaticResource ContextMenuDuplicateInsertButtons}" />
                <dxb:BarButtonItem x:Name="contextMenuPopulate" Command="{Binding AutoPopulateCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Self}}" Content="Populate" Glyph="{dx:DXImageOffice2013 Image=PictureShapeFillColor_16x16.png}" RibbonStyle="SmallWithText" ToolTip="Auto generate selected column values based on known variables" />
                <dxb:BarButtonItem x:Name="contextMenuFillUp" Command="{Binding FillUpCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Self}}" Content="Fill Up" Glyph="{dx:DXImageOffice2013 Image=MoveUp_16x16.png}" RibbonStyle="SmallWithText" ToolTip="Replicate column values for selected rows starting from last selection" />
                <dxb:BarButtonItem x:Name="contextMenuFillDown" Command="{Binding FillDownCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Self}}" Content="Fill Down" Glyph="{dx:DXImageOffice2013 Image=MoveDown_16x16.png}" RibbonStyle="SmallWithText" ToolTip="Replicate column values for selected rows starting from first selection" />
                <dxb:BarButtonItem x:Name="contextMenuDuplicate" Command="{Binding DuplicateCommand}" Content="Duplicate" Glyph="{dx:DXImageOffice2013 Image=Paste_16x16.png}" RibbonStyle="SmallWithText" ToolTip="Duplicate selected deliverable(s) and rename their internal number affix(es) to the next largest number(s)" />
                <dxb:BarButtonItem x:Name="contextMenuInsert" Command="{Binding  InsertCommand}" Content="Insert" Glyph="{dx:DXImageOffice2013 Image=Paste_16x16.png}" RibbonStyle="SmallWithText" ToolTip="Insert new deliverable(s) and rename their internal number affix(es) to the number right after selected deliverable(s)" />
                <dxb:BarButtonItem x:Name="contextMenuBulkEdit" Command="{Binding BulkColumnEditCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Self}}" Content="Bulk Edit" Glyph="{dx:DXImageOffice2013 Image=CustomizeGrid_16x16.png}" RibbonStyle="SmallWithText" ToolTip="Change column values for selected rows" />
                <dxb:BarButtonItem x:Name="contextMenuFindReplace" Command="{Binding FindReplaceCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Self}}" Content="Find and Replace" Glyph="{dx:DXImageOffice2013 Image=Replace_16x16.png}" RibbonStyle="SmallWithText" ToolTip="Replace characters found in selected columns to new values" />
                <dxb:BarButtonItem x:Name="biEditReport1" Command="{Binding EditReportCommand}" Content="Edit Report" Glyph="{dx:DXImage Image=Edit_16x16.png}" LargeGlyph="{dx:DXImage Image=Edit_32x32.png}" RibbonStyle="SmallWithText" ToolTip="Redesign the current report layout" />
                <dxb:BarButtonItem x:Name="biViewReport1" Command="{Binding ViewReportCommand}" Content="View Report" Glyph="{dx:DXImage Image=Report_16x16.png}" LargeGlyph="{dx:DXImage Image=Report_32x32.png}" RibbonStyle="SmallWithText" ToolTip="View report of the deliverables list. Report will be sorted and filtered according to what is shown in this table" />
                <dxb:BarButtonItem x:Name="biViewCostReport" Command="{Binding ViewRoleCostReportCommand}" Content="View Cost Report"  Glyph="{dxc:DXImage Images/People/UserGroup_32x32.png}" LargeGlyph="{dx:DXImage Images/People/UserGroup_16x16.png}" RibbonStyle="SmallWithText" ToolTip="View report of the deliverables list. Report will be sorted and filtered according to what is shown in this table" />
                <dxb:BarButtonItem x:Name="biBookTime" Command="{Binding BookTimeCommand}" Content="Book Time" Glyph="{dx:DXImageOffice2013 Image=AlignHorizontalTop_16x16.png}" ToolTip="Book time on deliverable" />
                <dxb:BarSubItem x:Name="contextMenuDuplicateMulti" Content="Duplicate Multiple" Glyph="{dx:DXImageOffice2013 Image=Parameters_16x16.png}" ToolTip="Specify number of times to duplicate selected deliverable(s) and rename their internal number affix(es) to the next largest number(s)">
                    <dxb:BarEditItem Name="contextMenuDuplicateMultiCount" EditValue="2" Content="Count">
                        <dxb:BarEditItem.EditSettings>
                            <dxe:SpinEditSettings Increment="1" IsFloatValue="False" IsTextEditable="True" Mask="n0" MaskType="Numeric" MaskUseAsDisplayFormat="True" MaxValue="99" MinValue="2">
                                <dxe:SpinEditSettings.Buttons>
                                    <dxe:ButtonInfo GlyphKind="Apply">
                                        <dxmvvm:Interaction.Behaviors>
                                            <dxmvvm:EventToCommand Command="{Binding DuplicateMultipleCommand}" CommandParameter="{Binding ElementName=contextMenuDuplicateMultiCount}" EventName="Click" />
                                        </dxmvvm:Interaction.Behaviors>
                                    </dxe:ButtonInfo>
                                </dxe:SpinEditSettings.Buttons>
                            </dxe:SpinEditSettings>
                        </dxb:BarEditItem.EditSettings>
                    </dxb:BarEditItem>
                </dxb:BarSubItem>
                <dxb:BarSubItem x:Name="contextMenuInsertMulti" Content="Insert Multiple" Glyph="{dx:DXImageOffice2013 Image=Parameters_16x16.png}" ToolTip="Specify number of times to insert new deliverable(s) and rename their internal number affix(es) to the number right after selected deliverable(s)">
                    <dxb:BarEditItem Name="contextMenuInsertMultiCount" EditValue="2" Content="Count">
                        <dxb:BarEditItem.EditSettings>
                            <dxe:SpinEditSettings Increment="1" IsFloatValue="False" IsTextEditable="True" Mask="n0" MaskType="Numeric" MaskUseAsDisplayFormat="True" MaxValue="99" MinValue="2">
                                <dxe:SpinEditSettings.Buttons>
                                    <dxe:ButtonInfo GlyphKind="Apply">
                                        <dxmvvm:Interaction.Behaviors>
                                            <dxmvvm:EventToCommand Command="{Binding InsertMultipleCommand}" CommandParameter="{Binding ElementName=contextMenuInsertMultiCount}" EventName="Click" />
                                        </dxmvvm:Interaction.Behaviors>
                                    </dxe:ButtonInfo>
                                </dxe:SpinEditSettings.Buttons>
                            </dxe:SpinEditSettings>
                        </dxb:BarEditItem.EditSettings>
                    </dxb:BarEditItem>
                </dxb:BarSubItem>
                <dxb:BarButtonItem x:Name="biUnapproveSelectedIntNum" Command="{Binding UnapproveSelectedInternalNumbersCommand}" Content="Unapprove Selected Internal Numbers" Glyph="{dxc:DXImage Image=Edit_16x16.png}" LargeGlyph="{dx:DXImage Image=Edit_32x32.png}" ToolTip="Unlock selected deliverable(s) internal numbers" />
                <dxb:BarButtonItem x:Name="biApproveSelectedIntNum" Command="{Binding UnapproveSelectedClientNumbersCommand}" Content="Unapprove Selected Client Numbers" Glyph="{dxc:DXImage Image=Edit_16x16.png}" LargeGlyph="{dx:DXImage Image=Edit_32x32.png}" ToolTip="Unlock selected deliverable(s) client numbers" />
            </dxb:BarManager.Items>
            <DockPanel>
                <dxr:RibbonControl Style="{StaticResource DefaultRibbonControlStyle}">
                    <dxr:RibbonDefaultPageCategory MergeType="MergeItems" Caption="defaultCategory">
                        <dxr:RibbonPage MergeType="Replace" Caption="Grid">
                            <dxr:RibbonPageGroup MergeType="Replace" Caption="Grid">
                                <dxb:BarButtonItemLink BarItemName="biFullRefresh1" />
                                <dxb:BarButtonItemLink BarItemName="biBulkDelete1" />
                                <dxb:BarButtonItemLink BarItemName="biUndo1" />
                                <dxb:BarButtonItemLink BarItemName="biRedo1" />
                                <dxb:BarButtonItemLink BarItemName="biKeyboardCopy1"/>
                                <dxb:BarButtonItemLink BarItemName="biKeyboardPaste1" />
                                <dxb:BarCheckItemLink BarItemName="biCellSelection1" />
                                <dxb:BarButtonItemLink BarItemName="biExpandAllGroups1" />
                                <dxb:BarButtonItemLink BarItemName="biCollapseAllGroups1" />
                                <dxb:BarButtonItemLink BarItemName="biSaveLayout1" />
                                <dxb:BarButtonItemLink BarItemName="biResetLayout1" />
                                <dxb:BarButtonItemLink BarItemName="biExportToExcel1" />
                                <dxb:BarButtonItemLink BarItemName="biExportToPDF1" />
                                <dxb:BarButtonItemLink BarItemName="biEditReport1" />
                                <dxb:BarButtonItemLink BarItemName="biViewReport1" />
                                <dxb:BarButtonItemLink BarItemName="biViewCostReport" />
                            </dxr:RibbonPageGroup>
                            <dxr:RibbonPageGroup MergeType="Replace" Caption="Grid" local:CustomRibbonPageGroupsItemsPanel.GroupAlignment="Right">
                                <dxb:BarCheckItem x:Name="bcShowBookableOnly" IsEnabled="{Binding IsExoDataLoaded}" Content="Show Bookable Only"  Glyph="{dxc:DXImage Image=Date&amp;Time_16x16.png}" IsChecked="{Binding ShowBookable}" LargeGlyph="{dxc:DXImage Image=Date&amp;Time_32x32.png}" ToolTip="Show bookable only" />
                            </dxr:RibbonPageGroup>
                            <!--<dxr:RibbonPageGroup MergeType="Replace" Caption="Report" ItemLinksSource="{StaticResource RibbonDefaultReportingButtons}" />-->
                        </dxr:RibbonPage>
                        <dxr:RibbonPage MergeType="Replace" Caption="Tools">
                            <dxr:RibbonPageGroup MergeType="Replace" Caption="Tools">
                                <dxb:BarButtonItemLink BarItemName="contextMenuPopulate" /> 
                                <dxb:BarButtonItemLink BarItemName="contextMenuFindReplace" />
                                <dxb:BarButtonItemLink BarItemName="contextMenuDuplicate" />
                                <dxb:BarButtonItemLink BarItemName="biInsert1" />
                                <dxb:BarSubItemLink BarItemName="biDuplicateMulti" />
                                <dxb:BarSubItemLink BarItemName="biInsertMulti" />
                            </dxr:RibbonPageGroup>
                        </dxr:RibbonPage>
                        <dxr:RibbonPage MergeType="Replace" Caption="Doc Control">
                            <dxr:RibbonPageGroup MergeType="Replace" Caption="Doc Control">
                                <dxb:BarButtonItem x:Name="bbMapClientNumber" Command="{Binding MapClientNumberCommand}" Content="Import Client Numbers" Glyph="{dx:DXImage Image=Wizard_16x16.png}" LargeGlyph="{dxc:DXImage Image=Wizard_32x32.png}" ToolTip="Copy 2 columns from excel with the left being internal number and the right being client number, then paste it in here" />
                                <dxb:BarButtonItem x:Name="biFinaliseInternalNum" Command="{Binding FinaliseInternalNumbersCommand}" Content="Finalise Internal Num" Glyph="{dxc:DXImage Image=BOPermission_16x16.png}" LargeGlyph="{dx:DXImage Image=BOPermission_32x32.png}" ToolTip="Lock current list internal numbers" />
                                <dxb:BarButtonItem x:Name="biFinaliseClientNum" Command="{Binding FinaliseClientNumbersCommand}" Content="Finalise Client Num" Glyph="{dxc:DXImage Image=BOPermission_16x16.png}" LargeGlyph="{dx:DXImage Image=BOPermission_32x32.png}" ToolTip="Lock current list client numbers" />
                                <dxb:BarButtonItem x:Name="biModifyInternalNum" Command="{Binding UnapproveSelectedInternalNumbersCommand}" Content="Modify Internal Num(s)" Glyph="{dxc:DXImage Image=Edit_16x16.png}" LargeGlyph="{dx:DXImage Image=Edit_32x32.png}" ToolTip="Unlock selected deliverable(s) internal numbers" />
                                <dxb:BarButtonItem x:Name="biModifyClientNum" Command="{Binding UnapproveSelectedClientNumbersCommand}" Content="Modify Client Num(s)" Glyph="{dxc:DXImage Image=Edit_16x16.png}" LargeGlyph="{dx:DXImage Image=Edit_32x32.png}" ToolTip="Unlock selected deliverable(s) client numbers" />
                            </dxr:RibbonPageGroup>
                            <dxr:RibbonPageGroup x:Name="InternalNumberGroup" MergeType="Replace" Caption="Internal Numbers" local:CustomRibbonPageGroupsItemsPanel.GroupAlignment="Right">
                                <dxb:BarCheckItem x:Name="bcInternalNumDefault" Content="Default" Glyph="{dxc:DXImage Image=CheckButtons_16x16.png}" IsChecked="{Binding InternalNumDefault, Mode=TwoWay}" LargeGlyph="{dx:DXImage Image=CheckButtons_32x32.png}" ToolTip="Only non-progressed internal number can be edited and auto-generated" />
                                <dxb:BarCheckItem x:Name="bcInternalNumAlwaysEditable" Content="Editable" Glyph="{dxc:DXImage Image=EditName_16x16.png}" IsChecked="{Binding InternalNumAlwaysEditable, Mode=TwoWay}" LargeGlyph="{dx:DXImage Image=EditName_32x32.png}" ToolTip="All internal number can be auto-generated and edited" />
                                <dxb:BarCheckItem x:Name="bcInternalNumManual" Content="Manual" Glyph="{dxc:DXImage Image=BORules_16x16.png}" IsChecked="{Binding InternalNumManual, Mode=TwoWay}" LargeGlyph="{dx:DXImage Image=BORules_32x32.png}" ToolTip="Only non-progressed internal number can be manually edited or populated by context menu option" />
                            </dxr:RibbonPageGroup>
                        </dxr:RibbonPage>
                        <dxr:RibbonPage MergeType="Replace" Caption="Baseline">
                            <dxr:RibbonPageGroup MergeType="Replace" Caption="Baseline">
                                <dxb:BarStaticItem x:Name="bsAvailableUnits" Content="Available Units" />
                                <dxb:BarEditItem x:Name="beFreeUnits" EditValue="{Binding FreeUnits, Mode=OneWay}" IsReadOnly="True" ToolTip="Remaining units to be assigned when baseline is locked">
                                    <dxb:BarEditItem.EditSettings>
                                        <dxe:TextEditSettings NullText="Unlimited" />
                                    </dxb:BarEditItem.EditSettings>
                                </dxb:BarEditItem>
                                <dxb:BarCheckItem x:Name="bcLockBaseline" Content="Lock Baseline" Glyph="{dxc:DXImage Image=ProtectDocument_16x16.png}" IsChecked="{Binding IsBASELINELocked}" LargeGlyph="{dxc:DXImage Image=ProtectDocument_32x32.png}" ToolTip="Lock total budget units, so that units assigned to all deliverables cannot exceed the current total units" />
                            </dxr:RibbonPageGroup>
                        </dxr:RibbonPage>
                    </dxr:RibbonDefaultPageCategory>
                </dxr:RibbonControl>
                <dxlc:LayoutControl DockPanel.Dock="Right">
                    <dxlc:LayoutGroup.LayoutTransform>
                        <RotateTransform Angle="90" />
                    </dxlc:LayoutGroup.LayoutTransform>
                    <dxlc:LayoutGroup IsCollapsible="True" View="Group">
                        <Grid>
                            <Grid.LayoutTransform>
                                <RotateTransform Angle="-90" />
                            </Grid.LayoutTransform>
                            <filter:FilterAccordionView DataContext="{Binding FilterTreeViewModel}" />
                        </Grid>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutControl>
                <dxg:GridControl x:Name="GridControl" dxc:DXSerializer.SerializationID="GridControlBASELINE_ITEM" DockPanel.Dock="Right" Style="{StaticResource DefaultGridControlTemplate}">
                    <dxmvvm:Interaction.Behaviors>
                        <dxmvvm:EventToCommand Command="{Binding CustomColumnDisplayTextCommand}" EventName="CustomColumnDisplayText" PassEventArgsToCommand="True" />
                    </dxmvvm:Interaction.Behaviors>
                    <dxg:GridControl.Bands>
                        <dxg:GridControlBand x:Name="gcbProperties" Header="Properties">
                            <dxg:GridColumn Tag="True;True;Populate from Sub Job" FieldName="Entity.Entity.GUID_AREA" AllowBestFit="false" Width="50" Header="Area" HeaderToolTip="Changing this field may affect subjob name, see internal number mode default, editable, manual on the ribbon" SortMode="DisplayText">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="INTERNAL_NUM" IsTextEditable="True" ItemsSource="{Binding AREACollection}" ValueMember="GUID" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Tag="True;True;Populate from Sub Job" AllowBestFit="false" Width="50" FieldName="Entity.Entity.SubAreaGuid" Header="Sub Area" HeaderToolTip="Changing this field may affect subjob name, see internal number mode default, editable, manual on the ribbon" SortMode="DisplayText">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <dxe:ComboBoxEdit x:Name="PART_Editor" DisplayMember="INTERNAL_NUM" ImmediatePopup="True" IncrementalFiltering="True" ItemsSource="{Binding RowData.Row.Entity.Entity.SubAreaCollection}" NullValueButtonPlacement="Popup" ValidateOnEnterKeyPressed="True" ValidateOnTextInput="True" ValueMember="GUID" />
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                                <!--For Filtering-->
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="INTERNAL_NUM" IsTextEditable="True" ItemsSource="{Binding SUBAREACollection}" ValueMember="GUID" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Entity.Entity.GUID_DISCIPLINE" ColumnFilterMode="DisplayText" Header="Discipline" SortMode="DisplayText">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding DISCIPLINECollection}" ValueMember="GUID" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Entity.Entity.DISCIPLINE_NUM" Header="Discipline Number" AllowBestFit="false" Width="60">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:SpinEditSettings Increment="1" IsFloatValue="False" IsTextEditable="True" Mask="n0" MaskType="Numeric" MaskUseAsDisplayFormat="True" MaxValue="99" MinValue="1" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Entity.Entity.GUID_DOCTYPE" Header="Document Type" HeaderToolTip="Discipline must be entered for this field to work" SortMode="DisplayText">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <dxe:ComboBoxEdit x:Name="PART_Editor" DisplayMember="NAME" AutoComplete="True" ImmediatePopup="True" IncrementalFiltering="True" ItemsSource="{Binding RowData.Row.Entity.Entity.ValidDOCTYPES}" NullValueButtonPlacement="Popup" ValidateOnEnterKeyPressed="True" ValidateOnTextInput="True" ValueMember="GUID" />
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                                <!--  For Filtering  -->
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding DOCTYPECollection}" NullValueButtonPlacement="EditBox" ValueMember="GUID" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Entity.Entity.DELIVERABLE_TYPE" Header="Deliverable Type" SortMode="DisplayText">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings AutoComplete="True" IsTextEditable="True" ItemsSource="{dxe:EnumItemsSource EnumType={x:Type common:DeliverableType}}" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Entity.Entity.GUID_DEPARTMENT" Header="Department" HeaderToolTip="Default value can be populated by document type selection" SortMode="DisplayText">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding DEPARTMENTCollection}" ValueMember="GUID" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Tag="True;False;Populate from Area, Department, Discipline and Document Type" FieldName="Entity.Entity.INTERNAL_NUM" AllowBestFit="false" Width="140" Header="Internal Number" HeaderToolTip="Must be unique">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <!--  Use IsEnabled because when textEdit is invoked the 2nd time IsReadOnly didn't get picked up in the binding  -->
                                        <dxe:TextEdit Name="PART_Editor" IsEnabled="{Binding RowData.Row.IsInternalNumberEditable}" />
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Entity.Entity.INTERNALNUM_STATUS" Header="Internal Number Status" ReadOnly="True" SortMode="DisplayText">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings AutoComplete="True" IsTextEditable="True" ItemsSource="{dxe:EnumItemsSource EnumType={x:Type common:DocumentNumberStatus}}" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="IsInternalNumberEditable" Visible="False" />
                            <dxg:GridColumn FieldName="Entity.Entity.CLIENT_NUM" Header="Client Number">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <!--  Use IsEnabled because when textEdit is invoked the 2nd time IsReadOnly didn't get picked up in the binding  -->
                                        <dxe:TextEdit Name="PART_Editor" IsEnabled="{Binding RowData.Row.IsClientNumberEditable}" />
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Entity.Entity.CLIENTNUM_STATUS" Header="Client Number Status" ReadOnly="True" SortMode="DisplayText">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings AutoComplete="True" IsTextEditable="True" ItemsSource="{dxe:EnumItemsSource EnumType={x:Type common:DocumentNumberStatus}}" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Entity.Entity.REVISION_NUMBER" Header="Revision Number" AllowBestFit="false" Width="60" />
                            <dxg:GridColumn FieldName="Entity.Entity.PRIMARY_TITLE" Header="Primary Title" />
                            <dxg:GridColumn FieldName="Entity.Entity.SECONDARY_TITLE" Header="Secondary Title" />
                            <dxg:GridColumn FieldName="Entity.Entity.COMMENTS" Header="Comments" />
                            <dxg:GridColumn FieldName="Entity.Entity.DeliverableStatusGuid" Header="Status" HeaderToolTip="Changing this field may affect progress if [Update % by Status] button is click in progress" SortMode="DisplayText">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <dxe:ComboBoxEdit x:Name="PART_Editor" DisplayMember="NAME" ImmediatePopup="True" IncrementalFiltering="True" ItemsSource="{Binding RowData.Row.Entity.Entity.DeliverableStatusCollection}" NullValueButtonPlacement="Popup" ValidateOnEnterKeyPressed="True" ValidateOnTextInput="True" ValueMember="GUID" />
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                                <!--  For Filtering  -->
                                <dxg:GridColumn.EditSettings>
