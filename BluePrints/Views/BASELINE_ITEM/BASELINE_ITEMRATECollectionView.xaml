<UserControl x:Class="BluePrints.Views.BASELINE_ITEMRATECollectionView" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:common="clr-namespace:BluePrints.Common" xmlns:converters="clr-namespace:BluePrints.Common.ViewModel.Converters" xmlns:custom="clr-namespace:BaseModel.Misc;assembly=BaseModel" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxa="http://schemas.devexpress.com/winfx/2008/xaml/accordion" xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon" xmlns:dxrudex="http://schemas.devexpress.com/winfx/2008/xaml/reports/userdesignerextensions" xmlns:filter="clr-namespace:BluePrints.Common.Filtering" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:view="clr-namespace:BluePrints.Views" xmlns:viewmodel="clr-namespace:BluePrints.ViewModels" x:Name="userControl" d:DesignHeight="400" d:DesignWidth="600" DataContext="{dxmvvm:ViewModelSource viewmodel:BASELINE_ITEMRATECollectionViewModelWrapper}" mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <DataTemplate x:Key="glyphTemplate">
                <dxc:DXImage x:Name="glyph" Width="16" Height="16" Margin="3,0,0,0" SnapsToDevicePixels="True" Source="{Binding}" />
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                        <Setter TargetName="glyph" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
            <Style x:Key="accordionItemContainerStyle" TargetType="dxa:AccordionItem">
                <Setter Property="Header" Value="{Binding Name}" />
                <Style.Triggers>
                    <Trigger Property="ItemLevel" Value="1">
                        <Setter Property="ShowInCollapsedMode" Value="{Binding ShowInCollapsedMode}" />
                        <Setter Property="Glyph" Value="{Binding Icon}" />
                        <Setter Property="GlyphTemplate" Value="{StaticResource glyphTemplate}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <common:RowNameConverter x:Key="RowNameConverter" />
            <converters:IReportableStatsMaximumUnitsConverter x:Key="IReportableStatsMaximumUnitsConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/DefaultBluePrintsResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/BaseModel;component/View/ResourceDictionaries/DefaultControlResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/CustomControlResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/ConverterResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Style="{StaticResource CollectionView.RootContainer}">
        <DockPanel>
            <dxr:RibbonControl Style="{StaticResource DefaultRibbonControlStyle}">
                <dxr:RibbonDefaultPageCategory MergeType="Replace" Caption="defaultCategory">
                    <dxr:RibbonPage MergeType="Replace" Caption="Grid">
                        <dxr:RibbonPageGroup MergeType="Replace" Caption="Grid" ItemLinksSource="{StaticResource RibbonDefaultGridButtons}" />
                        <dxr:RibbonPageGroup MergeType="Replace" Caption="Tools">
                            <!--<dxb:BarStaticItem Content="{Binding DataDate}" />-->
                            <dxb:BarCheckItem Content="Hide Zero Cost" Glyph="{dxc:DXImage Image=Hide_16x16.png}" IsChecked="{Binding HideZeroCost}" LargeGlyph="{dxc:DXImage Image=Hide_32x32.png}" ToolTip="Hide role with zero cost" />
                        </dxr:RibbonPageGroup>
                        <dxr:RibbonPageGroup MergeType="Replace" Caption="Report">
                            <dxb:BarSubItem AllowDrop="True" Content="Role Report" Glyph="{dxc:DXImage Image=Role_16x16.png}" LargeGlyph="{dxc:DXImage Image=Role_32x32.png}">
                                <dxb:BarButtonItem Command="{Binding EditReportRoleCommand}" Content="Edit Report" Glyph="{dx:DXImage Image=Edit_16x16.png}" LargeGlyph="{dx:DXImage Image=Edit_32x32.png}" RibbonStyle="SmallWithText" ToolTip="Redesign the report layout" />
                                <dxb:BarButtonItem Command="{Binding ViewReportRoleCommand}" Content="View Report" Glyph="{dx:DXImage Image=Report_16x16.png}" LargeGlyph="{dx:DXImage Image=Report_32x32.png}" RibbonStyle="SmallWithText" ToolTip="View rate report of the deliverable's costs by role. Report will filtered according to what is shown in this table" />
                            </dxb:BarSubItem>
                            <dxb:BarSubItem AllowDrop="True" Content="Discipline Report" Glyph="{dxc:DXImage Image=Team_16x16.png}" LargeGlyph="{dxc:DXImage Image=Team_32x32.png}">
                                <dxb:BarButtonItem Command="{Binding EditReportDisciplineCommand}" Content="Edit Report" Glyph="{dx:DXImage Image=Edit_16x16.png}" LargeGlyph="{dx:DXImage Image=Edit_32x32.png}" RibbonStyle="SmallWithText" ToolTip="Redesign the report layout" />
                                <dxb:BarButtonItem Command="{Binding ViewReportDisciplineCommand}" Content="View Report" Glyph="{dx:DXImage Image=Report_16x16.png}" LargeGlyph="{dx:DXImage Image=Report_32x32.png}" RibbonStyle="SmallWithText" ToolTip="View rate report of the deliverable's costs by role. Report will filtered according to what is shown in this table" />
                            </dxb:BarSubItem>
                            <dxb:BarSubItem AllowDrop="True" Content="Discipline Role Report" Glyph="{dxc:DXImage Image=UserGroup_16x16.png}" LargeGlyph="{dxc:DXImage Image=UserGroup_32x32.png}">
                                <dxb:BarButtonItem Command="{Binding EditReportDisciplineRoleCommand}" Content="Edit Report" Glyph="{dx:DXImage Image=Edit_16x16.png}" LargeGlyph="{dx:DXImage Image=Edit_32x32.png}" RibbonStyle="SmallWithText" ToolTip="Redesign the report layout" />
                                <dxb:BarButtonItem Command="{Binding ViewReportDisciplineRoleCommand}" Content="View Report" Glyph="{dx:DXImage Image=Report_16x16.png}" LargeGlyph="{dx:DXImage Image=Report_32x32.png}" RibbonStyle="SmallWithText" ToolTip="View rate report of the deliverable's costs by role. Report will filtered according to what is shown in this table" />
                            </dxb:BarSubItem>
                        </dxr:RibbonPageGroup>
                        <!--<dxr:RibbonPageGroup MergeType="Replace" Caption="Report" ItemLinksSource="{StaticResource RibbonDefaultReportingButtons}" />-->
                    </dxr:RibbonPage>
                </dxr:RibbonDefaultPageCategory>
            </dxr:RibbonControl>
            <dxlc:LayoutControl DockPanel.Dock="Right">
                <dxlc:LayoutGroup.LayoutTransform>
                    <RotateTransform Angle="90" />
                </dxlc:LayoutGroup.LayoutTransform>
                <dxlc:LayoutGroup IsCollapsible="True" View="Group">
                    <Grid>
                        <Grid.LayoutTransform>
                            <RotateTransform Angle="-90" />
                        </Grid.LayoutTransform>
                        <filter:FilterAccordionView DataContext="{Binding FilterTreeViewModel}" />
                    </Grid>
                </dxlc:LayoutGroup>
            </dxlc:LayoutControl>
            <dxg:GridControl x:Name="GridControl" dxc:DXSerializer.SerializationID="GridControlBASELINE_ITEM" dxc:DXSerializer.StoreLayoutMode="All" DockPanel.Dock="Right" Style="{StaticResource DefaultGridControlTemplate}">
                <dxg:GridControl.Columns>
                    <dxg:GridColumn FieldName="Entity.GUID_AREA" Header="Area" ReadOnly="True">
                        <dxg:GridColumn.EditSettings>
                            <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="INTERNAL_NUM" IsTextEditable="True" ItemsSource="{Binding AREACollection}" ValueMember="GUID" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="Entity.SubAreaGuid" Header="Sub-Area" ReadOnly="True">
                        <dxg:GridColumn.CellTemplate>
                            <DataTemplate>
                                <dxe:ComboBoxEdit x:Name="PART_Editor" DisplayMember="INTERNAL_NUM" ImmediatePopup="True" IncrementalFiltering="True" ItemsSource="{Binding RowData.Row.Entity.SubAreaCollection}" NullValueButtonPlacement="Popup" ValidateOnEnterKeyPressed="True" ValidateOnTextInput="True" ValueMember="GUID" />
                            </DataTemplate>
                        </dxg:GridColumn.CellTemplate>
                        <!--  For Filtering  -->
                        <dxg:GridColumn.EditSettings>
                            <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="INTERNAL_NUM" IsTextEditable="True" ItemsSource="{Binding SUBAREACollection}" NullValueButtonPlacement="EditBox" ValueMember="GUID" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="Entity.GUID_DISCIPLINE" Header="Discipline" ReadOnly="True">
                        <dxg:GridColumn.EditSettings>
                            <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding DISCIPLINECollection}" ValueMember="GUID" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="Entity.GUID_DOCTYPE" Header="Document Type" ReadOnly="True">
                        <dxg:GridColumn.EditSettings>
                            <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding DOCTYPECollection}" ValueMember="GUID" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="Entity.GUID_DEPARTMENT" Header="Department" ReadOnly="True">
                        <dxg:GridColumn.EditSettings>
                            <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding DEPARTMENTCollection}" ValueMember="GUID" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="RateRole" Header="Role" ReadOnly="True">
                        <dxg:GridColumn.EditSettings>
                            <dxe:ComboBoxEditSettings AutoComplete="True" IsTextEditable="True" ItemsSource="{dxe:EnumItemsSource EnumType={x:Type common:RateRole}}" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="Entity.INTERNAL_NUM" Header="Internal Number" IsEnabled="False" ReadOnly="True" />
                    <dxg:GridColumn FieldName="Entity.DELIVERABLE_TYPE" Header="Deliverable Type" IsEnabled="False" ReadOnly="True" />
                    <dxg:GridColumn FieldName="Entity.PRIMARY_TITLE" Header="Primary Title" IsEnabled="False" ReadOnly="True" />
                    <dxg:GridColumn FieldName="Entity.SECONDARY_TITLE" Header="Secondary Title" IsEnabled="False" ReadOnly="True" />
                    <dxg:GridColumn FieldName="Entity.COMMENTS" Header="Comments" ReadOnly="True" />
                    <dxg:GridColumn FieldName="SplitHours" Header="Budget Hours" HeaderToolTip="Estimated Hours" IsEnabled="False" ReadOnly="True">
                        <dxg:GridColumn.EditSettings>
                            <dxe:SpinEditSettings Increment="1" Mask="n0" MaskType="Numeric" MaskUseAsDisplayFormat="True" MinValue="0" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="SplitRate" Header="Budget Rate" HeaderToolTip="Estimated Rate" IsEnabled="False" ReadOnly="True">
                        <dxg:GridColumn.EditSettings>
                            <dxe:SpinEditSettings Increment="1" Mask="c0" MaskType="Numeric" MaskUseAsDisplayFormat="True" MinValue="0" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="RoleCost" Header="Budget Cost" HeaderToolTip="Estimated Costs" IsEnabled="False" ReadOnly="True">
                        <dxg:GridColumn.EditSettings>
                            <dxe:SpinEditSettings Increment="1" Mask="c0" MaskType="Numeric" MaskUseAsDisplayFormat="True" MinValue="0" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="Entity.GUID_SUBJOB" Header="Subjob" HeaderToolTip="Automatically assigned field. Changing this will affect workpack name" ReadOnly="True" Visible="true">
                        <dxg:GridColumn.EditSettings>
                            <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="INTERNAL_NAME1" IsTextEditable="True" ItemsSource="{Binding SUBJOBCollection}" ValueMember="GUID" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="Entity.GUID_WORKPACK" Header="Workpack" HeaderToolTip="Automatically assigned field. Must match Exo subjob to produce a summary of burned" ReadOnly="True" Visible="true">
                        <dxg:GridColumn.EditSettings>
                            <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding WORKPACKCollection}" ValueMember="GUID" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                </dxg:GridControl.Columns>
                <dxg:GridControl.GroupSummary>
                    <dxg:GridSummaryItem DisplayFormat="n" FieldName="SplitHours" ShowInColumn="SplitHours" SummaryType="Sum" />
                    <dxg:GridSummaryItem DisplayFormat="c" FieldName="RoleCost" ShowInColumn="RoleCost" SummaryType="Sum" />
                    <dxg:GridSummaryItem FieldName="Entity.GUID_AREA" dxc:DXSerializer.Enabled="False" DisplayFormat="{}{0} Record(s)" SummaryType="Count" />
                </dxg:GridControl.GroupSummary>
                <dxg:GridControl.TotalSummary>
                    <dxg:GridSummaryItem DisplayFormat="n" FieldName="SplitHours" ShowInColumn="SplitHours" SummaryType="Sum" />
                    <dxg:GridSummaryItem DisplayFormat="c" FieldName="RoleCost" ShowInColumn="RoleCost" SummaryType="Sum" />
                </dxg:GridControl.TotalSummary>
                <dxg:GridControl.View>
                    <dxg:TableView x:Name="tableView" Style="{StaticResource DefaultTableViewTemplate}">
                        <dxg:TableView.RowCellMenuCustomizations>
                            <dxb:BarLinkContainerItem ItemLinksSource="{StaticResource ContextMenuDefaultHeaderButtons}" />
                            <dxb:BarItemLinkSeparator />
                            <dxb:BarLinkContainerItem ItemLinksSource="{StaticResource ContextMenuDefaultFooterButtons}" />
                        </dxg:TableView.RowCellMenuCustomizations>
                    </dxg:TableView>
                </dxg:GridControl.View>
            </dxg:GridControl>
        </DockPanel>
    </Grid>
</UserControl>
