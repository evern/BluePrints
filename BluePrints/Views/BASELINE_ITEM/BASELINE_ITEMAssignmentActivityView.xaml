<dx:DXWindow 
             x:Name="userControl"
             x:Class="BluePrints.Views.BASELINE_ITEMAssignmentActivityView"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:custom="clr-namespace:BaseModel.Misc;assembly=BaseModel"
             Height="700" Width="1000" Title="Deliverable's Activity Assignment" WindowStartupLocation="CenterScreen">
    <dxlc:LayoutControl Orientation="Vertical" MaxHeight="1000">
        <dxlc:LayoutGroup Name="LayoutGroupContainer" View="Group" Header="Current Deliverable" Orientation="Horizontal">
            <dxlc:LayoutGroup Name="LayoutGroupBaseline_ItemSelection" View="GroupBox" Header="Activity Assignments" Orientation="Vertical">
                <dxlc:LayoutGroup Orientation="Horizontal">
                    <dxlc:LayoutItem Height="25" Label="Activity:" IsRequired="True">
                        <dxg:LookUpEdit AutoPopulateColumns="False" x:Name="lookupActivity"
                            SelectedItem="{Binding SelectedTASK, Mode=TwoWay}" DisplayMember="Description"
                            ItemsSource="{Binding TASKSItemSource}">
                            <dxmvvm:Interaction.Behaviors>
                                <dxmvvm:EventToCommand EventName="EditValueChanging"
                                            Command="{Binding lookupActivity_EditValueChangingCommand}"
                                            PassEventArgsToCommand="True" />
                            </dxmvvm:Interaction.Behaviors>
                            <dxg:LookUpEdit.PopupContentTemplate>
                                <ControlTemplate TargetType="ContentControl">
                                    <custom:GridControlEx x:Name="PART_GridControl" dx:DXSerializer.SerializationID="GridControlAssignmentBASELINE_ITEM" ShowBorder="False">
                                        <dxg:GridControl.Columns>
                                            <dxg:GridColumn IsSmart="True" AllowEditing="False" FieldName="Subject" />
                                            <dxg:GridColumn IsSmart="True" AllowEditing="False" Width="500"
                                                FieldName="Description" />
                                        </dxg:GridControl.Columns>
                                        <dxg:GridControl.View>
                                            <dxg:TreeListView Name="treeListView1" TreeDerivationMode="Selfreference"
                                                    KeyFieldName="task_id" ParentFieldName="ParentId" />
                                        </dxg:GridControl.View>
                                    </custom:GridControlEx>
                                </ControlTemplate>
                            </dxg:LookUpEdit.PopupContentTemplate>
                        </dxg:LookUpEdit>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem Width="80">
                        <Button x:Name="btnMatchAssignment" VerticalAlignment="Top" Width="25" Height="25" ToolTip="Match Selected Assignment"
                            Padding="0, 0, 0, 0" Command="{Binding MatchSelectedBASELINE_ITEM_ASSIGNMENTCommand}">
                            <StackPanel>
                                <Image Source="{dx:DXImageOffice2013 Image=Find_32x32.png}" />
                            </StackPanel>
                        </Button>
                    </dxlc:LayoutItem>
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup Orientation="Horizontal">
                    <dxlc:LayoutItem Width="80" HorizontalAlignment="Center"/>
                </dxlc:LayoutGroup>
                <dxlc:LayoutGroup View="GroupBox" Header="Assignments" Orientation="Horizontal">
                    <dxlc:LayoutItem HorizontalAlignment="Left" Height="460" >
                        <custom:GridControlEx x:Name="gridControlBASELINE_ITEM_ASSIGNMENTS" dx:DXSerializer.SerializationID="GridControlBASELINE_ITEM_ASSIGNMENTS" SelectionMode="Row" ShowBorder="False"
                                    CurrentItem="{Binding DataContext.SelectedASSIGNMENT, Mode=TwoWay, ElementName=userControl}"
                                    SelectedItems="{Binding DataContext.SelectedASSIGNMENTS, Mode=TwoWay, ElementName=userControl}"
                                    ItemsSource="{Binding ContextBASELINE_ITEM_ASSIGNMENTS}">
                            <dxg:GridControl.Columns>
                                <dxg:GridColumn AllowEditing="False" ReadOnly="True" Header="Deliverable" FieldName="INTERNAL_NUM" Width="200" VisibleIndex="0"/>
                                <dxg:GridColumn AllowEditing="False" ReadOnly="True" Header="P6 ID"
                                        FieldName="Entity.P6_ACTIVITYID" VisibleIndex="10" />
                                <dxg:GridColumn AllowEditing="False" ReadOnly="True" Header="P6 Description"
                                        FieldName="Entity.P6_ACTIVITYID" VisibleIndex="20" Width="300">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings ItemsSource="{Binding TASKSItemSource}"
                                                            ValueMember="Subject" DisplayMember="Description" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn AllowEditing="False" ReadOnly="True" Header="Low Value"
                                        FieldName="Entity.LOW_VALUE" VisibleIndex="30">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings DisplayFormat="p2" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn AllowEditing="False" ReadOnly="True" Header="High Value"
                                        FieldName="Entity.HIGH_VALUE" VisibleIndex="40">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings DisplayFormat="p2" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                            </dxg:GridControl.Columns>
                            <dxg:GridControl.View>
                                <custom:TableViewEx x:Name="GridViewBaseline_ItemAssignment"
                                        FocusedRow="{Binding SelectedBASELINE_ITEM_ASSIGNMENT, Mode=TwoWay}"
                                        NavigationStyle="Row" ShowGroupPanel="False" AutoWidth="False"
                                        AllowEditing="False" AllowSorting="False" />
                            </dxg:GridControl.View>
                        </custom:GridControlEx>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutGroup x:Name="assignmentNavigationLayoutGroup" HorizontalAlignment="Right"
                                Orientation="Vertical">
                        <dxlc:LayoutItem>
                            <Button x:Name="btnPriorityUp" VerticalAlignment="Top" Width="40" Height="40"
                            Padding="0, 0, 0, 0" Command="{Binding PriorityUpCommand}">
                                <StackPanel>
                                    <Image Source="{dx:DXImageOffice2013 Image=Previous_32x32.png}" />
                                </StackPanel>
                            </Button>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem>
                            <Button x:Name="btnPriorityDown" VerticalAlignment="Top" Width="40" Height="40"
                            Padding="0, 0, 0, 0" Command="{Binding PriorityDownCommand}">
                                <StackPanel>
                                    <Image Source="{dx:DXImageOffice2013 Image=NavigateNext_32x32.png}" />
                                </StackPanel>
                            </Button>
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem>
                            <Button x:Name="btnAssignmentDelete" VerticalAlignment="Top" Width="40" Height="40"
                            Padding="0, 0, 0, 0" Command="{Binding DeleteAssignmentCommand}">
                                <StackPanel>
                                    <Image Source="{dx:DXImageOffice2013 Image=DeleteFooter_32x32.png}" />
                                </StackPanel>
                            </Button>
                        </dxlc:LayoutItem>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutGroup>
    </dxlc:LayoutControl>
</dx:DXWindow>