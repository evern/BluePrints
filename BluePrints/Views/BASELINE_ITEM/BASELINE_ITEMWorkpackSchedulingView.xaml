<UserControl x:Class="BluePrints.Views.BASELINE_ITEMWorkpackSchedulingView" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:common="clr-namespace:BluePrints.Common" xmlns:commonviewmodel="clr-namespace:BluePrints.Common.ViewModel" xmlns:converters="clr-namespace:BluePrints.Common.ViewModel.Converters" xmlns:custom="clr-namespace:BaseModel.Misc;assembly=BaseModel" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxa="http://schemas.devexpress.com/winfx/2008/xaml/accordion" xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys" xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon" xmlns:dxrudex="http://schemas.devexpress.com/winfx/2008/xaml/reports/userdesignerextensions" xmlns:helper="clr-namespace:BluePrints.Common.Helpers" xmlns:local="clr-namespace:BluePrints.Views" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:services="clr-namespace:BaseModel.ViewModel.Services;assembly=BaseModel" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:themes="http://schemas.devexpress.com/winfx/2008/xaml/editors/themekeys" xmlns:view="clr-namespace:BluePrints.Views" xmlns:viewmodel="clr-namespace:BluePrints.ViewModels" x:Name="userControl" d:DesignHeight="1500" d:DesignWidth="1800" DataContext="{dxmvvm:ViewModelSource viewmodel:BASELINE_ITEMWorkpackSchedulingViewModelWrapper}" mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <common:RowNameConverter x:Key="RowNameConverter" />
            <converters:IReportableStatsMaximumUnitsConverter x:Key="IReportableStatsMaximumUnitsConverter" />
            <Style x:Key="SelectedRowStyle" TargetType="{x:Type dxg:RowControl}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Path=IsSelected}" Value="True">
                        <Setter Property="Background" Value="Gray" />
                        <Setter Property="Foreground" Value="White" />
                    </DataTrigger>
                    <Trigger Property="dxg:GridViewBase.IsFocusedRow" Value="True">
                        <Setter Property="Background" Value="Salmon" />
                        <Setter Property="Foreground" Value="White" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <DataTemplate x:Key="TimeTemplate">
                <dxe:DateEdit x:Name="PART_Editor" Mask="dd-MMM-yy" MaskUseAsDisplayFormat="True" />
            </DataTemplate>
            <DataTemplate x:Key="GanttTemplate">
                <commonviewmodel:GanttCanvas x:Name="LayoutRoot" DataContext="{Binding Value}" EditRange="{Binding SelectionRange, ElementName=GanttRange}">
                    <Border Canvas.Left="{Binding Left, Mode=OneWay}" Canvas.Top="2" Width="{Binding Width, Mode=OneWay}" Height="16" BorderBrush="DimGray" BorderThickness="1" CornerRadius="3" Opacity="1" />
                    <ItemsControl ItemsSource="{Binding Days, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Rectangle Width="{Binding DataContext.DayWidth, ElementName=LayoutRoot, Mode=OneWay}" Height="20" Stroke="Gray" StrokeThickness="0.1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </commonviewmodel:GanttCanvas>
            </DataTemplate>
            <ControlTemplate x:Key="{themes:CalendarClientThemeKey IsThemeIndependent=True, ResourceKey=CalendarItemTemplate}" TargetType="{x:Type dxe:CalendarItem}">
                <Border x:Name="Border" Background="#FFB9BAC3" BorderThickness="0">
                    <TextBlock x:Name="Text" Margin="0" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{TemplateBinding Text}" TextAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Border" Property="Background" Value="LightSteelBlue" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/DefaultBluePrintsResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/BaseModel;component/View/ResourceDictionaries/DefaultControlResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/ConverterResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/CustomControlResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Style="{StaticResource CollectionView.RootContainer}">
        <dxmvvm:Interaction.Behaviors>
            <dxc:DialogService x:Name="CommodityCodeDialogService">
                <dxc:DialogService.DialogStyle>
                    <Style TargetType="dx:DXDialogWindow">
                        <Setter Property="SizeToContent" Value="WidthAndHeight" />
                    </Style>
                </dxc:DialogService.DialogStyle>
            </dxc:DialogService>
            <dxc:DialogService x:Name="ActivityIdDialog">
                <dxc:DialogService.DialogStyle>
                    <Style TargetType="dx:DXDialogWindow">
                        <Setter Property="SizeToContent" Value="WidthAndHeight" />
                        <Setter Property="MinWidth" Value="600" />
                        <Setter Property="MinHeight" Value="600" />
                    </Style>
                </dxc:DialogService.DialogStyle>
            </dxc:DialogService>
        </dxmvvm:Interaction.Behaviors>
        <Grid DataContext="{Binding MainViewModel}">
            <DockPanel>
                <dxr:RibbonControl MDIMergeStyle="WhenChildActivated" AllowCustomization="False" DockPanel.Dock="Top" RibbonStyle="Office2010">
                    <dxr:RibbonDefaultPageCategory MergeType="Replace" Caption="defaultCategory">
                        <dxr:RibbonPage MergeType="Replace" Caption="Grid">
                            <dxr:RibbonPageGroup MergeType="Replace" Caption="Grid" ItemLinksSource="{StaticResource RibbonDefaultGridButtons}" />
                            <dxr:RibbonPageGroup MergeType="Replace" Caption="Layout" ItemLinksSource="{StaticResource RibbonDefaultLayoutButtons}" />
                            <dxr:RibbonPageGroup MergeType="Replace" Caption="Scheduling">
                                <dxb:BarButtonItem Content="Check and Delete Assignments" ToolTip="Check for invalid assignment and prompt to remove them" Command="{Binding DataContext.Check_AssignmentsCommand, ElementName=userControl}" LargeGlyph="{dx:DXImageOffice2013 Image=Delete_32x32.png}" Glyph="{dx:DXImage Image=Delete_16x16.png}" />
                                <dxb:BarButtonItem Content="Remap P6 Ids" ToolTip="Map old assignments activity id to new assignments activity id" Command="{Binding DataContext.Remap_P6_IdsCommand, ElementName=userControl}" LargeGlyph="{dx:DXImage Image=DuplicateValues_32x32.png}" Glyph="{dxc:DXImage Image=DuplicateValues_16x16.png}" />
                                <dxb:BarButtonItem Content="Push to P6" ToolTip="Push assigned units to budgeted units in P6" Command="{Binding DataContext.PushToP6Command, ElementName=userControl}" LargeGlyph="{dx:DXImage Image=DoubleNext_32x32.png}" Glyph="{dx:DXImage Image=DoubleNext_16x16.png}" />
                            </dxr:RibbonPageGroup>
                        </dxr:RibbonPage>
                    </dxr:RibbonDefaultPageCategory>
                </dxr:RibbonControl>
                <dxr:RibbonStatusBarControl DockPanel.Dock="Bottom">
                    <dxr:RibbonStatusBarControl.LeftItems>
                        <dxb:BarStaticItem Content="{Binding Entities.Count, Converter={dxmvvm:FormatStringConverter FormatString='RECORDS: {0}'}}" />
                    </dxr:RibbonStatusBarControl.LeftItems>
                </dxr:RibbonStatusBarControl>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="0" />
                    </Grid.RowDefinitions>
                    <custom:GridControlEx x:Name="GridControlExcelExport" Grid.Row="0" dxc:DXSerializer.Enabled="False" ItemsSource="{Binding DataContext.ExcelExportData, ElementName=userControl}" Visibility="Collapsed">
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn Header="Workpack Id" FieldName="INTERNAL_NUM" ReadOnly="True" />
                            <dxg:GridColumn Header="Workpack Description" FieldName="Deliverable_Description" ReadOnly="True" />
                            <dxg:GridColumn Header="P6 Id" FieldName="P6_ACTIVITY" ReadOnly="True" />
                            <dxg:GridColumn Header="P6 Description" FieldName="P6_Description" ReadOnly="True" />
                            <dxg:GridColumn Header="Current Assignment Units" FieldName="UNITS" ReadOnly="True" />
                            <dxg:GridColumn FieldName="FromPercentage" ReadOnly="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:SpinEditSettings Increment="1" Mask="p2" MaskType="Numeric" MaskUseAsDisplayFormat="True" MinValue="0" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="ToPercentage" ReadOnly="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:SpinEditSettings Increment="1" Mask="p2" MaskType="Numeric" MaskUseAsDisplayFormat="True" MinValue="0" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                        </dxg:GridControl.Columns>
                        <dxg:GridControl.View>
                            <!--  need to set tableView name here for export to work  -->
                            <dxg:TableView Name="tableView" />
                        </dxg:GridControl.View>
                    </custom:GridControlEx>
                </Grid>
                <dxlc:LayoutControl Orientation="Vertical">
                    <dxlc:LayoutGroup Header="Edit Value" Name="LayoutGroupGrid" Height="500" dxlc:LayoutControl.AllowVerticalSizing="True" Orientation="Vertical" View="Group">
                        <dxlc:LayoutGroup HorizontalAlignment="Stretch" Orientation="Horizontal">
                            <dxlc:LayoutGroup HorizontalAlignment="Stretch" dxlc:LayoutControl.AllowHorizontalSizing="True">
                                <dxg:GridControl dxc:DXSerializer.SerializationID="GridControlActivities" DesignTimeDataObjectType="{x:Type commonviewmodel:P6_Activity}" ItemsSource="{Binding DataContext.Activities_Source, ElementName=userControl}" SelectedItem="{Binding DataContext.Selected_Activity, Mode=TwoWay, ElementName=userControl}">
                                    <dxg:GridControl.Columns>
                                        <dxg:GridColumn Header="Activity Id" FieldName="P6_ActivityId" Width="50" IsSmart="True" />
                                        <dxg:GridColumn Header="Task" FieldName="Description" IsSmart="True" />
                                        <dxg:GridColumn Header="Type" FieldName="DisplayActivityType" FixedWidth="True" IsSmart="True" />
                                        <dxg:GridColumn Header="Begin" FieldName="Start" Width="100" CellTemplate="{StaticResource TimeTemplate}" IsSmart="True" />
                                        <dxg:GridColumn Header="End" FieldName="End" Width="100" CellTemplate="{StaticResource TimeTemplate}" IsSmart="True" />
                                        <dxg:GridColumn Header="Assigned Units" FieldName="Assigned_Units" Width="100" IsSmart="True">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings HorizontalContentAlignment="Left" DisplayFormat="n" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <!--<dxg:GridColumn Binding="{Binding}" CellTemplate="{StaticResource GanttTemplate}" Header="Chart" />-->
                                    </dxg:GridControl.Columns>
                                    <dxg:GridControl.View>
                                        <dxg:TreeListView x:Name="treeView" AllowEditing="False" AllowPerPixelScrolling="True" AutoExpandAllNodes="True" KeyFieldName="Id" NavigationStyle="Row" ParentFieldName="ParentId" RowStyle="{StaticResource WBSBackgroundStyle}" ShowTotalSummary="False" TreeDerivationMode="Selfreference">
                                            <dxmvvm:Interaction.Behaviors>
                                                <dxmvvm:EventToCommand Command="{Binding DataContext.NodeExpandedCommand, ElementName=userControl}" EventName="NodeExpanded" />
                                                <dxmvvm:EventToCommand Command="{Binding DataContext.Activities_MouseDownCommand, ElementName=userControl}" EventName="MouseDown" PassEventArgsToCommand="True" />
                                            </dxmvvm:Interaction.Behaviors>
                                        </dxg:TreeListView>
                                    </dxg:GridControl.View>
                                    <dxmvvm:Interaction.Behaviors>
                                        <common:CustomTreeViewDragDropManager AllowDrag="False" AllowDrop="True">
                                            <dxmvvm:Interaction.Behaviors>
                                                <dxmvvm:EventToCommand Command="{Binding DataContext.Scheduler_DropCommand, ElementName=userControl}" EventName="Drop" PassEventArgsToCommand="True" />
                                                <dxmvvm:EventToCommand Command="{Binding DataContext.Scheduler_DroppedCommand, ElementName=userControl}" EventName="Dropped" PassEventArgsToCommand="True" />
                                            </dxmvvm:Interaction.Behaviors>
                                            <dxg:TreeListDragDropManager.DragElementTemplate>
                                                <DataTemplate>
                                                    <Border Background="White" BorderBrush="LightGray" BorderThickness="2" CornerRadius="5">
                                                        <StackPanel Margin="5" HorizontalAlignment="Left" Background="White" Orientation="Vertical">
                                                            <StackPanel Margin="5" Background="White" Orientation="Vertical">
                                                                <TextBlock Padding="3" FontWeight="Bold" Text="{Binding Path=DraggingRows.Count, StringFormat='Dragging {0} row(s)'}" />
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Padding="3,3,0,3" FontWeight="Bold" Text="Source: " />
                                                                    <TextBlock Padding="0,3,3,3" Text="{Binding Path=DraggingRows, Converter={StaticResource RowNameConverter}}" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                            <Separator />
                                                            <StackPanel Margin="5" Orientation="Horizontal">
                                                                <!--<StackPanel.Background>
                                                            <Binding Path="." Converter="{StaticResource RowColorConverter}" UpdateSourceTrigger="PropertyChanged"/>
                                                        </StackPanel.Background>-->
                                                                <TextBlock Padding="3,3,0,3" FontWeight="Bold" Text="Target: " />
                                                                <TextBlock Padding="0,3,3,0" Text="{Binding Path=DropTargetRow, Converter={StaticResource RowNameConverter}}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </dxg:TreeListDragDropManager.DragElementTemplate>
                                        </common:CustomTreeViewDragDropManager>
                                    </dxmvvm:Interaction.Behaviors>
                                </dxg:GridControl>
                            </dxlc:LayoutGroup>
                            <dxlc:LayoutGroup Header="Activity Assignments" Orientation="Vertical" View="GroupBox">
                                <dxlc:LayoutGroup Orientation="Horizontal">
                                    <dxlc:LayoutItem IsRequired="True" Label="Activity:">
                                        <dxg:LookUpEdit x:Name="lookupActivity" AutoPopulateColumns="False" DisplayMember="Description" ItemsSource="{Binding DataContext.Activities_Source, ElementName=userControl}" NullValueButtonPlacement="EditBox" SelectedItem="{Binding DataContext.Selected_Activity, Mode=TwoWay, ElementName=userControl}">
                                            <dxmvvm:Interaction.Behaviors>
                                                <dxmvvm:EventToCommand Command="{Binding DataContext.lookupActivity_EditValueChangingCommand, ElementName=userControl}" EventName="EditValueChanging" PassEventArgsToCommand="True" />
                                            </dxmvvm:Interaction.Behaviors>
                                            <dxg:LookUpEdit.PopupContentTemplate>
                                                <ControlTemplate TargetType="ContentControl">
                                                    <dxg:GridControl x:Name="PART_GridControl" ShowBorder="False">
                                                        <dxg:GridControl.Columns>
                                                            <dxg:GridColumn FieldName="P6_ActivityId" AllowEditing="False" IsSmart="True" />
                                                            <dxg:GridColumn FieldName="Description" Width="500" AllowEditing="False" IsSmart="True" />
                                                        </dxg:GridControl.Columns>
                                                        <dxg:GridControl.View>
                                                            <dxg:TreeListView Name="treeListView1" KeyFieldName="Id" ParentFieldName="ParentId" TreeDerivationMode="Selfreference" />
                                                        </dxg:GridControl.View>
                                                    </dxg:GridControl>
                                                </ControlTemplate>
                                            </dxg:LookUpEdit.PopupContentTemplate>
                                        </dxg:LookUpEdit>
                                    </dxlc:LayoutItem>
                                </dxlc:LayoutGroup>
                                <dxlc:LayoutGroup Orientation="Horizontal">
                                    <dxlc:LayoutItem Label="{Binding DataContext.Assignment_UOM, ElementName=userControl}" Visibility="{Binding DataContext.QuantityAssignmentVisibility, ElementName=userControl}">
                                        <dxe:SpinEdit EditValue="{Binding DataContext.Assignment_Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ElementName=userControl}" Increment="1" Mask="n2" MaskType="Numeric" MaskUseAsDisplayFormat="True" MaxValue="{Binding DataContext.Remaining_Quantity, ElementName=userControl}" MinValue="0" />
                                    </dxlc:LayoutItem>
                                    <dxlc:LayoutItem IsRequired="True" Label="Percentage:">
                                        <dxe:SpinEdit EditValue="{Binding DataContext.Assignment_Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ElementName=userControl}" Increment="0.1" Mask="p2" MaskType="Numeric" MaskUseAsDisplayFormat="True" MaxValue="{Binding DataContext.Assignment_MaxValue, ElementName=userControl}" MinValue="{Binding DataContext.Assignment_MinValue, ElementName=userControl}" />
                                    </dxlc:LayoutItem>
                                </dxlc:LayoutGroup>
                                <dxlc:LayoutGroup Orientation="Horizontal">
                                    <dxlc:LayoutItem HorizontalAlignment="Center">
                                        <Button Command="{Binding DataContext.Add_AssignmentsCommand, ElementName=userControl}">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{dx:DXImageOffice2013 Image=Add_32x32.png}" />
                                                <TextBlock VerticalAlignment="Center" Text="Add" />
                                            </StackPanel>
                                        </Button>
                                    </dxlc:LayoutItem>
                                </dxlc:LayoutGroup>
                                <dxlc:LayoutGroup Header="Assignments" Orientation="Horizontal" View="GroupBox">
                                    <dxlc:LayoutItem HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <dxg:GridControl dxc:DXSerializer.SerializationID="GridControlP6Assignments" CurrentItem="{Binding DataContext.Selected_P6_Assignment, Mode=TwoWay, ElementName=userControl}" ItemsSource="{Binding DataContext.P6_Assignments, ElementName=userControl}" SelectedItems="{Binding DataContext.Selected_P6_Assignments, Mode=TwoWay, ElementName=userControl}" SelectionMode="Row" ShowBorder="False">
                                            <dxg:GridControl.Columns>
                                                <dxg:GridColumn Header="{Binding DataContext.DeliverableHeaderTitle, ElementName=userControl}" FieldName="Deliverable_Name" ReadOnly="True" MinWidth="200" AllowEditing="False" />
                                                <dxg:GridColumn Header="P6 Id" FieldName="Entity.P6_ACTIVITYID" ReadOnly="True" AllowEditing="False" />
                                                <dxg:GridColumn Header="P6 Description" FieldName="Entity.P6_ACTIVITYID" ReadOnly="True" MinWidth="200" AllowEditing="False">
                                                    <dxg:GridColumn.EditSettings>
                                                        <dxe:ComboBoxEditSettings DisplayMember="Description" ItemsSource="{Binding DataContext.Activities_Source, ElementName=userControl}" ValueMember="P6_ActivityId" />
                                                    </dxg:GridColumn.EditSettings>
                                                </dxg:GridColumn>
                                                <dxg:GridColumn Header="From %" FieldName="Entity.LOW_VALUE" ReadOnly="True" AllowEditing="False">
                                                    <dxg:GridColumn.EditSettings>
                                                        <dxe:TextEditSettings DisplayFormat="p2" />
                                                    </dxg:GridColumn.EditSettings>
                                                </dxg:GridColumn>
                                                <dxg:GridColumn Header="To %" FieldName="Entity.HIGH_VALUE" ReadOnly="True" AllowEditing="False">
                                                    <dxg:GridColumn.EditSettings>
                                                        <dxe:TextEditSettings DisplayFormat="p2" />
                                                    </dxg:GridColumn.EditSettings>
                                                </dxg:GridColumn>
                                            </dxg:GridControl.Columns>
                                            <dxg:GridControl.View>
                                                <dxg:TableView AllowEditing="False" FocusedRow="{Binding DataContext.Selected_P6_Assignment, Mode=TwoWay, ElementName=userControl}" NavigationStyle="Row" RowStyle="{StaticResource SelectedRowStyle}" ShowGroupPanel="False">
                                                    <dxmvvm:Interaction.Behaviors>
                                                        <dxmvvm:EventToCommand Command="{Binding DataContext.P6_Assignment_MouseDownCommand, ElementName=userControl}" EventName="MouseDown" PassEventArgsToCommand="True" />
                                                    </dxmvvm:Interaction.Behaviors>
                                                </dxg:TableView>
                                            </dxg:GridControl.View>
                                        </dxg:GridControl>
                                    </dxlc:LayoutItem>
                                    <dxlc:LayoutGroup HorizontalAlignment="Right" Orientation="Vertical">
                                        <dxlc:LayoutItem>
                                            <Button Command="{Binding DataContext.PriorityUpCommand, ElementName=userControl}" x:Name="btnPriorityUp" Width="40" Height="40" Padding="0,0,0,0" VerticalAlignment="Top">
                                                <StackPanel>
                                                    <Image Source="{dx:DXImageOffice2013 Image=Previous_32x32.png}" />
                                                </StackPanel>
                                            </Button>
                                        </dxlc:LayoutItem>
                                        <dxlc:LayoutItem>
                                            <Button Command="{Binding DataContext.PriorityDownCommand, ElementName=userControl}" x:Name="btnPriorityDown" Width="40" Height="40" Padding="0,0,0,0" VerticalAlignment="Top">
                                                <StackPanel>
                                                    <Image Source="{dx:DXImageOffice2013 Image=NavigateNext_32x32.png}" />
                                                </StackPanel>
                                            </Button>
                                        </dxlc:LayoutItem>
                                        <dxlc:LayoutItem>
                                            <Button Command="{Binding DataContext.Delete_AssignmentsCommand, ElementName=userControl}" x:Name="btnAssignmentDelete" Width="40" Height="40" Padding="0,0,0,0" VerticalAlignment="Top">
                                                <StackPanel>
                                                    <Image Source="{dx:DXImageOffice2013 Image=DeleteFooter_32x32.png}" />
                                                </StackPanel>
                                            </Button>
                                        </dxlc:LayoutItem>
                                    </dxlc:LayoutGroup>
                                </dxlc:LayoutGroup>
                            </dxlc:LayoutGroup>
                        </dxlc:LayoutGroup>
                    </dxlc:LayoutGroup>
                    <dxlc:LayoutGroup Name="LayoutGroupTreeGrid" View="Group">
                        <custom:GridControlEx x:Name="GridControl" dxc:DXSerializer.SerializationID="GridControlDeliverables" dxc:DXSerializer.StoreLayoutMode="All" CurrentItem="{Binding DataContext.Selected_Deliverable, ElementName=userControl, Mode=TwoWay}" SelectedItems="{Binding DataContext.Selected_Deliverables, ElementName=userControl, Mode=TwoWay}" Style="{StaticResource DefaultGridControlTemplate}">
                            <dxg:GridControl.Columns>
                                <dxg:GridColumn Header="WORKPACK" FieldName="P6AssignmentName" ReadOnly="True" Width="100" VisibleIndex="0" />
                                <dxg:GridColumn Header="TITLE" FieldName="P6AssignmentDescription" ReadOnly="True" Width="100" VisibleIndex="0" />
                                <dxg:GridColumn Header="DISCIPLINE" FieldName="P6AssignmentDescription2" ReadOnly="True" Width="100" VisibleIndex="0" />
                                <dxg:GridColumn Header="BUDGET_HOURS" FieldName="Budget_Units" ReadOnly="True">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings Mask="n2" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn Header="DC_HOURS" FieldName="Variation_Units" ReadOnly="True" />
                                <dxg:GridColumn Header="ASSIGNED %" FieldName="Assigned_Percentage" ReadOnly="True" AllowEditing="False">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings Mask="p" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                            </dxg:GridControl.Columns>
                            <dxg:GridControl.GroupSummary>
                                <dxg:GridSummaryItem FieldName="GroupName" dxc:DXSerializer.Enabled="False" DisplayFormat="Total {0} Records" ShowInColumn="GroupName" SummaryType="Count" />
                                <dxg:GridSummaryItem FieldName="Budget_Units" dxc:DXSerializer.Enabled="False" DisplayFormat="Total: {0}" ShowInColumn="Budget_Units" SummaryType="Sum" />
                                <dxg:GridSummaryItem FieldName="Variation_Units" dxc:DXSerializer.Enabled="False" DisplayFormat="Total: {0:n}" ShowInColumn="Variation_Units" SummaryType="Sum" />
                            </dxg:GridControl.GroupSummary>
                            <dxg:GridControl.TotalSummary>
                                <dxg:GridSummaryItem FieldName="GroupName" dxc:DXSerializer.Enabled="False" DisplayFormat="Total {0} Records" ShowInColumn="GroupName" SummaryType="Count" />
                                <dxg:GridSummaryItem FieldName="Budget_Units" dxc:DXSerializer.Enabled="False" DisplayFormat="Total: {0}" ShowInColumn="Budget_Units" SummaryType="Sum" />
                                <dxg:GridSummaryItem FieldName="Variation_Units" dxc:DXSerializer.Enabled="False" DisplayFormat="Total: {0:n}" ShowInColumn="Variation_Units" SummaryType="Sum" />
                            </dxg:GridControl.TotalSummary>
                            <dxg:GridControl.View>
                                <dxg:TableView x:Name="tableViewAssignment" NewItemRowPosition="None" RowStyle="{StaticResource SelectedRowStyle}" Style="{StaticResource DefaultTableViewTemplate}">
                                    <dxg:TableView.FormatConditions>
                                        <dxg:DataBarFormatCondition FieldName="Assigned_Percentage" MaxValue="1" MinValue="0">
                                            <dxc:DataBarFormat BorderBrush="#FF63C384" BorderBrushNegative="#FFFF555A">
                                                <dxc:DataBarFormat.FillNegative>
                                                    <LinearGradientBrush EndPoint="1,0">
                                                        <GradientStop Offset="0" Color="White" />
                                                        <GradientStop Offset="1" Color="#FFFF555A" />
                                                    </LinearGradientBrush>
                                                </dxc:DataBarFormat.FillNegative>
                                                <dxc:DataBarFormat.Fill>
                                                    <LinearGradientBrush EndPoint="1,0">
                                                        <GradientStop Offset="0" Color="#FF63C384" />
                                                        <GradientStop Offset="1" Color="White" />
                                                    </LinearGradientBrush>
                                                </dxc:DataBarFormat.Fill>
                                                <dxc:DataBarFormat.ZeroLineBrush>
                                                    <DrawingBrush TileMode="Tile" Viewport="0,0,1001,4" ViewportUnits="Absolute">
                                                        <DrawingBrush.Drawing>
                                                            <GeometryDrawing Brush="Black">
                                                                <GeometryDrawing.Geometry>
                                                                    <GeometryGroup>
                                                                        <RectangleGeometry Rect="0,0,1000,3" />
                                                                        <RectangleGeometry Rect="1000,3,1,1" />
                                                                    </GeometryGroup>
                                                                </GeometryDrawing.Geometry>
                                                            </GeometryDrawing>
                                                        </DrawingBrush.Drawing>
                                                    </DrawingBrush>
                                                </dxc:DataBarFormat.ZeroLineBrush>
                                            </dxc:DataBarFormat>
                                        </dxg:DataBarFormatCondition>
                                    </dxg:TableView.FormatConditions>
                                    <dxg:TableView.RowCellMenuCustomizations>
                                        <dxb:BarButtonItem Content="Refresh" Command="{Binding DataContext.FullRefreshCommand, ElementName=userControl}" Glyph="{dx:DXImage Image=Refresh_16x16.png}" />
                                    </dxg:TableView.RowCellMenuCustomizations>
                                    <dxmvvm:Interaction.Behaviors>
                                        <dxmvvm:EventToCommand Command="{Binding DataContext.Deliverables_MouseDownCommand, ElementName=userControl}" EventName="MouseDown" PassEventArgsToCommand="True" />
                                    </dxmvvm:Interaction.Behaviors>
                                </dxg:TableView>
                            </dxg:GridControl.View>
                            <dxmvvm:Interaction.Behaviors>
                                <dxg:GridDragDropManager AllowDrag="True" AllowScrolling="True">
                                    <dxg:GridDragDropManager.DragElementTemplate>
                                        <DataTemplate>
                                            <Border Background="White" BorderBrush="LightGray" BorderThickness="2" CornerRadius="5">
                                                <StackPanel Margin="5" HorizontalAlignment="Left" Background="White" Orientation="Vertical">
                                                    <StackPanel Margin="5" Background="White" Orientation="Vertical">
                                                        <TextBlock Padding="3" FontWeight="Bold" Text="{Binding Path=DraggingRows.Count, StringFormat='Dragging {0} row(s)'}" />
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Padding="3,3,0,3" FontWeight="Bold" Text="Source: " />
                                                            <TextBlock Padding="0,3,3,3" Text="{Binding Path=DraggingRows, Converter={StaticResource RowNameConverter}}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Separator />
                                                    <StackPanel Margin="5" Orientation="Horizontal">
                                                        <!--<StackPanel.Background>
                                                            <Binding Converter="{StaticResource RowColorConverter}" Path="." UpdateSourceTrigger="PropertyChanged" />
                                                        </StackPanel.Background>-->
                                                        <TextBlock Padding="3,3,0,3" FontWeight="Bold" Text="Target: " />
                                                        <TextBlock Padding="0,3,3,0" Text="{Binding Path=DropTargetRow, Converter={StaticResource RowNameConverter}}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </dxg:GridDragDropManager.DragElementTemplate>
                                </dxg:GridDragDropManager>
                            </dxmvvm:Interaction.Behaviors>
                        </custom:GridControlEx>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutControl>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
