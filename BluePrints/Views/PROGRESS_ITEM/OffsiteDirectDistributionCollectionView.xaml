<UserControl x:Class="BluePrints.Views.OffsiteDirectDistributionCollectionView" xmlns:dxci="http://schemas.devexpress.com/winfx/2008/xaml/core/internal" xmlns:view1="clr-namespace:BluePrints.Common.ViewModel.Misc" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converter="clr-namespace:BluePrints.Common.ViewModel.Converters" xmlns:custom="clr-namespace:BaseModel.Misc;assembly=BaseModel" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon" xmlns:dxrudex="http://schemas.devexpress.com/winfx/2008/xaml/reports/userdesignerextensions" xmlns:filter="clr-namespace:BluePrints.Common.Filtering" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:view="clr-namespace:BluePrints.Views" xmlns:viewmodel="clr-namespace:BluePrints.ViewModels" x:Name="userControl" d:DesignHeight="400" d:DesignWidth="600" DataContext="{dxmvvm:ViewModelSource viewmodel:OffsiteDirectDistributionCollectionViewModelWrapper}" mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <view1:ColumnTemplateSelector x:Key="ColumnTemplateSelector"/>
            <DataTemplate x:Key="DefaultColumnTemplate">
                <ContentControl>
                    <dxg:GridColumn AllowBestFit="False" FieldName="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).FieldName, RelativeSource={RelativeSource Self}}" 
                        Header="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Header, RelativeSource={RelativeSource Self}}" 
                        Width="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Width, RelativeSource={RelativeSource Self}}"
                        Fixed="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Fixed, RelativeSource={RelativeSource Self}}"
                        ReadOnly="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).ReadOnly, RelativeSource={RelativeSource Self}}"
                        Visible="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Visible, RelativeSource={RelativeSource Self}, Mode=TwoWay}"
                        HeaderToolTip="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).HeaderToolTip, RelativeSource={RelativeSource Self}}"/>
                </ContentControl>
            </DataTemplate>
            <DataTemplate x:Key="NumberColumnTemplate">
                <ContentControl>
                    <dxg:GridColumn AllowBestFit="False" ColumnFilterMode="Value" FieldName="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).FieldName, RelativeSource={RelativeSource Self}}" 
                        Header="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Header, RelativeSource={RelativeSource Self}}" 
                        Width="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Width, RelativeSource={RelativeSource Self}}"
                        Fixed="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Fixed, RelativeSource={RelativeSource Self}}"
                        ReadOnly="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).ReadOnly, RelativeSource={RelativeSource Self}}"
                        Visible="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Visible, RelativeSource={RelativeSource Self}, Mode=TwoWay}"
                        HeaderToolTip="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).HeaderToolTip, RelativeSource={RelativeSource Self}}" >
                        <dxg:GridColumn.EditSettings>
                            <dxe:SpinEditSettings Mask="{Binding Mask}" MaskType="Numeric" Increment="{Binding Increment}" MaskUseAsDisplayFormat="True" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                </ContentControl>
            </DataTemplate>
            <DataTemplate x:Key="GatesColumnTemplate">
                <ContentControl>
                    <dxg:GridColumn AllowBestFit="False" UnboundType="Object" FieldName="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).FieldName, RelativeSource={RelativeSource Self}}" 
                        Header="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Header, RelativeSource={RelativeSource Self}}" 
                        Width="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Width, RelativeSource={RelativeSource Self}}"
                        Fixed="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Fixed, RelativeSource={RelativeSource Self}}"
                        ReadOnly="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).ReadOnly, RelativeSource={RelativeSource Self}}"
                        Visible="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Visible, RelativeSource={RelativeSource Self}, Mode=TwoWay}"
                        HeaderToolTip="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).HeaderToolTip, RelativeSource={RelativeSource Self}}" >
                        <dxg:GridColumn.CellTemplate>
                            <DataTemplate>
                                <dxe:ComboBoxEdit x:Name="PART_Editor" DisplayMember="NAME" ImmediatePopup="True" IncrementalFiltering="True" ItemsSource="{Binding RowData.Row.Entity.Entity.Entity.DeliverableStatusCollection}" ValidateOnEnterKeyPressed="True" NullValueButtonPlacement="Popup" ValidateOnTextInput="True" ValueMember="GUID" />
                            </DataTemplate>
                        </dxg:GridColumn.CellTemplate>
                        <!--  For copy paste  -->
                        <dxg:GridColumn.EditSettings>
                            <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding DataContext.DELIVERABLES_STATUSCollection}" ValueMember="GUID" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                </ContentControl>
            </DataTemplate>
            <DataTemplate x:Key="PercentColumnTemplate">
                <ContentControl>
                    <dxg:GridColumn AllowBestFit="False" ColumnFilterMode="Value" FieldName="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).FieldName, RelativeSource={RelativeSource Self}}" 
                        Header="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Header, RelativeSource={RelativeSource Self}}" 
                        Width="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Width, RelativeSource={RelativeSource Self}}"
                        Fixed="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Fixed, RelativeSource={RelativeSource Self}}"
                        ReadOnly="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).ReadOnly, RelativeSource={RelativeSource Self}}"
                        Visible="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Visible, RelativeSource={RelativeSource Self}, Mode=TwoWay}"
                        HeaderToolTip="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).HeaderToolTip, RelativeSource={RelativeSource Self}}" >
                        <dxg:GridColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Width="90">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Source="{dx:DXImage Image=First_16x16.png}" ToolTip="Minimum Possible Progress">
                                        <Image.Visibility>
                                            <MultiBinding Converter="{StaticResource NumericCompareToVisibilityConverter}" FallbackValue="Hidden">
                                                <MultiBinding.ConverterParameter>
                                                    <sys:Boolean>False</sys:Boolean>
                                                </MultiBinding.ConverterParameter>
                                                <Binding ElementName="PART_Editor" Path="MinValue" />
                                                <Binding ElementName="PART_Editor" Path="EditValue" />
                                            </MultiBinding>
                                        </Image.Visibility>
                                    </Image>
                                    <Image Grid.Column="1" Source="{dx:DXImage Image=Last_16x16.png}" ToolTip="Maximum Possible Progress, please check gates max %">
                                        <Image.Visibility>
                                            <MultiBinding Converter="{StaticResource NumericCompareToVisibilityConverter}" FallbackValue="Hidden">
                                                <MultiBinding.ConverterParameter>
                                                    <sys:Boolean>False</sys:Boolean>
                                                </MultiBinding.ConverterParameter>
                                                <Binding ElementName="PART_Editor" Path="MaxValue" />
                                                <Binding ElementName="PART_Editor" Path="EditValue" />
                                            </MultiBinding>
                                        </Image.Visibility>
                                    </Image>
                                    <dxe:SpinEdit Name="PART_Editor" Tag="{Binding RowData.Row.Entity.IsMaxPercentageRestrictedByFuturePercentage}" Grid.Column="2" Increment="0.01" Mask="p0" MaskType="Numeric" MaskUseAsDisplayFormat="True" MaxValue="{Binding RowData.Row.Entity.MaxPercentage}" MinValue="0">
                                        <dxe:SpinEdit.ErrorToolTipContentTemplate>
                                            <DataTemplate>
                                                <dxe:TextEdit>
                                                    <dxe:TextEdit.Text>
                                                        <MultiBinding Converter="{StaticResource ValueOutOfRangeMessageConverter}">
                                                            <Binding Path="MaxValue" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type dxe:SpinEdit}}" />
                                                            <Binding Path="MinValue" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type dxe:SpinEdit}}" />
                                                            <Binding Path="EditValue" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type dxe:SpinEdit}}" />
                                                            <Binding Path="Tag" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type dxe:SpinEdit}}" />
                                                        </MultiBinding>
                                                    </dxe:TextEdit.Text>
                                                </dxe:TextEdit>
                                            </DataTemplate>
                                        </dxe:SpinEdit.ErrorToolTipContentTemplate>
                                    </dxe:SpinEdit>
                                </Grid>
                            </DataTemplate>
                        </dxg:GridColumn.CellTemplate>
                    </dxg:GridColumn>
                </ContentControl>
            </DataTemplate>
            <DataTemplate x:Key="SummaryTemplate">
                <ContentControl>
                    <dxg:GridSummaryItem FieldName="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).FieldName, RelativeSource={RelativeSource Self}}"
                                         SummaryType="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).Type, RelativeSource={RelativeSource Self}}"
                                         DisplayFormat="{Binding Path=(dxci:DependencyObjectExtensions.DataContext).DisplayFormat, RelativeSource={RelativeSource Self}}"/>
                </ContentControl>
            </DataTemplate>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/DefaultBluePrintsResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/BaseModel;component/View/ResourceDictionaries/DefaultControlResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/ConverterResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Style="{StaticResource CollectionView.RootContainer}">
        <dxb:BarManager>
            <dxb:BarManager.Items>
                <dxb:BarSubItem ItemLinksSource="{StaticResource RibbonDefaultGridButtons}" />
                <dxb:BarButtonItem x:Name="biEditReport1" Command="{Binding EditReportCommand}" Content="Edit Report" Glyph="{dx:DXImage Image=Edit_16x16.png}" LargeGlyph="{dx:DXImage Image=Edit_32x32.png}" RibbonStyle="SmallWithText" ToolTip="Redesign the current report layout" />
                <dxb:BarButtonItem x:Name="biViewReport1" Command="{Binding ViewReportCommand}" Content="View Report" Glyph="{dx:DXImage Image=Report_16x16.png}" LargeGlyph="{dx:DXImage Image=Report_32x32.png}" RibbonStyle="SmallWithText" ToolTip="View report. Report will be sorted and filtered according to what is shown in this table" />
                <!--Not Stable-->
                <dxb:BarButtonItem x:Name="biProgressUndo" Command="{Binding ProgressUndoCommand}" Content="Undo" Glyph="{dx:DXImage Image=Undo_16x16.png}" LargeGlyph="{dx:DXImage Image=Undo_32x32.png}" ToolTip="Undo last action" />
                <dxb:BarButtonItem x:Name="biProgressRedo" Command="{Binding ProgressRedoCommand}" Content="Redo" Glyph="{dx:DXImage Image=Redo_16x16.png}" LargeGlyph="{dx:DXImage Image=Redo_32x32.png}" ToolTip="Redo undone action" />
                <dxb:BarButtonItem x:Name="biFixProgressItem" Command="{Binding FixProgressItemCommand}" Content="Fix Data" Glyph="{dxc:DXImage Image=IDE_16x16.png}" LargeGlyph="{dx:DXImage Image=IDE_32x32.png}" ToolTip="Fix the data in database in case anything unexpected happens" />
                <dxb:BarStaticItem x:Name="biDataDate" Content="{Binding DataDateStr}" ToolTip="Data date" />
                <!--Disable for now, see user response to re-enable it
                <dxb:BarButtonItem x:Name="biDateBackward" Command="{Binding DateBackwardCommand}" Content="Backward" Glyph="{dx:DXImage Image=HistoryItem_16x16.png}" LargeGlyph="{dx:DXImage Image=HistoryItem_32x32.png}" ToolTip="Rewind data date to previous interval" />
                <dxb:BarStaticItem x:Name="biDataDate" Content="{Binding DataDateStr}" ToolTip="Data date" />
                <dxb:BarButtonItem x:Name="biFDateForward" Command="{Binding DateForwardCommand}" Content="Forward" Glyph="{dx:DXImage Image=HistoryItem_16x16.png}" LargeGlyph="{dx:DXImage Image=HistoryItem_32x32.png}" ToolTip="Forward data date to next interval">
                    <dxb:BarButtonItem.GlyphTemplate>
                        <DataTemplate>
                            <Image RenderTransformOrigin="0.5,0.5" Source="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=dxb:BarItemLinkInfo}, Path=Item.LargeGlyph}">
                                <Image.RenderTransform>
                                    <ScaleTransform ScaleX="-1" />
                                </Image.RenderTransform>
                            </Image>
                        </DataTemplate>
                    </dxb:BarButtonItem.GlyphTemplate>
                </dxb:BarButtonItem>-->
                <dxb:BarButtonItem x:Name="biUpdateAllPercentagesByStatus" Command="{Binding UpdateAllPercentagesByStatusCommand}" Content="Update % by Gates" Glyph="{dx:DXImage Image=ClearFormatting_16x16.png}" LargeGlyph="{dx:DXImageOffice2013 Image=ClearFormatting_32x32.png}" ToolTip="Update all deliverables progress by gates. Can be use to increase or reduce current %" />
            </dxb:BarManager.Items>
            <DockPanel>
                <dxr:RibbonControl Style="{StaticResource DefaultRibbonControlStyle}">
                    <dxr:RibbonDefaultPageCategory MergeType="Replace" Caption="defaultCategory">
                        <dxr:RibbonPage MergeType="Replace" Caption="Grid">
                            <dxr:RibbonPageGroup MergeType="Replace" Caption="Grid">
                                <dxb:BarButtonItemLink BarItemName="biFullRefresh1" />
                                <dxb:BarButtonItemLink BarItemName="biProgressUndo" />
                                <dxb:BarButtonItemLink BarItemName="biProgressRedo" />
                                <dxb:BarButtonItemLink BarItemName="biKeyboardCopy1"/>
                                <dxb:BarButtonItemLink BarItemName="biKeyboardPaste1" />
                                <dxb:BarCheckItemLink BarItemName="biCellSelection1" />
                                <dxb:BarButtonItemLink BarItemName="biSaveLayout1" />
                                <dxb:BarButtonItemLink BarItemName="biResetLayout1" />
                                <dxb:BarButtonItemLink BarItemName="biExpandAllGroups1" />
                                <dxb:BarButtonItemLink BarItemName="biCollapseAllGroups1" />
                                <dxb:BarButtonItemLink BarItemName="biExportToExcel1" />
                                <dxb:BarButtonItemLink BarItemName="biExportToPDF1" />
                                <dxb:BarButtonItemLink BarItemName="biEditReport1" />
                                <dxb:BarButtonItemLink BarItemName="biViewReport1" />
                            </dxr:RibbonPageGroup>
                            <dxr:RibbonPageGroup MergeType="Replace" Caption="Data Date">
                                <dxb:BarButtonItemLink BarItemName="biDateBackward" />
                                <dxb:BarStaticItem Content="Data Date" />
                                <dxb:BarStaticItemLink BarItemName="biDataDate" />
                                <dxb:BarButtonItemLink BarItemName="biFDateForward" />
                            </dxr:RibbonPageGroup>
                            <dxr:RibbonPageGroup MergeType="Replace" Caption="Tools">
                                <dxb:BarButtonItemLink BarItemName="biUpdateAllPercentagesByStatus" />
                            </dxr:RibbonPageGroup>
                        </dxr:RibbonPage>
                    </dxr:RibbonDefaultPageCategory>
                </dxr:RibbonControl>
                <dxlc:LayoutControl DockPanel.Dock="Right">
                    <dxlc:LayoutGroup.LayoutTransform>
                        <RotateTransform Angle="90" />
                    </dxlc:LayoutGroup.LayoutTransform>
                    <dxlc:LayoutGroup IsCollapsible="True" View="Group">
                        <Grid>
                            <Grid.LayoutTransform>
                                <RotateTransform Angle="-90" />
                            </Grid.LayoutTransform>
                            <filter:FilterAccordionView DataContext="{Binding FilterTreeViewModel}" />
                        </Grid>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutControl>
                <dxlc:LayoutGroup Name="LayoutGroupMain" Orientation="Horizontal" View="Group">
                    <dxlc:LayoutGroup>
                        <custom:GridControlEx x:Name="GridControl" TotalSummarySource="{Binding SummaryDescriptors}"
                                    TotalSummaryGeneratorTemplate="{StaticResource SummaryTemplate}"
                                    GroupSummarySource="{Binding SummaryDescriptors}"
                                    GroupSummaryGeneratorTemplate="{StaticResource SummaryTemplate}"
                                    ColumnGeneratorTemplateSelector="{StaticResource ColumnTemplateSelector}" ColumnsSource="{Binding ColumnDescriptors}" LayoutTransform="{Binding Zoom, Mode=OneWay}" AutoGenerateColumns="None" dxc:DXSerializer.SerializationID="GridControlOffsiteDirectDistribution" dxc:DXSerializer.StoreLayoutMode="All" ClipboardCopyMode="ExcludeHeader" CurrentItem="{Binding SelectedDataRow, Mode=TwoWay}" ItemsSource="{Binding DataPointsTable}" SelectedItems="{Binding SelectedDataRows, Mode=TwoWay}" SelectionMode="{Binding SelectMode}" ShowLoadingPanel="{Binding IsCalculationCompleted, Converter={StaticResource BooleanNegationConverter}}">
                            <dxmvvm:Interaction.Behaviors>
                                <dxmvvm:EventToCommand Command="{Binding CustomUnboundColumnDataCommand}" EventName="CustomUnboundColumnData" PassEventArgsToCommand="True" />
                                <dxmvvm:EventToCommand Command="{Binding Grid_MouseWheelCommand}" EventName="PreviewMouseWheel" PassEventArgsToCommand="True" />
                            </dxmvvm:Interaction.Behaviors>
                            <dxg:GridControl.Columns>
                                <dxg:GridColumn FieldName="Entity.Entity.Entity.GUID_AREA" Width="50" Fixed="Left" Header="Area" ReadOnly="True">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="INTERNAL_NUM" IsTextEditable="True" ItemsSource="{Binding AREACollection}" ValueMember="GUID" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="Entity.Entity.Entity.GUID_DOCTYPE" Fixed="Left" Header="Document Type" ReadOnly="True">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding DOCTYPECollection}" ValueMember="GUID" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="Entity.Entity.Entity.GUID_DISCIPLINE" Fixed="Left" Header="Discipline" ReadOnly="True">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding DISCIPLINECollection}" ValueMember="GUID" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="Entity.Entity.Entity.GUID_DEPARTMENT" Fixed="Left" Header="Department" ReadOnly="True">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding DEPARTMENTCollection}" ValueMember="GUID" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="Entity.Entity.Entity.INTERNAL_NUM" Width="140" Fixed="Left" Header="Internal Number" IsEnabled="False" ReadOnly="True" />
                                <dxg:GridColumn FieldName="Entity.Entity.Entity.CLIENT_NUM" Fixed="Left" Header="Client Number" IsEnabled="False" ReadOnly="True" />
                                <dxg:GridColumn FieldName="Entity.Entity.Entity.PRIMARY_TITLE" Fixed="Left" Header="Primary Title" IsEnabled="False" />
                                <dxg:GridColumn FieldName="Entity.Total_Units" Fixed="Left" Width="70" Header="Total Hours" HeaderToolTip="Budget Hours + Variation Hours" IsEnabled="False" ReadOnly="True">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:SpinEditSettings Increment="1" Mask="n" MaskType="Numeric" MaskUseAsDisplayFormat="True" MinValue="0" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="Entity.Earned_Units_ToDate" Width="70" Fixed="Left" Header="Total Earn" HeaderToolTip="Cumulative earned units" IsEnabled="False" ReadOnly="True">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings Mask="n" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="Entity.Earned_Units_OnDataDate" Width="70" Fixed="Left" Header="Period Earn" HeaderToolTip="Units earned on this period" IsEnabled="False" ReadOnly="True">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:SpinEditSettings Mask="n" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn UnboundType="Object" FieldName="ProgressId" Fixed="Left" Header="Gates" HeaderToolTip="From deliverables status table. Changing this value will increase current % only if the status has a higher percentage than previously earned %">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:ComboBoxEdit x:Name="PART_Editor" DisplayMember="NAME" ImmediatePopup="True" IncrementalFiltering="True" ItemsSource="{Binding RowData.Row.Entity.Entity.Entity.DeliverableStatusCollection}" ValidateOnEnterKeyPressed="True" NullValueButtonPlacement="Popup" ValidateOnTextInput="True" ValueMember="GUID" />
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                    <!--  For Filtering  -->
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding DELIVERABLES_STATUSCollection}" ValueMember="GUID" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="Entity.Entity.Entity.GUID_SUBJOB" Width="110" Fixed="Left" Header="Subjob" ReadOnly="True" Visible="False">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings DisplayMember="INTERNAL_NAME1" IsTextEditable="False" ItemsSource="{Binding SUBJOBCollection}" ValueMember="GUID" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="Entity.Entity.Entity.DELIVERABLE_TYPE" Fixed="Left" Header="Deliverable Type" IsEnabled="False" ReadOnly="True" Visible="False" />
                                <dxg:GridColumn FieldName="Entity.Entity.Entity.SECONDARY_TITLE" Fixed="Left" Header="Secondary Title" IsEnabled="False" ReadOnly="True" Visible="False" />
                                <dxg:GridColumn FieldName="Entity.Entity.Entity.COMMENTS" Fixed="Left" Header="Comments" ReadOnly="True" Visible="False" />
                                <dxg:GridColumn FieldName="Total_Earned_Percentage" Fixed="Left" Header="Total Earned %" ReadOnly="True" Visible="False">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:SpinEditSettings Increment="0.1" Mask="n" MaskType="Numeric" MaskUseAsDisplayFormat="True" MinValue="0" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                            </dxg:GridControl.Columns>
                            <dxg:GridControl.View>
                                <dxg:TableView x:Name="tableView" GroupSummaryDisplayMode="AlignByColumns" NewItemRowPosition="None" ShowTotalSummary="True" Style="{StaticResource DefaultMinimalTableViewTemplate}" ScrollBarAnnotationMode="None" ShowGridMenu="tableView_ShowGridMenu">
                                    <dxg:TableView.RowCellMenuCustomizations>
                                        <dxb:BarButtonItemLink BarItemName="biCopyWithHeader1" />
                                        <dxb:BarButtonItem x:Name="biFillUp2" Command="{Binding View.DataContext.FillUpCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Self}}" Content="Fill Up" Glyph="{dx:DXImageOffice2013 Image=MoveUp_16x16.png}" RibbonStyle="SmallWithText" ToolTip="Replicate deliverable gates for selected rows starting from last selection" />
                                        <dxb:BarButtonItem x:Name="biFillDown2" Command="{Binding View.DataContext.FillDownCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Self}}" Content="Fill Down" Glyph="{dx:DXImageOffice2013 Image=MoveDown_16x16.png}" RibbonStyle="SmallWithText" ToolTip="Replicate deliverable gates for selected rows starting from first selection" />
                                        <dxb:BarItemLinkSeparator />
                                        <dxb:BarButtonItemLink BarItemName="biProgressUndo" />
                                        <dxb:BarButtonItemLink BarItemName="biProgressRedo" />
                                        <dxb:BarItemLinkSeparator />
                                        <dxb:BarButtonItemLink BarItemName="biFullRefresh1" />
                                    </dxg:TableView.RowCellMenuCustomizations>
                                    <dxmvvm:Interaction.Behaviors>
                                        <dxmvvm:EventToCommand Command="{Binding FixedCellValueChangingCommand}" EventName="CellValueChanging" PassEventArgsToCommand="True" />
                                        <dxmvvm:EventToCommand Command="{Binding CellValueChangedProgressUpdateCommand}" EventName="CellValueChanged" PassEventArgsToCommand="True" />
                                        <dxmvvm:EventToCommand Command="{Binding PastingFromClipboardCommand}" EventName="PastingFromClipboard" PassEventArgsToCommand="True" />
                                    </dxmvvm:Interaction.Behaviors>
                                </dxg:TableView>
                            </dxg:GridControl.View>
                        </custom:GridControlEx>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutGroup>
            </DockPanel>
        </dxb:BarManager>
    </Grid>
</UserControl>
