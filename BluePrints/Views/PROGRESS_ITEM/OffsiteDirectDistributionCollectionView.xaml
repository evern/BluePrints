<UserControl x:Class="BluePrints.Views.OffsiteDirectDistributionCollectionView" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:custom="clr-namespace:BaseModel.Misc;assembly=BaseModel" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon" xmlns:dxrudex="http://schemas.devexpress.com/winfx/2008/xaml/reports/userdesignerextensions" xmlns:filter="clr-namespace:BluePrints.Common.Filtering" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:view="clr-namespace:BluePrints.Views" xmlns:viewmodel="clr-namespace:BluePrints.ViewModels" x:Name="userControl" d:DesignHeight="400" d:DesignWidth="600" DataContext="{dxmvvm:ViewModelSource viewmodel:OffsiteDirectDistributionCollectionViewModelWrapper}" mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/DefaultBluePrintsResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/BaseModel;component/View/ResourceDictionaries/DefaultControlResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/ConverterResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Style="{StaticResource CollectionView.RootContainer}">
        <Grid DataContext="{Binding MainViewModel}">
            <DockPanel>
                <dxr:RibbonControl AllowCustomization="False" DockPanel.Dock="Top" MDIMergeStyle="Always" RibbonStyle="Office2010">
                    <dxr:RibbonDefaultPageCategory Caption="defaultCategory">
                        <dxr:RibbonPage Caption="Live Deliverables Progress">
                            <dxr:RibbonPageGroup Caption="Grid" ItemLinksSource="{StaticResource RibbonDefaultGridButtons}" />
                            <dxr:RibbonPageGroup Caption="Layout" ItemLinksSource="{StaticResource RibbonDefaultLayoutButtons}" />
                            <dxr:RibbonPageGroup Caption="Report" ItemLinksSource="{StaticResource RibbonDefaultReportingButtons}" />
                            <dxr:RibbonPageGroup Caption="Data Date">
                                <dxb:BarButtonItem Content="Backward" ToolTip="Rewind data date to previous interval" Command="{Binding DataContext.DateBackwardCommand, ElementName=userControl}" LargeGlyph="{dx:DXImage Image=HistoryItem_32x32.png}" Glyph="{dx:DXImage Image=HistoryItem_16x16.png}" />
                                <!--<dxb:BarStaticItem Content="Data Date" />-->
                                <dxb:BarStaticItem Content="{Binding DataContext.DataDate, ElementName=userControl}" ToolTip="Data date" />
                                <dxb:BarButtonItem Content="Forward" ToolTip="Forward data date to next interval" Command="{Binding DataContext.DateForwardCommand, ElementName=userControl}" LargeGlyph="{dx:DXImage Image=HistoryItem_32x32.png}" Glyph="{dx:DXImage Image=HistoryItem_16x16.png}">
                                    <dxb:BarButtonItem.GlyphTemplate>
                                        <DataTemplate>
                                            <Image RenderTransformOrigin="0.5,0.5" Source="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=dxb:BarItemLinkInfo}, Path=Item.LargeGlyph}">
                                                <Image.RenderTransform>
                                                    <ScaleTransform ScaleX="-1" />
                                                </Image.RenderTransform>
                                            </Image>
                                        </DataTemplate>
                                    </dxb:BarButtonItem.GlyphTemplate>
                                </dxb:BarButtonItem>
                            </dxr:RibbonPageGroup>
                            <dxr:RibbonPageGroup Caption="Tools">
                                <!--<dxb:BarButtonItem Content="Fix Status" Command="{Binding DataContext.FixDeliverablesStatusCommand, ElementName=userControl}" LargeGlyph="{dx:DXImageOffice2013 Image=Replace_32x32.png}" Glyph="{dx:DXImage Image=Replace_16x16.png}" />-->
                                <dxb:BarButtonItem Content="Update % by Status" ToolTip="Bulk update all deliverables progress by it's status. Deliverables without statuses will be ignored. When deliverables status % is lower than current %, previous progresses will be reduced starting from previous interval." Command="{Binding DataContext.UpdateAllPercentagesByStatusCommand, ElementName=userControl}" LargeGlyph="{dx:DXImageOffice2013 Image=ClearFormatting_32x32.png}" Glyph="{dx:DXImage Image=ClearFormatting_16x16.png}" />
                                <dxb:BarButtonItem Content="Pull From P6" ToolTip="WARNING: DO NOT USE IF YOU ARE NOT HARRY! Updates deliverables progress based on activity % in P6." Command="{Binding DataContext.PullFromP6Command, ElementName=userControl}" LargeGlyph="{dx:DXImage Image=DoublePrev_32x32.png}" Glyph="{dxc:DXImage Image=DoublePrev_16x16.png}" IsVisible="{Binding DataContext.IsPullFromP6Visible, ElementName=userControl}" />
                                <dxb:BarButtonItem Content="Progress To P6" ToolTip="Update P6 earned units to current deliverables earned units." Command="{Binding DataContext.PushToP6OriginalCommand, ElementName=userControl}" LargeGlyph="{dx:DXImage Image=DoubleNext_32x32.png}" Glyph="{dx:DXImage Image=DoubleNext_16x16.png}" />
                            </dxr:RibbonPageGroup>
                        </dxr:RibbonPage>
                    </dxr:RibbonDefaultPageCategory>
                </dxr:RibbonControl>
                <dxr:RibbonStatusBarControl DockPanel.Dock="Bottom">
                    <dxr:RibbonStatusBarControl.LeftItems>
                        <dxb:BarStaticItem Content="{Binding Entities.Count, Converter={dxmvvm:FormatStringConverter FormatString='RECORDS: {0}'}}" />
                    </dxr:RibbonStatusBarControl.LeftItems>
                </dxr:RibbonStatusBarControl>
                <dxlc:LayoutControl DockPanel.Dock="Right">
                    <dxlc:LayoutGroup.LayoutTransform>
                        <RotateTransform Angle="90" />
                    </dxlc:LayoutGroup.LayoutTransform>
                    <dxlc:LayoutGroup IsCollapsible="True" View="Group">
                        <Grid>
                            <Grid.LayoutTransform>
                                <RotateTransform Angle="-90" />
                            </Grid.LayoutTransform>
                            <filter:FilterAccordionView DataContext="{Binding DataContext.FilterTreeViewModel, ElementName=userControl}" />
                        </Grid>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutControl>
                <dxlc:LayoutGroup Name="LayoutGroupMain" Orientation="Horizontal" View="Group">
                    <dxlc:LayoutGroup>
                        <custom:GridControlEx x:Name="GridControl" dxc:DXSerializer.SerializationID="GridControlOffsiteDirectDistribution" dxc:DXSerializer.StoreLayoutMode="All" Style="{StaticResource DefaultGridControlTemplate}">
                            <dxmvvm:Interaction.Behaviors>
                                <dxmvvm:EventToCommand Command="{Binding DataContext.CustomSummaryCommand, ElementName=userControl}" EventName="CustomSummary" PassEventArgsToCommand="True" />
                                <!--<dxmvvm:EventToCommand Command="{Binding DataContext.OnCustomColumnSortCommand, ElementName=userControl}" EventName="CustomColumnSort" PassEventArgsToCommand="True" />-->
                            </dxmvvm:Interaction.Behaviors>
                            <dxg:GridControl.Bands>
                                <dxg:GridControlBand Header="General (Read Only)">
                                    <dxg:GridColumn Header="Subjob" FieldName="Entity.Entity.GUID_SUBJOB" ReadOnly="True" FilterPopupMode="CheckedList">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:ComboBoxEditSettings DisplayMember="INTERNAL_NAME1" IsTextEditable="False" ItemsSource="{Binding DataContext.SUBJOBCollection, ElementName=userControl}" ValueMember="GUID" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Workpack" FieldName="Entity.Entity.GUID_WORKPACK" ReadOnly="True" FilterPopupMode="CheckedList">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding DataContext.WORKPACKCollection, ElementName=userControl}" ValueMember="GUID" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Area" FieldName="Entity.Entity.GUID_AREA" ReadOnly="True" FilterPopupMode="CheckedList">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="INTERNAL_NUM" IsTextEditable="True" ItemsSource="{Binding DataContext.AREACollection, ElementName=userControl}" ValueMember="GUID" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Sub-Area" FieldName="Entity.Entity.SubAreaGuid" ReadOnly="True" ColumnFilterMode="DisplayText" FilterPopupMode="CheckedList">
                                        <dxg:GridColumn.CellTemplate>
                                            <DataTemplate>
                                                <dxe:ComboBoxEdit x:Name="PART_Editor" DisplayMember="INTERNAL_NUM" ImmediatePopup="True" IncrementalFiltering="True" ItemsSource="{Binding RowData.Row.Entity.Entity.SubAreaCollection}" NullValueButtonPlacement="Popup" ValidateOnEnterKeyPressed="True" ValidateOnTextInput="True" ValueMember="GUID" />
                                            </DataTemplate>
                                        </dxg:GridColumn.CellTemplate>
                                        <!--  For Filtering  -->
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="INTERNAL_NUM" IsTextEditable="True" ItemsSource="{Binding DataContext.SUBAREACollection, ElementName=userControl}" NullValueButtonPlacement="EditBox" ValueMember="GUID" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Document Type" FieldName="Entity.Entity.GUID_DOCTYPE" ReadOnly="True" FilterPopupMode="CheckedList">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding DataContext.DOCTYPECollection, ElementName=userControl}" ValueMember="GUID" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Discipline" FieldName="Entity.Entity.GUID_DISCIPLINE" ReadOnly="True" FilterPopupMode="CheckedList">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding DataContext.DISCIPLINECollection, ElementName=userControl}" ValueMember="GUID" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Department" FieldName="Entity.Entity.GUID_DEPARTMENT" ReadOnly="True" FilterPopupMode="CheckedList">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding DataContext.DEPARTMENTCollection, ElementName=userControl}" ValueMember="GUID" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Internal Number" FieldName="Entity.Entity.INTERNAL_NUM" ReadOnly="True" FilterPopupMode="CheckedList" IsEnabled="False" />
                                    <dxg:GridColumn Header="Deliverable Type" FieldName="Entity.Entity.DELIVERABLE_TYPE" ReadOnly="True" FilterPopupMode="CheckedList" IsEnabled="False" />
                                    <dxg:GridColumn Header="Primary Title" FieldName="Entity.Entity.PRIMARY_TITLE" ReadOnly="True" FilterPopupMode="CheckedList" IsEnabled="False" />
                                    <dxg:GridColumn Header="Secondary Title" FieldName="Entity.Entity.SECONDARY_TITLE" ReadOnly="True" FilterPopupMode="CheckedList" IsEnabled="False" />
                                    <dxg:GridColumn Header="Comments" FieldName="Entity.Entity.COMMENTS" ReadOnly="True" FilterPopupMode="CheckedList" />
                                </dxg:GridControlBand>
                            </dxg:GridControl.Bands>
                            <dxg:GridControl.DetailDescriptor>
                                <dxg:DataControlDetailDescriptor ItemsSourceBinding="{Binding Milestones}">
                                    <dxg:GridControl x:Name="gridControlChild">
                                        <dxg:GridControl.Columns>
                                            <dxg:GridColumn Header="Required Percentage" FieldName="Percentage" HeaderToolTip="Percentage required based on maped activity P6 schedule" ReadOnly="True">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:TextEditSettings DisplayFormat="p2" MaskUseAsDisplayFormat="True" />
                                                </dxg:GridColumn.EditSettings>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn Header="On Date" FieldName="DueDate" HeaderToolTip="Percentage required on date based on maped activity in P6 schedule" ReadOnly="True">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:DateEditSettings />
                                                </dxg:GridColumn.EditSettings>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn Header="P6 Activity" FieldName="Milestone" HeaderToolTip="P6 activity name for the required percentage" ReadOnly="True" Width="300" />
                                        </dxg:GridControl.Columns>
                                        <dxg:GridControl.View>
                                            <dxg:TableView x:Name="tableView1" AllowEditing="False" Style="{StaticResource DefaultDetailTableViewTemplate}">
                                                <dxg:TableView.FormatConditions>
                                                    <dxg:DataBarFormatCondition FieldName="Percentage" MaxValue="1" MinValue="0">
                                                        <dxc:DataBarFormat BorderBrush="#FF63C384" BorderBrushNegative="#FFFF555A">
                                                            <dxc:DataBarFormat.FillNegative>
                                                                <LinearGradientBrush EndPoint="1,0">
                                                                    <GradientStop Offset="0" Color="White" />
                                                                    <GradientStop Offset="1" Color="#FFFF555A" />
                                                                </LinearGradientBrush>
                                                            </dxc:DataBarFormat.FillNegative>
                                                            <dxc:DataBarFormat.Fill>
                                                                <LinearGradientBrush EndPoint="1,0">
                                                                    <GradientStop Offset="0" Color="#FF63C384" />
                                                                    <GradientStop Offset="1" Color="White" />
                                                                </LinearGradientBrush>
                                                            </dxc:DataBarFormat.Fill>
                                                            <dxc:DataBarFormat.ZeroLineBrush>
                                                                <DrawingBrush TileMode="Tile" Viewport="0,0,1001,4" ViewportUnits="Absolute">
                                                                    <DrawingBrush.Drawing>
                                                                        <GeometryDrawing Brush="Black">
                                                                            <GeometryDrawing.Geometry>
                                                                                <GeometryGroup>
                                                                                    <RectangleGeometry Rect="0,0,1000,3" />
                                                                                    <RectangleGeometry Rect="1000,3,1,1" />
                                                                                </GeometryGroup>
                                                                            </GeometryDrawing.Geometry>
                                                                        </GeometryDrawing>
                                                                    </DrawingBrush.Drawing>
                                                                </DrawingBrush>
                                                            </dxc:DataBarFormat.ZeroLineBrush>
                                                        </dxc:DataBarFormat>
                                                    </dxg:DataBarFormatCondition>
                                                </dxg:TableView.FormatConditions>
                                            </dxg:TableView>
                                        </dxg:GridControl.View>
                                    </dxg:GridControl>
                                </dxg:DataControlDetailDescriptor>
                            </dxg:GridControl.DetailDescriptor>
                            <dxg:GridControl.GroupSummary>
                                <dxg:GridSummaryItem FieldName="Baseline_Percentage" DisplayFormat="Total: {0:p}" ShowInColumn="Baseline_Percentage" SummaryType="Custom" />
                                <dxg:GridSummaryItem FieldName="SchedulePercentage" DisplayFormat="Total: {0:p}" ShowInColumn="SchedulePercentage" SummaryType="Custom" />
                                <dxg:GridSummaryItem FieldName="ScheduleCurrentPeriodPercentage" DisplayFormat="Total: {0:p}" ShowInColumn="ScheduleCurrentPeriodPercentage" SummaryType="Custom" />
                                <dxg:GridSummaryItem FieldName="Total_Earned_Percentage" DisplayFormat="Total: {0:p}" ShowInColumn="Total_Earned_Percentage" SummaryType="Custom" />
                                <dxg:GridSummaryItem FieldName="Earned_Percentage_OnDataDate" DisplayFormat="Total: {0:p}" ShowInColumn="Earned_Percentage_OnDataDate" SummaryType="Custom" />
                                <dxg:GridSummaryItem FieldName="Earned_Units_OnDataDate" DisplayFormat="Total: {0:n}" ShowInColumn="Earned_Units_OnDataDate" SummaryType="Sum" />
                                <dxg:GridSummaryItem FieldName="Earned_Units_ToDate" DisplayFormat="Total: {0:n}" ShowInColumn="Earned_Units_ToDate" SummaryType="Sum" />
                                <dxg:GridSummaryItem FieldName="Stats.Budgeted.CurrentPeriodDataPoint.UnitsPercentage" DisplayFormat="Total: {0:p}" ShowInColumn="Stats.Budgeted.CurrentPeriodDataPoint.UnitsPercentage" SummaryType="Custom" />
                                <dxg:GridSummaryItem FieldName="DisplayPeriodEarnedCosts" DisplayFormat="Total: {0:c2}" ShowInColumn="DisplayPeriodEarnedCosts" SummaryType="Sum" />
                                <dxg:GridSummaryItem FieldName="Entity.Entity.BUDGET_HOURS" DisplayFormat="Total: {0:n}" SummaryType="Sum" />
                                <dxg:GridSummaryItem FieldName="Entity.Entity.DC_HOURS" DisplayFormat="Total: {0:n}" SummaryType="Sum" />
                                <dxg:GridSummaryItem FieldName="Entity.Entity.Total_Units" DisplayFormat="Total: {0:n}" SummaryType="Sum" />
                                <dxg:GridSummaryItem FieldName="PROGRESS_ITEMcurrent.EARNED_UNITS" DisplayFormat="Total: {0:n}" SummaryType="Sum" />
                                <dxg:GridSummaryItem FieldName="Entity.BASELINE_ITEM" DisplayFormat="Total {0} Records" ShowInColumn="Entity.BASELINE_ITEM" SummaryType="Count" />
                            </dxg:GridControl.GroupSummary>
                            <dxg:GridControl.TotalSummary>
                                <dxg:GridSummaryItem FieldName="Baseline_Percentage" DisplayFormat="Total: {0:p}" ShowInColumn="Baseline_Percentage" SummaryType="Custom" />
                                <dxg:GridSummaryItem FieldName="SchedulePercentage" DisplayFormat="Total: {0:p}" ShowInColumn="SchedulePercentage" SummaryType="Custom" />
                                <dxg:GridSummaryItem FieldName="ScheduleCurrentPeriodPercentage" DisplayFormat="Total: {0:p}" ShowInColumn="ScheduleCurrentPeriodPercentage" SummaryType="Custom" />
                                <dxg:GridSummaryItem FieldName="Total_Earned_Percentage" DisplayFormat="Total: {0:p}" ShowInColumn="Total_Earned_Percentage" SummaryType="Custom" />
                                <dxg:GridSummaryItem FieldName="Earned_Percentage_OnDataDate" DisplayFormat="Total: {0:p}" ShowInColumn="Earned_Percentage_OnDataDate" SummaryType="Custom" />
                                <dxg:GridSummaryItem FieldName="Earned_Units_OnDataDate" DisplayFormat="Total: {0:n}" ShowInColumn="Earned_Units_OnDataDate" SummaryType="Sum" />
                                <dxg:GridSummaryItem FieldName="Earned_Units_ToDate" DisplayFormat="Total: {0:n}" ShowInColumn="Earned_Units_ToDate" SummaryType="Sum" />
                                <dxg:GridSummaryItem FieldName="Stats.Budgeted.CurrentPeriodDataPoint.UnitsPercentage" DisplayFormat="Total: {0:p}" ShowInColumn="Stats.Budgeted.CurrentPeriodDataPoint.UnitsPercentage" SummaryType="Custom" />
                                <dxg:GridSummaryItem FieldName="DisplayPeriodEarnedCosts" DisplayFormat="Total: {0:c2}" ShowInColumn="DisplayPeriodEarnedCosts" SummaryType="Sum" />
                                <dxg:GridSummaryItem FieldName="Entity.Entity.BUDGET_HOURS" DisplayFormat="Total: {0:n}" SummaryType="Sum" />
                                <dxg:GridSummaryItem FieldName="Entity.Entity.DC_HOURS" DisplayFormat="Total: {0:n}" SummaryType="Sum" />
                                <dxg:GridSummaryItem FieldName="Entity.Entity.Total_Units" DisplayFormat="Total: {0:n}" SummaryType="Sum" />
                                <dxg:GridSummaryItem FieldName="Entity.BASELINE_ITEM" DisplayFormat="Total {0} Records" ShowInColumn="Entity.BASELINE_ITEM" SummaryType="Count" />
                            </dxg:GridControl.TotalSummary>
                            <dxg:GridControl.View>
                                <dxg:TableView x:Name="tableView" GroupSummaryDisplayMode="AlignByColumns" IsDetailButtonVisibleBinding="{Binding Row.IHaveMilestones}" NewItemRowPosition="None" ShowTotalSummary="True" Style="{StaticResource DefaultTableViewTemplate}">
                                    <dxg:TableView.FormatConditions>
                                        <dxg:FormatCondition FieldName="IAmCritical" ApplyToRow="True" Expression="[IAmCritical] = 'True'">
                                            <dxc:Format Background="LightBlue" />
                                        </dxg:FormatCondition>
                                        <dxg:FormatCondition FieldName="IAmOverdue" ApplyToRow="True" Expression="[IAmOverdue] = 'True'">
                                            <dxc:Format Background="Salmon" />
                                        </dxg:FormatCondition>
                                    </dxg:TableView.FormatConditions>
                                    <dxg:TableView.RowCellMenuCustomizations>
                                        <dxb:BarLinkContainerItem ItemLinksSource="{StaticResource ContextMenuDefaultHeaderButtons}" />
                                        <dxb:BarItemLinkSeparator />
                                        <dxb:BarLinkContainerItem ItemLinksSource="{StaticResource ContextMenuDefaultFooterButtons}" />
                                    </dxg:TableView.RowCellMenuCustomizations>
                                </dxg:TableView>
                            </dxg:GridControl.View>
                        </custom:GridControlEx>
                    </dxlc:LayoutGroup>
                    <dxlc:LayoutGroup DataContext="{Binding DataContext, ElementName=userControl}">
                        <custom:GridControlEx x:Name="GridControlDataPoints" MaxHeight="2000" dxc:DXSerializer.SerializationID="GridControlDataPoints" dxc:DXSerializer.StoreLayoutMode="All" AutoGenerateColumns="RemoveOld" CurrentItem="{Binding DataContext.SelectedDataRow, Mode=TwoWay, ElementName=userControl}" ItemsSource="{Binding DataPointsTable}" Style="{StaticResource DefaultGridControlTemplate}">
                            <dxmvvm:Interaction.Behaviors>
                                <dxmvvm:EventToCommand Command="{Binding DataContext.AutoGeneratingPercentageColumnsCommand, ElementName=userControl}" EventName="AutoGeneratingColumn" PassEventArgsToCommand="True" />
                            </dxmvvm:Interaction.Behaviors>
                            <dxg:GridControl.View>
                                <dxg:TableView x:Name="tableViewDataPoints" />
                            </dxg:GridControl.View>
                        </custom:GridControlEx>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutGroup>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
