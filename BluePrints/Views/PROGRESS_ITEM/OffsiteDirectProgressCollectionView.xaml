<UserControl x:Name="userControl" x:Class="BluePrints.Views.OffsiteDirectProgressCollectionView" xmlns:view="clr-namespace:BluePrints.Views" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/presentation" xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon" xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" xmlns:dxrudex="http://schemas.devexpress.com/winfx/2008/xaml/reports/userdesignerextensions" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:viewmodel="clr-namespace:BluePrints.ViewModels" xmlns:custom="clr-namespace:BaseModel.Misc;assembly=BaseModel" mc:Ignorable="d" d:DesignHeight="400" d:DesignWidth="600" DataContext="{dxmvvm:ViewModelSource viewmodel:OffsiteDirectProgressCollectionViewModelWrapper}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BaseModel;component/View/ResourceDictionaries/DefaultControlResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/ConverterResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Style="{StaticResource CollectionView.RootContainer}">
        <Grid DataContext="{Binding MainViewModel}">
            <DockPanel>
                <dxr:RibbonControl RibbonStyle="Office2010" DockPanel.Dock="Top" AllowCustomization="False" MDIMergeStyle="Always">
                    <dxr:RibbonDefaultPageCategory Caption="defaultCategory">
                        <dxr:RibbonPage Caption="Home">
                            <dxr:RibbonPageGroup Caption="PROGRESS ITEM Tasks">
                                <dxb:BarButtonItem Content="Refresh" Command="{Binding DataContext.FullRefreshCommand, ElementName=userControl}" LargeGlyph="{dx:DXImage Image=Refresh_32x32.png}" Glyph="{dx:DXImage Image=Refresh_16x16.png}" />
                                <!--<dxb:BarButtonItem Content="Fix Status" Command="{Binding DataContext.FixDeliverablesStatusCommand, ElementName=userControl}"
                                                   LargeGlyph="{dx:DXImageOffice2013 Image=Replace_32x32.png}"
                                                   Glyph="{dx:DXImage Image=Replace_16x16.png}" />-->
                                <dxb:BarButtonItem Content="Update % by Status" Command="{Binding DataContext.UpdateAllPercentagesByStatusCommand, ElementName=userControl}" LargeGlyph="{dx:DXImageOffice2013 Image=ClearFormatting_32x32.png}" Glyph="{dx:DXImage Image=ClearFormatting_16x16.png}" />
                                <dxb:BarButtonItem Content="Undo" Command="{Binding UndoCommand}" LargeGlyph="{dx:DXImage Image=Undo_32x32.png}" Glyph="{dx:DXImage Image=Undo_16x16.png}" />
                                <dxb:BarButtonItem Content="Redo" Command="{Binding RedoCommand}" LargeGlyph="{dx:DXImage Image=Redo_32x32.png}" Glyph="{dx:DXImage Image=Redo_16x16.png}" />
                                <dxb:BarButtonItem Content="Save Layout" Command="{Binding DataContext.SaveLayoutCommand, ElementName=userControl}" LargeGlyph="{dx:DXImage Image=Save_32x32.png}" Glyph="{dx:DXImage Image=Save_16x16.png}" />
                                <dxb:BarButtonItem Content="Reset Layout" Command="{Binding DataContext.ResetLayoutCommand, ElementName=userControl}" LargeGlyph="{dx:DXImage Image=SaveAndClose_32x32.png}" Glyph="{dx:DXImage Image=SaveAndClose_16x16.png}" />
                                <dxb:BarCheckItem Content="Cell Selection" IsChecked="{Binding IsPasteCellLevel, Mode=TwoWay}" Glyph="{dx:DXImage Image=SplitTableCells_16x16.png}" LargeGlyph="{dx:DXImage Image=SplitTableCells_32x32.png}" />
                                <dxb:BarItemSeparator />
                                <dxb:BarButtonItem Content="Backward" Command="{Binding DataContext.DateBackwardCommand, ElementName=userControl}" LargeGlyph="{dx:DXImage Image=HistoryItem_32x32.png}" Glyph="{dx:DXImage Image=HistoryItem_16x16.png}" />
                                <dxb:BarButtonItem Content="Forward" Command="{Binding DataContext.DateForwardCommand, ElementName=userControl}" LargeGlyph="{dx:DXImage Image=HistoryItem_32x32.png}" Glyph="{dx:DXImage Image=HistoryItem_16x16.png}">
                                    <dxb:BarButtonItem.GlyphTemplate>
                                        <DataTemplate>
                                            <Image Source="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=dxb:BarItemLinkInfo}, Path=Item.LargeGlyph}" RenderTransformOrigin="0.5,0.5">
                                                <Image.RenderTransform>
                                                    <ScaleTransform ScaleX="-1" />
                                                </Image.RenderTransform>
                                            </Image>
                                        </DataTemplate>
                                    </dxb:BarButtonItem.GlyphTemplate>
                                </dxb:BarButtonItem>
                                <dxb:BarItemSeparator />
                                <dxb:BarButtonItem Content="Edit Report" Command="{Binding DataContext.EditReportCommand, ElementName=userControl}" LargeGlyph="{dx:DXImage Image=Edit_32x32.png}" Glyph="{dx:DXImage Image=Edit_16x16.png}" />
                                <dxb:BarButtonItem Content="View Report" Command="{Binding DataContext.ViewReportCommand, ElementName=userControl}" LargeGlyph="{dx:DXImage Image=Report_32x32.png}" Glyph="{dx:DXImage Image=Report_16x16.png}" />
                                <dxb:BarButtonItem Content="Export" Command="{Binding DataContext.ExportToExcelCommand, ElementName=userControl}" LargeGlyph="{dx:DXImage Image=ExportToXLSX_32x32.png}" Glyph="{dx:DXImage Image=ExportToXLSX_16x16.png}" />
                                <!--<dxb:BarButtonItem Content="Push to P6" Command="{Binding DataContext.PushToP6Command, ElementName=userControl}" LargeGlyph="{dx:DXImage Image=Export_32x32.png}" Glyph="{dx:DXImage Image=Export_16x16.png}" />-->
                                <dxb:BarItemSeparator />
                                <dxb:BarStaticItem Content="Data Date" />
                                <dxb:BarStaticItem Content="{Binding DataContext.DataDate, ElementName=userControl}" />
                                <dxb:BarButtonItem Content="Progress P6" Command="{Binding DataContext.PushToP6OriginalCommand, ElementName=userControl}" LargeGlyph="{dx:DXImage Image=DoubleNext_32x32.png}" Glyph="{dx:DXImage Image=DoubleNext_16x16.png}" />
                                <!--<dxb:BarButtonItem Content="Populate P6 Modified Units"
                                                   Command="{Binding DataContext.PushToP6ModifiedCommand, ElementName=userControl}"
                                                   LargeGlyph="{dx:DXImage Image=DoubleNext_32x32.png}"
                                                   Glyph="{dx:DXImage Image=DoubleNext_16x16.png}" />-->
                            </dxr:RibbonPageGroup>
                        </dxr:RibbonPage>
                    </dxr:RibbonDefaultPageCategory>
                </dxr:RibbonControl>
                <dxr:RibbonStatusBarControl DockPanel.Dock="Bottom">
                    <dxr:RibbonStatusBarControl.LeftItems>
                        <dxb:BarStaticItem Content="{Binding Entities.Count, Converter={dxmvvm:FormatStringConverter FormatString='RECORDS: {0}'}}" />
                    </dxr:RibbonStatusBarControl.LeftItems>
                </dxr:RibbonStatusBarControl>
                <Grid>
                    <custom:GridControlEx x:Name="GridControl" dx:DXSerializer.SerializationID="GridControlOffsiteDirectProgress" dx:DXSerializer.StoreLayoutMode="All" Style="{StaticResource DefaultGridControlTemplate}">
                        <dxmvvm:Interaction.Behaviors>
                            <dxmvvm:EventToCommand Command="{Binding DataContext.CustomSummaryCommand, ElementName=userControl}" PassEventArgsToCommand="True" EventName="CustomSummary" />
                            <dxmvvm:EventToCommand EventName="CustomColumnSort" Command="{Binding DataContext.OnCustomColumnSortCommand, ElementName=userControl}" PassEventArgsToCommand="True"/>
                        </dxmvvm:Interaction.Behaviors>
                        <dxg:GridControl.Bands>
                            <dxg:GridControlBand Name="bandGeneral" Header="General">
                                <custom:GridColumnEx Name="columnSubjob" FieldName="Entity.Entity.GUID_SUBJOB" Header="SUBJOB" FilterPopupMode="CheckedList" ReadOnly="True">
                                    <custom:GridColumnEx.EditSettings>
                                        <dxe:ComboBoxEditSettings ItemsSource="{Binding DataContext.SUBJOBCollection, ElementName=userControl}" IsTextEditable="False" DisplayMember="INTERNAL_NAME1" ValueMember="GUID" />
                                    </custom:GridColumnEx.EditSettings>
                                </custom:GridColumnEx>
                                <custom:GridColumnEx Name="colWORKPACK" FieldName="Entity.Entity.GUID_WORKPACK" Header="WORKPACK" FilterPopupMode="CheckedList" ReadOnly="True">
                                    <custom:GridColumnEx.EditSettings>
                                        <dxe:ComboBoxEditSettings ItemsSource="{Binding DataContext.WORKPACKCollection, ElementName=userControl}" IsTextEditable="True" AutoComplete="True" DisplayMember="NAME" ValueMember="GUID" />
                                    </custom:GridColumnEx.EditSettings>
                                </custom:GridColumnEx>
                                <custom:GridColumnEx Name="colAREA" FieldName="Entity.Entity.GUID_AREA" Header="AREA" FilterPopupMode="CheckedList" ReadOnly="True">
                                    <custom:GridColumnEx.EditSettings>
                                        <dxe:ComboBoxEditSettings ItemsSource="{Binding DataContext.AREACollection, ElementName=userControl}" IsTextEditable="True" AutoComplete="True" DisplayMember="INTERNAL_NUM" ValueMember="GUID" />
                                    </custom:GridColumnEx.EditSettings>
                                </custom:GridColumnEx>
                                <custom:GridColumnEx Name="colSUBAREA" FieldName="Entity.Entity.SubAreaGuid" Header="SUBAREA" ColumnFilterMode="DisplayText" FilterPopupMode="CheckedList" ReadOnly="True">
                                    <custom:GridColumnEx.CellTemplate>
                                        <DataTemplate>
                                            <dxe:ComboBoxEdit x:Name="PART_Editor" ItemsSource="{Binding RowData.Row.Entity.Entity.SubAreaCollection}" DisplayMember="INTERNAL_NUM" ValueMember="GUID" ValidateOnTextInput="True" ValidateOnEnterKeyPressed="True" IncrementalFiltering="True" NullValueButtonPlacement="Popup" ImmediatePopup="True"></dxe:ComboBoxEdit>
                                        </DataTemplate>
                                    </custom:GridColumnEx.CellTemplate>
                                    <!--For Filtering-->
                                    <custom:GridColumnEx.EditSettings>
                                        <dxe:ComboBoxEditSettings NullValueButtonPlacement="EditBox" ItemsSource="{Binding DataContext.SUBAREACollection, ElementName=userControl}" IsTextEditable="True" AutoComplete="True" DisplayMember="INTERNAL_NUM" ValueMember="GUID" />
                                    </custom:GridColumnEx.EditSettings>
                                </custom:GridColumnEx>
                                <custom:GridColumnEx Name="colDOCTYPE" FieldName="Entity.Entity.GUID_DOCTYPE" Header="DOCTYPE" FilterPopupMode="CheckedList" ReadOnly="True">
                                    <custom:GridColumnEx.EditSettings>
                                        <dxe:ComboBoxEditSettings ItemsSource="{Binding DataContext.DOCTYPECollection, ElementName=userControl}" IsTextEditable="True" AutoComplete="True" DisplayMember="NAME" ValueMember="GUID" />
                                    </custom:GridColumnEx.EditSettings>
                                </custom:GridColumnEx>
                                <custom:GridColumnEx Name="colDISCIPLINE" FieldName="Entity.Entity.GUID_DISCIPLINE" Header="DISCIPLINE" FilterPopupMode="CheckedList" ReadOnly="True">
                                    <custom:GridColumnEx.EditSettings>
                                        <dxe:ComboBoxEditSettings ItemsSource="{Binding DataContext.DISCIPLINECollection, ElementName=userControl}" IsTextEditable="True" AutoComplete="True" DisplayMember="NAME" ValueMember="GUID" />
                                    </custom:GridColumnEx.EditSettings>
                                </custom:GridColumnEx>
                                <custom:GridColumnEx Name="colDEPARTMENT" FieldName="Entity.Entity.GUID_DEPARTMENT" Header="DEPARTMENT" FilterPopupMode="CheckedList" ReadOnly="True">
                                    <custom:GridColumnEx.EditSettings>
                                        <dxe:ComboBoxEditSettings ItemsSource="{Binding DataContext.DEPARTMENTCollection, ElementName=userControl}" IsTextEditable="True" AutoComplete="True" DisplayMember="NAME" ValueMember="GUID" />
                                    </custom:GridColumnEx.EditSettings>
                                </custom:GridColumnEx>
                                <custom:GridColumnEx Name="columnInternalNum" FieldName="Entity.Entity.INTERNAL_NUM" Header="INTERNAL NUM" FilterPopupMode="CheckedList" ReadOnly="True" IsEnabled="False" />
                                <custom:GridColumnEx Name="columnType" FieldName="Entity.Entity.DELIVERABLE_TYPE" Header="TYPE" FilterPopupMode="CheckedList" ReadOnly="True" IsEnabled="False" />
                                <custom:GridColumnEx Name="columnTitle" FieldName="Entity.Entity.PRIMARY_TITLE" Header="PRIMARY TITLE" FilterPopupMode="CheckedList" ReadOnly="True" IsEnabled="False" />
                                <custom:GridColumnEx Name="columnTitle2" FieldName="Entity.Entity.SECONDARY_TITLE" Header="SECONDARY TITLE" FilterPopupMode="CheckedList" ReadOnly="True" IsEnabled="False" />
                                <custom:GridColumnEx Name="colCOMMENTS" FieldName="Entity.Entity.COMMENTS" Header="COMMENTS" ReadOnly="True" FilterPopupMode="CheckedList" />
                            </dxg:GridControlBand>
                            <dxg:GridControlBand Name="bandBudgeted" Header="Budgeted">
                                <custom:GridColumnEx Name="colBY_DURATION" ReadOnly="True" IsEnabled="False" FieldName="Entity.Entity.BY_DURATION" Header="BY DURATION" FilterPopupMode="CheckedList" />
                                <custom:GridColumnEx Name="columnEstimatedHours" FieldName="Entity.Entity.ESTIMATED_HOURS" Header="ESTIMATED HOURS" FilterPopupMode="CheckedList" ReadOnly="True" IsEnabled="False" Visible="False" SortMode="Custom">
                                    <custom:GridColumnEx.EditSettings>
                                        <dxe:SpinEditSettings MaskType="Numeric" Mask="n" MinValue="0" Increment="1" MaskUseAsDisplayFormat="True" />
                                    </custom:GridColumnEx.EditSettings>
                                </custom:GridColumnEx>
                                <custom:GridColumnEx Name="columnDCHours" FieldName="Entity.Entity.DC_HOURS" Header="DC HOURS" ReadOnly="True" IsEnabled="False" FilterPopupMode="CheckedList" Visible="False" SortMode="Custom">
                                    <custom:GridColumnEx.EditSettings>
                                        <dxe:SpinEditSettings MaskType="Numeric" Mask="n" Increment="1" MaskUseAsDisplayFormat="True" />
                                    </custom:GridColumnEx.EditSettings>
                                </custom:GridColumnEx>
                                <custom:GridColumnEx Name="columnTotalHours" FieldName="Entity.Entity.Total_Units" Header="TOTAL HOURS" ReadOnly="True" FilterPopupMode="CheckedList" IsEnabled="False" SortMode="Custom">
                                    <custom:GridColumnEx.EditSettings>
                                        <dxe:SpinEditSettings MaskType="Numeric" Mask="n" MinValue="0" Increment="1" MaskUseAsDisplayFormat="True" />
                                    </custom:GridColumnEx.EditSettings>
                                </custom:GridColumnEx>
                                <custom:GridColumnEx Name="columnRate" FieldName="Entity.ItemRate" Header="RATE" ReadOnly="True" IsEnabled="False" FilterPopupMode="CheckedList" Visible="False" SortMode="Custom">
                                    <custom:GridColumnEx.EditSettings>
                                        <dxe:SpinEditSettings MaskType="Numeric" Mask="n" MinValue="0" Increment="1" MaskUseAsDisplayFormat="True" />
                                    </custom:GridColumnEx.EditSettings>
                                </custom:GridColumnEx>
                                <custom:GridColumnEx Name="columnStatus" FieldName="DeliverableStatusProgressGuid" Header="STATUS" FilterPopupMode="Custom" ColumnFilterMode="DisplayText">
                                    <custom:GridColumnEx.CellTemplate>
                                        <DataTemplate>
                                            <dxe:ComboBoxEdit x:Name="PART_Editor" ItemsSource="{Binding RowData.Row.Entity.Entity.DeliverableStatusCollection}" DisplayMember="NAME" ValueMember="GUID" ValidateOnTextInput="True" ValidateOnEnterKeyPressed="True" IncrementalFiltering="True" NullValueButtonPlacement="Popup" ImmediatePopup="True"></dxe:ComboBoxEdit>
                                        </DataTemplate>
                                    </custom:GridColumnEx.CellTemplate>
                                    <!--For Filtering-->
                                    <custom:GridColumnEx.EditSettings>
                                        <dxe:ComboBoxEditSettings ItemsSource="{Binding DataContext.DELIVERABLES_STATUSCollection, ElementName=userControl}" IsTextEditable="True" AutoComplete="True" DisplayMember="NAME" ValueMember="GUID" />
                                    </custom:GridColumnEx.EditSettings>
                                </custom:GridColumnEx>
                                <custom:GridColumnEx Name="columnUser" FieldName="Entity.Entity.GUID_USER" FilterPopupMode="CheckedList" Header="RESOURCE">
                                    <custom:GridColumnEx.EditSettings>
                                        <dxe:ComboBoxEditSettings ItemsSource="{Binding DataContext.USERCollection, ElementName=userControl}" IsTextEditable="True" AutoComplete="True" DisplayMember="NAME" ValueMember="GUID" />
                                    </custom:GridColumnEx.EditSettings>
                                </custom:GridColumnEx>
                            </dxg:GridControlBand>
                            <dxg:GridControlBand Name="bandCumulative" Header="Cumulative">
                                <custom:GridColumnEx Name="columnBaselinePercentage" Header="BASELINE %" FieldName="Baseline_Percentage" ReadOnly="True" FilterPopupMode="CheckedList" IsEnabled="False" SortMode="Custom">
                                    <custom:GridColumnEx.EditSettings>
                                        <dxe:TextEditSettings MaskType="Numeric" Mask="p" MaskUseAsDisplayFormat="True" />
                                    </custom:GridColumnEx.EditSettings>
                                </custom:GridColumnEx>
                                <custom:GridColumnEx Name="columnTotalPercentage" Header="TOTAL %" FieldName="Total_Percentage_ToDate" ReadOnly="True" IsEnabled="False" FilterPopupMode="CheckedList" Visible="False" SortMode="Custom">
                                    <custom:GridColumnEx.EditSettings>
                                        <dxe:TextEditSettings MaskType="Numeric" Mask="p" MaskUseAsDisplayFormat="True" />
                                    </custom:GridColumnEx.EditSettings>
                                </custom:GridColumnEx>
                                <custom:GridColumnEx Name="columnSchedulePercentage" FieldName="SchedulePercentage" Header="SCHEDULE %" ReadOnly="True" FilterPopupMode="CheckedList" IsEnabled="False" SortMode="Custom">
                                    <custom:GridColumnEx.EditSettings>
                                        <dxe:SpinEditSettings MaskType="Numeric" Mask="p" MaskUseAsDisplayFormat="True" />
                                    </custom:GridColumnEx.EditSettings>
                                </custom:GridColumnEx>
                                <custom:GridColumnEx Name="columnDueDate" FieldName="DueDate" Header="DUE DATE" ReadOnly="True" FilterPopupMode="CheckedList" IsEnabled="False" SortMode="Custom">
                                    <custom:GridColumnEx.EditSettings>
                                        <dxe:DateEditSettings />
                                    </custom:GridColumnEx.EditSettings>
                                </custom:GridColumnEx>
                                <custom:GridColumnEx Name="columnForecastDate" FieldName="ForecastDate" Header="FORECAST DATE" ReadOnly="True" FilterPopupMode="CheckedList" IsEnabled="False" SortMode="Custom">
                                    <custom:GridColumnEx.EditSettings>
                                        <dxe:DateEditSettings />
                                    </custom:GridColumnEx.EditSettings>
                                </custom:GridColumnEx>
                                <custom:GridColumnEx Name="colTargetDate" FieldName="Entity.Entity.TARGET_DATE" Header="TARGET DATE" FilterPopupMode="CheckedList" SortMode="Custom">
                                    <custom:GridColumnEx.EditSettings>
                                        <dxe:DateEditSettings NullValueButtonPlacement="Popup" />
                                    </custom:GridColumnEx.EditSettings>
                                </custom:GridColumnEx>
                                <custom:GridColumnEx Name="columnTotalEarnedPercentage" FieldName="Total_Earned_Percentage" Header="CURRENT %" AllowEditing="True" FilterPopupMode="CheckedList" SortMode="Custom">
                                    <custom:GridColumnEx.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="15" />
                                                    <ColumnDefinition Width="15" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Image Source="{Binding Source=DevExpress.Xpf.Core.Editors.Images.info.png, Converter={StaticResource EmbeddedResourceImageConverter}}" ToolTip="Minimum Possible Progress" Grid.Column="0">
                                                    <Image.Visibility>
                                                        <MultiBinding Converter="{StaticResource NumericCompareToVisibilityConverter}" FallbackValue="Hidden">
                                                            <MultiBinding.ConverterParameter>
                                                                <sys:Boolean>False</sys:Boolean>
                                                            </MultiBinding.ConverterParameter>
                                                            <Binding ElementName="PART_Editor" Path="MinValue" />
                                                            <Binding ElementName="PART_Editor" Path="EditValue" />
                                                        </MultiBinding>
                                                    </Image.Visibility>
                                                </Image>
                                                <Image Source="{Binding Source=DevExpress.Xpf.Core.Editors.Images.info.png, Converter={StaticResource EmbeddedResourceImageConverter}}" ToolTip="Maximum Possible Progress" Grid.Column="1">
                                                    <Image.Visibility>
                                                        <MultiBinding Converter="{StaticResource NumericCompareToVisibilityConverter}" FallbackValue="Hidden">
                                                            <MultiBinding.ConverterParameter>
                                                                <sys:Boolean>False</sys:Boolean>
                                                            </MultiBinding.ConverterParameter>
                                                            <Binding ElementName="PART_Editor" Path="MaxValue" />
                                                            <Binding ElementName="PART_Editor" Path="EditValue" />
                                                        </MultiBinding>
                                                    </Image.Visibility>
                                                </Image>
                                                <dxe:SpinEdit Name="PART_Editor" MaskType="Numeric" Mask="p0" MaskUseAsDisplayFormat="True" Increment="0.01" MaxValue="{Binding RowData.Row.MaxPercentage}" MinValue="{Binding RowData.Row.MinPercentage}" Grid.Column="2" />
                                            </Grid>
                                        </DataTemplate>
                                    </custom:GridColumnEx.CellTemplate>
                                </custom:GridColumnEx>
                                <custom:GridColumnEx Name="columnEarnedUnits" Header="EARNED UNITS" FieldName="Earned_Units_ToDate" ReadOnly="True" IsEnabled="False" FilterPopupMode="CheckedList" SortMode="Custom">
                                    <custom:GridColumnEx.EditSettings>
                                        <dxe:TextEditSettings MaskType="Numeric" Mask="n" MaskUseAsDisplayFormat="True" />
                                    </custom:GridColumnEx.EditSettings>
                                </custom:GridColumnEx>
                                <custom:GridColumnEx Name="columnTotalEarnedCost" Header="TOTAL EARNED $" FieldName="Earned_Costs_ToDate" ReadOnly="True" IsEnabled="False" Visible="False" FilterPopupMode="CheckedList" SortMode="Custom">
                                    <custom:GridColumnEx.EditSettings>
                                        <dxe:SpinEditSettings MaskType="Numeric" Mask="c" MaskUseAsDisplayFormat="True" />
                                    </custom:GridColumnEx.EditSettings>
                                </custom:GridColumnEx>
                            </dxg:GridControlBand>
                            <dxg:GridControlBand Name="bandPeriod" Header="Period">
                                <custom:GridColumnEx Name="columnPeriodPlannedPercentage" Header="PLANNED %" FieldName="ScheduleCurrentPeriodPercentage" ReadOnly="True" IsEnabled="False" FilterPopupMode="CheckedList" SortMode="Custom">
                                    <custom:GridColumnEx.EditSettings>
                                        <dxe:TextEditSettings MaskType="Numeric" Mask="p" MaskUseAsDisplayFormat="True" />
                                    </custom:GridColumnEx.EditSettings>
                                </custom:GridColumnEx>
                                <custom:GridColumnEx Name="columnPeriodEarnedPercentage" Header="EARNED %" FieldName="Earned_Percentage_OnDataDate" ReadOnly="True" IsEnabled="False" FilterPopupMode="CheckedList" SortMode="Custom">
                                    <custom:GridColumnEx.EditSettings>
                                        <dxe:TextEditSettings MaskType="Numeric" Mask="p" MaskUseAsDisplayFormat="True" />
                                    </custom:GridColumnEx.EditSettings>
                                </custom:GridColumnEx>
                                <custom:GridColumnEx Name="columnPeriodEarnedUnits" Header="EARNED UNITS" FieldName="Earned_Units_OnDataDate" ReadOnly="True" IsEnabled="False" FilterPopupMode="CheckedList" SortMode="Custom">
                                    <custom:GridColumnEx.EditSettings>
                                        <dxe:SpinEditSettings MaskType="Numeric" Mask="n" MaskUseAsDisplayFormat="True" />
                                    </custom:GridColumnEx.EditSettings>
                                </custom:GridColumnEx>
                                <custom:GridColumnEx Name="columnCurrentEarnedCost" Header="CURRENT EARNED COSTS" FieldName="Earned_Costs_OnDataDate" ReadOnly="True" IsEnabled="False" Visible="False" FilterPopupMode="CheckedList" SortMode="Custom">
                                    <custom:GridColumnEx.EditSettings>
                                        <dxe:SpinEditSettings MaskType="Numeric" Mask="c" MaskUseAsDisplayFormat="True" />
                                    </custom:GridColumnEx.EditSettings>
                                </custom:GridColumnEx>
                            </dxg:GridControlBand>
                            <dxg:GridControlBand Name="bandProductivity" Header="Productivity">
                                <custom:GridColumnEx FieldName="Current_Productivity" Header="CURRENT_PRODUCTIVITY" IsEnabled="False" ReadOnly="True" FilterPopupMode="CheckedList">
                                    <custom:GridColumnEx.EditSettings>
                                        <dxe:SpinEditSettings MaskType="Numeric" Mask="n" MaskUseAsDisplayFormat="True" />
                                    </custom:GridColumnEx.EditSettings>
                                </custom:GridColumnEx>
                                <custom:GridColumnEx FieldName="Override_Productivity" Header="OVERRIDE_PRODUCTIVITY" FilterPopupMode="CheckedList">
                                    <custom:GridColumnEx.EditSettings>
                                        <dxe:SpinEditSettings MaskType="Numeric" Mask="n" MaskUseAsDisplayFormat="True" Increment="0.1" NullValueButtonPlacement="EditBox" />
                                    </custom:GridColumnEx.EditSettings>
                                </custom:GridColumnEx>
                                <custom:GridColumnEx FieldName="Remaining_Productivity" Header="REMAINING_PRODUCTIVITY" IsEnabled="False" ReadOnly="True" FilterPopupMode="CheckedList">
                                    <custom:GridColumnEx.EditSettings>
                                        <dxe:SpinEditSettings MaskType="Numeric" Mask="n" MaskUseAsDisplayFormat="True" Increment="0.1" NullValueButtonPlacement="EditBox" />
                                    </custom:GridColumnEx.EditSettings>
                                </custom:GridColumnEx>
                                <custom:GridColumnEx Name="colCREATED" FieldName="Last_Updated" Header="UPDATED" AllowSearchPanel="False" FilterPopupMode="CheckedList" ReadOnly="True" Visible="False" />
                                <custom:GridColumnEx Name="colCREATEDBY" FieldName="Last_UpdatedBy" Header="UPDATEDBY" AllowSearchPanel="False" FilterPopupMode="CheckedList" ReadOnly="True" Visible="False" >
                                    <custom:GridColumnEx.EditSettings>
                                        <dxe:ComboBoxEditSettings ItemsSource="{Binding DataContext.USERCollection, ElementName=userControl}" IsTextEditable="True" AutoComplete="True" DisplayMember="NAME" ValueMember="GUID" />
                                    </custom:GridColumnEx.EditSettings>
                                </custom:GridColumnEx>
                            </dxg:GridControlBand>
                        </dxg:GridControl.Bands>
                        <dxg:GridControl.DetailDescriptor>
                            <dxg:DataControlDetailDescriptor ItemsSourceBinding="{Binding Milestones}">
                                <dxg:GridControl x:Name="gridControlChild" Style="{StaticResource DefaultDetailGridControlTemplate}">
                                    <dxg:GridControl.Columns>
                                        <dxg:GridColumn Header="Required Percentage" FieldName="Percentage" ReadOnly="True">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings DisplayFormat="p2" MaskUseAsDisplayFormat="True" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn Header="On Date" FieldName="DueDate" ReadOnly="True">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:DateEditSettings />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn Header="P6 Activity" FieldName="Milestone" ReadOnly="True"/>
                                    </dxg:GridControl.Columns>
                                    <dxg:GridControl.View>
                                        <dxg:TableView x:Name="tableView1" Style="{StaticResource DefaultDetailTableViewTemplate}" >
