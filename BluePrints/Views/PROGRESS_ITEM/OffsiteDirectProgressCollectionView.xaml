<UserControl x:Class="BluePrints.Views.OffsiteDirectProgressCollectionView" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:common="clr-namespace:BluePrints.Common" xmlns:custom="clr-namespace:BaseModel.Misc;assembly=BaseModel" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon" xmlns:dxrudex="http://schemas.devexpress.com/winfx/2008/xaml/reports/userdesignerextensions" xmlns:filter="clr-namespace:BluePrints.Common.Filtering" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:view="clr-namespace:BluePrints.Views" xmlns:viewmodel="clr-namespace:BluePrints.ViewModels" x:Name="userControl" d:DesignHeight="400" d:DesignWidth="600" DataContext="{dxmvvm:ViewModelSource viewmodel:OffsiteDirectProgressCollectionViewModelWrapper}" mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/DefaultBluePrintsResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/BaseModel;component/View/ResourceDictionaries/DefaultControlResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/ConverterResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Style="{StaticResource CollectionView.RootContainer}">
        <Grid DataContext="{Binding MainViewModel}">
            <DockPanel>
                <dxr:RibbonControl AllowCustomization="False" DockPanel.Dock="Top" MDIMergeStyle="Always" RibbonStyle="Office2010">
                    <dxr:RibbonDefaultPageCategory Caption="defaultCategory">
                        <dxr:RibbonPage Caption="Live Deliverables Progress">
                            <dxr:RibbonPageGroup Caption="Grid" ItemLinksSource="{StaticResource RibbonDefaultGridButtons}" />
                            <dxr:RibbonPageGroup Caption="Layout" ItemLinksSource="{StaticResource RibbonDefaultLayoutButtons}" />
                            <dxr:RibbonPageGroup Caption="Report" ItemLinksSource="{StaticResource RibbonDefaultReportingButtons}" />
                            <dxr:RibbonPageGroup Caption="Data Date">
                                <dxb:BarButtonItem Command="{Binding DataContext.DateBackwardCommand, ElementName=userControl}" Content="Backward" Glyph="{dx:DXImage Image=HistoryItem_16x16.png}" LargeGlyph="{dx:DXImage Image=HistoryItem_32x32.png}" ToolTip="Rewind data date to previous interval" />
                                <!--<dxb:BarStaticItem Content="Data Date" />-->
                                <dxb:BarEditItem EditValue="{Binding DataContext.DataDate, ElementName=userControl}" ToolTip="Data date">
                                    <dxb:BarEditItem.EditSettings>
                                        <dxe:DateEditSettings />
                                    </dxb:BarEditItem.EditSettings>
                                </dxb:BarEditItem>
                                <dxb:BarButtonItem Command="{Binding DataContext.DateForwardCommand, ElementName=userControl}" Content="Forward" Glyph="{dx:DXImage Image=HistoryItem_16x16.png}" LargeGlyph="{dx:DXImage Image=HistoryItem_32x32.png}" ToolTip="Forward data date to next interval">
                                    <dxb:BarButtonItem.GlyphTemplate>
                                        <DataTemplate>
                                            <Image RenderTransformOrigin="0.5,0.5" Source="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=dxb:BarItemLinkInfo}, Path=Item.LargeGlyph}">
                                                <Image.RenderTransform>
                                                    <ScaleTransform ScaleX="-1" />
                                                </Image.RenderTransform>
                                            </Image>
                                        </DataTemplate>
                                    </dxb:BarButtonItem.GlyphTemplate>
                                </dxb:BarButtonItem>
                            </dxr:RibbonPageGroup>
                            <!--<dxr:RibbonPageGroup Caption="Data Date">
                                <dxb:BarButtonItem Command="{Binding DataContext.DateBackwardCommand, ElementName=userControl}" Content="Backward" Glyph="{dx:DXImage Image=HistoryItem_16x16.png}" LargeGlyph="{dx:DXImage Image=HistoryItem_32x32.png}" ToolTip="Rewind data date to previous interval" />
                            -->
                            <!--<dxb:BarStaticItem Content="Data Date" />-->
                            <!--
                                <dxb:BarStaticItem Content="{Binding DataContext.DataDate, ElementName=userControl}" ToolTip="Data date" />
                                <dxb:BarButtonItem Command="{Binding DataContext.DateForwardCommand, ElementName=userControl}" Content="Forward" Glyph="{dx:DXImage Image=HistoryItem_16x16.png}" LargeGlyph="{dx:DXImage Image=HistoryItem_32x32.png}" ToolTip="Forward data date to next interval">
                                    <dxb:BarButtonItem.GlyphTemplate>
                                        <DataTemplate>
                                            <Image RenderTransformOrigin="0.5,0.5" Source="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=dxb:BarItemLinkInfo}, Path=Item.LargeGlyph}">
                                                <Image.RenderTransform>
                                                    <ScaleTransform ScaleX="-1" />
                                                </Image.RenderTransform>
                                            </Image>
                                        </DataTemplate>
                                    </dxb:BarButtonItem.GlyphTemplate>
                                </dxb:BarButtonItem>
                            </dxr:RibbonPageGroup>-->
                            <dxr:RibbonPageGroup Caption="Tools">
                                <!--<dxb:BarButtonItem Content="Fix Status" Command="{Binding DataContext.FixDeliverablesStatusCommand, ElementName=userControl}" LargeGlyph="{dx:DXImageOffice2013 Image=Replace_32x32.png}" Glyph="{dx:DXImage Image=Replace_16x16.png}" />-->
                                <dxb:BarButtonItem Command="{Binding DataContext.UpdateAllPercentagesByStatusCommand, ElementName=userControl}" Content="Update % by Gates" Glyph="{dx:DXImage Image=ClearFormatting_16x16.png}" LargeGlyph="{dx:DXImage Image=ClearFormatting_32x32.png}" ToolTip="Bulk update all deliverables progress by it's gate. Deliverables without gates will be ignored. When deliverables status % is lower than current %, previous progresses will be reduced starting from previous interval." />
                                <dxb:BarButtonItem Command="{Binding DataContext.InteractWithP6Command, ElementName=userControl}" CommandParameter="{Binding RelativeSource={RelativeSource Self}}" Content="Pull From P6" Glyph="{dxc:DXImage Image=DoublePrev_16x16.png}" IsVisible="{Binding DataContext.IsInteractWithP6Visible, ElementName=userControl}" LargeGlyph="{dx:DXImage Image=DoublePrev_32x32.png}" ToolTip="WARNING: DO NOT USE IF YOU ARE NOT HARRY! Updates deliverables progress based on activity % in P6." />
                                <dxb:BarButtonItem Command="{Binding DataContext.InteractWithP6Command, ElementName=userControl}" CommandParameter="{Binding RelativeSource={RelativeSource Self}}" Content="Fix P6 And Pull" Glyph="{dxc:DXImage Image=Refresh_16x16.png}" IsVisible="{Binding DataContext.IsInteractWithP6Visible, ElementName=userControl}" LargeGlyph="{dx:DXImage Image=Refresh_32x32.png}" ToolTip="WARNING: DO NOT USE IF YOU ARE NOT HARRY! Also completes P6 activity that have successors that has started then dpdates deliverables progress based on activity % in P6." />
                                <dxb:BarButtonItem Command="{Binding DataContext.PushToP6OriginalCommand, ElementName=userControl}" Content="Progress To P6" Glyph="{dx:DXImage Image=DoubleNext_16x16.png}" LargeGlyph="{dx:DXImage Image=DoubleNext_32x32.png}" ToolTip="Update P6 earned units to current deliverables earned units." />
                                <dxb:BarButtonItem Command="{Binding DataContext.FixVariationCommand, ElementName=userControl}" Content="Fix DC Hours" Glyph="{dx:DXImage Image=DoubleNext_16x16.png}" LargeGlyph="{dx:DXImage Image=DoubleNext_32x32.png}" ToolTip="Fix deliverable DC hours." />
                            </dxr:RibbonPageGroup>
                        </dxr:RibbonPage>
                    </dxr:RibbonDefaultPageCategory>
                </dxr:RibbonControl>
                <dxr:RibbonStatusBarControl DockPanel.Dock="Bottom">
                    <dxr:RibbonStatusBarControl.LeftItems>
                        <dxb:BarStaticItem Content="{Binding Entities.Count, Converter={dxmvvm:FormatStringConverter FormatString='RECORDS: {0}'}}" />
                    </dxr:RibbonStatusBarControl.LeftItems>
                </dxr:RibbonStatusBarControl>
                <dxlc:LayoutControl DockPanel.Dock="Right">
                    <dxlc:LayoutGroup.LayoutTransform>
                        <RotateTransform Angle="90" />
                    </dxlc:LayoutGroup.LayoutTransform>
                    <dxlc:LayoutGroup IsCollapsible="True" View="Group">
                        <Grid>
                            <Grid.LayoutTransform>
                                <RotateTransform Angle="-90" />
                            </Grid.LayoutTransform>
                            <filter:FilterAccordionView DataContext="{Binding DataContext.FilterTreeViewModel, ElementName=userControl}" />
                        </Grid>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutControl>
                <custom:GridControlEx x:Name="GridControl" dxc:DXSerializer.SerializationID="GridControlOffsiteDirectProgress" dxc:DXSerializer.StoreLayoutMode="All" Style="{StaticResource DefaultGridControlTemplate}">
                    <dxmvvm:Interaction.Behaviors>
                        <dxmvvm:EventToCommand Command="{Binding DataContext.CustomSummaryCommand, ElementName=userControl}" EventName="CustomSummary" PassEventArgsToCommand="True" />
                        <!--<dxmvvm:EventToCommand Command="{Binding DataContext.OnCustomColumnSortCommand, ElementName=userControl}" EventName="CustomColumnSort" PassEventArgsToCommand="True" />-->
                    </dxmvvm:Interaction.Behaviors>
                    <dxg:GridControl.Bands>
                        <dxg:GridControlBand Header="General (Read Only)">
                            <dxg:GridColumn FieldName="Entity.Entity.GUID_SUBJOB" FilterPopupMode="CheckedList" Header="Subjob" ReadOnly="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings DisplayMember="INTERNAL_NAME1" IsTextEditable="False" ItemsSource="{Binding DataContext.SUBJOBCollection, ElementName=userControl}" ValueMember="GUID" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Entity.Entity.GUID_WORKPACK" FilterPopupMode="CheckedList" Header="Workpack" ReadOnly="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding DataContext.WORKPACKCollection, ElementName=userControl}" ValueMember="GUID" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Entity.Entity.OFFICE" FilterPopupMode="CheckedList" Header="Office">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings AutoComplete="True" IsTextEditable="True" ItemsSource="{dxe:EnumItemsSource EnumType={x:Type common:Office}}" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Entity.Entity.GUID_AREA" FilterPopupMode="CheckedList" Header="Area" ReadOnly="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="INTERNAL_NUM" IsTextEditable="True" ItemsSource="{Binding DataContext.AREACollection, ElementName=userControl}" ValueMember="GUID" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn ColumnFilterMode="DisplayText" FieldName="Entity.Entity.SubAreaGuid" FilterPopupMode="CheckedList" Header="Sub-Area" ReadOnly="True">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <dxe:ComboBoxEdit x:Name="PART_Editor" DisplayMember="INTERNAL_NUM" ImmediatePopup="True" IncrementalFiltering="True" ItemsSource="{Binding RowData.Row.Entity.Entity.SubAreaCollection}" NullValueButtonPlacement="Popup" ValidateOnEnterKeyPressed="True" ValidateOnTextInput="True" ValueMember="GUID" />
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                                <!--  For Filtering  -->
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="INTERNAL_NUM" IsTextEditable="True" ItemsSource="{Binding DataContext.SUBAREACollection, ElementName=userControl}" NullValueButtonPlacement="EditBox" ValueMember="GUID" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Entity.Entity.GUID_DOCTYPE" FilterPopupMode="CheckedList" Header="Document Type" ReadOnly="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding DataContext.DOCTYPECollection, ElementName=userControl}" ValueMember="GUID" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Entity.Entity.GUID_DISCIPLINE" FilterPopupMode="CheckedList" Header="Discipline" ReadOnly="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding DataContext.DISCIPLINECollection, ElementName=userControl}" ValueMember="GUID" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Entity.Entity.GUID_DEPARTMENT" FilterPopupMode="CheckedList" Header="Department" ReadOnly="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding DataContext.DEPARTMENTCollection, ElementName=userControl}" ValueMember="GUID" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Entity.Entity.INTERNAL_NUM" FilterPopupMode="CheckedList" Header="Internal Number" IsEnabled="False" ReadOnly="True" />
                            <dxg:GridColumn FieldName="Entity.Entity.CLIENT_NUM" FilterPopupMode="CheckedList" Header="Client Number" IsEnabled="False" ReadOnly="True" />
                            <dxg:GridColumn FieldName="Entity.Entity.DELIVERABLE_TYPE" FilterPopupMode="CheckedList" Header="Deliverable Type" IsEnabled="False" ReadOnly="True" />
                            <dxg:GridColumn FieldName="Entity.Entity.PRIMARY_TITLE" FilterPopupMode="CheckedList" Header="Primary Title" IsEnabled="False" ReadOnly="True" />
                            <dxg:GridColumn FieldName="Entity.Entity.SECONDARY_TITLE" FilterPopupMode="CheckedList" Header="Secondary Title" IsEnabled="False" ReadOnly="True" />
                            <dxg:GridColumn FieldName="Entity.Entity.COMMENTS" FilterPopupMode="CheckedList" Header="Comments" ReadOnly="True" />
                        </dxg:GridControlBand>
                        <dxg:GridControlBand Header="Budgeted">
                            <dxg:GridColumn FieldName="Entity.Entity.BY_DURATION" FilterPopupMode="CheckedList" Header="By Duration" HeaderToolTip="Check this so that deliverable can be mapped to P6 activity without increasing it's budgeted units" IsEnabled="False" />
                            <dxg:GridColumn FieldName="Entity.Entity.BUDGET_HOURS" FilterPopupMode="CheckedList" Header="Estimated Hours" HeaderToolTip="Baseline hours" IsEnabled="False" ReadOnly="True" Visible="False">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:SpinEditSettings Increment="1" Mask="n" MaskType="Numeric" MaskUseAsDisplayFormat="True" MinValue="0" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Entity.Entity.DC_HOURS" FilterPopupMode="CheckedList" Header="Variation Hours" HeaderToolTip="Variation hours have to be added from the variation page and approved to be shown here" IsEnabled="False" ReadOnly="True" Visible="False">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:SpinEditSettings Increment="1" Mask="n" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Entity.Entity.Total_Units" FilterPopupMode="CheckedList" Header="Total Hours" HeaderToolTip="Estimated Hours + Variation Hours" IsEnabled="False" ReadOnly="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:SpinEditSettings Increment="1" Mask="n" MaskType="Numeric" MaskUseAsDisplayFormat="True" MinValue="0" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Entity.Budget_ItemRate" FilterPopupMode="CheckedList" Header="Rate" HeaderToolTip="From rates table by deliverables discipline" IsEnabled="False" ReadOnly="True" Visible="False">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:SpinEditSettings Increment="1" Mask="n" MaskType="Numeric" MaskUseAsDisplayFormat="True" MinValue="0" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn ColumnFilterMode="DisplayText" FieldName="DeliverableStatusProgressGuid" FilterPopupMode="Custom" Header="Gates" HeaderToolTip="From deliverables status table. Changing this value will increase current % only if the status has a higher percentage than previously earned %">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <dxe:ComboBoxEdit x:Name="PART_Editor" DisplayMember="NAME" ImmediatePopup="True" IncrementalFiltering="True" ItemsSource="{Binding RowData.Row.Entity.Entity.DeliverableStatusCollection}" NullValueButtonPlacement="Popup" ValidateOnEnterKeyPressed="True" ValidateOnTextInput="True" ValueMember="GUID" />
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                                <!--  For Filtering  -->
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding DataContext.DELIVERABLES_STATUSCollection, ElementName=userControl}" ValueMember="GUID" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <!--<dxg:GridColumn Header="Resource" FieldName="Entity.Entity.GUID_USER" FilterPopupMode="CheckedList">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding DataContext.USERCollection, ElementName=userControl}" ValueMember="GUID" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>-->
                        </dxg:GridControlBand>
                        <dxg:GridControlBand Header="Cumulative">
                            <dxg:GridColumn FieldName="Baseline_Percentage" FilterPopupMode="CheckedList" Header="Baseline %" HeaderToolTip="% as benchmarked against budget. May exceed 100% if variation exists" IsEnabled="False" ReadOnly="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings Mask="p" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Total_Percentage_ToDate" FilterPopupMode="CheckedList" Header="Total %" HeaderToolTip="% as benchmarked against budget + variation" IsEnabled="False" ReadOnly="True" Visible="False">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings Mask="p" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="SchedulePercentage" FilterPopupMode="CheckedList" Header="Schedule %" HeaderToolTip="Required % as obtained from P6 or subjob dates. % as benchmarked against budget. May exceed 100% if variation exists" IsEnabled="False" ReadOnly="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:SpinEditSettings Mask="p" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="StartDate" FilterPopupMode="CheckedList" Header="Start Date" HeaderToolTip="Date obtained from subjob or P6" IsEnabled="False" ReadOnly="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:DateEditSettings />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="DueDate" FilterPopupMode="CheckedList" Header="Due Date" HeaderToolTip="Date obtained from subjob or P6" IsEnabled="False" ReadOnly="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:DateEditSettings />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="ForecastDate" FilterPopupMode="CheckedList" Header="Forecast Finish Date" HeaderToolTip="Date obtained from subjob or P6. Calculated by 1.0 productivity by default and can be overridden by Override Productivity column" IsEnabled="False" ReadOnly="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:DateEditSettings />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Entity.Entity.TARGET_DATE" FilterPopupMode="CheckedList" Header="Target Date" HeaderToolTip="Internal manual target date. Can be set by anyone">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:DateEditSettings NullValueButtonPlacement="Popup" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn AllowEditing="True" FieldName="Total_Earned_Percentage" FilterPopupMode="CheckedList" Header="Current %" HeaderToolTip="Cumulative % earned since the start of the project. % as benchmarked against baseline + variation. Update this to earn units for this period">
                                <dxg:GridColumn.HeaderStyle>
                                    <Style TargetType="Control">
                                        <Setter Property="Background" Value="LightCyan" />
                                    </Style>
                                </dxg:GridColumn.HeaderStyle>
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="15" />
                                                <ColumnDefinition Width="15" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Image Grid.Column="0" Source="{dx:DXImage Image=First_16x16.png}" ToolTip="Minimum Possible Progress">
                                                <Image.Visibility>
                                                    <MultiBinding Converter="{StaticResource NumericCompareToVisibilityConverter}" FallbackValue="Hidden">
                                                        <MultiBinding.ConverterParameter>
                                                            <sys:Boolean>False</sys:Boolean>
                                                        </MultiBinding.ConverterParameter>
                                                        <Binding ElementName="PART_Editor" Path="MinValue" />
                                                        <Binding ElementName="PART_Editor" Path="EditValue" />
                                                    </MultiBinding>
                                                </Image.Visibility>
                                            </Image>
                                            <Image Grid.Column="1" Source="{dx:DXImage Image=Last_16x16.png}" ToolTip="Maximum Possible Progress">
                                                <Image.Visibility>
                                                    <MultiBinding Converter="{StaticResource NumericCompareToVisibilityConverter}" FallbackValue="Hidden">
                                                        <MultiBinding.ConverterParameter>
                                                            <sys:Boolean>False</sys:Boolean>
                                                        </MultiBinding.ConverterParameter>
                                                        <Binding ElementName="PART_Editor" Path="MaxValue" />
                                                        <Binding ElementName="PART_Editor" Path="EditValue" />
                                                    </MultiBinding>
                                                </Image.Visibility>
                                            </Image>
                                            <dxe:SpinEdit Name="PART_Editor" Grid.Column="2" Increment="0.01" Mask="p0" MaskType="Numeric" MaskUseAsDisplayFormat="True" MaxValue="{Binding RowData.Row.MaxPercentage}" MinValue="{Binding RowData.Row.MinPercentage}" />
                                        </Grid>
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Earned_Units_ToDate" FilterPopupMode="CheckedList" Header="Total Earned Units" HeaderToolTip="Cumulative earned units" IsEnabled="False" ReadOnly="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings Mask="n" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Earned_Costs_ToDate" FilterPopupMode="CheckedList" Header="Total Earned Costs" HeaderToolTip="Cumulative earned costs" IsEnabled="False" ReadOnly="True" Visible="False">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:SpinEditSettings Mask="c" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                        </dxg:GridControlBand>
                        <dxg:GridControlBand Header="Period">
                            <dxg:GridColumn FieldName="ScheduleCurrentPeriodPercentage" FilterPopupMode="CheckedList" Header="Planned %" HeaderToolTip="Required % for current period obtained from subjob or P6" IsEnabled="False" ReadOnly="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings Mask="p" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Earned_Percentage_OnDataDate" FilterPopupMode="CheckedList" Header="Earned %" HeaderToolTip="% earned for this period" IsEnabled="False" ReadOnly="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings Mask="p" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Earned_Units_OnDataDate" FilterPopupMode="CheckedList" Header="Earned Units" HeaderToolTip="Units earned on this period" IsEnabled="False" ReadOnly="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:SpinEditSettings Mask="n" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Earned_Costs_OnDataDate" FilterPopupMode="CheckedList" Header="Earned Costs" HeaderToolTip="Costs earned on this period" IsEnabled="False" ReadOnly="True" Visible="False">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:SpinEditSettings Mask="c" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                        </dxg:GridControlBand>
                        <dxg:GridControlBand Header="Productivity">
                            <dxg:GridColumn FieldName="Current_Productivity" FilterPopupMode="CheckedList" Header="Current Productivity" HeaderToolTip="Productivity is calculated as [current earned hours / schedule planned hours]" IsEnabled="False" ReadOnly="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:SpinEditSettings Mask="n" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Override_Productivity" FilterPopupMode="CheckedList" Header="Override Productivity" HeaderToolTip="By default current productivity will be used to forecast end date for P6 schedule activity. Use 1 for planned productivity in case schedule is too pessimistic. After productivity is set it is necessary to push progress to P6 then press F9 on P6 to produce the new forecasted end date then Close and reopen this view to obtain the newly calculated forecast end date">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:SpinEditSettings Increment="0.1" Mask="n" MaskType="Numeric" MaskUseAsDisplayFormat="True" NullValueButtonPlacement="EditBox" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Remaining_Productivity" FilterPopupMode="CheckedList" Header="Remaining Productivity" HeaderToolTip="Productivity required to finish project on time. Only critical items will have a value" IsEnabled="False" ReadOnly="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:SpinEditSettings Increment="0.1" Mask="n" MaskType="Numeric" MaskUseAsDisplayFormat="True" NullValueButtonPlacement="EditBox" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <!--<dxg:GridColumn Header="Guid" FieldName="GuidCurrent" ReadOnly="True" FilterPopupMode="CheckedList" IsEnabled="False" />-->
                            <dxg:GridColumn AllowSearchPanel="False" FieldName="Last_Created" FilterPopupMode="CheckedList" Header="Progress Created" HeaderToolTip="Progress first created date" ReadOnly="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:DateEditSettings DisplayFormat="M/d/yyyy HH:mm:ss" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn AllowSearchPanel="False" FieldName="Last_CreatedBy" FilterPopupMode="CheckedList" Header="Created By" HeaderToolTip="Person where current progress is created by" ReadOnly="True" Visible="False">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding DataContext.USERCollection, ElementName=userControl}" ValueMember="GUID" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn AllowSearchPanel="False" FieldName="Last_Updated" FilterPopupMode="CheckedList" Header="Progress Updated" HeaderToolTip="Progress last updated date" ReadOnly="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:DateEditSettings DisplayFormat="M/d/yyyy HH:mm:ss" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn AllowSearchPanel="False" FieldName="Last_UpdatedBy" FilterPopupMode="CheckedList" Header="Updated By" HeaderToolTip="Person where current progress is updated by" ReadOnly="True" Visible="False">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding DataContext.USERCollection, ElementName=userControl}" ValueMember="GUID" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="IAmCritical" FilterPopupMode="CheckedList" Header="Critical" HeaderToolTip="Deliverable is required to hit a milestone in the next interval. Expand this row to view required milestone" ReadOnly="True" />
                            <dxg:GridColumn FieldName="IAmOverdue" FilterPopupMode="CheckedList" Header="Overdue" HeaderToolTip="Deliverable is overdue. Expand this row to view required milestone" ReadOnly="True" />
                        </dxg:GridControlBand>
                    </dxg:GridControl.Bands>
                    <dxg:GridControl.DetailDescriptor>
                        <dxg:DataControlDetailDescriptor ItemsSourceBinding="{Binding Milestones}">
                            <dxg:GridControl x:Name="gridControlChild">
                                <dxg:GridControl.Columns>
                                    <dxg:GridColumn FieldName="Percentage" Header="Required Percentage" HeaderToolTip="Percentage required based on maped activity P6 schedule" ReadOnly="True">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings DisplayFormat="p2" MaskUseAsDisplayFormat="True" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="DueDate" Header="On Date" HeaderToolTip="Percentage required on date based on maped activity in P6 schedule" ReadOnly="True">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:DateEditSettings />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Width="300" FieldName="Milestone" Header="P6 Activity" HeaderToolTip="P6 activity name for the required percentage" ReadOnly="True" />
                                </dxg:GridControl.Columns>
                                <dxg:GridControl.View>
                                    <dxg:TableView x:Name="tableView1" AllowEditing="False" Style="{StaticResource DefaultDetailTableViewTemplate}">
                                        <dxg:TableView.FormatConditions>
                                            <dxg:DataBarFormatCondition FieldName="Percentage" MaxValue="1" MinValue="0">
                                                <dxc:DataBarFormat BorderBrush="#FF63C384" BorderBrushNegative="#FFFF555A">
                                                    <dxc:DataBarFormat.FillNegative>
                                                        <LinearGradientBrush EndPoint="1,0">
                                                            <GradientStop Offset="0" Color="White" />
                                                            <GradientStop Offset="1" Color="#FFFF555A" />
                                                        </LinearGradientBrush>
                                                    </dxc:DataBarFormat.FillNegative>
                                                    <dxc:DataBarFormat.Fill>
                                                        <LinearGradientBrush EndPoint="1,0">
                                                            <GradientStop Offset="0" Color="#FF63C384" />
                                                            <GradientStop Offset="1" Color="White" />
                                                        </LinearGradientBrush>
                                                    </dxc:DataBarFormat.Fill>
                                                    <dxc:DataBarFormat.ZeroLineBrush>
                                                        <DrawingBrush TileMode="Tile" Viewport="0,0,1001,4" ViewportUnits="Absolute">
                                                            <DrawingBrush.Drawing>
                                                                <GeometryDrawing Brush="Black">
                                                                    <GeometryDrawing.Geometry>
                                                                        <GeometryGroup>
                                                                            <RectangleGeometry Rect="0,0,1000,3" />
                                                                            <RectangleGeometry Rect="1000,3,1,1" />
                                                                        </GeometryGroup>
                                                                    </GeometryDrawing.Geometry>
                                                                </GeometryDrawing>
                                                            </DrawingBrush.Drawing>
                                                        </DrawingBrush>
                                                    </dxc:DataBarFormat.ZeroLineBrush>
                                                </dxc:DataBarFormat>
                                            </dxg:DataBarFormatCondition>
                                        </dxg:TableView.FormatConditions>
                                    </dxg:TableView>
                                </dxg:GridControl.View>
                            </dxg:GridControl>
                        </dxg:DataControlDetailDescriptor>
                    </dxg:GridControl.DetailDescriptor>
                    <dxg:GridControl.GroupSummary>
                        <dxg:GridSummaryItem DisplayFormat="Total: {0:p}" FieldName="Baseline_Percentage" ShowInColumn="Baseline_Percentage" SummaryType="Custom" />
                        <dxg:GridSummaryItem DisplayFormat="Total: {0:p}" FieldName="SchedulePercentage" ShowInColumn="SchedulePercentage" SummaryType="Custom" />
                        <dxg:GridSummaryItem DisplayFormat="Total: {0:p}" FieldName="ScheduleCurrentPeriodPercentage" ShowInColumn="ScheduleCurrentPeriodPercentage" SummaryType="Custom" />
                        <dxg:GridSummaryItem DisplayFormat="Total: {0:p}" FieldName="Total_Earned_Percentage" ShowInColumn="Total_Earned_Percentage" SummaryType="Custom" />
                        <dxg:GridSummaryItem DisplayFormat="Total: {0:p}" FieldName="Earned_Percentage_OnDataDate" ShowInColumn="Earned_Percentage_OnDataDate" SummaryType="Custom" />
                        <dxg:GridSummaryItem DisplayFormat="Total: {0:n}" FieldName="Earned_Units_OnDataDate" ShowInColumn="Earned_Units_OnDataDate" SummaryType="Sum" />
                        <dxg:GridSummaryItem DisplayFormat="Total: {0:n}" FieldName="Earned_Units_ToDate" ShowInColumn="Earned_Units_ToDate" SummaryType="Sum" />
                        <dxg:GridSummaryItem DisplayFormat="Total: {0:p}" FieldName="Stats.Budgeted.CurrentPeriodDataPoint.UnitsPercentage" ShowInColumn="Stats.Budgeted.CurrentPeriodDataPoint.UnitsPercentage" SummaryType="Custom" />
                        <dxg:GridSummaryItem DisplayFormat="Total: {0:c2}" FieldName="DisplayPeriodEarnedCosts" ShowInColumn="DisplayPeriodEarnedCosts" SummaryType="Sum" />
                        <dxg:GridSummaryItem DisplayFormat="Total: {0:n}" FieldName="Entity.Entity.BUDGET_HOURS" SummaryType="Sum" />
                        <dxg:GridSummaryItem DisplayFormat="Total: {0:n}" FieldName="Entity.Entity.DC_HOURS" SummaryType="Sum" />
                        <dxg:GridSummaryItem DisplayFormat="Total: {0:n}" FieldName="Entity.Entity.Total_Units" SummaryType="Sum" />
                        <dxg:GridSummaryItem DisplayFormat="Total: {0:n}" FieldName="PROGRESS_ITEMcurrent.EARNED_UNITS" SummaryType="Sum" />
                        <dxg:GridSummaryItem DisplayFormat="Total {0} Records" FieldName="Entity.BASELINE_ITEM" ShowInColumn="Entity.BASELINE_ITEM" SummaryType="Count" />
                    </dxg:GridControl.GroupSummary>
                    <dxg:GridControl.TotalSummary>
                        <dxg:GridSummaryItem DisplayFormat="Total: {0:p}" FieldName="Baseline_Percentage" ShowInColumn="Baseline_Percentage" SummaryType="Custom" />
                        <dxg:GridSummaryItem DisplayFormat="Total: {0:p}" FieldName="SchedulePercentage" ShowInColumn="SchedulePercentage" SummaryType="Custom" />
                        <dxg:GridSummaryItem DisplayFormat="Total: {0:p}" FieldName="ScheduleCurrentPeriodPercentage" ShowInColumn="ScheduleCurrentPeriodPercentage" SummaryType="Custom" />
                        <dxg:GridSummaryItem DisplayFormat="Total: {0:p}" FieldName="Total_Earned_Percentage" ShowInColumn="Total_Earned_Percentage" SummaryType="Custom" />
                        <dxg:GridSummaryItem DisplayFormat="Total: {0:p}" FieldName="Earned_Percentage_OnDataDate" ShowInColumn="Earned_Percentage_OnDataDate" SummaryType="Custom" />
                        <dxg:GridSummaryItem DisplayFormat="Total: {0:n}" FieldName="Earned_Units_OnDataDate" ShowInColumn="Earned_Units_OnDataDate" SummaryType="Sum" />
                        <dxg:GridSummaryItem DisplayFormat="Total: {0:n}" FieldName="Earned_Units_ToDate" ShowInColumn="Earned_Units_ToDate" SummaryType="Sum" />
                        <dxg:GridSummaryItem DisplayFormat="Total: {0:p}" FieldName="Stats.Budgeted.CurrentPeriodDataPoint.UnitsPercentage" ShowInColumn="Stats.Budgeted.CurrentPeriodDataPoint.UnitsPercentage" SummaryType="Custom" />
                        <dxg:GridSummaryItem DisplayFormat="Total: {0:c2}" FieldName="DisplayPeriodEarnedCosts" ShowInColumn="DisplayPeriodEarnedCosts" SummaryType="Sum" />
                        <dxg:GridSummaryItem DisplayFormat="Total: {0:n}" FieldName="Entity.Entity.BUDGET_HOURS" SummaryType="Sum" />
                        <dxg:GridSummaryItem DisplayFormat="Total: {0:n}" FieldName="Entity.Entity.DC_HOURS" SummaryType="Sum" />
                        <dxg:GridSummaryItem DisplayFormat="Total: {0:n}" FieldName="Entity.Entity.Total_Units" SummaryType="Sum" />
                        <dxg:GridSummaryItem DisplayFormat="Total {0} Records" FieldName="Entity.BASELINE_ITEM" ShowInColumn="Entity.BASELINE_ITEM" SummaryType="Count" />
                    </dxg:GridControl.TotalSummary>
                    <dxg:GridControl.View>
                        <dxg:TableView x:Name="tableView" GroupSummaryDisplayMode="AlignByColumns" IsDetailButtonVisibleBinding="{Binding Row.IHaveMilestones}" NewItemRowPosition="None" ShowTotalSummary="True" Style="{StaticResource DefaultTableViewTemplate}">
                            <dxg:TableView.FormatConditions>
                                <dxg:FormatCondition ApplyToRow="True" Expression="[IAmCritical] = 'True'" FieldName="IAmCritical">
                                    <dxc:Format Background="LightBlue" />
                                </dxg:FormatCondition>
                                <dxg:FormatCondition ApplyToRow="True" Expression="[IAmOverdue] = 'True'" FieldName="IAmOverdue">
                                    <dxc:Format Background="Salmon" />
                                </dxg:FormatCondition>
                                <dxg:ColorScaleFormatCondition FieldName="Total_Earned_Percentage" MaxValue="1" MinValue="0">
                                    <dxc:ColorScaleFormat ColorMax="#FF63BE7B" ColorMiddle="#FFFFEB84" ColorMin="#FFF8696B" />
                                </dxg:ColorScaleFormatCondition>
                            </dxg:TableView.FormatConditions>
                            <dxg:TableView.RowCellMenuCustomizations>
                                <dxb:BarLinkContainerItem ItemLinksSource="{StaticResource ContextMenuDefaultHeaderButtons}" />
                                <dxb:BarItemLinkSeparator />
                                <dxb:BarLinkContainerItem ItemLinksSource="{StaticResource ContextMenuDefaultFooterButtons}" />
                            </dxg:TableView.RowCellMenuCustomizations>
                        </dxg:TableView>
                    </dxg:GridControl.View>
                </custom:GridControlEx>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
