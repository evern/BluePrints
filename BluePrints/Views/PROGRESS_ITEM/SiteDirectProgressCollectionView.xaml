<UserControl x:Class="BluePrints.Views.SiteDirectProgressCollectionView" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:common="clr-namespace:BluePrints.Common" xmlns:custom="clr-namespace:BaseModel.Misc;assembly=BaseModel" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon" xmlns:dxrudex="http://schemas.devexpress.com/winfx/2008/xaml/reports/userdesignerextensions" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:view="clr-namespace:BluePrints.Views" xmlns:viewmodel="clr-namespace:BluePrints.ViewModels" x:Name="userControl" d:DesignHeight="400" d:DesignWidth="600" DataContext="{dxmvvm:ViewModelSource viewmodel:SiteDirectProgressCollectionViewModelWrapper}" mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/GridColumnResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/BaseModel;component/View/ResourceDictionaries/DefaultControlResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/ConverterResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/CustomControlResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/DefaultBluePrintsResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Style="{StaticResource CollectionView.RootContainer}">
        <Grid DataContext="{Binding MainViewModel}">
            <DockPanel>
                <dxr:RibbonControl AllowCustomization="False" DockPanel.Dock="Top" MDIMergeStyle="Always" RibbonStyle="Office2010">
                    <dxr:RibbonDefaultPageCategory Caption="defaultCategory">
                        <dxr:RibbonPage Caption="Live Estimate Progress">
                            <dxr:RibbonPageGroup Caption="Grid" ItemLinksSource="{StaticResource RibbonDefaultGridButtons}" />
                            <dxr:RibbonPageGroup Caption="Layout" ItemLinksSource="{StaticResource RibbonDefaultLayoutButtons}" />
                            <!--<dxr:RibbonPageGroup Caption="Report" ItemLinksSource="{StaticResource RibbonDefaultReportingButtons}" />-->
                            <dxr:RibbonPageGroup Caption="Data Date">
                                <dxb:BarButtonItem Command="{Binding DataContext.DateBackwardCommand, ElementName=userControl}" Content="Backward" Glyph="{dx:DXImage Image=HistoryItem_16x16.png}" LargeGlyph="{dx:DXImage Image=HistoryItem_32x32.png}" ToolTip="Rewind data date to previous interval" />
                                <!--<dxb:BarStaticItem Content="Data Date" />-->
                                <dxb:BarStaticItem Content="{Binding DataContext.DataDate, ElementName=userControl}" ToolTip="Data date" />
                                <dxb:BarButtonItem Command="{Binding DataContext.DateForwardCommand, ElementName=userControl}" Content="Forward" Glyph="{dx:DXImage Image=HistoryItem_16x16.png}" LargeGlyph="{dx:DXImage Image=HistoryItem_32x32.png}" ToolTip="Forward data date to next interval">
                                    <dxb:BarButtonItem.GlyphTemplate>
                                        <DataTemplate>
                                            <Image RenderTransformOrigin="0.5,0.5" Source="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=dxb:BarItemLinkInfo}, Path=Item.LargeGlyph}">
                                                <Image.RenderTransform>
                                                    <ScaleTransform ScaleX="-1" />
                                                </Image.RenderTransform>
                                            </Image>
                                        </DataTemplate>
                                    </dxb:BarButtonItem.GlyphTemplate>
                                </dxb:BarButtonItem>
                            </dxr:RibbonPageGroup>
                            <dxr:RibbonPageGroup Caption="Tools">
                                <!--<dxb:BarButtonItem Content="Fix Status" Command="{Binding DataContext.FixDeliverablesStatusCommand, ElementName=userControl}" LargeGlyph="{dx:DXImageOffice2013 Image=Replace_32x32.png}" Glyph="{dx:DXImage Image=Replace_16x16.png}" />-->
                                <dxb:BarButtonItem Command="{Binding DataContext.AutoProgressIndirectsCommand, ElementName=userControl}" Content="Auto Indirect" Glyph="{dx:DXImage Image=ClearFormatting_16x16.png}" LargeGlyph="{dx:DXImageOffice2013 Image=ClearFormatting_32x32.png}" ToolTip="Auto progress indirects." />
                                <dxb:BarButtonItem Command="{Binding DataContext.PushToP6OriginalCommand, ElementName=userControl}" Content="Progress P6" Glyph="{dx:DXImage Image=DoubleNext_16x16.png}" LargeGlyph="{dx:DXImage Image=DoubleNext_32x32.png}" ToolTip="Update P6 earned units to current deliverables earned units." />
                            </dxr:RibbonPageGroup>
                        </dxr:RibbonPage>
                    </dxr:RibbonDefaultPageCategory>
                </dxr:RibbonControl>
                <dxr:RibbonStatusBarControl DockPanel.Dock="Bottom">
                    <dxr:RibbonStatusBarControl.LeftItems>
                        <dxb:BarStaticItem Content="{Binding Entities.Count, Converter={dxmvvm:FormatStringConverter FormatString='RECORDS: {0}'}}" />
                    </dxr:RibbonStatusBarControl.LeftItems>
                </dxr:RibbonStatusBarControl>
                <Grid>
                    <dxmvvm:Interaction.Behaviors>
                        <dxmvvm:LayoutSerializationService />
                    </dxmvvm:Interaction.Behaviors>
                    <custom:GridControlEx x:Name="GridControl" dx:DXSerializer.SerializationID="GridControlSiteDirectProgress" dx:DXSerializer.StoreLayoutMode="All" Style="{StaticResource DefaultGridControlTemplate}">
                        <dxg:GridControl.Bands>
                            <dxg:GridControlBand Header="General">
                                <dxg:GridColumn FieldName="ProgressItem.Area_Guid" Header="Area" ReadOnly="True">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="INTERNAL_NUM" IsTextEditable="True" ItemsSource="{Binding DataContext.AREACollection, ElementName=userControl}" ValueMember="GUID" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="ProgressItem.SubArea_Guid" Header="Sub-Area" ReadOnly="True">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="INTERNAL_NUM" IsTextEditable="True" ItemsSource="{Binding DataContext.SUBAREACollection, ElementName=userControl}" NullValueButtonPlacement="EditBox" ValueMember="GUID" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="ProgressItem.Stock_Group_Guid" Header="Stock Group" IsEnabled="False" ReadOnly="True">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="DESCRIPTION" IsTextEditable="True" ItemsSource="{Binding DataContext.STOCK_GROUPCollection, ElementName=userControl}" NullValueButtonPlacement="EditBox" ValueMember="GUID" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="ProgressItem.Deliverable_Name" Header="Stock Code" IsEnabled="False" ReadOnly="True" />
                                <dxg:GridColumn FieldName="Description" Header="Name" IsEnabled="False" ReadOnly="True" />
                                <dxg:GridColumn FieldName="Comments" Header="Comments" IsEnabled="False" ReadOnly="True" />
                                <dxg:GridColumn FieldName="ProgressItem.Total_Quantity" Header="Total Qty" HeaderToolTip="Estimated quantity + variation quantity" IsEnabled="False" ReadOnly="True">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:SpinEditSettings Mask="n" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="ProgressItem.UnitsPerQuantity" Header="Hours Per Qty" HeaderToolTip="Required installation hours per quantity" IsEnabled="False" ReadOnly="True">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings DisplayTextConverter="{StaticResource HoursToTextConverter}" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="ProgressItem.Remaining_Hours_To_Completion" Header="Remaining Hours" HeaderToolTip="Remaining hours to completion" IsEnabled="False" ReadOnly="True">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings DisplayTextConverter="{StaticResource HoursToTextConverter}" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="ProgressItem.IsByDuration" FilterPopupMode="CheckedList" Header="By Duration" HeaderToolTip="Check this so that deliverable can be mapped to P6 activity without increasing it's budgeted units" IsEnabled="False" />
                                <dxg:GridColumn FieldName="ProgressItem.Trackable_Total_Quantity" Header="Total Trackable Qty" HeaderToolTip="Only estimate items marked as trackable will be summed up here" IsEnabled="False" ReadOnly="True">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:SpinEditSettings Mask="n" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="ProgressItem.Budget_UOM" Header="UOM" HeaderToolTip="Unit of measure" IsEnabled="False" ReadOnly="True" />
                            </dxg:GridControlBand>
                            <dxg:GridControlBand Header="Period">
                                <dxg:GridColumn FieldName="ProgressItem.CurrentPeriodInstalledQuantity" Header="Intalled Qty" HeaderToolTip="Installed quantity for this period" IsEnabled="False">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:SpinEdit Name="PART_Editor" Increment="1" Mask="n" MaskType="Numeric" MaskUseAsDisplayFormat="True" MaxValue="{Binding RowData.Row.ProgressItem.MaxCurrentQuantity}" MinValue="0" />
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="ProgressItem.Earned_Units_OnDataDate" Header="Earned Hours" HeaderToolTip="Earned installation hours for this period" IsEnabled="False">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:SpinEditSettings Mask="n" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="ProgressItem.Earned_Install_Costs_OnDataDate" Header="Earned Install Costs" HeaderToolTip="Earned installation costs for this period" IsEnabled="False">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:SpinEditSettings Mask="c" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="ProgressItem.Earned_Supply_Costs_OnDataDate" Header="Earned Supply Costs" HeaderToolTip="Earned supply costs for this period" IsEnabled="False">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:SpinEditSettings Mask="c" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="ProgressItem.Earned_Total_Costs_OnDataDate" Header="Total Earned Costs" HeaderToolTip="Total earned costs for this period" IsEnabled="False">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:SpinEditSettings Mask="c" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                            </dxg:GridControlBand>
                            <dxg:GridControlBand Header="Totals To Date">
                                <dxg:GridColumn FieldName="ProgressItem.Schedule_Estimated_Quantity" Header="Planned Qty" HeaderToolTip="Planned quantity to date as per schedule" IsEnabled="False">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:SpinEditSettings Mask="n" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="ProgressItem.Trackable_Installed_Quantity" Header="Total Trackable Installed Qty" HeaderToolTip="Total trackable only installed quantity to date" IsEnabled="False">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:SpinEditSettings Mask="n" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="ProgressItem.AbsoluteTotalInstalledQuantity" Header="Total Installed Qty" HeaderToolTip="Total Installed quantity to date" IsEnabled="False">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:SpinEditSettings Mask="n" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="ProgressItem.Earned_Units_ToDate" Header="Total Installed Hours" HeaderToolTip="Total earned installation hours to date" IsEnabled="False" ReadOnly="True">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:SpinEditSettings Mask="n" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="ProgressItem.Earned_Install_Costs_OnDataDate" Header="Total Installed Costs" HeaderToolTip="Total earned installation costs to date" IsEnabled="False" ReadOnly="True">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:SpinEditSettings Mask="c" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="ProgressItem.Earned_Supply_Costs_OnDataDate" Header="Total Supplied Costs" HeaderToolTip="Total earned supply costs to date" IsEnabled="False" ReadOnly="True">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:SpinEditSettings Mask="c" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="ProgressItem.Earned_Total_Costs_OnDataDate" Header="Total Costs" HeaderToolTip="Total costs to date" IsEnabled="False" ReadOnly="True">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:SpinEditSettings Mask="n" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                            </dxg:GridControlBand>
                            <dxg:GridControlBand Header="Productivity">
                                <dxg:GridColumn FieldName="ProgressItem.Current_Productivity" Header="Current Productivity" HeaderToolTip="Productivity is calculated as [current earned quantity / schedule planned quantity]" IsEnabled="False">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:SpinEditSettings Mask="n" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="ProgressItem.Override_Productivity" Header="Override Productivity" HeaderToolTip="By default current productivity will be used to forecast end date for P6 schedule activity. Use 1 for planned productivity in case schedule is too pessimistic. After productivity is set it is necessary to push progress to P6 then press F9 on P6 to produce the new forecasted end date then Close and reopen this view to obtain the newly calculated forecast end date">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:SpinEditSettings Increment="0.1" Mask="n" MaskType="Numeric" MaskUseAsDisplayFormat="True" NullValueButtonPlacement="EditBox" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="ProgressItem.Remaining_Productivity" Header="Remaining Productivity" HeaderToolTip="Productivity required to finish project on time. Only critical items will have a value" IsEnabled="False">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:SpinEditSettings Increment="0.1" Mask="n" MaskType="Numeric" MaskUseAsDisplayFormat="True" NullValueButtonPlacement="EditBox" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                            </dxg:GridControlBand>
                        </dxg:GridControl.Bands>
                        <dxg:GridControl.DetailDescriptor>
                            <dxg:DataControlDetailDescriptor ItemsSourceBinding="{Binding Reportables}">
                                <dxg:GridControl x:Name="gridControlChild">
                                    <dxg:GridControl.Bands>
                                        <dxg:GridControlBand Header="General">
                                            <dxg:GridColumn Binding="{Binding Area_Guid}" Header="Area" ReadOnly="True">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="INTERNAL_NUM" IsTextEditable="True" ItemsSource="{Binding DataContext.AREACollection, ElementName=userControl}" ValueMember="GUID" />
                                                </dxg:GridColumn.EditSettings>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn Binding="{Binding SubArea_Guid}" ColumnFilterMode="DisplayText" Header="Sub-Area" ReadOnly="True">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="INTERNAL_NUM" IsTextEditable="True" ItemsSource="{Binding DataContext.SUBAREACollection, ElementName=userControl}" NullValueButtonPlacement="EditBox" ValueMember="GUID" />
                                                </dxg:GridColumn.EditSettings>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn Binding="{Binding Stock_Group_Guid}" Header="Stock Group" IsEnabled="False" ReadOnly="True">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="DESCRIPTION" IsTextEditable="True" ItemsSource="{Binding DataContext.STOCK_GROUPCollection, ElementName=userControl}" NullValueButtonPlacement="EditBox" ValueMember="GUID" />
                                                </dxg:GridColumn.EditSettings>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn Binding="{Binding Deliverable_Name}" Header="Stock Code" IsEnabled="False" ReadOnly="True" />
                                            <dxg:GridColumn Binding="{Binding ReadOnlyEstimate.Entity.Entity.NAME}" Header="Name" IsEnabled="False" ReadOnly="True" />
                                            <dxg:GridColumn Binding="{Binding ReadOnlyEstimate.Entity.Entity.COMMENTS}" Header="Comments" IsEnabled="False" ReadOnly="True" />
                                            <dxg:GridColumn Binding="{Binding Total_Quantity}" Header="Total Qty" HeaderToolTip="Estimated quantity + variation quantity" IsEnabled="False" ReadOnly="True">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:SpinEditSettings Mask="n" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                                </dxg:GridColumn.EditSettings>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn Binding="{Binding UnitsPerQuantity}" Header="Hours Per Qty" HeaderToolTip="Required installation hours per quantity" IsEnabled="False" ReadOnly="True">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:TextEditSettings DisplayTextConverter="{StaticResource HoursToTextConverter}" />
                                                </dxg:GridColumn.EditSettings>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn Binding="{Binding Remaining_Hours_To_Completion}" Header="Remaining Hours" HeaderToolTip="Remaining hours to completion" IsEnabled="False" ReadOnly="True">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:TextEditSettings DisplayTextConverter="{StaticResource HoursToTextConverter}" />
                                                </dxg:GridColumn.EditSettings>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn Binding="{Binding IsByDuration}" Header="By Duration" HeaderToolTip="Check this so that deliverable can be mapped to P6 activity without increasing it's budgeted units" IsEnabled="False" ReadOnly="True">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:CheckEditSettings />
                                                </dxg:GridColumn.EditSettings>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn Binding="{Binding Trackable_Total_Quantity}" Header="Total Trackable Qty" HeaderToolTip="Only estimate items marked as trackable will be summed up here" IsEnabled="False" ReadOnly="True">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:SpinEditSettings Mask="n" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                                </dxg:GridColumn.EditSettings>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn Binding="{Binding UOM}" Header="UOM" HeaderToolTip="Unit of measure" IsEnabled="False" ReadOnly="True" />
                                        </dxg:GridControlBand>
                                        <dxg:GridControlBand Header="Period">
                                            <dxg:GridColumn Binding="{Binding CurrentPeriodInstalledQuantity}" Header="Installed Qty" HeaderToolTip="Installed quantity for this period" IsEnabled="False">
                                                <dxg:GridColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <dxe:SpinEdit Name="PART_Editor" Increment="1" Mask="n" MaskType="Numeric" MaskUseAsDisplayFormat="True" MaxValue="{Binding RowData.Row.MaxCurrentQuantity}" MinValue="0" />
                                                    </DataTemplate>
                                                </dxg:GridColumn.CellTemplate>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn Binding="{Binding Earned_Units_OnDataDate}" Header="Earned Hours" HeaderToolTip="Earned installation hours for this period" IsEnabled="False">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:SpinEditSettings Mask="n" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                                </dxg:GridColumn.EditSettings>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn Binding="{Binding Earned_Install_Costs_OnDataDate}" Header="Earned Install Costs" HeaderToolTip="Earned installation costs for this period" IsEnabled="False">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:SpinEditSettings Mask="c" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                                </dxg:GridColumn.EditSettings>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn Binding="{Binding Earned_Supply_Costs_OnDataDate}" Header="Earned Supply Costs" HeaderToolTip="Earned supply costs for this period" IsEnabled="False">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:SpinEditSettings Mask="c" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                                </dxg:GridColumn.EditSettings>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn Binding="{Binding Earned_Total_Costs_OnDataDate}" Header="Total Earned Costs" HeaderToolTip="Total earned costs for this period" IsEnabled="False">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:SpinEditSettings Mask="c" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                                </dxg:GridColumn.EditSettings>
                                            </dxg:GridColumn>
                                        </dxg:GridControlBand>
                                        <dxg:GridControlBand Header="Totals">
                                            <dxg:GridColumn Binding="{Binding Schedule_Estimated_Quantity}" Header="Planned Qty" HeaderToolTip="Planned quantity to date as per schedule" IsEnabled="False" ReadOnly="True">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:SpinEditSettings Mask="n" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                                </dxg:GridColumn.EditSettings>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn Binding="{Binding Trackable_Installed_Quantity}" Header="Total Trackable Installed Qty" HeaderToolTip="Total trackable only installed quantity to date" IsEnabled="False" ReadOnly="True">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:SpinEditSettings Mask="n" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                                </dxg:GridColumn.EditSettings>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn Binding="{Binding AbsoluteTotalInstalledQuantity}" Header="Total Installed Qty" HeaderToolTip="Total Installed quantity to date" IsEnabled="False" ReadOnly="True">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:SpinEditSettings Mask="n" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                                </dxg:GridColumn.EditSettings>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn Binding="{Binding Total_Install_Hours}" Header="Total Installed Hours" IsEnabled="False" ReadOnly="True">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:SpinEditSettings Mask="n" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                                </dxg:GridColumn.EditSettings>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn Binding="{Binding Total_Install_Cost}" Header="Total Installed Costs" HeaderToolTip="Total earned installation costs to date" IsEnabled="False" ReadOnly="True">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:SpinEditSettings Mask="c" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                                </dxg:GridColumn.EditSettings>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn Binding="{Binding Total_Supply_Cost}" Header="Total Supplied Costs" HeaderToolTip="Total earned supply costs to date" IsEnabled="False" ReadOnly="True">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:SpinEditSettings Mask="c" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                                </dxg:GridColumn.EditSettings>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn Binding="{Binding Total_Cost}" FieldName="ProgressItem.Total_Cost" Header="Total Costs" HeaderToolTip="Total costs to date" IsEnabled="False" ReadOnly="True">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:SpinEditSettings Mask="n" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                                </dxg:GridColumn.EditSettings>
                                            </dxg:GridColumn>
                                        </dxg:GridControlBand>
                                        <dxg:GridControlBand Header="Productivity">
                                            <dxg:GridColumn Binding="{Binding Current_Productivity}" Header="Current Productivity" HeaderToolTip="Productivity is calculated as [current earned quantity / schedule planned quantity]" IsEnabled="False">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:SpinEditSettings Mask="n" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                                </dxg:GridColumn.EditSettings>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn Binding="{Binding Override_Productivity}" Header="Override Productivity" HeaderToolTip="By default current productivity will be used to forecast end date for P6 schedule activity. Use 1 for planned productivity in case schedule is too pessimistic. After productivity is set it is necessary to push progress to P6 then press F9 on P6 to produce the new forecasted end date then Close and reopen this view to obtain the newly calculated forecast end date">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:SpinEditSettings Increment="0.1" Mask="n" MaskType="Numeric" MaskUseAsDisplayFormat="True" NullValueButtonPlacement="EditBox" />
                                                </dxg:GridColumn.EditSettings>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn Binding="{Binding Remaining_Productivity}" Header="Remaining Productivity" HeaderToolTip="Productivity required to finish project on time. Only critical items will have a value" IsEnabled="False">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:SpinEditSettings Increment="0.1" Mask="n" MaskType="Numeric" MaskUseAsDisplayFormat="True" NullValueButtonPlacement="EditBox" />
                                                </dxg:GridColumn.EditSettings>
