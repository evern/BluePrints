<UserControl x:Class="BluePrints.Views.ROLECollectionView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:common="clr-namespace:BluePrints.Common" xmlns:custom="clr-namespace:BaseModel.Misc;assembly=BaseModel" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon" xmlns:dxrudex="http://schemas.devexpress.com/winfx/2008/xaml/reports/userdesignerextensions" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:services="clr-namespace:BaseModel.ViewModel.Services;assembly=BaseModel" xmlns:viewmodel="clr-namespace:BluePrints.ViewModels" x:Name="userControl" d:DesignHeight="400" d:DesignWidth="600" DataContext="{dxmvvm:ViewModelSource viewmodel:ROLECollectionViewModelWrapper}" mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <common:RowNameConverter x:Key="RowNameConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BaseModel;component/View/ResourceDictionaries/DefaultControlResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/DefaultBluePrintsResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Style="{StaticResource CollectionView.BaseRootContainer}">
        <dxmvvm:Interaction.Behaviors>
            <services:GridControlService Name="DefaultGridControlService" GridControl="{Binding ElementName=GridControlPermission}" />
            <services:GridControlService Name="TreeGridControlService" GridControl="{Binding ElementName=GridControlTree}" />
        </dxmvvm:Interaction.Behaviors>
        <Grid DataContext="{Binding MainViewModel}">
            <dxb:BarManager>
                <dxb:BarManager.Items>
                    <dxb:BarButtonItem x:Name="biFullRefresh1" Command="{Binding DataContext.FullRefreshCommand, ElementName=userControl}" Content="Refresh" Glyph="{dx:DXImage Image=Refresh_16x16.png}" LargeGlyph="{dx:DXImage Image=Refresh_32x32.png}" RibbonStyle="SmallWithText" ToolTip="Refresh table with updated data. Also clears any undo redo entries" />
                    <dxb:BarButtonItem x:Name="biBulkDelete1" Command="{Binding BulkDeleteCommand}" Content="Delete Row" Glyph="{dx:DXImage Image=Delete_16x16.png}" LargeGlyph="{dx:DXImage Image=Delete_32x32.png}" RibbonStyle="SmallWithText" ToolTip="Delete selected rows" />
                    <dxb:BarButtonItem x:Name="biSaveLayout1" Command="{Binding DataContext.SaveLayoutCommand, ElementName=userControl}" Content="Save Layout" Glyph="{dx:DXImage Image=Save_16x16.png}" LargeGlyph="{dx:DXImage Image=Save_32x32.png}" RibbonStyle="SmallWithText" ToolTip="Save current table filters, sorting, grouping and expanded group" />
                    <dxb:BarButtonItem x:Name="biResetLayout1" Command="{Binding DataContext.ResetLayoutCommand, ElementName=userControl}" Content="Reset Layout" Glyph="{dx:DXImage Image=SaveAndClose_16x16.png}" LargeGlyph="{dx:DXImage Image=SaveAndClose_32x32.png}" RibbonStyle="SmallWithText" ToolTip="Reset layout to default. Please reopen current view for default layout to take effect" />
                    <dxb:BarButtonItem x:Name="biAddRowBefore" Command="{Binding DataContext.AddRowBeforeCommand, ElementName=userControl}" Content="Insert Before" Glyph="{dx:DXImageOffice2013 Image=Insert_16x16.png}" LargeGlyph="{dx:DXImageOffice2013 Image=Insert_32x32.png}" />
                    <dxb:BarButtonItem x:Name="biAddRowAfter" Command="{Binding DataContext.AddRowAfterCommand, ElementName=userControl}" Content="Insert After" Glyph="{dx:DXImageOffice2013 Image=Insert_16x16.png}" LargeGlyph="{dx:DXImageOffice2013 Image=Insert_32x32.png}" />
                    <dxb:BarButtonItem x:Name="biCheckPermissions" Command="{Binding DataContext.CheckPermissionsCommand, ElementName=userControl}" CommandParameter="{Binding RelativeSource={RelativeSource Self}}" Content="Check" Glyph="{dx:DXImage Images/Conditional Formatting/IconSetSymbols3_16x16.png}" RibbonStyle="SmallWithText" ToolTip="Replicate column values in the permission grid for selected rows starting from last selection" />
                    <dxb:BarButtonItem x:Name="biUncheckPermissions" Command="{Binding DataContext.UncheckPermissionsCommand, ElementName=userControl}" CommandParameter="{Binding RelativeSource={RelativeSource Self}}" Content="Uncheck" Glyph="{dx:DXImage Images/Edit/Delete_16x16.png}" RibbonStyle="SmallWithText" ToolTip="Replicate column values in the permission grid for selected rows starting from first selection" />
                </dxb:BarManager.Items>
                <DockPanel>
                    <dxr:RibbonControl MDIMergeStyle="WhenChildActivated" AllowCustomization="False" DockPanel.Dock="Top" RibbonStyle="Office2010">
                        <dxr:RibbonDefaultPageCategory MergeType="Replace" Caption="defaultCategory">
                            <dxr:RibbonPage MergeType="Replace" Caption="Grid">
                                <dxr:RibbonPageGroup MergeType="Replace" Caption="Grid" >
                                    <dxb:BarButtonItemLink BarItemName="biFullRefresh1" />
                                    <dxb:BarButtonItemLink BarItemName="biBulkDelete1" />
                                    <dxb:BarButtonItemLink BarItemName="biSaveLayout1" />
                                    <dxb:BarButtonItemLink BarItemName="biResetLayout1" />
                                    <dxb:BarButtonItemLink BarItemName="biExportToExcel1" />
                                    <dxb:BarButtonItemLink BarItemName="biExportToPDF1" />
                                </dxr:RibbonPageGroup>
                                <dxr:RibbonPageGroup MergeType="Replace" Caption="Tools">
                                    <dxb:BarButtonItemLink BarItemName="biAddRowBefore" />
                                    <dxb:BarButtonItemLink BarItemName="biAddRowAfter"  />
                                </dxr:RibbonPageGroup>
                            </dxr:RibbonPage>
                        </dxr:RibbonDefaultPageCategory>
                    </dxr:RibbonControl>
                    <dxr:RibbonStatusBarControl DockPanel.Dock="Bottom">
                        <dxr:RibbonStatusBarControl.LeftItems>
                            <dxb:BarStaticItem Content="{Binding Entities.Count, Converter={dxmvvm:FormatStringConverter FormatString='RECORDS: {0}'}}" />
                        </dxr:RibbonStatusBarControl.LeftItems>
                    </dxr:RibbonStatusBarControl>
                    <dxdo:DockLayoutManager Name="dockLayoutManager" Margin="0" Padding="0" BorderThickness="0" MDIMergeStyle="WhenChildActivated">
                        <dxdo:LayoutGroup Margin="0" Padding="0" BorderThickness="0" ItemHeight="*" Orientation="Horizontal">
                            <dxdo:LayoutGroup MaxWidth="450" Name="LayoutGroupMain" Orientation="Horizontal">
                                <dxdo:LayoutPanel>
                                    <dxg:GridControl Name="GridControlTree" MaxHeight="2000" dx:DXSerializer.SerializationID="ROLETree" MouseUp="GridControl_MouseUp" Style="{StaticResource DefaultGridControlTemplate}">
                                        <dxmvvm:Interaction.Behaviors>
                                            <dxg:TreeListDragDropManager x:Name="dragDropManager">
                                                <dxmvvm:Interaction.Behaviors>
                                                    <dxmvvm:EventToCommand Command="{Binding DataContext.DragDropManager_DropCommand, ElementName=userControl}" EventName="Drop" PassEventArgsToCommand="True" />
                                                    <dxmvvm:EventToCommand Command="{Binding DataContext.DragDropManager_DroppedCommand, ElementName=userControl}" EventName="Dropped" PassEventArgsToCommand="True" />
                                                </dxmvvm:Interaction.Behaviors>
                                                <dxg:TreeListDragDropManager.DragElementTemplate>
                                                    <DataTemplate>
                                                        <Border Background="White" BorderBrush="LightGray" BorderThickness="2" CornerRadius="5">
                                                            <StackPanel Margin="5" HorizontalAlignment="Left" Background="White" Orientation="Vertical">
                                                                <StackPanel Margin="5" Background="White" Orientation="Vertical">
                                                                    <TextBlock Padding="3" FontWeight="Bold" Text="{Binding Path=DraggingRows.Count, StringFormat='Dragging {0} row(s)'}" />
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Padding="3,3,0,3" FontWeight="Bold" Text="Source: " />
                                                                        <TextBlock Padding="0,3,3,3" Text="{Binding Path=DraggingRows, Converter={StaticResource RowNameConverter}}" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                                <Separator />
                                                                <StackPanel Margin="5" Orientation="Horizontal">
                                                                    <TextBlock Padding="3,3,0,3" FontWeight="Bold" Text="Target: " />
                                                                    <TextBlock Padding="0,3,3,0" Text="{Binding Path=DropTargetRow, Converter={StaticResource RowNameConverter}}" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </dxg:TreeListDragDropManager.DragElementTemplate>
                                            </dxg:TreeListDragDropManager>
                                        </dxmvvm:Interaction.Behaviors>
                                        <dxg:GridControl.Columns>
                                            <dxg:GridColumn FieldName="Entity.NAME" Header="NAME" VisibleIndex="10" />
                                            <dxg:GridColumn FieldName="Entity.ISMANAGER" Header="IS MANAGER" HeaderToolTip="Tick this so that user associated to this role can be assigned to project in project collection view" VisibleIndex="20">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:CheckEditSettings />
                                                </dxg:GridColumn.EditSettings>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn FieldName="Entity.SORTORDER" ReadOnly="True" Visible="False" VisibleIndex="30" />
                                        </dxg:GridControl.Columns>
                                        <dxg:GridControl.View>
                                            <dxg:TreeListView x:Name="treeListView" Style="{StaticResource DefaultTreeListViewTemplate}">
                                                <dxg:TreeListView.RowCellMenuCustomizations>
                                                    <dxb:BarButtonItemLink BarItemName="biFullRefresh1" />
                                                    <dxb:BarButtonItemLink BarItemName="biAddRowBefore" />
                                                    <dxb:BarButtonItemLink BarItemName="biAddRowAfter"  />
                                                    <dxb:BarButtonItemLink BarItemName="biBulkDelete1" />
                                                </dxg:TreeListView.RowCellMenuCustomizations>
                                            </dxg:TreeListView>
                                        </dxg:GridControl.View>
                                    </dxg:GridControl>
                                </dxdo:LayoutPanel>
                            </dxdo:LayoutGroup>
                            <dxdo:LayoutGroup DataContext="{Binding DataContext, ElementName=userControl}" Orientation="Vertical">
                                <dxdo:LayoutPanel ItemHeight="30" ShowControlBox="False" ShowCloseButton="False" ShowCollapseButton="False" ShowPinButton="False">
                                    <dxlc:LayoutItem HorizontalAlignment="Center" VerticalAlignment="Center" Label="Hold shift + left mouse click to select multiple checkboxes and then right click on the desired checkbox column to bring up additional options to set checkbox values" LabelPosition="Left" />
                                </dxdo:LayoutPanel>
                                <dxdo:LayoutPanel>
                                    <custom:GridControlEx x:Name="GridControlPermission" MaxHeight="2000" SelectionMode="Row" dx:DXSerializer.SerializationID="GridControlROLE_PERMISSION" dx:DXSerializer.StoreLayoutMode="All" ItemsSource="{Binding Permissions}" SelectedItem="{Binding SelectedPermission, Mode=TwoWay}" SelectedItems="{Binding SelectedPermissions, Mode=TwoWay}">
                                        <dxg:GridControl.Columns>
                                            <dxg:GridColumn Width="600" AllowEditing="False" FieldName="DisplayName" Header="Permission" HeaderToolTip="Permissions within the system">
                                                <!--<dxg:GridColumn.EditSettings>
                                            <dxe:ComboBoxEditSettings DisplayMember="Value" IsTextEditable="False" ItemsSource="{Binding DataContext.PermissionLookUp, ElementName=userControl}" ValueMember="Key" />
                                        </dxg:GridColumn.EditSettings>-->
                                            </dxg:GridColumn>
                                            <dxg:GridColumn FieldName="IsAssigned" MaxWidth="100" Header="Assigned" HeaderToolTip="Indicate whether selected role have the permission to read/write">
                                                <dxg:GridColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <dxe:CheckEdit x:Name="PART_Editor" Visibility="{Binding RowData.Row.CanAssign, Converter={dxmvvm:BooleanToVisibilityConverter}}"  ToolTip="Specify whether selected role on the left have access to current permission as read/write"/>
                                                    </DataTemplate>
                                                </dxg:GridColumn.CellTemplate>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn FieldName="IsReadOnly" MaxWidth="100" Header="Read Only" HeaderToolTip="Indicate whether selected role have the permission but in read only mode">
                                                <dxg:GridColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <dxe:CheckEdit x:Name="PART_Editor" Visibility="{Binding RowData.Row.CanAssignReadOnly, Converter={dxmvvm:BooleanToVisibilityConverter}}"  ToolTip="Specify whether selected role on the left have access to current permission as read only"/>
                                                    </DataTemplate>
                                                </dxg:GridColumn.CellTemplate>
                                            </dxg:GridColumn>
                                        </dxg:GridControl.Columns>
                                        <dxg:GridControl.TotalSummary>
                                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" Alignment="Right" SummaryType="Count" />
                                        </dxg:GridControl.TotalSummary>
                                        <dxg:GridControl.GroupSummary>
                                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" SummaryType="Count" />
                                        </dxg:GridControl.GroupSummary>
                                        <dxg:GridControl.View>
                                            <dxg:TreeListView x:Name="permissionTreeListView" ShowSearchPanelMode="Always" AutoWidth="True" AutoExpandAllNodes="True" KeyFieldName="PermissionId" ParentFieldName="PermissionParentId">
                                                <dxmvvm:Interaction.Behaviors>
                                                    <dxmvvm:EventToCommand Command="{Binding DataContext.PermissionCellValueChangingCommand, ElementName=userControl}" EventName="CellValueChanging" PassEventArgsToCommand="True" />
                                                </dxmvvm:Interaction.Behaviors>
                                                <dxg:TreeListView.RowCellMenuCustomizations>
                                                    <dxb:BarButtonItemLink BarItemName="biCheckPermissions" />
                                                    <dxb:BarButtonItemLink BarItemName="biUncheckPermissions" />
                                                </dxg:TreeListView.RowCellMenuCustomizations>
                                            </dxg:TreeListView>
                                        </dxg:GridControl.View>
                                    </custom:GridControlEx>
                                </dxdo:LayoutPanel>
                            </dxdo:LayoutGroup>
                            <dxdo:LayoutGroup>
                                <dxdo:LayoutPanel MinWidth="420" ShowHideButton="True" AutoHidden="True" DataContext="{Binding DataContext, ElementName=userControl}">
                                    <custom:GridControlEx x:Name="GridControlCommodity" MaxHeight="2000" dx:DXSerializer.SerializationID="GridControlCommodity" dx:DXSerializer.StoreLayoutMode="All" ItemsSource="{Binding DocTypePermissions}" SelectedItem="{Binding SelectedDocTypePermission, Mode=TwoWay}">
                                        <dxg:GridControl.Columns>
                                            <dxg:GridColumn MinWidth="75" AllowEditing="False" FieldName="DocType.CODE" Header="Cost Type" HeaderToolTip="Cost type in exo is document type code in Blueprints" />
                                            <dxg:GridColumn AllowEditing="False" FieldName="DocType.NAME" Header="Description" />
                                            <dxg:GridColumn FieldName="IsAssigned" Header="Assigned" HeaderToolTip="Indicate whether cost type is recommended for the selected role">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:CheckEditSettings />
                                                </dxg:GridColumn.EditSettings>
                                            </dxg:GridColumn>
                                        </dxg:GridControl.Columns>
                                        <dxg:GridControl.TotalSummary>
                                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" Alignment="Right" SummaryType="Count" />
                                        </dxg:GridControl.TotalSummary>
                                        <dxg:GridControl.GroupSummary>
                                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" SummaryType="Count" />
                                        </dxg:GridControl.GroupSummary>
                                        <dxg:GridControl.View>
                                            <dxg:TableView x:Name="tableView1" ShowGroupPanel="False">
                                                <dxmvvm:Interaction.Behaviors>
                                                    <dxmvvm:EventToCommand Command="{Binding DataContext.DocTypePermissionCellValueChangingCommand, ElementName=userControl}" EventName="CellValueChanging" PassEventArgsToCommand="True" />
                                                </dxmvvm:Interaction.Behaviors>
                                            </dxg:TableView>
                                        </dxg:GridControl.View>
                                    </custom:GridControlEx>
                                </dxdo:LayoutPanel>
                            </dxdo:LayoutGroup>
                        </dxdo:LayoutGroup>
                    </dxdo:DockLayoutManager>
                </DockPanel>
            </dxb:BarManager>
        </Grid>
    </Grid>
</UserControl>