<UserControl x:Class="BluePrints.Views.RATECollectionView" xmlns:converters="clr-namespace:BluePrints.Common.ViewModel.Converters" xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:common="clr-namespace:BluePrints.Common" xmlns:custom="clr-namespace:BaseModel.Misc;assembly=BaseModel" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon" xmlns:dxrudex="http://schemas.devexpress.com/winfx/2008/xaml/reports/userdesignerextensions" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:view="clr-namespace:BluePrints.Views" xmlns:viewmodel="clr-namespace:BluePrints.ViewModels" x:Name="userControl" d:DesignHeight="400" d:DesignWidth="600" DataContext="{dxmvvm:ViewModelSource viewmodel:RATECollectionViewModelWrapper}" mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <converters:RateMaximumPercentageConverter x:Key="RateMaximumPercentageConverter" />
            <DataTemplate x:Key="PercentageCellTemplate" >
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="15" />
                        <ColumnDefinition Width="15" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0" Source="{dx:DXImage Image=First_16x16.png}" ToolTip="Minimum Possible %">
                        <Image.Visibility>
                            <MultiBinding Converter="{StaticResource NumericCompareToVisibilityConverter}" FallbackValue="Hidden">
                                <MultiBinding.ConverterParameter>
                                    <sys:Boolean>False</sys:Boolean>
                                </MultiBinding.ConverterParameter>
                                <Binding ElementName="PART_Editor" Path="MinValue" />
                                <Binding ElementName="PART_Editor" Path="EditValue" />
                            </MultiBinding>
                        </Image.Visibility>
                    </Image>
                    <Image Grid.Column="1" Source="{dx:DXImage Image=Last_16x16.png}" ToolTip="Maximum Possible %. Because total % must be added up to 100%">
                        <Image.Visibility>
                            <MultiBinding Converter="{StaticResource NumericCompareToVisibilityConverter}" FallbackValue="Hidden">
                                <MultiBinding.ConverterParameter>
                                    <sys:Boolean>False</sys:Boolean>
                                </MultiBinding.ConverterParameter>
                                <Binding ElementName="PART_Editor" Path="MaxValue" />
                                <Binding ElementName="PART_Editor" Path="EditValue" />
                            </MultiBinding>
                        </Image.Visibility>
                    </Image>
                    <dxe:SpinEdit Grid.Column="2" x:Name="PART_Editor" NullValueButtonPlacement="EditBox" Increment="0.1" MinValue="0" Mask="p0" MaskUseAsDisplayFormat="True" >
                        <dxe:SpinEdit.MaxValue>
                            <MultiBinding Converter="{StaticResource RateMaximumPercentageConverter}">
                                <Binding ElementName="PART_Editor" Path="EditValue" />
                                <Binding Path="RowData.Row" />
                                <Binding RelativeSource="{RelativeSource Mode=TemplatedParent}" />
                            </MultiBinding>
                        </dxe:SpinEdit.MaxValue>
                    </dxe:SpinEdit>
                </Grid>
            </DataTemplate>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BaseModel;component/View/ResourceDictionaries/DefaultControlResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/GridColumnResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/CustomControlResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/DefaultBluePrintsResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Style="{StaticResource CollectionView.RootContainer}">
        <dxb:BarManager>
            <dxb:BarManager.Items>
                <dxb:BarSubItem ItemLinksSource="{StaticResource RibbonDefaultGridButtons}" />
                <dxb:BarButtonItem x:Name="biRemoveDuplicates" Command="{Binding RemoveDuplicatesCommand}" Content="Remove Duplicates" Glyph="{dx:DXImage Image=Wizard_16x16.png}" LargeGlyph="{dxc:DXImage Image=Wizard_32x32.png}" ToolTip="Copy 2 columns from excel with the left being internal number and the right being client number, then paste it in here" />
            </dxb:BarManager.Items>
            <DockPanel>
                <dxr:RibbonControl Style="{StaticResource DefaultRibbonControlStyle}">
                    <dxr:RibbonDefaultPageCategory MergeType="Replace" Caption="defaultCategory">
                        <dxr:RibbonPage MergeType="Replace" Caption="Grid">
                            <dxr:RibbonPageGroup MergeType="Replace" Caption="Grid" >
                                <dxb:BarButtonItemLink BarItemName="biFullRefresh1" />
                                <dxb:BarButtonItemLink BarItemName="biBulkDelete1" />
                                <dxb:BarButtonItemLink BarItemName="biUndo1" />
                                <dxb:BarButtonItemLink BarItemName="biRedo1" />
                                <dxb:BarButtonItemLink BarItemName="biKeyboardCopy1"/>
                                <dxb:BarButtonItemLink BarItemName="biKeyboardPaste1" />
                                <dxb:BarCheckItemLink BarItemName="biCellSelection1" />
                                <dxb:BarButtonItemLink BarItemName="biSaveLayout1" />
                                <dxb:BarButtonItemLink BarItemName="biResetLayout1" />
                                <dxb:BarButtonItemLink BarItemName="biExpandAllGroups1" />
                                <dxb:BarButtonItemLink BarItemName="biCollapseAllGroups1" />
                                <dxb:BarButtonItemLink BarItemName="biExportToExcel1" />
                                <dxb:BarButtonItemLink BarItemName="biExportToPDF1" />
                            </dxr:RibbonPageGroup>
                            <dxr:RibbonPageGroup MergeType="Replace" Caption="Tools">
                                <dxb:BarButtonItemLink BarItemName="biRemoveDuplicates" />
                            </dxr:RibbonPageGroup>
                        </dxr:RibbonPage>
                    </dxr:RibbonDefaultPageCategory>
                </dxr:RibbonControl>
                <custom:GridControlEx x:Name="GridControl" dx:DXSerializer.SerializationID="GridControlRATE" dx:DXSerializer.StoreLayoutMode="All" Style="{StaticResource DefaultGridControlTemplate}">
                    <dxmvvm:Interaction.Behaviors>
                        <dxmvvm:EventToCommand Command="{Binding CustomColumnDisplayTextCommand}" EventName="CustomColumnDisplayText" MarkRoutedEventsAsHandled="True" PassEventArgsToCommand="True" />
                    </dxmvvm:Interaction.Behaviors>
                    <dxg:GridControl.Bands>
                        <dxg:GridControlBand Header="Default Columns">
                            <dxg:GridColumn FieldName="Phase_Type" Header="Phase Type" Visible="False" HeaderToolTip="Indicate which phase this rate belongs to">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings AutoComplete="True" IsTextEditable="True" ItemsSource="{dxe:EnumItemsSource EnumType={x:Type common:PhaseType}}" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="CHARGE_TYPE" Visible="False" Header="Charge Type" HeaderToolTip="Indicate whether rate will be used for direct or indirect">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings AutoComplete="True" IsTextEditable="True" ItemsSource="{dxe:EnumItemsSource EnumType={x:Type common:ChargeType}}" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="GUID_DISCIPLINE" Header="Discipline" HeaderToolTip="Which discipline the current rate will be applied to">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding DISCIPLINECollection}" NullValueButtonPlacement="EditBox" ValueMember="MappingEntityKey" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="GUID_DEPARTMENT" Header="Department" HeaderToolTip="Which department the current rate will be applied to">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding DEPARTMENTCollection}" NullValueButtonPlacement="EditBox" ValueMember="MappingEntityKey" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="COMMODITY_CODE" Header="Doc Type" HeaderToolTip="Which commodity the current rate will be applied to">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <custom:PopupBaseEditEx Name="PART_Editor" PopupMinWidth="600" ValueMember="Code" NullValueButtonPlacement="EditBox">
                                            <custom:PopupBaseEditEx.PopupContentTemplate>
                                                <ControlTemplate TargetType="ContentControl">
                                                    <dxg:GridControl x:Name="PART_GridControl" HorizontalAlignment="Right" Width="600" MaxHeight="750" ItemsSource="{Binding RowData.Row.ValidCommodityCodes}" SelectionMode="Row" ShowBorder="False">
                                                        <dxg:GridControl.Columns>
                                                            <dxg:GridColumn FieldName="Code" Header="Code" ReadOnly="True" />
                                                            <dxg:GridColumn FieldName="Description" Header="Description" ReadOnly="True" />
                                                        </dxg:GridControl.Columns>
                                                        <dxg:GridControl.View>
                                                            <dxg:TableView RowStyle="{StaticResource SelectionBackgroundStyle}" AutoWidth="True" ShowSearchPanelMode="Always" ShowFilterPanelMode="ShowAlways" ShowFocusedRectangle="True" ShowGroupPanel="False" ShowSelectionRectangle="True" />
                                                        </dxg:GridControl.View>
                                                    </dxg:GridControl>
                                                </ControlTemplate>
                                            </custom:PopupBaseEditEx.PopupContentTemplate>
                                        </custom:PopupBaseEditEx>
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="Code" IsTextEditable="True" ItemsSource="{Binding CombinedCommodityCodeCollection}" NullValueButtonPlacement="EditBox" ValueMember="Code" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="RATE1" Header="Charge Rate" HeaderToolTip="Charge rate per hour">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:SpinEditSettings Increment="10" Mask="n2" MaskType="Numeric" MaskUseAsDisplayFormat="True" MinValue="0" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="GUID_PHASE" Visible="False" Header="Phase (ReadOnly)" HeaderToolTip="Auto generated field to indicate which phase this rate belongs to" >
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="INTERNAL_NUM" IsTextEditable="True" ItemsSource="{Binding PHASECollection}" NullValueButtonPlacement="EditBox" ValueMember="GUID" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="IsUsingGangRate" Header="Is Gang Rate" HeaderToolTip="Auto checked field to indicate whether rate is derived from gang rate" Visible="False" ReadOnly="True" />
                        </dxg:GridControlBand>
                        <dxg:GridControlBand Header="Gang Rate Parameters (Fill in every columns in this section (Even 0% or 0 Rate) so that gang rate will be used. Row will be highlighted in green when gang rate is successfully applied)">
                            <dxg:GridColumn FieldName="MANAGER_RATE" Header="Manager Rate" HeaderToolTip="Charge rate for manager per hour" >
                                <dxg:GridColumn.EditSettings>
                                    <dxe:SpinEditSettings NullValueButtonPlacement="EditBox" MinValue="0" Increment="10" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="PRINCIPAL_RATE" Header="Principal Rate" HeaderToolTip="Charge rate for principal per hour" >
                                <dxg:GridColumn.EditSettings>
                                    <dxe:SpinEditSettings NullValueButtonPlacement="EditBox" MinValue="0" Increment="10" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="LEAD_RATE" Header="Lead Rate" HeaderToolTip="Charge rate for lead per hour" >
                                <dxg:GridColumn.EditSettings>
                                    <dxe:SpinEditSettings NullValueButtonPlacement="EditBox" MinValue="0" Increment="10" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="SENIOR_RATE" Header="Senior Rate" HeaderToolTip="Charge rate for senior per hour" >
                                <dxg:GridColumn.EditSettings>
                                    <dxe:SpinEditSettings NullValueButtonPlacement="EditBox" MinValue="0" Increment="10" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="ENGINEER_RATE" Header="Engineer Rate" HeaderToolTip="Charge rate for engineer per hour" >
                                <dxg:GridColumn.EditSettings>
                                    <dxe:SpinEditSettings NullValueButtonPlacement="EditBox" MinValue="0" Increment="10" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="GRADUATE_RATE" Header="Graduate Rate" HeaderToolTip="Charge rate for graduate per hour" >
                                <dxg:GridColumn.EditSettings>
                                    <dxe:SpinEditSettings NullValueButtonPlacement="EditBox" MinValue="0" Increment="10" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="UNDERGRADUATE_RATE" Header="Undergraduate Rate" HeaderToolTip="Charge rate for undergraduate per hour" >
                                <dxg:GridColumn.EditSettings>
                                    <dxe:SpinEditSettings NullValueButtonPlacement="EditBox" MinValue="0" Increment="10" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="MANAGER_PERCENT" MinWidth="100" Header="Manager %" HeaderToolTip="Rate weighting for manager" CellTemplate="{StaticResource PercentageCellTemplate}" />
                            <dxg:GridColumn FieldName="PRINCIPAL_PERCENT" MinWidth="100" Header="Principal %" HeaderToolTip="Rate weighting for principal" CellTemplate="{StaticResource PercentageCellTemplate}" />
                            <dxg:GridColumn FieldName="LEAD_PERCENT" MinWidth="100" Header="Lead %" HeaderToolTip="Rate weighting for lead" CellTemplate="{StaticResource PercentageCellTemplate}" />
                            <dxg:GridColumn FieldName="SENIOR_PERCENT" MinWidth="100" Header="Senior %" HeaderToolTip="Rate weighting for senior" CellTemplate="{StaticResource PercentageCellTemplate}" />
                            <dxg:GridColumn FieldName="ENGINEER_PERCENT" MinWidth="100" Header="Engineer %" HeaderToolTip="Rate weighting for engineer" CellTemplate="{StaticResource PercentageCellTemplate}" />
                            <dxg:GridColumn FieldName="GRADUATE_PERCENT" MinWidth="100" Header="Graduate %" HeaderToolTip="Rate weighting for graduate" CellTemplate="{StaticResource PercentageCellTemplate}" />
                            <dxg:GridColumn FieldName="UNDERGRADUATE_PERCENT" MinWidth="100" Header="Undergraduate %" HeaderToolTip="Rate weighting for undergraduate" CellTemplate="{StaticResource PercentageCellTemplate}" />
                            <dxg:GridColumn FieldName="UniqueConstraint" Visible="False" Header="Constraint" HeaderToolTip="Unique Constraints" />
                        </dxg:GridControlBand>
                    </dxg:GridControl.Bands>
                    <dxg:GridControl.TotalSummary>
                        <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" Alignment="Right" SummaryType="Count" />
                    </dxg:GridControl.TotalSummary>
                    <dxg:GridControl.GroupSummary>
                        <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" Alignment="Right" SummaryType="Count" />
                    </dxg:GridControl.GroupSummary>
                    <dxg:GridControl.View>
                        <dxg:TableView x:Name="tableView" Style="{StaticResource DefaultTableViewTemplate}" ScrollBarAnnotationMode="None">
                            <dxmvvm:Interaction.Behaviors>
                                <dxmvvm:EventToCommand Command="{Binding InitNewRowCommand}" EventName="InitNewRow" PassEventArgsToCommand="True" />
                            </dxmvvm:Interaction.Behaviors>
                            <dxg:TableView.RowCellMenuCustomizations>
                                <dxb:BarLinkContainerItem ItemLinksSource="{StaticResource ContextMenuDefaultHeaderButtons}" />
                                <dxb:BarItemLinkSeparator />
                                <dxb:BarButtonItemLink BarItemName="biBulkDelete1" />
                                <dxb:BarButtonItemLink BarItemName="biFullRefresh1" />
                            </dxg:TableView.RowCellMenuCustomizations>
                            <dxg:TableView.FormatConditions>
                                <dxg:FormatCondition Expression="[IsUsingGangRate] = 'True'" ApplyToRow="True" >
                                    <dxc:Format Background="LightGreen" />
                                </dxg:FormatCondition>
                                <dxg:UniqueDuplicateRuleFormatCondition FieldName="UniqueConstraint" ApplyToRow="True">
                                    <dxc:Format Background="#FFFF9B98" />
                                </dxg:UniqueDuplicateRuleFormatCondition>
                            </dxg:TableView.FormatConditions>
                        </dxg:TableView>
                    </dxg:GridControl.View>
                </custom:GridControlEx>
            </DockPanel>
        </dxb:BarManager>
    </Grid>
</UserControl>
