<UserControl x:Class="BluePrints.Views.CostRATECollectionView" xmlns:converters="clr-namespace:BluePrints.Common.ViewModel.Converters" xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:common="clr-namespace:BluePrints.Common" xmlns:custom="clr-namespace:BaseModel.Misc;assembly=BaseModel" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon" xmlns:dxrudex="http://schemas.devexpress.com/winfx/2008/xaml/reports/userdesignerextensions" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:view="clr-namespace:BluePrints.Views" xmlns:viewmodel="clr-namespace:BluePrints.ViewModels" x:Name="userControl" d:DesignHeight="400" d:DesignWidth="600" DataContext="{dxmvvm:ViewModelSource viewmodel:CostRATECollectionViewModelWrapper}" mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <converters:RateMaximumPercentageConverter x:Key="RateMaximumPercentageConverter" />
            <DataTemplate x:Key="PercentageCellTemplate" >
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="15" />
                        <ColumnDefinition Width="15" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0" Source="{dx:DXImage Image=First_16x16.png}" ToolTip="Minimum Possible %">
                        <Image.Visibility>
                            <MultiBinding Converter="{StaticResource NumericCompareToVisibilityConverter}" FallbackValue="Hidden">
                                <MultiBinding.ConverterParameter>
                                    <sys:Boolean>False</sys:Boolean>
                                </MultiBinding.ConverterParameter>
                                <Binding ElementName="PART_Editor" Path="MinValue" />
                                <Binding ElementName="PART_Editor" Path="EditValue" />
                            </MultiBinding>
                        </Image.Visibility>
                    </Image>
                    <Image Grid.Column="1" Source="{dx:DXImage Image=Last_16x16.png}" ToolTip="Maximum Possible %. Because total % must be added up to 100%">
                        <Image.Visibility>
                            <MultiBinding Converter="{StaticResource NumericCompareToVisibilityConverter}" FallbackValue="Hidden">
                                <MultiBinding.ConverterParameter>
                                    <sys:Boolean>False</sys:Boolean>
                                </MultiBinding.ConverterParameter>
                                <Binding ElementName="PART_Editor" Path="MaxValue" />
                                <Binding ElementName="PART_Editor" Path="EditValue" />
                            </MultiBinding>
                        </Image.Visibility>
                    </Image>
                    <dxe:SpinEdit Grid.Column="2" x:Name="PART_Editor" NullValueButtonPlacement="EditBox" Increment="0.1" MinValue="0" Mask="p0" MaskUseAsDisplayFormat="True" >
                        <dxe:SpinEdit.MaxValue>
                            <MultiBinding Converter="{StaticResource RateMaximumPercentageConverter}">
                                <Binding ElementName="PART_Editor" Path="EditValue" />
                                <Binding Path="RowData.Row" />
                                <Binding RelativeSource="{RelativeSource Mode=TemplatedParent}" />
                            </MultiBinding>
                        </dxe:SpinEdit.MaxValue>
                    </dxe:SpinEdit>
                </Grid>
            </DataTemplate>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BaseModel;component/View/ResourceDictionaries/DefaultControlResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/GridColumnResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/CustomControlResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/DefaultBluePrintsResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Style="{StaticResource CollectionView.RootContainer}">
        <dxb:BarManager>
            <dxb:BarManager.Items>
                <dxb:BarSubItem ItemLinksSource="{StaticResource RibbonDefaultGridButtons}" />
                <dxb:BarButtonItem x:Name="biUpdateFloating" Command="{Binding UpdateFloatingRatesCommand}" Content="Update Floating Rates" Glyph="{dxc:DXImage Images/Actions/ConvertToRange_16x16.png}" LargeGlyph="{dxc:DXImage Images/Actions/ConvertToRange_32x32.png}" ToolTip="Apply recommended rate to floating rates" />
                <dxb:BarButtonItem x:Name="biRemoveDuplicates" Command="{Binding RemoveDuplicatesCommand}" Content="Remove Duplicates" Glyph="{dx:DXImage Image=Wizard_16x16.png}" LargeGlyph="{dxc:DXImage Image=Wizard_32x32.png}" ToolTip="Copy 2 columns from excel with the left being internal number and the right being client number, then paste it in here" />
                <dxb:BarStaticItem x:Name="biLabel" LargeGlyph="{dxc:DXImage Images/Status/Warning_16x16.png}" Content="Rows Highlighted in Red Indicates Duplication" Glyph="{dxc:DXImage Images/Status/Warning_32x32.png}" />
            </dxb:BarManager.Items>
            <DockPanel>
                <dxr:RibbonControl Style="{StaticResource DefaultRibbonControlStyle}">
                    <dxr:RibbonDefaultPageCategory MergeType="Replace" Caption="defaultCategory">
                        <dxr:RibbonPage MergeType="Replace" Caption="Grid">
                            <dxr:RibbonPageGroup MergeType="Replace" Caption="Grid" >
                                <dxb:BarButtonItemLink BarItemName="biFullRefresh1" />
                                <dxb:BarButtonItemLink BarItemName="biBulkDelete1" />
                                <dxb:BarButtonItemLink BarItemName="biUndo1" />
                                <dxb:BarButtonItemLink BarItemName="biRedo1" />
                                <dxb:BarButtonItemLink BarItemName="biKeyboardCopy1"/>
                                <dxb:BarButtonItemLink BarItemName="biKeyboardPaste1" />
                                <dxb:BarCheckItemLink BarItemName="biCellSelection1" />
                                <dxb:BarButtonItemLink BarItemName="biSaveLayout1" />
                                <dxb:BarButtonItemLink BarItemName="biResetLayout1" />
                                <dxb:BarButtonItemLink BarItemName="biExpandAllGroups1" />
                                <dxb:BarButtonItemLink BarItemName="biCollapseAllGroups1" />
                                <dxb:BarButtonItemLink BarItemName="biExportToExcel1" />
                                <dxb:BarButtonItemLink BarItemName="biExportToPDF1" />
                                <dxb:BarItemLinkSeparator />
                                <dxb:BarButtonItemLink BarItemName="biUpdateFloating" />
                                <dxb:BarStaticItemLink BarItemName="biLabel" />
                            </dxr:RibbonPageGroup>
                            <dxr:RibbonPageGroup MergeType="Replace" Caption="Tools">
                                <dxb:BarButtonItemLink BarItemName="biRemoveDuplicates" />
                            </dxr:RibbonPageGroup>
                        </dxr:RibbonPage>
                    </dxr:RibbonDefaultPageCategory>
                </dxr:RibbonControl>
                <custom:GridControlEx x:Name="GridControl" dx:DXSerializer.SerializationID="GridControlRATE" dx:DXSerializer.StoreLayoutMode="All" Style="{StaticResource DefaultGridControlTemplate}">
                    <dxmvvm:Interaction.Behaviors>
                        <dxmvvm:EventToCommand Command="{Binding CustomColumnDisplayTextCommand}" EventName="CustomColumnDisplayText" MarkRoutedEventsAsHandled="True" PassEventArgsToCommand="True" />
                    </dxmvvm:Interaction.Behaviors>
                    <dxg:GridControl.Columns>
                        <dxg:GridColumn FieldName="Phase_Type" Visible="False" Header="Phase Type" HeaderToolTip="Indicate which phase this rate belongs to">
                            <dxg:GridColumn.EditSettings>
                                <dxe:ComboBoxEditSettings AutoComplete="True" IsTextEditable="True" ItemsSource="{dxe:EnumItemsSource EnumType={x:Type common:PhaseType}}" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="CHARGE_TYPE" Visible="False" Header="Charge Type" HeaderToolTip="Indicate whether rate will be used for direct or indirect" >
                            <dxg:GridColumn.EditSettings>
                                <dxe:ComboBoxEditSettings AutoComplete="True" IsTextEditable="True" ItemsSource="{dxe:EnumItemsSource EnumType={x:Type common:ChargeType}}" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="GUID_AREA" Width="100" Header="Area" HeaderToolTip="Which area the current rate will be applied to">
                            <dxg:GridColumn.EditSettings>
                                <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="INTERNAL_NUM" IsTextEditable="True" ItemsSource="{Binding AREACollection}" NullValueButtonPlacement="EditBox" ValueMember="GUID" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn AllowBestFit="false" Width="50" FieldName="GUID_SUBAREA" Header="Sub Area" HeaderToolTip="Which subarea the current rate will be applied to">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <dxe:ComboBoxEdit x:Name="PART_Editor" DisplayMember="INTERNAL_NUM" ImmediatePopup="True" IncrementalFiltering="True" ItemsSource="{Binding RowData.Row.SubAreaCollection}" NullValueButtonPlacement="EditBox" ValueMember="GUID" />
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                            <!--For Filtering-->
                            <dxg:GridColumn.EditSettings>
                                <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="INTERNAL_NUM" IsTextEditable="True" ItemsSource="{Binding SUBAREACollection}" ValueMember="GUID" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="GUID_DISCIPLINE" AllowBestFit="false" Width="100" Header="Discipline" HeaderToolTip="Which discipline the current rate will be applied to">
                            <dxg:GridColumn.EditSettings>
                                <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding DISCIPLINECollection}" NullValueButtonPlacement="EditBox" ValueMember="GUID" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="DISCIPLINE_NUM" AllowBestFit="false" Width="70" Header="Discipline Num" HeaderToolTip="Which discipline num the current rate will be applied to">
                            <dxg:GridColumn.EditSettings>
                                <dxe:SpinEditSettings Increment="1" IsFloatValue="False" IsTextEditable="True" Mask="n0" MaskType="Numeric" MaskUseAsDisplayFormat="True" MaxValue="99" NullValueButtonPlacement="EditBox"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="GUID_DEPARTMENT" Visible="{Binding IsDepartmentVisible}" Header="Department" HeaderToolTip="Which department the current rate will be applied to">
                            <dxg:GridColumn.EditSettings>
                                <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding DEPARTMENTCollection}" NullValueButtonPlacement="EditBox" ValueMember="MappingEntityKey" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="COMMODITY_CODE" Width="70" Header="Commodity" HeaderToolTip="Which commodity the current rate will be applied to">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <custom:PopupBaseEditEx Name="PART_Editor" ValueMember="Code" PopupMinWidth="600" NullValueButtonPlacement="EditBox">
                                        <custom:PopupBaseEditEx.PopupContentTemplate>
                                            <ControlTemplate TargetType="ContentControl">
                                                <dxg:GridControl x:Name="PART_GridControl" HorizontalAlignment="Right" Width="600" MaxHeight="750" ItemsSource="{Binding RowData.Row.ValidCommodityCodes}" SelectionMode="Row" ShowBorder="False">
                                                    <dxg:GridControl.Columns>
                                                        <dxg:GridColumn FieldName="Code" Header="Code" ReadOnly="True" />
                                                        <dxg:GridColumn FieldName="Name" Header="Name" ReadOnly="True" />
                                                        <dxg:GridColumn FieldName="Description" Header="Description" ReadOnly="True" />
                                                    </dxg:GridControl.Columns>
                                                    <dxg:GridControl.View>
                                                        <dxg:TableView RowStyle="{StaticResource SelectionBackgroundStyle}" AutoWidth="True" ShowSearchPanelMode="Always" ShowFilterPanelMode="ShowAlways" ShowFocusedRectangle="True" ShowGroupPanel="False" ShowSelectionRectangle="True" />
                                                    </dxg:GridControl.View>
                                                </dxg:GridControl>
                                            </ControlTemplate>
                                        </custom:PopupBaseEditEx.PopupContentTemplate>
                                    </custom:PopupBaseEditEx>
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                            <dxg:GridColumn.EditSettings>
                                <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="Code" IsTextEditable="True" ItemsSource="{Binding CombinedCommodityCodeCollection}" NullValueButtonPlacement="EditBox" ValueMember="Code" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="VARIATION_CODE" Width="100" Header="Variation Code" Visible="{Binding IsVariationCodeVisible}" HeaderToolTip="Which variation code the current rate will be applied to">
                            <dxg:GridColumn.EditSettings>
                                <dxe:ComboBoxEditSettings IsTextEditable="True" ItemsSource="{Binding VariationCodeCollection}" NullValueButtonPlacement="EditBox" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="RATE1" Width="90" Header="Cost Rate" HeaderToolTip="Cost rate per hour">
                            <dxg:GridColumn.EditSettings>
                                <dxe:SpinEditSettings Increment="10" Mask="c2" MaskType="Numeric" MaskUseAsDisplayFormat="True" MinValue="0" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn ReadOnly="True" FieldName="RecommendedRate" Header="Recommended Rate" AllowBestFit="false" Width="90" HeaderToolTip="Recommended rate scrapped from transactions">
                            <dxg:GridColumn.EditSettings>
                                <dxe:SpinEditSettings Mask="c2" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn ReadOnly="True" FieldName="TransactionCount" AllowBestFit="false" Width="70" Header="Transaction Count" HeaderToolTip="Number of transactions recommended rate was derived from">
                            <dxg:GridColumn.EditSettings>
                                <dxe:SpinEditSettings Mask="n0" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn Header="Transaction" HeaderToolTip="Show the transactions which the recommended rate were derived">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <dxg:LookUpEdit Name="PART_Editor" NullText="Expand to Inspect" AutoComplete="True" PopupMinWidth="600" NullValueButtonPlacement="Popup" AutoPopulateColumns="False" IsTextEditable="true" ItemsSource="{Binding RowData.Row.Transactions}" >
                                        <dxg:LookUpEdit.StyleSettings>
                                            <dxg:SearchLookUpEditStyleSettings />
                                        </dxg:LookUpEdit.StyleSettings>
                                        <dxg:LookUpEdit.PopupContentTemplate>
                                            <ControlTemplate TargetType="ContentControl">
                                                <dxg:GridControl x:Name="PART_GridControl" SelectionMode="Row" ShowBorder="False">
                                                    <dxg:GridControl.Columns>
                                                        <dxg:GridColumn FieldName="Description" Width="300" Header="Description" ReadOnly="True" />
                                                        <dxg:GridColumn FieldName="ActualDate" SortIndex="1" SortOrder="Descending" Width="100" Header="Date" ReadOnly="True" />
                                                        <dxg:GridColumn FieldName="CostPerQty" Width="150" Header="Rate" ReadOnly="True" >
                                                            <dxg:GridColumn.EditSettings>
                                                                <dxe:SpinEditSettings Mask="c2" MaskUseAsDisplayFormat="True" MaskType="Numeric" />
                                                            </dxg:GridColumn.EditSettings>
                                                        </dxg:GridColumn>
                                                    </dxg:GridControl.Columns>
                                                    <dxg:GridControl.View>
                                                        <dxg:TableView AutoWidth="False" RowStyle="{StaticResource SelectionBackgroundStyle}" ShowFocusedRectangle="True" ShowGroupPanel="True" ShowSearchPanelMode="Always" ShowSearchPanelNavigationButtons="True" ShowSelectionRectangle="True" />
                                                    </dxg:GridControl.View>
                                                </dxg:GridControl>
                                            </ControlTemplate>
                                        </dxg:LookUpEdit.PopupContentTemplate>
                                    </dxg:LookUpEdit>
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                            <dxg:GridColumn.EditSettings>
                                <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding DISCIPLINECollection}" NullValueButtonPlacement="EditBox" ValueMember="GUID" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="IsRateExists" Width="50" Header="Active" HeaderToolTip="Whether rate is in use" />
                        <dxg:GridColumn FieldName="IS_FLOATING" Width="50" Header="Floating" HeaderToolTip="Whether recommended rate will be bulk edited by update recommended rate button" />
                    </dxg:GridControl.Columns>
                    <dxg:GridControl.TotalSummary>
                        <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" Alignment="Right" SummaryType="Count" />
                    </dxg:GridControl.TotalSummary>
                    <dxg:GridControl.GroupSummary>
                        <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" Alignment="Right" SummaryType="Count" />
                    </dxg:GridControl.GroupSummary>
                    <dxg:GridControl.View>
                        <dxg:TableView x:Name="tableView" Style="{StaticResource DefaultTableViewTemplate}">
                            <dxmvvm:Interaction.Behaviors>
                                <dxmvvm:EventToCommand Command="{Binding InitNewRowCommand}" EventName="InitNewRow" PassEventArgsToCommand="True" />
                            </dxmvvm:Interaction.Behaviors>
                            <dxg:TableView.RowCellMenuCustomizations>
                                <dxb:BarLinkContainerItem ItemLinksSource="{StaticResource ContextMenuDefaultHeaderButtons}" />
                                <dxb:BarItemLinkSeparator />
                                <dxb:BarButtonItemLink BarItemName="biUpdateFloating" />
                                <dxb:BarItemLinkSeparator />
                                <dxb:BarButtonItemLink BarItemName="biBulkDelete1" />
                                <dxb:BarButtonItemLink BarItemName="biFullRefresh1" />
                            </dxg:TableView.RowCellMenuCustomizations>
                            <dxg:TableView.FormatConditions>
                                <dxg:UniqueDuplicateRuleFormatCondition FieldName="UniqueConstraint" ApplyToRow="True">
                                    <dxc:Format Background="#FFFF9B98" />
                                </dxg:UniqueDuplicateRuleFormatCondition>
                            </dxg:TableView.FormatConditions>
                        </dxg:TableView>
                    </dxg:GridControl.View>
                </custom:GridControlEx>
            </DockPanel>
        </dxb:BarManager>
    </Grid>
</UserControl>
