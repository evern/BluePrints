<UserControl
    x:Name="userControl"
    x:Class="BluePrints.Views.WORKPACKCollectionView"
    xmlns:view="clr-namespace:BluePrints.Views"
    xmlns="http://schemas.microsoft.com/netfx/2009/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon"
    xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
    xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
    xmlns:dxrudex="http://schemas.devexpress.com/winfx/2008/xaml/reports/userdesignerextensions"
    xmlns:viewmodel="clr-namespace:BluePrints.ViewModels"
    xmlns:custom="clr-namespace:BaseModel.Misc;assembly=BaseModel"
    xmlns:common="clr-namespace:BluePrints.Common"
    mc:Ignorable="d" d:DesignHeight="400" d:DesignWidth="600"
    DataContext="{dxmvvm:ViewModelSource viewmodel:WORKPACKCollectionViewModelWrapper}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                                <ResourceDictionary Source="pack://application:,,,/BaseModel;component/View/ResourceDictionaries/DefaultControlResourceDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Style="{StaticResource CollectionView.RootContainer}">
        <Grid DataContext="{Binding MainViewModel}">
            <DockPanel>
                <dxr:RibbonControl RibbonStyle="Office2010" DockPanel.Dock="Top" AllowCustomization="False"
                                   MDIMergeStyle="Always">
                    <dxr:RibbonDefaultPageCategory Caption="defaultCategory">
                        <dxr:RibbonPage Caption="Home">
                            <dxr:RibbonPageGroup Caption="WORKPACK Tasks">
                                <dxb:BarButtonItem Content="Delete Row" Command="{Binding BulkDeleteCommand}"
                                                   LargeGlyph="{dx:DXImage Image=Delete_32x32.png}"
                                                   Glyph="{dx:DXImage Image=Delete_16x16.png}" />
                                <dxb:BarButtonItem Content="Refresh" Command="{Binding DataContext.FullRefreshCommand, ElementName=userControl}"
                                                   LargeGlyph="{dx:DXImage Image=Refresh_32x32.png}"
                                                   Glyph="{dx:DXImage Image=Refresh_16x16.png}" />
                                <dxb:BarButtonItem Content="Undo" Command="{Binding UndoCommand}"
                                                   LargeGlyph="{dx:DXImage Image=Undo_32x32.png}"
                                                   Glyph="{dx:DXImage Image=Undo_16x16.png}" />
                                <dxb:BarButtonItem Content="Redo" Command="{Binding RedoCommand}"
                                                   LargeGlyph="{dx:DXImage Image=Redo_32x32.png}"
                                                   Glyph="{dx:DXImage Image=Redo_16x16.png}" />
                                <dxb:BarButtonItem Content="Save Layout"
                                                   Command="{Binding DataContext.SaveLayoutCommand, ElementName=userControl}"
                                                   LargeGlyph="{dx:DXImage Image=Save_32x32.png}"
                                                   Glyph="{dx:DXImage Image=Save_16x16.png}" />
                                <dxb:BarButtonItem Content="Reset Layout"
                                                   Command="{Binding DataContext.ResetLayoutCommand, ElementName=userControl}"
                                                   LargeGlyph="{dx:DXImage Image=SaveAndClose_32x32.png}"
                                                   Glyph="{dx:DXImage Image=SaveAndClose_16x16.png}" />
                                <dxb:BarCheckItem Content="Cell Selection" IsChecked="{Binding IsPasteCellLevel, Mode=TwoWay}" Glyph="{dx:DXImage Image=SplitTableCells_16x16.png}" LargeGlyph="{dx:DXImage Image=SplitTableCells_32x32.png}" />
                            </dxr:RibbonPageGroup>
                        </dxr:RibbonPage>
                    </dxr:RibbonDefaultPageCategory>
                </dxr:RibbonControl>
                <dxr:RibbonStatusBarControl DockPanel.Dock="Bottom">
                    <dxr:RibbonStatusBarControl.LeftItems>
                        <dxb:BarStaticItem
                            Content="{Binding Entities.Count, Converter={dxmvvm:FormatStringConverter FormatString='RECORDS: {0}'}}" />
                    </dxr:RibbonStatusBarControl.LeftItems>
                </dxr:RibbonStatusBarControl>
                <Grid>
                    <dxmvvm:Interaction.Behaviors>
                        <dxmvvm:LayoutSerializationService />
                    </dxmvvm:Interaction.Behaviors>
                    <custom:GridControlEx x:Name="GridControl" dx:DXSerializer.SerializationID="GridControlWORKPACK" dx:DXSerializer.StoreLayoutMode="All" Style="{StaticResource DefaultGridControlTemplate}">
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn Header="PHASE" FieldName="Entity.GUID_DPHASE">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings ItemsSource="{Binding DataContext.PHASECollection, ElementName=userControl}"
                                          IsTextEditable="True" AutoComplete="True" DisplayMember="INTERNAL_NUM"
                                          ValueMember="GUID" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="AREA" FieldName="Entity.GUID_DAREA">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings ItemsSource="{Binding DataContext.AREACollection, ElementName=userControl}"
                                          IsTextEditable="True" AutoComplete="True" DisplayMember="INTERNAL_NUM"
                                          ValueMember="GUID" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Name="colSUBAREA" FieldName="Entity.SubAreaGuid" Header="SUBAREA" ColumnFilterMode="DisplayText">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <dxe:ComboBoxEdit 
                                                  x:Name="PART_Editor"
                                                  ItemsSource="{Binding RowData.Row.Entity.SubAreaCollection}"
                                                  DisplayMember="INTERNAL_NUM" 
                                                  ValueMember="GUID"
                                                  ValidateOnTextInput="True"
                                                  ValidateOnEnterKeyPressed="True"
                                                  IncrementalFiltering="True"
                                                  NullValueButtonPlacement="Popup"
                                                  ImmediatePopup="True">
                                        </dxe:ComboBoxEdit>
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                                <!--For Filtering-->
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings NullValueButtonPlacement="EditBox"
                                                              ItemsSource="{Binding DataContext.SUBAREACollection, ElementName=userControl}"
                                                              IsTextEditable="True" AutoComplete="True"
                                                              DisplayMember="INTERNAL_NUM" ValueMember="GUID" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn x:Name="colINTERNAL_NAME" Header="INTERNAL NAME" FieldName="Entity.INTERNAL_NAME1" />
                            <dxg:GridColumn Header="DESCRIPTION" FieldName="Entity.INTERNAL_NAME2" />
                            <dxg:GridColumn Header="COMMENTS" FieldName="Entity.COMMENTS" />
                            <dxg:GridColumn Header="START DATE" FieldName="Entity.STARTDATE">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:DateEditSettings MinValue="1753-01-01" MaxValue="12/31/9999 23:59:59" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="END DATE" FieldName="Entity.ENDDATE">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:DateEditSettings MinValue="1753-01-01" MaxValue="12/31/9999 23:59:59" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="REVIEW START DATE" FieldName="Entity.REVIEWSTARTDATE">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:DateEditSettings MinValue="1753-01-01" MaxValue="12/31/9999 23:59:59" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="REVIEW END DATE" FieldName="Entity.REVIEWENDDATE">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:DateEditSettings MinValue="1753-01-01" MaxValue="12/31/9999 23:59:59" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="FORECAST START DATE" FieldName="Entity.FORECASTSTARTDATE">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:DateEditSettings MinValue="1753-01-01" MaxValue="12/31/9999 23:59:59" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="FORECAST END DATE" FieldName="Entity.FORECASTENDDATE">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:DateEditSettings MinValue="1753-01-01" MaxValue="12/31/9999 23:59:59" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="AUTO GENERATED" FieldName="Entity.AUTOGENERATED" ReadOnly="True" />
                            <dxg:GridColumn FieldName="Estimated_Units" ReadOnly="True"/>
                            <dxg:GridColumn FieldName="Total_Units" ReadOnly="True"/>
                            <dxg:GridColumn FieldName="Estimated_Costs" ReadOnly="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings MaskType="Numeric" Mask="c" MaskUseAsDisplayFormat="True" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Total_Costs" ReadOnly="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings MaskType="Numeric" Mask="c" MaskUseAsDisplayFormat="True" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                        </dxg:GridControl.Columns>
                        <dxg:GridControl.TotalSummary>
                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" FieldName="Estimated_Units"
                                                 SummaryType="Sum" DisplayFormat="Total: {0:n}" />
                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" FieldName="Estimated_Costs"
                                                 SummaryType="Sum" DisplayFormat="Total: {0:c2}" />
                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" SummaryType="Count" Alignment="Right" />
                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" FieldName="Total_Units"
                                                 SummaryType="Sum" DisplayFormat="Total: {0:n}" />
                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" FieldName="Total_Costs"
                                                 SummaryType="Sum" DisplayFormat="Total: {0:c2}" />
                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" SummaryType="Count" Alignment="Right" />
                        </dxg:GridControl.TotalSummary>
                        <dxg:GridControl.GroupSummary>
                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" FieldName="Estimated_Units"
                                                 SummaryType="Sum" DisplayFormat="Total: {0:n}" />
                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" FieldName="Estimated_Costs"
                                                 SummaryType="Sum" DisplayFormat="Total: {0:c2}" />
                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" SummaryType="Count" Alignment="Right" />
                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" FieldName="Total_Units"
                                                 SummaryType="Sum" DisplayFormat="Total: {0:n}" />
                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" FieldName="Total_Costs"
                                                 SummaryType="Sum" DisplayFormat="Total: {0:c2}" />
                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" SummaryType="Count" Alignment="Right" />
                        </dxg:GridControl.GroupSummary>
                        <dxg:GridControl.View>
                            <dxg:TableView x:Name="tableView" Style="{StaticResource DefaultTableViewTemplate}" ShowGridMenu="tableView_ShowGridMenu">
                                <dxmvvm:Interaction.Behaviors>
                                    <dxmvvm:EventToCommand PassEventArgsToCommand="True"
                                                           Command="{Binding DataContext.CellValueChangedCommand, ElementName=userControl}"
                                                           EventName="CellValueChanged" />
                                </dxmvvm:Interaction.Behaviors>
                                <dxg:TableView.RowCellMenuCustomizations>
                                    <dxb:BarButtonItem Content="Copy With Headers" Command="{Binding DataContext.CopyWithHeaderCommand, ElementName=userControl}" Glyph="{dx:DXImageOffice2013 Image=AlignHorizontalTop_16x16.png}" />
                                    <dxb:BarButtonItem Content="Bulk Edit"
                                                       Command="{Binding View.DataContext.BulkColumnEditCommand}"
                                                       CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                                                       Glyph="{dx:DXImageOffice2013 Image=CustomizeGrid_16x16.png}" />
                                    <dxb:BarButtonItem Content="Fill Up"
                                                       Glyph="{dx:DXImageOffice2013 Image=MoveUp_16x16.png}"
                                                       Command="{Binding View.DataContext.FillUpCommand}"
                                                       CommandParameter="{Binding RelativeSource={RelativeSource Self}}" />
                                    <dxb:BarButtonItem Content="Fill Down"
                                                       Glyph="{dx:DXImageOffice2013 Image=MoveDown_16x16.png}"
                                                       Command="{Binding View.DataContext.FillDownCommand}"
                                                       CommandParameter="{Binding RelativeSource={RelativeSource Self}}" />
                                    <dxb:BarButtonItem Name="contextMenuPopulate" Content="Populate"
                                                       Glyph="{dx:DXImageOffice2013 Image=PictureShapeFillColor_16x16.png}"
                                                       Command="{Binding DataContext.AutoPopulateCommand, ElementName=userControl}"
                                                       CommandParameter="{Binding RelativeSource={RelativeSource Self}}" />
                                    <dxb:BarButtonItem x:Name="contextMenuDuplicate" Content="Duplicate"
                                                       Command="{Binding DataContext.DuplicateCommand, ElementName=userControl}"
                                                       Glyph="{dx:DXImageOffice2013 Image=Paste_16x16.png}" />
                                    <dxb:BarSubItem x:Name="contextMenuDuplicateMulti" Content="Duplicate Multiple"
                                                    Glyph="{dx:DXImageOffice2013 Image=Parameters_16x16.png}">
                                        <dxb:BarEditItem x:Name="contextMenuDuplicateMultiCount" Content="Count"
                                                         EditValue="2">
                                            <dxb:BarEditItem.EditSettings>
                                                <dxe:SpinEditSettings IsTextEditable="True" IsFloatValue="False"
                                                                      Increment="1" MinValue="2" MaxValue="99"
                                                                      MaskType="Numeric" Mask="n0"
                                                                      MaskUseAsDisplayFormat="True">
                                                    <dxe:SpinEditSettings.Buttons>
                                                        <dxe:ButtonInfo x:Name="contextMenuPasteMultiCountBtn"
                                                                        GlyphKind="Apply">
                                                            <dxmvvm:Interaction.Behaviors>
                                                                <dxmvvm:EventToCommand
                                                                    Command="{Binding DataContext.DuplicateMultipleCommand, ElementName=userControl}"
                                                                    CommandParameter="{Binding ElementName=contextMenuDuplicateMultiCount}"
                                                                    EventName="Click" />
                                                            </dxmvvm:Interaction.Behaviors>
                                                        </dxe:ButtonInfo>
                                                    </dxe:SpinEditSettings.Buttons>
                                                </dxe:SpinEditSettings>
                                            </dxb:BarEditItem.EditSettings>
                                        </dxb:BarEditItem>
                                    </dxb:BarSubItem>
                                    <dxb:BarButtonItem Content="Delete Row"
                                                       Command="{Binding View.DataContext.BulkDeleteCommand}"
                                                       CommandParameter="{Binding View.DataContext.SelectedEntities}"
                                                       Glyph="{dx:DXImage Image=Delete_16x16.png}" />
                                    <dxb:BarButtonItem Content="Refresh"
                                                       Command="{Binding DataContext.FullRefreshCommand, ElementName=userControl}"
                                                       Glyph="{dx:DXImage Image=Refresh_16x16.png}" />
                                </dxg:TableView.RowCellMenuCustomizations>
                            </dxg:TableView>
                        </dxg:GridControl.View>
                    </custom:GridControlEx>
                </Grid>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
