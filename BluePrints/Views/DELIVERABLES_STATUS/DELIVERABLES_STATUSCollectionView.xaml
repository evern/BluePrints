<UserControl x:Name="userControl" x:Class="BluePrints.Views.DELIVERABLES_STATUSCollectionView" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:custom="clr-namespace:BaseModel.Misc;assembly=BaseModel" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon" xmlns:dxrudex="http://schemas.devexpress.com/winfx/2008/xaml/reports/userdesignerextensions" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:viewmodel="clr-namespace:BluePrints.ViewModels" d:DesignHeight="400" d:DesignWidth="600" DataContext="{dxmvvm:ViewModelSource viewmodel:DELIVERABLES_STATUSCollectionViewModelWrapper}" mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BaseModel;component/View/ResourceDictionaries/DefaultControlResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/DefaultBluePrintsResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Style="{StaticResource CollectionView.RootContainer}">
        <dxb:BarManager>
            <dxb:BarManager.Items>
                <dxb:BarSubItem ItemLinksSource="{StaticResource RibbonDefaultGridButtons}" />
                <dxb:BarButtonItem x:Name="biCopyFrom" Content="Copy From" ToolTip="Copy statuses from other project" Command="{Binding CopyFromCommand}" LargeGlyph="{dx:DXImage Image=Copy_32x32.png}" Glyph="{dx:DXImageOffice2013 Image=Copy_16x16.png}" />
                <dxb:BarButtonItem x:Name="biInsertStatus" Content="Insert" ToolTip="Insert new status below currently selected status." Command="{Binding InsertCommand}" Glyph="{dx:DXImageOffice2013 Image=Paste_16x16.png}" />
            </dxb:BarManager.Items>
            <DockPanel>
                <dxr:RibbonControl Style="{StaticResource DefaultRibbonControlStyle}">
                    <dxr:RibbonDefaultPageCategory MergeType="Replace" Caption="defaultCategory">
                        <dxr:RibbonPage MergeType="Replace" Caption="Grid">
                            <dxr:RibbonPageGroup MergeType="Replace" Caption="Grid" >
                                <dxb:BarButtonItemLink BarItemName="biFullRefresh1" />
                                <dxb:BarButtonItemLink BarItemName="biBulkDelete1" />
                                <dxb:BarButtonItemLink BarItemName="biUndo1" />
                                <dxb:BarButtonItemLink BarItemName="biRedo1" />
                                <dxb:BarButtonItemLink BarItemName="biKeyboardCopy1"/>
                                <dxb:BarButtonItemLink BarItemName="biKeyboardPaste1" />
                                <dxb:BarCheckItemLink BarItemName="biCellSelection1" />
                                <dxb:BarButtonItemLink BarItemName="biSaveLayout1" />
                                <dxb:BarButtonItemLink BarItemName="biResetLayout1" />
                                <dxb:BarButtonItemLink BarItemName="biExpandAllGroups1" />
                                <dxb:BarButtonItemLink BarItemName="biCollapseAllGroups1" />
                                <dxb:BarButtonItemLink BarItemName="biExportToExcel1" />
                                <dxb:BarButtonItemLink BarItemName="biExportToPDF1" />
                            </dxr:RibbonPageGroup>
                            <dxr:RibbonPageGroup MergeType="Replace" Caption="Tools" >
                                <dxb:BarButtonItemLink BarItemName="biInsertStatus" />
                                <dxb:BarButtonItemLink BarItemName="biCopyFrom" />
                            </dxr:RibbonPageGroup>
                        </dxr:RibbonPage>
                    </dxr:RibbonDefaultPageCategory>
                </dxr:RibbonControl>
                <Grid>
                    <dxmvvm:Interaction.Behaviors>
                        <dxmvvm:LayoutSerializationService />
                    </dxmvvm:Interaction.Behaviors>
                    <custom:GridControlEx x:Name="GridControl" dxc:DXSerializer.SerializationID="GridControlDELIVERABLE_STATUS" dxc:DXSerializer.StoreLayoutMode="All" Style="{StaticResource DefaultGridControlTemplate}">
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn Header="Name" FieldName="NAME" Width="200" AllowBestFit="False" HeaderToolTip="Name of the status" />
                            <dxg:GridColumn FieldName="GUID_PHASE" Header="Phase" Width="170" AllowBestFit="False" HeaderToolTip="Leave empty to apply to all phases">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings AutoComplete="True" NullValueButtonPlacement="EditBox" NullText="Leave empty to apply to all" DisplayMember="INTERNAL_NUM" IsTextEditable="True" ItemsSource="{Binding PHASECollection}" ValueMember="GUID" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Document Types" Width="*" AllowBestFit="False" SortMode="DisplayText" FieldName="MultipleAssignedDocTypeObject" HeaderToolTip="Document types which status can be chosen from" SortIndex="1">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings
                                                ItemsSource="{Binding DOCTYPECollection}"
                                                DisplayMember="NAME" 
                                                ValidateOnTextInput="True"
                                                ValidateOnEnterKeyPressed="True"
                                                IncrementalFiltering="True"
                                                AllowDefaultButton="True"
                                                ImmediatePopup="True">
                                        <dxe:ComboBoxEditSettings.StyleSettings>
                                            <dxe:CheckedTokenComboBoxStyleSettings NewTokenPosition="Far" EnableTokenWrapping="True" ShowTokenButtons="True" AllowEditTokens="False" />
                                        </dxe:ComboBoxEditSettings.StyleSettings>
                                    </dxe:ComboBoxEditSettings>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Auto Percentage" FieldName="AUTO_PERCENTAGE" HeaderToolTip="Percentage that will be automatically assigned when status is assigned in progress" SortIndex="2">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <dxe:SpinEdit Name="PART_Editor" Increment="0.1" Mask="p0" MaskType="Numeric" MaskUseAsDisplayFormat="True" MaxValue="1" MinValue="0" />
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                                <!--For Filtering-->
                                <dxg:GridColumn.EditSettings>
                                    <dxe:SpinEditSettings Mask="p0" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Maximum Percentage" FieldName="MAX_PERCENTAGE" HeaderToolTip="Maximum allowed percentage for this status" SortIndex="2">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:SpinEditSettings Increment="0.1" Mask="p0" MaskType="Numeric" MaskUseAsDisplayFormat="True" MaxValue="1" MinValue="0" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Deliverable" FieldName="FOR_NCR" HeaderToolTip="Can this status be chosen for deliverable type of 'Deliverable'?" />
                            <dxg:GridColumn Header="Deliverable ICR" FieldName="FOR_DELIVERABLE" HeaderToolTip="Can this status be chosen for deliverable type of 'Deliverable ICR'?" />
                            <dxg:GridColumn Header="Task" FieldName="FOR_TASK" HeaderToolTip="Can this status be chosen for deliverable type of 'Task'?" />
                            <dxg:GridColumn Header="Non Deliverable" FieldName="FOR_NONDELIVERABLE" HeaderToolTip="Can this status be chosen for deliverable type of 'Non Deliverable'?" />
                        </dxg:GridControl.Columns>
                        <dxg:GridControl.TotalSummary>
                            <dxg:GridSummaryItem dxc:DXSerializer.Enabled="False" Alignment="Right" SummaryType="Count" />
                        </dxg:GridControl.TotalSummary>
                        <dxg:GridControl.GroupSummary>
                            <dxg:GridSummaryItem dxc:DXSerializer.Enabled="False" SummaryType="Count" />
                        </dxg:GridControl.GroupSummary>
                        <dxg:GridControl.View>
                            <dxg:TableView x:Name="tableView" Style="{StaticResource DefaultTableViewTemplate}">
                                <dxg:TableView.RowCellMenuCustomizations>
                                    <dxb:BarLinkContainerItem ItemLinksSource="{StaticResource ContextMenuDefaultHeaderButtons}" />
                                    <dxb:BarItemLinkSeparator />
                                    <dxb:BarButtonItemLink BarItemName="biInsertStatus" />
                                    <dxb:BarItemLinkSeparator />
                                    <dxb:BarButtonItemLink BarItemName="biBulkDelete1" />
                                    <dxb:BarButtonItemLink BarItemName="biFullRefresh1" />
                                </dxg:TableView.RowCellMenuCustomizations>
                            </dxg:TableView>
                        </dxg:GridControl.View>
                    </custom:GridControlEx>
                </Grid>
            </DockPanel>
        </dxb:BarManager>
    </Grid>
</UserControl>
