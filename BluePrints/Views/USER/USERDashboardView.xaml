<UserControl x:Name="userControl" x:Class="BluePrints.Views.USERDashboardView"
             xmlns="http://schemas.microsoft.com/netfx/2009/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/charts"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxrudex="http://schemas.devexpress.com/winfx/2008/xaml/reports/userdesignerextensions"
             xmlns:viewmodel="clr-namespace:BluePrints.ViewModels"
             xmlns:common="clr-namespace:BluePrints.Common"
             xmlns:converter="clr-namespace:BluePrints.Common.ViewModel.Converters"
             mc:Ignorable="d" d:DesignHeight="1200" d:DesignWidth="1200"
             DataContext="{dxmvvm:ViewModelSource viewmodel:USERDashboardViewModelWrapper}">
    <UserControl.Resources>
        <ResourceDictionary>
            <dxmvvm:BooleanNegationConverter x:Key="BooleanNegationConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/DefaultControlResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/ChartResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <dxmvvm:Interaction.Behaviors>
        <dx:DialogService x:Name="IssuesDialogService">
            <dx:DialogService.DialogStyle>
                <Style TargetType="dx:DXDialogWindow">
                    <Setter Property="SizeToContent" Value="WidthAndHeight" />
                </Style>
            </dx:DialogService.DialogStyle>
        </dx:DialogService>
        <dx:DXMessageBoxService />
        <!--<dxmvvm:EventToCommand Event="Loaded" Command="{Binding OnLoadedCommand}" />-->
        <dx:WindowedDocumentUIService YieldToParent="True" />
    </dxmvvm:Interaction.Behaviors>
    <Grid dx:DXSerializer.StoreLayoutMode="UI">
        <dxmvvm:Interaction.Behaviors>
            <dxmvvm:LayoutSerializationService />
        </dxmvvm:Interaction.Behaviors>
        <Grid DataContext="{Binding MainViewModel}" dx:DXSerializer.StoreLayoutMode="UI">
            <DockPanel>
                <dxr:RibbonControl RibbonStyle="OfficeSlim" DockPanel.Dock="Top" AllowCustomization="False"
                                   MDIMergeStyle="Always">
                    <dxr:RibbonDefaultPageCategory Caption="defaultCategory">
                        <dxr:RibbonPage Caption="Home">
                            <dxr:RibbonPageGroup Caption="USER Tasks">
                                <dxb:BarCheckItem x:Name="biCheckUnits" Content="Units"
                                                  Command="{Binding DataContext.ChangeStatsTypeCommand, ElementName=userControl}"
                                                  CommandParameter="{Binding Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                  Glyph="{dx:DXImageOffice2013 Image=Time_16x16.png}"
                                                  LargeGlyph="{dx:DXImageOffice2013 Image=Time_32x32.png}"
                                                  IsChecked="True" />
                                <dxb:BarCheckItem x:Name="biCheckCosts" Content="Costs"
                                                  Command="{Binding DataContext.ChangeStatsTypeCommand, ElementName=userControl}"
                                                  CommandParameter="{Binding Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                                  Glyph="{dx:DXImageOffice2013 Image=Currency_32x32.png}"
                                                  LargeGlyph="{dx:DXImageOffice2013 Image=Currency_32x32.png}"
                                                  IsChecked="{Binding ElementName=biCheckUnits, Path=IsChecked, Converter={StaticResource BooleanNegationConverter}}" />
                                <dxb:BarButtonItem Content="Refresh" Command="{Binding DataContext.FullRefreshCommand, ElementName=userControl}"
                                                   LargeGlyph="{dx:DXImage Image=Refresh_32x32.png}"
                                                   Glyph="{dx:DXImageOffice2013 Image=Refresh_16x16.png}" />
                                <!--<dxb:BarCheckItem Content="Auto Refresh"
                                                  IsChecked="{Binding DataContext.DoNotAutoRefresh, ElementName=userControl, Converter={dxmvvm:BooleanNegationConverter}}"
                                                  Glyph="{dx:DXImageOffice2013 Image=Refresh_16x16.png}" />-->
                                <dxb:BarButtonItem Content="P6 Issues"
                                               Command="{Binding DataContext.ShowP6ErrorsCommand, ElementName=userControl}"
                                               LargeGlyph="{dx:DXImage Image=BugReport_32x32.png}"
                                               Glyph="{dx:DXImageOffice2013 Image=BugReport_16x16.png}" />
                                <dxb:BarButtonItem Content="Exo Issues"
                                               Command="{Binding DataContext.ShowExoErrorsCommand, ElementName=userControl}"
                                               LargeGlyph="{dx:DXImage Image=BugReport_32x32.png}"
                                               Glyph="{dx:DXImageOffice2013 Image=BugReport_16x16.png}" />
                            </dxr:RibbonPageGroup>
                        </dxr:RibbonPage>
                    </dxr:RibbonDefaultPageCategory>
                </dxr:RibbonControl>
                <dxr:RibbonStatusBarControl DockPanel.Dock="Bottom">
                    <dxr:RibbonStatusBarControl.LeftItems>
                        <dxb:BarStaticItem
                            Content="{Binding DataContext.DisplayEntities.Count, ElementName=userControl, Converter={dxmvvm:FormatStringConverter FormatString='RECORDS: {0}'}}" />
                    </dxr:RibbonStatusBarControl.LeftItems>
                </dxr:RibbonStatusBarControl>
                <dxlc:LayoutControl Orientation="Vertical">
                    <dxmvvm:Interaction.Behaviors>
                        <dxmvvm:LayoutSerializationService />
                    </dxmvvm:Interaction.Behaviors>
                    <dxlc:LayoutGroup Name="LayoutGroupGrid" View="Group" Header="Edit Value" Orientation="Vertical"
                                      dxlc:LayoutControl.AllowVerticalSizing="True">
                        <dxg:GridControl Name="gridControl" dx:DXSerializer.SerializationID="USER_DashboardGrid"
                                         Style="{StaticResource DefaultGridControlTemplate}" >
                            <dxmvvm:Interaction.Behaviors>
                                <dxmvvm:EventToCommand PassEventArgsToCommand="True"
                                                       Command="{Binding DataContext.EditCommand, ElementName=userControl}"
                                                       EventName="MouseDoubleClick" MarkRoutedEventsAsHandled="True">
                                    <dxmvvm:EventToCommand.EventArgsConverter>
                                        <dx:EventArgsToDataRowConverter />
                                    </dxmvvm:EventToCommand.EventArgsConverter>
                                </dxmvvm:EventToCommand>
                            </dxmvvm:Interaction.Behaviors>
                            <dxg:GridControl.Bands>
                                <dxg:GridControlBand Name="bandProject" Header="PROJECT">
                                    <dxg:GridColumn Header="Number" FieldName="Entity.NUMBER" VisibleIndex="0" />
                                    <dxg:GridColumn Header="Name" FieldName="Entity.NAME" VisibleIndex="10" />
                                    <dxg:GridColumn Header="Client" FieldName="Entity.CLIENT" VisibleIndex="20" />
                                    <dxg:GridColumn Header="Contract Type" FieldName="Entity.CONTRACTTYPE"
                                                    VisibleIndex="40">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:ComboBoxEditSettings IsTextEditable="True" AutoComplete="True"
                                                                      ItemsSource="{dxe:EnumItemsSource EnumType={x:Type common:ContractType}}" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Design Manager" FieldName="Entity.DESIGNMANAGER"
                                                    VisibleIndex="60">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:ComboBoxEditSettings IsTextEditable="True" AutoComplete="True"
                                                                      ItemsSource="{dxe:EnumItemsSource EnumType={x:Type common:DesignManager}}" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                </dxg:GridControlBand>
                                <dxg:GridControlBand Name="bandDeliverable" Header="DELIVERABLE">
                                    <dxg:GridColumn Name="colWORKPACKInternalName1" FieldName="PROGRESS_ITEMProjection.Entity.Entity.GUID_WORKPACK"
                                            Header="WORKPACK" VisibleIndex="10">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:ComboBoxEditSettings 
                                                              ItemsSource="{Binding DataContext.WORKPACKCollection, ElementName=userControl}"
                                                              IsTextEditable="True" AutoComplete="True"
                                                              DisplayMember="INTERNAL_NAME1" ValueMember="GUID" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Header="Number" FieldName="PROGRESS_ITEMProjection.Entity.Entity.INTERNAL_NUM" MinWidth="150" VisibleIndex="20" />
                                    <dxg:GridColumn Header="Primary Title" FieldName="PROGRESS_ITEMProjection.Entity.Entity.PRIMARY_TITLE" MinWidth="150" VisibleIndex="30" />
                                    <dxg:GridColumn Header="Secondary Title" FieldName="PROGRESS_ITEMProjection.Entity.Entity.SECONDARY_TITLE" VisibleIndex="40" />
                                    <dxg:GridColumn Header="Comments" FieldName="PROGRESS_ITEMProjection.Entity.Entity.COMMENTS" VisibleIndex="50" />
                                    <dxg:GridColumn Header="Status" FieldName="PROGRESS_ITEMProjection.Entity.Entity.GUID_STATUS" VisibleIndex="60" >
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:ComboBoxEditSettings NullValueButtonPlacement="EditBox"
                                                              ItemsSource="{Binding DataContext.DELIVERABLES_STATUSCollection, ElementName=userControl}"
                                                              IsTextEditable="True" AutoComplete="True"
                                                              DisplayMember="NAME" ValueMember="GUID" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn x:Name="colCumulativeBudget" Header="Total Units"
                                                    FieldName="Stats.BudgetedUnits" ReadOnly="True"
                                                    AllowEditing="False" VisibleIndex="70">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings Name="colCumulativeBudgetText" MaskType="Numeric"
                                                                  Mask="n" MaskUseAsDisplayFormat="True" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                </dxg:GridControlBand>
                                <dxg:GridControlBand Name="bandCumulative" Header="Cumulative">
                                    <dxg:GridColumn x:Name="colCumulativePlannedPercentage" Header="Planned %"
                                                    FieldName="PROGRESS_ITEMProjection.Stats.Budgeted.CurrentPeriodCumulativeDataPoint.UnitsPercentage"
                                                    ReadOnly="True" AllowEditing="False" VisibleIndex="10">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings MaskType="Numeric" Mask="p2"
                                                                  MaskUseAsDisplayFormat="True" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn x:Name="colCumulativeEarnedPercentage" Header="Earned %"
                                                    FieldName="PROGRESS_ITEMProjection.Stats.Earned.CurrentPeriodCumulativeDataPoint.UnitsPercentage"
                                                    ReadOnly="True" AllowEditing="False" VisibleIndex="20">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings MaskType="Numeric" Mask="p2"
                                                                  MaskUseAsDisplayFormat="True" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn x:Name="colCumulativePlanned" Header="Planned Units"
                                                    FieldName="PROGRESS_ITEMProjection.Stats.Budgeted.CurrentPeriodCumulativeDataPoint.Units" ReadOnly="True"
                                                    AllowEditing="False" VisibleIndex="30">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings Name="colCumulativePlannedText" MaskType="Numeric"
                                                                  Mask="n" MaskUseAsDisplayFormat="True" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn x:Name="colCumulativeEarned" Header="Earned Units"
                                                    FieldName="PROGRESS_ITEMProjection.Stats.Earned.CurrentPeriodCumulativeDataPoint.Units" ReadOnly="True"
                                                    AllowEditing="False" VisibleIndex="40">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings Name="colCumulativeEarnedText" MaskType="Numeric"
                                                                  Mask="n" MaskUseAsDisplayFormat="True" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                </dxg:GridControlBand>
                                <dxg:GridControlBand Name="bandPeriod" Header="Period">
                                    <dxg:GridColumn x:Name="colPeriodPlannedPercentage" Header="Planned %"
                                                    FieldName="PROGRESS_ITEMProjection.Stats.Budget.CurrentPeriodDataPoint.UnitsPercentage" ReadOnly="True"
                                                    AllowEditing="False" VisibleIndex="10">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings MaskType="Numeric" Mask="p2"
                                                                  MaskUseAsDisplayFormat="True" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn x:Name="colPeriodEarnedPercentage" Header="Earned %"
                                                    FieldName="PROGRESS_ITEMProjection.Stats.Earned.CurrentPeriodDataPoint.UnitsPercentage" ReadOnly="True"
                                                    AllowEditing="False" VisibleIndex="20">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings MaskType="Numeric" Mask="p2"
                                                                  MaskUseAsDisplayFormat="True" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn x:Name="colPeriodPlanned" Header="Planned Units"
                                                    FieldName="PROGRESS_ITEMProjection.Stats.Budgeted.CurrentPeriodDataPoint.Units" ReadOnly="True"
                                                    AllowEditing="False" VisibleIndex="30">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings Name="colPeriodPlannedText" MaskType="Numeric"
                                                                  Mask="n" MaskUseAsDisplayFormat="True" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn x:Name="colPeriodEarned" Header="Earned Units"
                                                    FieldName="PROGRESS_ITEMProjection.Stats.Earned.CurrentPeriodDataPoint.Units" ReadOnly="True"
                                                    AllowEditing="False" VisibleIndex="40">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings Name="colPeriodEarnedText" MaskType="Numeric"
                                                                  Mask="n" MaskUseAsDisplayFormat="True" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                </dxg:GridControlBand>
                                <dxg:GridControlBand Name="bandPerformance" Header="Performance">
                                    <dxg:GridColumn x:Name="colUnitsProgressRatio" Header="Units Progress Ratio %"
                                                    FieldName="UnitsProgressRatio" ReadOnly="True" AllowEditing="False" MinWidth="130"
                                                    VisibleIndex="10">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings MaskType="Numeric" Mask="p2"
                                                                  MaskUseAsDisplayFormat="True" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn x:Name="colCostsProgressRatio" Header="Costs Progress Ratio %"
                                                    FieldName="CostsProgressRatio" ReadOnly="True" AllowEditing="False" MinWidth="130"
                                                    VisibleIndex="20">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings MaskType="Numeric" Mask="p2"
                                                                  MaskUseAsDisplayFormat="True" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                </dxg:GridControlBand>
                            </dxg:GridControl.Bands>
                            <dxg:GridControl.GroupSummary>
                                <dxg:GridSummaryItem x:Name="groupSummaryBudgeted"
                                                     ShowInColumn="PROGRESS_ITEMProjection.Stats.Budgeted.CurrentPeriodCumulativeDataPoint.Units"
                                                     FieldName="PROGRESS_ITEMProjection.Stats.Budgeted.CurrentPeriodCumulativeDataPoint.Units" SummaryType="Sum"
                                                     DisplayFormat="{}{0:n}" />
                                <dxg:GridSummaryItem x:Name="groupSummaryCumulativeEarned"
                                                     ShowInColumn="PROGRESS_ITEMProjection.Stats.Earned.CurrentPeriodCumulativeDataPoint.Units"
                                                     FieldName="PROGRESS_ITEMProjection.Stats.Earned.CurrentPeriodCumulativeDataPoint.Units"
                                                     SummaryType="Sum" DisplayFormat="{}{0:n}" />
                                <dxg:GridSummaryItem x:Name="groupSummaryPeriodPlanned"
                                                     ShowInColumn="PROGRESS_ITEMProjection.Stats.Budgeted.CurrentPeriodDataPoint.Units"
                                                     FieldName="PROGRESS_ITEMProjection.Stats.Budgeted.CurrentPeriodDataPoint.Units"
                                                     SummaryType="Sum" DisplayFormat="{}{0:n}" />
                                <dxg:GridSummaryItem x:Name="groupSummaryPeriodEarned"
                                                     ShowInColumn="PROGRESS_ITEMProjection.Stats.Earned.CurrentPeriodDataPoint.Units"
                                                     FieldName="PROGRESS_ITEMProjection.Stats.Earned.CurrentPeriodDataPoint.Units"
                                                     SummaryType="Sum" DisplayFormat="{}{0:n}" />
                            </dxg:GridControl.GroupSummary>
                            <dxg:GridControl.TotalSummary>
                                <dxg:GridSummaryItem x:Name="totalSummaryBudgeted"
                                                     ShowInColumn="PROGRESS_ITEMProjection.Stats.Budgeted.CurrentPeriodCumulativeDataPoint.Units"
                                                     FieldName="PROGRESS_ITEMProjection.Stats.Budgeted.CurrentPeriodCumulativeDataPoint.Units" SummaryType="Sum"
                                                     DisplayFormat="{}{0:n}" />
                                <dxg:GridSummaryItem x:Name="totalSummaryCumulativeEarned"
                                                     ShowInColumn="PROGRESS_ITEMProjection.Stats.Earned.CurrentPeriodCumulativeDataPoint.Units"
                                                     FieldName="PROGRESS_ITEMProjection.Stats.Earned.CurrentPeriodCumulativeDataPoint.Units"
                                                     SummaryType="Sum" DisplayFormat="{}{0:n}" />
                                <dxg:GridSummaryItem x:Name="totalSummaryPeriodPlanned"
                                                     ShowInColumn="PROGRESS_ITEMProjection.Stats.Budgeted.CurrentPeriodDataPoint.Units"
                                                     FieldName="PROGRESS_ITEMProjection.Stats.Budgeted.CurrentPeriodDataPoint.Units"
                                                     SummaryType="Sum" DisplayFormat="{}{0:n}" />
                                <dxg:GridSummaryItem x:Name="totalSummaryPeriodEarned"
                                                     ShowInColumn="PROGRESS_ITEMProjection.Stats.Earned.CurrentPeriodDataPoint.Units"
                                                     FieldName="PROGRESS_ITEMProjection.Stats.Earned.CurrentPeriodDataPoint.Units"
                                                     SummaryType="Sum" DisplayFormat="{}{0:n}" />
                            </dxg:GridControl.TotalSummary>
                            <dxg:GridControl.View>
                                <common:TableViewEx x:Name="tableView" AllowEditing="False" UseLightweightTemplates="{x:Null}"
                                               Style="{StaticResource DefaultTableViewTemplate}"
                                               NewItemRowPosition="None" >
                                    <common:TableViewEx.RowCellMenuCustomizations>
                                        <dxb:BarButtonItem Content="Workpacks"
                                                           Command="{Binding View.DataContext.EditCommand}"
                                                           CommandParameter="{Binding Row.Row}"
                                                           Glyph="{dx:DXImage Image=Line_32x32.png}" />
                                        <dxb:BarButtonItem Content="Refresh"
                                                           Command="{Binding DataContext.FullRefreshCommand, ElementName=userControl}"
                                                           Glyph="{dx:DXImage Image=Refresh_16x16.png}" />
                                    </common:TableViewEx.RowCellMenuCustomizations>
                                    <!--<common:TableViewEx.FormatConditions>
                                        <dxg:FormatCondition
                                            Expression="[Stats.Earned.CurrentPeriodCumulativeDataPoint.Units] / [Stats.Planned.CurrentPeriodCumulativeDataPoint.Units] &lt; 0.8"
                                            FieldName="Stats.Earned.CurrentPeriodCumulativeDataPoint.UnitsPercentage">
                                            <dx:Format Background="#FFFF9B98" />
                                        </dxg:FormatCondition>
                                        <dxg:FormatCondition
                                            Expression="[Stats.Earned.CurrentPeriodCumulativeDataPoint.Units] / [Stats.Planned.CurrentPeriodCumulativeDataPoint.Units] &gt;= 0.8 And [Stats.Earned.CurrentPeriodCumulativeDataPoint.Units] / [Stats.Planned.CurrentPeriodCumulativeDataPoint.Units] &lt; 1"
                                            FieldName="Stats.Earned.CurrentPeriodCumulativeDataPoint.UnitsPercentage">
                                            <dx:Format Background="#FFFFD400" />
                                        </dxg:FormatCondition>
                                        <dxg:FormatCondition
                                            Expression="[Stats.Earned.CurrentPeriodCumulativeDataPoint.Units] / [Stats.Planned.CurrentPeriodCumulativeDataPoint.Units] &gt; 1"
                                            FieldName="Stats.Earned.CurrentPeriodCumulativeDataPoint.UnitsPercentage">
                                            <dx:Format Background="LightGreen" />
                                        </dxg:FormatCondition>
                                        <dxg:FormatCondition
                                            Expression="[Stats.Earned.CurrentPeriodDataPoint.Units] / [Stats.Budgeted.CurrentPeriodDataPoint.Units] &lt; 0.8"
                                            FieldName="Stats.Earned.CurrentPeriodDataPoint.UnitsPercentage">
                                            <dx:Format Background="#FFFF9B98" />
                                        </dxg:FormatCondition>
                                        <dxg:FormatCondition
                                            Expression="[Stats.Earned.CurrentPeriodDataPoint.Units] / [Stats.Budgeted.CurrentPeriodDataPoint.Units] &gt;= 0.8 And [Stats.Earned.CurrentPeriodDataPoint.Units] / [Stats.Budgeted.CurrentPeriodDataPoint.Units] &lt; 1"
                                            FieldName="Stats.Earned.CurrentPeriodDataPoint.UnitsPercentage">
                                            <dx:Format Background="#FFFFD400" />
                                        </dxg:FormatCondition>
                                        <dxg:FormatCondition
                                            Expression="[Stats.Earned.CurrentPeriodDataPoint.Units] / [Stats.Budgeted.CurrentPeriodDataPoint.Units] &gt; 1"
                                            FieldName="Stats.Earned.CurrentPeriodDataPoint.UnitsPercentage">
                                            <dx:Format Background="LightGreen" />
                                        </dxg:FormatCondition>
                                    </common:TableViewEx.FormatConditions>-->
                                </common:TableViewEx>
                            </dxg:GridControl.View>
                        </dxg:GridControl>
                    </dxlc:LayoutGroup>
                    <dxlc:LayoutGroup Name="LayoutGroupChart"
                                      DataContext="{Binding DataContext, ElementName=userControl, Mode=OneWay, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"
                                      View="Group" Orientation="Vertical">
                        <dxc:ChartControl Name="chartSCurve" Padding="0" Margin="0" dx:DXSerializer.Enabled="False">
                            <dxc:ChartControl.Diagram>
                                <dxc:XYDiagram2D>
                                    <dxc:XYDiagram2D.AxisX>
                                        <dxc:AxisX2D>
                                            <dxc:AxisX2D.Label>
                                                <dxc:AxisLabel>
                                                    <dxc:Axis2D.ResolveOverlappingOptions>
                                                        <dxc:AxisLabelResolveOverlappingOptions />
                                                    </dxc:Axis2D.ResolveOverlappingOptions>
                                                </dxc:AxisLabel>
                                            </dxc:AxisX2D.Label>
                                        </dxc:AxisX2D>
                                    </dxc:XYDiagram2D.AxisX>
                                    <dxc:XYDiagram2D.AxisY>
                                        <dxc:AxisY2D x:Name="primaryAxisY">
                                            <dxc:AxisY2D.Title>
                                                <dxc:AxisTitle Content="Units % Complete" />
                                            </dxc:AxisY2D.Title>
                                            <dxc:AxisY2D.Label>
                                                <dxc:AxisLabel TextPattern="{}{V:0%}" />
                                            </dxc:AxisY2D.Label>
                                        </dxc:AxisY2D>
                                    </dxc:XYDiagram2D.AxisY>
                                    <dxc:XYDiagram2D.SecondaryAxesY>
                                        <dxc:SecondaryAxisY2D x:Name="secondaryAxisY">
                                            <dxc:SecondaryAxisY2D.Title>
                                                <dxc:AxisTitle Content="Total Units" />
                                            </dxc:SecondaryAxisY2D.Title>
                                        </dxc:SecondaryAxisY2D>
                                    </dxc:XYDiagram2D.SecondaryAxesY>
                                    <dxc:XYDiagram2D.Series>
                                        <dxc:BarSideBySideSeries2D Name="barSeriesOriginal"
                                                                   DisplayName="Baseline Planned Units"
                                                                   Style="{StaticResource DefaultBarSideBySideSeries2DTemplate}"
                                                                   Brush="Brown"
                                                                   DataSource="{Binding SummaryEntity.Stats.Budgeted.DataPoints, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}" />
                                        <dxc:BarSideBySideSeries2D Name="barSeriesPlanned"
                                                                   DisplayName="Current Planned Units"
                                                                   Style="{StaticResource DefaultBarSideBySideSeries2DTemplate}"
                                                                   Brush="Blue"
                                                                   DataSource="{Binding SummaryEntity.Stats.Current.DataPoints, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}" />
                                        <dxc:BarSideBySideSeries2D Name="barSeriesEarned" DisplayName="Earned Units"
                                                                   Style="{StaticResource DefaultBarSideBySideSeries2DTemplate}"
                                                                   Brush="Green"
                                                                   DataSource="{Binding SummaryEntity.Stats.Earned.DataPoints, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}" />
                                        <dxc:BarSideBySideSeries2D Name="barSeriesRemainingPlanned"
                                                                   DisplayName="Remaining Units"
                                                                   Style="{StaticResource DefaultBarSideBySideSeries2DTemplate}"
                                                                   Brush="Indigo"
                                                                   DataSource="{Binding SummaryEntity.Stats.Remaining.DataPoints, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}" />
                                        <dxc:BarSideBySideSeries2D Name="barSeriesBurned" DisplayName="Burned Units"
                                                                   Style="{StaticResource DefaultBarSideBySideSeries2DTemplate}"
                                                                   Brush="Red"
                                                                   DataSource="{Binding SummaryEntity.Stats.Burned.DataPoints, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}" />
                                        <dxc:BarSideBySideSeries2D Name="barSeriesActual" DisplayName="Actual Units"
                                                                   Style="{StaticResource DefaultBarSideBySideSeries2DTemplate}"
                                                                   Brush="#FFFFA200"
                                                                   DataSource="{Binding SummaryEntity.Stats.Actual.DataPoints, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}" />
                                        <dxc:LineSeries2D Name="lineSeriesOriginal"
                                                          DisplayName="Baseline Planned Units %"
                                                          Style="{StaticResource DefaultLineSeries2DTemplate}"
                                                          Brush="Brown"
                                                          DataSource="{Binding SummaryEntity.Stats.Budgeted.CumulativeDataPoints}" />
                                        <dxc:LineSeries2D Name="lineSeriesPlanned"
                                                          DisplayName="Current Planned Units %"
                                                          Style="{StaticResource DefaultLineSeries2DTemplate}"
                                                          Brush="Blue"
                                                          DataSource="{Binding SummaryEntity.Stats.Current.CumulativeDataPoints}" />
                                        <dxc:LineSeries2D Name="lineSeriesRemainingPlanned"
                                                          DisplayName="Remaining Units %"
                                                          Style="{StaticResource DefaultLineSeries2DTemplate}"
                                                          Brush="Indigo"
                                                          DataSource="{Binding SummaryEntity.Stats.Remaining.CumulativeDataPoints}" />
                                        <dxc:LineSeries2D Name="lineSeriesEarned" DisplayName="Earned Units %"
                                                          Style="{StaticResource DefaultLineSeries2DTemplate}"
                                                          Brush="Green"
                                                          DataSource="{Binding SummaryEntity.Stats.Earned.CumulativeDataPoints}" />
                                        <dxc:LineSeries2D Name="lineSeriesBurned" DisplayName="Burned Units %"
                                                          Style="{StaticResource DefaultLineSeries2DTemplate}"
                                                          Brush="Red"
                                                          DataSource="{Binding SummaryEntity.Stats.Burned.CumulativeDataPoints, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}" />
                                        <dxc:LineSeries2D Name="lineSeriesActual" DisplayName="Actual Units %"
                                                          Style="{StaticResource DefaultLineSeries2DTemplate}"
                                                          Brush="Red"
                                                          DataSource="{Binding SummaryEntity.Stats.Actual.CumulativeDataPoints, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}" />
                                    </dxc:XYDiagram2D.Series>
                                </dxc:XYDiagram2D>
                            </dxc:ChartControl.Diagram>
                        </dxc:ChartControl>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutControl>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>