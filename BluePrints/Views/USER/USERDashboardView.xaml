<UserControl x:Class="BluePrints.Views.USERDashboardView" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:common="clr-namespace:BluePrints.Common" xmlns:converter="clr-namespace:BluePrints.Common.ViewModel.Converters" xmlns:custom="clr-namespace:BaseModel.Misc;assembly=BaseModel" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/charts" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon" xmlns:dxrudex="http://schemas.devexpress.com/winfx/2008/xaml/reports/userdesignerextensions" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:viewmodel="clr-namespace:BluePrints.ViewModels" x:Name="userControl" d:DesignHeight="1200" d:DesignWidth="1200" DataContext="{dxmvvm:ViewModelSource viewmodel:USERDashboardViewModelWrapper}" mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <dxmvvm:BooleanNegationConverter x:Key="BooleanNegationConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BaseModel;component/View/ResourceDictionaries/DefaultControlResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/ChartResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/GridColumnResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/CustomControlResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/DefaultBluePrintsResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Style="{StaticResource CollectionView.RootContainer}">
        <Grid Style="{StaticResource DashboardView.RootContainer}">
            <Grid DataContext="{Binding MainViewModel}">
                <dxb:BarManager>
                    <dxb:BarManager.Items>
                        <dxb:BarButtonItem x:Name="biCheckUnits" Command="{Binding DataContext.ChangeStatsTypeCommand, ElementName=userControl}" CommandParameter="{Binding Mode=OneWay, RelativeSource={RelativeSource Self}}" Content="Units" Glyph="{dx:DXImageOffice2013 Image=Time_16x16.png}" LargeGlyph="{dx:DXImageOffice2013 Image=Time_32x32.png}" ToolTip="S-Curve shows by units" />
                        <dxb:BarButtonItem x:Name="biCheckCosts" Command="{Binding DataContext.ChangeStatsTypeCommand, ElementName=userControl}" CommandParameter="{Binding Mode=OneWay, RelativeSource={RelativeSource Self}}" Content="Costs" Glyph="{dx:DXImageOffice2013 Image=Currency_32x32.png}" LargeGlyph="{dx:DXImageOffice2013 Image=Currency_32x32.png}" ToolTip="S-Curve shows by costs" />
                        <dxb:BarButtonItem x:Name="biCheckQty" Command="{Binding DataContext.ChangeStatsTypeCommand, ElementName=userControl}" CommandParameter="{Binding Mode=OneWay, RelativeSource={RelativeSource Self}}" Content="Qty" Glyph="{dx:DXImage Image=Number_16x16.png}" LargeGlyph="{dx:DXImage Image=Number_32x32.png}" ToolTip="S-Curve shows by quantity" />
                        <dxb:BarButtonItem x:Name="biRefreshFromP6" Command="{Binding DataContext.Refresh_From_P6Command, ElementName=userControl}" Content="Calculate Stats" Glyph="{dx:DXImage Image=Reset2_16x16.png}" LargeGlyph="{dx:DXImage Image=Reset2_32x32.png}" ToolTip="Recalculate stats from P6. Must be performed after pressing F9 in P6" />
                        <dxb:BarButtonItem x:Name="biShowP6Error" Command="{Binding DataContext.ShowP6ErrorsCommand, ElementName=userControl}" Content="P6 Issues" Glyph="{dx:DXImageOffice2013 Image=BugReport_16x16.png}" LargeGlyph="{dx:DXImage Image=BugReport_32x32.png}" ToolTip="Shows any invalid mappings because activity isn't found on P6" />
                        <dxb:BarButtonItem x:Name="biShowExoError" Command="{Binding DataContext.ShowExoErrorsCommand, ElementName=userControl}" Content="Exo Issues" Glyph="{dx:DXImageOffice2013 Image=BugReport_16x16.png}" LargeGlyph="{dx:DXImage Image=BugReport_32x32.png}" ToolTip="Shows any subjobs in exo that isn't available in blueprints" />
                    </dxb:BarManager.Items>
                    <DockPanel>
                        <dxr:RibbonControl Style="{StaticResource DefaultRibbonControlStyle}">
                            <dxr:RibbonDefaultPageCategory MergeType="Replace" Caption="defaultCategory">
                                <dxr:RibbonPage MergeType="Replace" Caption="Grid">
                                    <dxr:RibbonPageGroup MergeType="Replace" Caption="Tools">
                                        <dxb:BarButtonItemLink BarItemName="biCheckUnits" />
                                        <dxb:BarButtonItemLink BarItemName="biCheckCosts" />
                                        <dxb:BarButtonItemLink BarItemName="biCheckQty" />
                                        <dxb:BarButtonItemLink BarItemName="biRefreshFromP6" />
                                        <dxb:BarButtonItemLink BarItemName="biShowP6Error" />
                                        <dxb:BarButtonItemLink BarItemName="biShowExoError" />
                                    </dxr:RibbonPageGroup>
                                </dxr:RibbonPage>
                            </dxr:RibbonDefaultPageCategory>
                        </dxr:RibbonControl>
                        <dxr:RibbonStatusBarControl DockPanel.Dock="Bottom">
                            <dxr:RibbonStatusBarControl.LeftItems>
                                <dxb:BarStaticItem Content="{Binding DataContext.DisplayEntities.Count, ElementName=userControl, Converter={dxmvvm:FormatStringConverter FormatString='RECORDS: {0}'}}" />
                            </dxr:RibbonStatusBarControl.LeftItems>
                        </dxr:RibbonStatusBarControl>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="0" />
                            </Grid.RowDefinitions>
                            <custom:GridControlEx x:Name="GridControlExcelExport" Grid.Row="0" dx:DXSerializer.Enabled="False" ItemsSource="{Binding DataContext.ExcelExportData, ElementName=userControl}" Visibility="Collapsed">
                                <dxg:GridControl.Columns>
                                    <dxg:GridColumn FieldName="Type" ReadOnly="True" />
                                    <dxg:GridColumn FieldName="Subjob_Name" ReadOnly="True" />
                                    <dxg:GridColumn FieldName="Department_Name" ReadOnly="True" />
                                    <dxg:GridColumn FieldName="Discipline_Name" ReadOnly="True" />
                                    <dxg:GridColumn FieldName="Commodity_Code" ReadOnly="True" />
                                    <dxg:GridColumn FieldName="Data_Date" ReadOnly="True" />
                                    <dxg:GridColumn FieldName="Units" ReadOnly="True" />
                                    <dxg:GridColumn FieldName="Costs" ReadOnly="True" />
                                    <dxg:GridColumn FieldName="Actual_Costs" ReadOnly="True" />
                                </dxg:GridControl.Columns>
                                <dxg:GridControl.View>
                                    <!--  need to set tableView name here for export to work  -->
                                    <dxg:TableView Name="tableView" />
                                </dxg:GridControl.View>
                            </custom:GridControlEx>
                        </Grid>
                        <dxlc:LayoutControl Orientation="Vertical">
                            <dxmvvm:Interaction.Behaviors>
                                <dxmvvm:LayoutSerializationService />
                            </dxmvvm:Interaction.Behaviors>
                            <dxlc:LayoutGroup Header="Edit Value" Name="LayoutGroupGrid" Height="500" dxlc:LayoutControl.AllowVerticalSizing="True" Orientation="Vertical" View="Group">
                                <custom:GridControlEx x:Name="GridControl" dx:DXSerializer.SerializationID="GridControlUserDashboard" dx:DXSerializer.StoreLayoutMode="All" IsFilterEnabled="False" SelectedItems="{Binding DataContext.Selected_Dashboards, Mode=TwoWay, ElementName=userControl}" Style="{StaticResource DefaultGridControlTemplate}">
                                    <dxg:GridControl.Bands>
                                        <dxg:GridControlBand Header="General">
                                            <dxg:GridColumn Header="Subjob" FieldName="Entity.Entity.SUBJOB.INTERNAL_NAME1" ReadOnly="True" />
                                            <dxg:GridColumn Header="Area" FieldName="Entity.Entity.AREA.INTERNAL_NUM" ReadOnly="True" />
                                            <dxg:GridColumn Header="Subarea" FieldName="Entity.Entity.AREA1.INTERNAL_NUM" ReadOnly="True" ColumnFilterMode="DisplayText" />
                                            <dxg:GridColumn Header="Document Type" FieldName="Entity.Entity.DOCTYPE.NAME" ReadOnly="True" />
                                            <dxg:GridColumn Header="Discipline" FieldName="Entity.Entity.DISCIPLINE.NAME" ReadOnly="True" />
                                            <dxg:GridColumn Header="Department" FieldName="Entity.Entity.DEPARTMENT.NAME" ReadOnly="True" />
                                            <dxg:GridColumn Header="Internal Number" FieldName="Entity.Entity.INTERNAL_NUM" ReadOnly="True" IsEnabled="False" />
                                            <dxg:GridColumn Header="Deliverable Type" FieldName="Entity.Entity.DELIVERABLE_TYPE" ReadOnly="True" IsEnabled="False" />
                                            <dxg:GridColumn Header="Primary Title" FieldName="Entity.Entity.PRIMARY_TITLE" ReadOnly="True" IsEnabled="False" />
                                            <dxg:GridColumn Header="Secondary Title" FieldName="Entity.Entity.SECONDARY_TITLE" ReadOnly="True" IsEnabled="False" />
                                        </dxg:GridControlBand>
                                        <dxg:GridControlBand Header="Cumulative">
                                            <dxg:GridColumn Header="Earned %" FieldName="{Binding DataContext.Cumulative_Current_Earned_Percentage, ElementName=userControl}" HeaderToolTip="Earned % to date" ReadOnly="True" AllowEditing="False" VisibleIndex="80">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:TextEditSettings Mask="p2" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                                </dxg:GridColumn.EditSettings>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn Header="{Binding DataContext.Header_Budgeted_ToDate, ElementName=userControl}" FieldName="{Binding DataContext.Cumulative_Planned_Units, ElementName=userControl}" HeaderToolTip="Schedule planned to date" ReadOnly="True" AllowEditing="False" VisibleIndex="90">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:TextEditSettings Mask="{Binding DataContext.Field_Mask, ElementName=userControl}" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                                </dxg:GridColumn.EditSettings>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn Header="{Binding DataContext.Header_Earned_ToDate, ElementName=userControl}" FieldName="{Binding DataContext.Cumulative_Earned_Units, ElementName=userControl}" HeaderToolTip="Earned to date" ReadOnly="True" AllowEditing="False" VisibleIndex="100">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:TextEditSettings Mask="{Binding DataContext.Field_Mask, ElementName=userControl}" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                                </dxg:GridColumn.EditSettings>
                                            </dxg:GridColumn>
                                        </dxg:GridControlBand>
                                        <dxg:GridControlBand Header="Period">
                                            <dxg:GridColumn Header="Earned %" FieldName="{Binding DataContext.Period_Current_Earned_Percentage, ElementName=userControl}" HeaderToolTip="Earned % for this period" ReadOnly="True" AllowEditing="False" VisibleIndex="130">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:TextEditSettings Mask="p2" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                                </dxg:GridColumn.EditSettings>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn Header="{Binding DataContext.Header_Budgeted_ToDate, ElementName=userControl}" FieldName="{Binding DataContext.Period_Planned_Units, ElementName=userControl}" HeaderToolTip="Planned for this period" ReadOnly="True" AllowEditing="False" VisibleIndex="140">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:TextEditSettings Mask="{Binding DataContext.Field_Mask, ElementName=userControl}" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                                </dxg:GridColumn.EditSettings>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn Header="{Binding DataContext.Header_Earned_ToDate, ElementName=userControl}" FieldName="{Binding DataContext.Period_Earned_Units, ElementName=userControl}" HeaderToolTip="Earned for this period" ReadOnly="True" AllowEditing="False" VisibleIndex="150">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:TextEditSettings Mask="{Binding DataContext.Field_Mask, ElementName=userControl}" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                                                </dxg:GridColumn.EditSettings>
                                            </dxg:GridColumn>
                                        </dxg:GridControlBand>
                                    </dxg:GridControl.Bands>
                                    <dxg:GridControl.View>
                                        <dxg:TableView AllowEditing="False" IsDetailButtonVisibleBinding="{Binding Row.IHaveSubjob_Dashboards}" NewItemRowPosition="None" ShowGroupPanel="False" ShowTotalSummary="True" Style="{StaticResource DefaultTableViewTemplate}" UseLightweightTemplates="{x:Null}" />
                                    </dxg:GridControl.View>
                                    <dxg:GridControl.TotalSummary>
                                        <dxg:GridSummaryItem FieldName="Stats.Budgeted.CurrentPeriodCumulativeDataPoint.Units" x:Name="totalSummaryBudgeted" dx:DXSerializer.Enabled="False" DisplayFormat="{}{0:n}" ShowInColumn="Stats.Budgeted.CurrentPeriodCumulativeDataPoint.Units" SummaryType="Sum" />
                                        <dxg:GridSummaryItem FieldName="Stats.Earned.CurrentPeriodCumulativeDataPoint.Units" x:Name="totalSummaryCumulativeEarned" dx:DXSerializer.Enabled="False" DisplayFormat="{}{0:n}" ShowInColumn="Stats.Earned.CurrentPeriodCumulativeDataPoint.Units" SummaryType="Sum" />
                                        <dxg:GridSummaryItem FieldName="Stats.Budgeted.CurrentPeriodDataPoint.Units" x:Name="totalSummaryPeriodPlanned" dx:DXSerializer.Enabled="False" DisplayFormat="{}{0:n}" ShowInColumn="Stats.Budgeted.CurrentPeriodDataPoint.Units" SummaryType="Sum" />
                                        <dxg:GridSummaryItem FieldName="Stats.Earned.CurrentPeriodDataPoint.Units" x:Name="totalSummaryPeriodEarned" dx:DXSerializer.Enabled="False" DisplayFormat="{}{0:n}" ShowInColumn="Stats.Earned.CurrentPeriodDataPoint.Units" SummaryType="Sum" />
                                    </dxg:GridControl.TotalSummary>
                                </custom:GridControlEx>
                            </dxlc:LayoutGroup>
                            <dxlc:LayoutGroup Name="LayoutGroupChart" DataContext="{Binding DataContext, ElementName=userControl, Mode=OneWay, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}" Orientation="Vertical" View="Group">
                                <dxc:ChartControl Name="chartSCurve" Margin="0" Padding="0" dx:DXSerializer.Enabled="False" AutoLayout="False">
                                    <dxc:XYDiagram2D SeriesItemsSource="{StaticResource userDashboardXYChartSeries}">
                                        <dxc:XYDiagram2D.AxisX>
                                            <dxc:AxisX2D>
                                                <dxc:AxisX2D.Label>
                                                    <dxc:AxisLabel>
                                                        <dxc:Axis2D.ResolveOverlappingOptions>
                                                            <dxc:AxisLabelResolveOverlappingOptions AllowRotate="True" AllowStagger="True" />
                                                        </dxc:Axis2D.ResolveOverlappingOptions>
                                                    </dxc:AxisLabel>
                                                </dxc:AxisX2D.Label>
                                            </dxc:AxisX2D>
                                        </dxc:XYDiagram2D.AxisX>
                                        <dxc:XYDiagram2D.AxisY>
                                            <dxc:AxisY2D x:Name="primaryAxisY">
                                                <dxc:AxisY2D.Title>
                                                    <dxc:AxisTitle Content="{Binding DataContext.AxisYPrimaryLabel, ElementName=userControl}" />
                                                </dxc:AxisY2D.Title>
                                            </dxc:AxisY2D>
                                        </dxc:XYDiagram2D.AxisY>
                                        <dxc:XYDiagram2D.SecondaryAxesY>
                                            <dxc:SecondaryAxisY2D x:Name="secondaryAxisY">
                                                <dxc:SecondaryAxisY2D.Title>
                                                    <dxc:AxisTitle Content="{Binding DataContext.AxisYSecondaryLabel, ElementName=userControl}" />
                                                </dxc:SecondaryAxisY2D.Title>
                                                <dxc:SecondaryAxisY2D.Label>
                                                    <dxc:AxisLabel TextPattern="{}{V:0%}" />
                                                </dxc:SecondaryAxisY2D.Label>
                                            </dxc:SecondaryAxisY2D>
                                        </dxc:XYDiagram2D.SecondaryAxesY>
                                    </dxc:XYDiagram2D>
                                    <dxc:ChartControl.Legend>
                                        <dxc:Legend UseCheckBoxes="True" />
                                    </dxc:ChartControl.Legend>
                                </dxc:ChartControl>
                            </dxlc:LayoutGroup>
                        </dxlc:LayoutControl>
                    </DockPanel>
                </dxb:BarManager>
            </Grid>
        </Grid>
    </Grid>
</UserControl>