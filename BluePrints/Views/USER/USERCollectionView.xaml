<UserControl x:Class="BluePrints.Views.USERCollectionView" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:common="clr-namespace:BluePrints.Common" xmlns:custom="clr-namespace:BaseModel.Misc;assembly=BaseModel" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon" xmlns:dxrudex="http://schemas.devexpress.com/winfx/2008/xaml/reports/userdesignerextensions" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:view="clr-namespace:BluePrints.Views" xmlns:viewmodel="clr-namespace:BluePrints.ViewModels" x:Name="userControl" d:DesignHeight="1200" d:DesignWidth="1200" DataContext="{dxmvvm:ViewModelSource viewmodel:USERCollectionViewModelWrapper}" mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BaseModel;component/View/ResourceDictionaries/DefaultControlResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/DefaultBluePrintsResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <dxmvvm:Interaction.Behaviors>
        <dx:DialogService x:Name="USERImportDialogService">
            <dx:DialogService.DialogStyle>
                <Style TargetType="dx:DXDialogWindow">
                    <Setter Property="SizeToContent" Value="Width" />
                    <Setter Property="MinWidth" Value="500" />
                    <Setter Property="MinHeight" Value="500" />
                </Style>
            </dx:DialogService.DialogStyle>
        </dx:DialogService>
    </dxmvvm:Interaction.Behaviors>
    <Grid Style="{StaticResource CollectionView.RootContainer}">
        <Grid DataContext="{Binding MainViewModel}">
            <DockPanel>
                <dxr:RibbonControl AllowCustomization="False" DockPanel.Dock="Top" MDIMergeStyle="Always" RibbonStyle="Office2010">
                    <dxr:RibbonDefaultPageCategory Caption="defaultCategory">
                        <dxr:RibbonPage Caption="Home">
                            <dxr:RibbonPageGroup Caption="Grid" ItemLinksSource="{StaticResource RibbonDefaultGridButtons}" />
                            <dxr:RibbonPageGroup Caption="Layout" ItemLinksSource="{StaticResource RibbonDefaultLayoutButtons}" />
                            <dxr:RibbonPageGroup Caption="Tools">
                                <dxb:BarButtonItem x:Name="biImport" Command="{Binding DataContext.ImportCommand, ElementName=userControl}" Content="Import" Glyph="{dx:DXImage Image=Download_16x16.png}" LargeGlyph="{dx:DXImage Image=Download_32x32.png}" />
                                <dxb:BarButtonItem x:Name="biUpdateUser" Command="{Binding DataContext.Update_UserCommand, ElementName=userControl}" Content="Update User(s)" ToolTip="Get user department, discipline and description from active directory" Glyph="{dx:DXImage Image=BODetails_16x16.png}" LargeGlyph="{dx:DXImage Image=BODetails_32x32.png}" />
                                <dxb:BarButtonItem x:Name="biMatchExoStaffId" Command="{Binding DataContext.MatchExoStaffIdCommand, ElementName=userControl}" Content="Update EXO Name" ToolTip="Auto populate user's EXO name" Glyph="{dx:DXImage Image=Merge_16x16.png}" LargeGlyph="{dx:DXImage Image=Merge_32x32.png}" />
                                <!--<dxb:BarEditItem EditValue="{Binding DataContext.SelectedCOMPort, ElementName=userControl}" Content="Arduino Port" Glyph="{dx:DXImage Image=Satellite_16x16.png}" LargeGlyph="{dx:DXImage Image=Satellite_32x32.png}">
                                    <dxb:BarEditItem.EditSettings>
                                        <dxe:ComboBoxEditSettings IsTextEditable="False" ItemsSource="{Binding DataContext.AvailablePorts, ElementName=userControl}" />
                                    </dxb:BarEditItem.EditSettings>
                                </dxb:BarEditItem>
                                <dxb:BarButtonItem BarItemDisplayMode="ContentAndGlyph"  Command="{Binding DataContext.PortConnectCommand, ElementName=userControl}" Content="{Binding DataContext.ConnectButtonContent, ElementName=userControl}" Glyph="{dx:DXImage Image=Satellite_16x16.png}" LargeGlyph="{dx:DXImage Image=Satellite_32x32.png}" />-->
                                <dxb:BarCheckItem x:Name="bcHideUser" Content="Hide User" Glyph="{dx:DXImage Image=User_16x16.png}" IsChecked="{Binding DataContext.HideLeave, ElementName=userControl}" LargeGlyph="{dx:DXImage Image=User_32x32.png}" ToolTip="Show bookable only" />
                            </dxr:RibbonPageGroup>
                        </dxr:RibbonPage>
                    </dxr:RibbonDefaultPageCategory>
                </dxr:RibbonControl>
                <dxr:RibbonStatusBarControl DockPanel.Dock="Bottom">
                    <dxr:RibbonStatusBarControl.LeftItems>
                        <dxb:BarStaticItem Content="{Binding Entities.Count, Converter={dxmvvm:FormatStringConverter FormatString='RECORDS: {0}'}}" />
                    </dxr:RibbonStatusBarControl.LeftItems>
                </dxr:RibbonStatusBarControl>
                <Grid>
                    <dxmvvm:Interaction.Behaviors>
                        <dxmvvm:LayoutSerializationService />
                    </dxmvvm:Interaction.Behaviors>
                    <custom:GridControlEx x:Name="GridControl" dx:DXSerializer.SerializationID="GridControlUSER" dx:DXSerializer.StoreLayoutMode="All" Style="{StaticResource DefaultGridControlTemplate}">
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn FieldName="NAME" Header="Login Name" HeaderToolTip="Name used to login into system" />
                            <dxg:GridColumn FieldName="FIRST_NAME" Header="First Name" />
                            <dxg:GridColumn FieldName="LAST_NAME" Header="Last Name" />
                            <dxg:GridColumn FieldName="GUID_DEPARTMENT" Header="Department">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding DataContext.DEPARTMENTCollection, ElementName=userControl}" NullValueButtonPlacement="Popup" ValueMember="GUID" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="GUID_DISCIPLINE" Header="Discipline">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding DataContext.DISCIPLINECollection, ElementName=userControl}" NullValueButtonPlacement="Popup" ValueMember="GUID" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="TITLE" Header="Title" />
                            <dxg:GridColumn FieldName="DESCRIPTION" Header="Description" />
                            <dxg:GridColumn FieldName="GUID_ROLE" Header="Role" HeaderToolTip="Role assigned will determine authorisation level within system. View role from navigation menu to view role authorisation">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding DataContext.RestrictedROLECollection, ElementName=userControl}" NullValueButtonPlacement="Popup" ValueMember="GUID" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="EXO_STAFF_ID" Header="Exo Name" HeaderToolTip="User name in Exo">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding DataContext.PrimeroSTAFFCollection, ElementName=userControl}" NullValueButtonPlacement="Popup" ValueMember="STAFFNO" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="GUID_OFFICE" Header="Office">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding DataContext.OFFICECollection, ElementName=userControl}" ValueMember="GUID" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="UTILIZATION" Header="Utilisation" HeaderToolTip="For reporting use only">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:SpinEditSettings Increment="0.01" Mask="p" MaskType="Numeric" MaskUseAsDisplayFormat="True" MaxValue="1" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="START_DATE" Header="Start Date" HeaderToolTip="User's start date in the company">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:DateEditSettings />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="LEAVE_DATE" Header="Leave Date" HeaderToolTip="User's leave date from the company">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:DateEditSettings />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                        </dxg:GridControl.Columns>
                        <dxg:GridControl.TotalSummary>
                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" Alignment="Right" SummaryType="Count" />
                        </dxg:GridControl.TotalSummary>
                        <dxg:GridControl.GroupSummary>
                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" SummaryType="Count" />
                        </dxg:GridControl.GroupSummary>
                        <dxg:GridControl.View>
                            <dxg:TableView x:Name="tableView" Style="{StaticResource DefaultTableViewTemplate}">
                                <dxg:TableView.RowCellMenuCustomizations>
                                    <dxb:BarButtonItem Command="{Binding DataContext.MatchExoStaffIdCommand, ElementName=userControl}" Content="Update EXO Name" ToolTip="Auto populate user's EXO name" Glyph="{dx:DXImage Image=Merge_16x16.png}" LargeGlyph="{dx:DXImage Image=Merge_32x32.png}" />
                                    <dxb:BarItemLinkSeparator />
                                    <dxb:BarButtonItem Command="{Binding DataContext.Update_UserCommand, ElementName=userControl}" Content="Update User(s)" ToolTip="Get user department, discipline and description from active directory" Glyph="{dx:DXImage Image=BODetails_16x16.png}" LargeGlyph="{dx:DXImage Image=BODetails_32x32.png}" />
                                    <dxb:BarItemLinkSeparator />
                                    <dxb:BarLinkContainerItem ItemLinksSource="{StaticResource ContextMenuDefaultHeaderButtons}" />
                                    <dxb:BarItemLinkSeparator />
                                    <dxb:BarLinkContainerItem ItemLinksSource="{StaticResource ContextMenuDefaultFooterButtons}" />
                                </dxg:TableView.RowCellMenuCustomizations>
                            </dxg:TableView>
                        </dxg:GridControl.View>
                    </custom:GridControlEx>
                </Grid>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
