<UserControl x:Class="BluePrints.Views.REGISTER_ISSUECollectionView" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:common="clr-namespace:BluePrints.Common" xmlns:custom="clr-namespace:BaseModel.Misc;assembly=BaseModel" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon" xmlns:dxrudex="http://schemas.devexpress.com/winfx/2008/xaml/reports/userdesignerextensions" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:view="clr-namespace:BluePrints.Views" xmlns:viewmodel="clr-namespace:BluePrints.ViewModels" x:Name="userControl" d:DesignHeight="400" d:DesignWidth="600" DataContext="{dxmvvm:ViewModelSource viewmodel:REGISTER_ISSUECollectionViewModelWrapper}" mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/GridColumnResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/BaseModel;component/View/ResourceDictionaries/DefaultControlResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/DefaultBluePrintsResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Style="{StaticResource CollectionView.RootContainer}">
        <Grid DataContext="{Binding MainViewModel}">
            <DockPanel>
                <dxr:RibbonControl AllowCustomization="False" DockPanel.Dock="Top" MDIMergeStyle="Always" RibbonStyle="Office2010">
                    <dxr:RibbonDefaultPageCategory Caption="defaultCategory">
                        <dxr:RibbonPage Caption="Home">
                            <dxr:RibbonPageGroup Caption="Grid" ItemLinksSource="{StaticResource RibbonDefaultGridButtons}" />
                            <dxr:RibbonPageGroup Caption="Layout" ItemLinksSource="{StaticResource RibbonDefaultLayoutButtons}" />
                            <dxr:RibbonPageGroup Caption="Send To">
                                <dxb:BarButtonItem Content="Change Register" ToolTip="Send selected issue to change register. Cannot send if item is already sent to hold/change register" Command="{Binding DataContext.SendToChangeRegisterCommand, ElementName=userControl}" LargeGlyph="{dx:DXImage Image=BOTask_32x32.png}" Glyph="{dx:DXImage Image=BOTask_16x16.png}" />
                                <dxb:BarButtonItem Content="Hold Register" ToolTip="Send selected issue to hold register. Cannot send if item is already sent to hold/change register" Command="{Binding DataContext.SendToHoldRegisterCommand, ElementName=userControl}" LargeGlyph="{dx:DXImage Image=BORules_32x32.png}" Glyph="{dx:DXImage Image=BORules_16x16.png}" />
                            </dxr:RibbonPageGroup>
                        </dxr:RibbonPage>
                    </dxr:RibbonDefaultPageCategory>
                </dxr:RibbonControl>
                <dxr:RibbonStatusBarControl DockPanel.Dock="Bottom">
                    <dxr:RibbonStatusBarControl.LeftItems>
                        <dxb:BarStaticItem Content="{Binding Entities.Count, Converter={dxmvvm:FormatStringConverter FormatString='RECORDS: {0}'}}" />
                    </dxr:RibbonStatusBarControl.LeftItems>
                </dxr:RibbonStatusBarControl>
                <Grid>
                    <dxmvvm:Interaction.Behaviors>
                        <dxmvvm:LayoutSerializationService />
                    </dxmvvm:Interaction.Behaviors>
                    <custom:GridControlEx x:Name="GridControl" dx:DXSerializer.SerializationID="GridControlREGISTER" dx:DXSerializer.StoreLayoutMode="All" Style="{StaticResource DefaultGridControlTemplate}">
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn Header="Issue Number" FieldName="NUMBER" HeaderToolTip="Unique number" AllowMoving="false" />
                            <dxg:GridColumn Header="Area" FieldName="GUID_AREA" AllowMoving="false">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="INTERNAL_NUM" IsTextEditable="True" ItemsSource="{Binding DataContext.AREACollection, ElementName=userControl}" ValueMember="GUID" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Discipline" FieldName="GUID_DISCIPLINE" AllowMoving="false">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding DataContext.DISCIPLINECollection, ElementName=userControl}" ValueMember="GUID" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Title" FieldName="TITLE" AllowMoving="false">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <dxe:TextEdit Name="PART_Editor" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Issue Description" FieldName="DESCRIPTION" AllowMoving="false">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <dxe:TextEdit Name="PART_Editor" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Proposed Solution or Comments" FieldName="PROPOSED_SOLUTION" AllowMoving="false">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <dxe:TextEdit Name="PART_Editor" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Schedule Impact" FieldName="SCHEDULE_IMPACT" AllowMoving="false">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings AutoComplete="True" IsTextEditable="True" NullValueButtonPlacement="Popup">
                                        <dxe:ComboBoxEditSettings.ItemsSource>
                                            <dxe:EnumItemsSource EnumType="{x:Type common:ScheduleImpact}" />
                                        </dxe:ComboBoxEditSettings.ItemsSource>
                                    </dxe:ComboBoxEditSettings>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Issue Type" FieldName="ISSUE_TYPE" AllowMoving="false">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings AutoComplete="True" IsTextEditable="True" NullValueButtonPlacement="Popup">
                                        <dxe:ComboBoxEditSettings.ItemsSource>
                                            <dxe:EnumItemsSource EnumType="{x:Type common:Register_IssueType}" />
                                        </dxe:ComboBoxEditSettings.ItemsSource>
                                    </dxe:ComboBoxEditSettings>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Importance" FieldName="IMPORTANCE" AllowMoving="false">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings AutoComplete="True" IsTextEditable="True" NullValueButtonPlacement="Popup">
                                        <dxe:ComboBoxEditSettings.ItemsSource>
                                            <dxe:EnumItemsSource EnumType="{x:Type common:Register_IssueImportance}" />
                                        </dxe:ComboBoxEditSettings.ItemsSource>
                                    </dxe:ComboBoxEditSettings>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Cost Impact" FieldName="COST_IMPACT" AllowMoving="false">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings AutoComplete="True" IsTextEditable="True" NullValueButtonPlacement="Popup">
                                        <dxe:ComboBoxEditSettings.ItemsSource>
                                            <dxe:EnumItemsSource EnumType="{x:Type common:ScheduleImpact}" />
                                        </dxe:ComboBoxEditSettings.ItemsSource>
                                    </dxe:ComboBoxEditSettings>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Client Notification" FieldName="CLIENT_NOTIFICATION" AllowMoving="false">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <dxe:TextEdit Name="PART_Editor" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Notified Person" FieldName="NOTIFIED_PERSON" AllowMoving="false">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <dxe:TextEdit Name="PART_Editor" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Date Raised" FieldName="DATE_RAISED" AllowMoving="false" />
                            <dxg:GridColumn Header="Responsible Person" FieldName="GUID_RESPONSIBLE_PERSON" AllowMoving="false">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings AutoComplete="True" DisplayMember="NAME" IsTextEditable="True" ItemsSource="{Binding DataContext.USERCollection, ElementName=userControl}" ValueMember="GUID" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Final Resolution" FieldName="FINAL_RESOLUTION" AllowMoving="false">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <dxe:TextEdit Name="PART_Editor" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Way Closed" FieldName="WAY_CLOSED" AllowMoving="false">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings TextWrapping="Wrap" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Closed Notified Person" FieldName="CLOSED_NOTIFIED_PERSON" AllowMoving="false" />
                            <dxg:GridColumn Header="Date Closed" FieldName="DATE_CLOSED" AllowMoving="false" />
                            <dxg:GridColumn Header="Actioned on Drawing" FieldName="ACTIONED_ON_DWG" AllowMoving="false">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings AutoComplete="True" IsTextEditable="True" NullValueButtonPlacement="Popup">
                                        <dxe:ComboBoxEditSettings.ItemsSource>
                                            <dxe:EnumItemsSource EnumType="{x:Type common:ActionedOnDrawing}" />
                                        </dxe:ComboBoxEditSettings.ItemsSource>
                                    </dxe:ComboBoxEditSettings>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Change Register" FieldName="RegisterChange.NUMBER" ReadOnly="True" AllowMoving="false" />
                            <dxg:GridColumn Header="Hold Register" FieldName="RegisterHold.NUMBER" ReadOnly="True" AllowMoving="false" />
                            <dxg:GridColumn FieldName="IsActionedOnDrawing" AllowMoving="false" Visible="{Binding DataContext.IsActionedOnDrawingVisibility, ElementName=userControl}" />
                        </dxg:GridControl.Columns>
                        <dxg:GridControl.TotalSummary>
                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" Alignment="Right" SummaryType="Count" />
                        </dxg:GridControl.TotalSummary>
                        <dxg:GridControl.GroupSummary>
                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" SummaryType="Count" />
                        </dxg:GridControl.GroupSummary>
                        <dxg:GridControl.View>
                            <dxg:TableView x:Name="tableView" Style="{StaticResource DefaultTableViewTemplate}">
                                <dxg:TableView.FormatConditions>
                                    <dxg:FormatCondition FieldName="ACTIONED_ON_DWG" Expression="Not IsActionedOnDrawing And [DATE_CLOSED] Is Not Null">
                                        <dx:Format Background="#FFFF9B98" Foreground="Black" />
                                    </dxg:FormatCondition>
                                    <dxg:FormatCondition FieldName="DATE_CLOSED" ApplyToRow="True" Expression="[DATE_CLOSED] Is Not Null">
                                        <dx:Format Background="LightBlue" Foreground="Black" />
                                    </dxg:FormatCondition>
                                </dxg:TableView.FormatConditions>
                                <dxg:TableView.RowCellMenuCustomizations>
                                    <dxb:BarLinkContainerItem ItemLinksSource="{StaticResource ContextMenuDefaultHeaderButtons}" />
                                    <dxb:BarItemLinkSeparator />
                                    <dxb:BarSubItem Content="Duplicate Multiple" ToolTip="Specify number of times to duplicate selected deliverables and assign the same internal number" Glyph="{dx:DXImageOffice2013 Image=Parameters_16x16.png}" x:Name="contextMenuDuplicateMulti">
                                        <dxb:BarEditItem Content="Count" Name="contextMenuDuplicateMultiCount" EditValue="2">
                                            <dxb:BarEditItem.EditSettings>
                                                <dxe:SpinEditSettings Increment="1" IsFloatValue="False" IsTextEditable="True" Mask="n0" MaskType="Numeric" MaskUseAsDisplayFormat="True" MaxValue="99" MinValue="2">
                                                    <dxe:SpinEditSettings.Buttons>
                                                        <dxe:ButtonInfo GlyphKind="Apply">
                                                            <dxmvvm:Interaction.Behaviors>
                                                                <dxmvvm:EventToCommand Command="{Binding DataContext.DuplicateMultipleCommand, ElementName=userControl}" CommandParameter="{Binding ElementName=contextMenuDuplicateMultiCount}" EventName="Click" />
                                                            </dxmvvm:Interaction.Behaviors>
                                                        </dxe:ButtonInfo>
                                                    </dxe:SpinEditSettings.Buttons>
                                                </dxe:SpinEditSettings>
                                            </dxb:BarEditItem.EditSettings>
                                        </dxb:BarEditItem>
                                    </dxb:BarSubItem>
                                    <dxb:BarSubItem Content="Insert Multiple" ToolTip="Specify number of times to insert new deliverables with continuing internal number affix. Also renames deliverables with internal number larger than the largest internal number affix to continue from the newly inserted deliverables" Glyph="{dx:DXImageOffice2013 Image=Parameters_16x16.png}" x:Name="contextMenuInsertMulti">
                                        <dxb:BarEditItem Content="Count" Name="contextMenuInsertMultiCount" EditValue="2">
                                            <dxb:BarEditItem.EditSettings>
                                                <dxe:SpinEditSettings Increment="1" IsFloatValue="False" IsTextEditable="True" Mask="n0" MaskType="Numeric" MaskUseAsDisplayFormat="True" MaxValue="99" MinValue="2">
                                                    <dxe:SpinEditSettings.Buttons>
                                                        <dxe:ButtonInfo GlyphKind="Apply">
                                                            <dxmvvm:Interaction.Behaviors>
                                                                <dxmvvm:EventToCommand Command="{Binding DataContext.InsertMultipleCommand, ElementName=userControl}" CommandParameter="{Binding ElementName=contextMenuInsertMultiCount}" EventName="Click" />
                                                            </dxmvvm:Interaction.Behaviors>
                                                        </dxe:ButtonInfo>
                                                    </dxe:SpinEditSettings.Buttons>
                                                </dxe:SpinEditSettings>
                                            </dxb:BarEditItem.EditSettings>
                                        </dxb:BarEditItem>
                                    </dxb:BarSubItem>
                                    <dxb:BarItemLinkSeparator />
                                    <dxb:BarLinkContainerItem ItemLinksSource="{StaticResource ContextMenuDefaultFooterButtons}" />
                                </dxg:TableView.RowCellMenuCustomizations>
                            </dxg:TableView>
                        </dxg:GridControl.View>
                    </custom:GridControlEx>
                </Grid>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
