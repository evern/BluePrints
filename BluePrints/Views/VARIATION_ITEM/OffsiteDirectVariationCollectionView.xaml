<UserControl x:Name="userControl" 
             x:Class="BluePrints.Views.OffsiteDirectVariationCollectionView"
             xmlns:view="clr-namespace:BluePrints.Views"
             xmlns="http://schemas.microsoft.com/netfx/2009/xaml/presentation"
             xmlns:converter="clr-namespace:BluePrints.Common.ViewModel.Converters"
             xmlns:custom="clr-namespace:BaseModel.Misc;assembly=BaseModel"
             xmlns:common="clr-namespace:BluePrints.Common"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxrudex="http://schemas.devexpress.com/winfx/2008/xaml/reports/userdesignerextensions"
             xmlns:viewmodel="clr-namespace:BluePrints.ViewModels"
             mc:Ignorable="d" d:DesignHeight="400" d:DesignWidth="600"
             DataContext="{dxmvvm:ViewModelSource viewmodel:OffsiteDirectVariationCollectionViewModelWrapper}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BaseModel;component/View/ResourceDictionaries/DefaultControlResourceDictionary.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/ConverterResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Style="{StaticResource CollectionView.RootContainer}">
        <Grid DataContext="{Binding MainViewModel}">
            <DockPanel>
                <dxr:RibbonControl RibbonStyle="Office2010" DockPanel.Dock="Top" AllowCustomization="False" MDIMergeStyle="Always">
                    <dxr:RibbonDefaultPageCategory Caption="defaultCategory">
                        <dxr:RibbonPage Caption="Home">
                            <dxr:RibbonPageGroup Caption="VARIATION ITEM Tasks">
                                <dxb:BarButtonItem Content="Refresh" Command="{Binding DataContext.FullRefreshCommand, ElementName=userControl}"
                                                   LargeGlyph="{dx:DXImage Image=Refresh_32x32.png}"
                                                   Glyph="{dx:DXImage Image=Refresh_16x16.png}" />
                                <dxb:BarButtonItem Content="Delete Row" Command="{Binding BulkDeleteCommand}"
                                                   LargeGlyph="{dx:DXImage Image=Delete_32x32.png}"
                                                   Glyph="{dx:DXImage Image=Delete_16x16.png}" />
                                <dxb:BarButtonItem Content="Undo" Command="{Binding UndoCommand}"
                                                   LargeGlyph="{dx:DXImage Image=Undo_32x32.png}"
                                                   Glyph="{dx:DXImage Image=Undo_16x16.png}" />
                                <dxb:BarButtonItem Content="Redo" Command="{Binding RedoCommand}"
                                                   LargeGlyph="{dx:DXImage Image=Redo_32x32.png}"
                                                   Glyph="{dx:DXImage Image=Redo_16x16.png}" />
                                <dxb:BarButtonItem Content="Save Layout"
                                                   Command="{Binding DataContext.SaveLayoutCommand, ElementName=userControl}"
                                                   LargeGlyph="{dx:DXImage Image=Save_32x32.png}"
                                                   Glyph="{dx:DXImage Image=Save_16x16.png}" />
                                <dxb:BarButtonItem Content="Reset Layout"
                                                   Command="{Binding DataContext.ResetLayoutCommand, ElementName=userControl}"
                                                   LargeGlyph="{dx:DXImage Image=SaveAndClose_32x32.png}"
                                                   Glyph="{dx:DXImage Image=SaveAndClose_16x16.png}" />
                                <dxb:BarCheckItem Content="Cell Selection" IsChecked="{Binding IsPasteCellLevel, Mode=TwoWay}" Glyph="{dx:DXImage Image=SplitTableCells_16x16.png}" LargeGlyph="{dx:DXImage Image=SplitTableCells_32x32.png}" />
                                <dxb:BarButtonItem Content="Export"
                                                   Command="{Binding DataContext.ExportToExcelCommand, ElementName=userControl}"
                                                   LargeGlyph="{dx:DXImage Image=ExportToXLSX_32x32.png}"
                                                   Glyph="{dx:DXImage Image=ExportToXLSX_16x16.png}" />
                            </dxr:RibbonPageGroup>
                        </dxr:RibbonPage>
                    </dxr:RibbonDefaultPageCategory>
                </dxr:RibbonControl>
                <dxr:RibbonStatusBarControl DockPanel.Dock="Bottom">
                    <dxr:RibbonStatusBarControl.LeftItems>
                        <dxb:BarStaticItem
                            Content="{Binding Entities.Count, Converter={dxmvvm:FormatStringConverter FormatString='RECORDS: {0}'}}" />
                    </dxr:RibbonStatusBarControl.LeftItems>
                </dxr:RibbonStatusBarControl>
                <Grid>
                    <dxmvvm:Interaction.Behaviors>
                        <dxmvvm:LayoutSerializationService />
                    </dxmvvm:Interaction.Behaviors>
                    <custom:GridControlEx x:Name="GridControl" dx:DXSerializer.SerializationID="GridControlVARIATION_ITEM" dx:DXSerializer.StoreLayoutMode="All" Style="{StaticResource DefaultGridControlTemplate}">
                        <dxmvvm:Interaction.Behaviors>
                            <dxmvvm:EventToCommand EventName="CustomColumnSort" Command="{Binding DataContext.OnCustomColumnSortCommand, ElementName=userControl}" PassEventArgsToCommand="True"/>
                        </dxmvvm:Interaction.Behaviors>
                        <dxg:GridControl.Columns>
                            <custom:GridColumnEx FieldName="Entity.Entity.Entity.GUID_PHASE" Header="PHASE" VisibleIndex="0">
                                <custom:GridColumnEx.EditSettings>
                                    <dxe:ComboBoxEditSettings
                                        ItemsSource="{Binding DataContext.PHASECollection, ElementName=userControl}"
                                        IsTextEditable="True" AutoComplete="True" DisplayMember="INTERNAL_NUM"
                                        ValueMember="GUID" />
                                </custom:GridColumnEx.EditSettings>
                                <custom:GridColumnEx.CellTemplate>
                                    <DataTemplate>
                                        <dxe:ComboBoxEdit Name="PART_Editor"
                                                          ItemsSource="{Binding DataContext.PHASECollection, ElementName=userControl}"
                                                          IsTextEditable="True" AutoComplete="True"
                                                          DisplayMember="INTERNAL_NUM" ValueMember="GUID"
                                                          IsEnabled="{Binding RowData.Row.IsReadOnly, Converter={StaticResource BooleanNegationConverter}}" />
                                    </DataTemplate>
                                </custom:GridColumnEx.CellTemplate>
                            </custom:GridColumnEx>
                            <custom:GridColumnEx Name="colSUBJOB"
                                            FieldName="Entity.Entity.Entity.GUID_SUBJOB" Tag="True;True;Autofill from area and sub-area"
                                            Header="SUBJOB" VisibleIndex="1">
                                <custom:GridColumnEx.EditSettings>
                                    <dxe:ComboBoxEditSettings
                                        ItemsSource="{Binding DataContext.SUBJOBCollection, ElementName=userControl}"
                                        IsTextEditable="True" AutoComplete="True" DisplayMember="INTERNAL_NAME1"
                                        ValueMember="GUID" />
                                </custom:GridColumnEx.EditSettings>
                                <custom:GridColumnEx.CellTemplate>
                                    <DataTemplate>
                                        <dxe:ComboBoxEdit Name="PART_Editor"
                                                          ItemsSource="{Binding DataContext.SUBJOBCollection, ElementName=userControl}"
                                                          IsTextEditable="True" AutoComplete="True"
                                                          DisplayMember="INTERNAL_NAME1" ValueMember="GUID"
                                                          IsEnabled="{Binding RowData.Row.IsReadOnly, Converter={StaticResource BooleanNegationConverter}}" />
                                    </DataTemplate>
                                </custom:GridColumnEx.CellTemplate>
                            </custom:GridColumnEx>
                            <custom:GridColumnEx Name="colWORKPACK"
                                            FieldName="Entity.Entity.Entity.GUID_WORKPACK" Tag="True;True;Autofill from workpack, discipline and discipline number"
                                            Header="WORKPACK" VisibleIndex="1">
                                <custom:GridColumnEx.EditSettings>
                                    <dxe:ComboBoxEditSettings
                                        ItemsSource="{Binding DataContext.WORKPACKCollection, ElementName=userControl}"
                                        IsTextEditable="True" AutoComplete="True" DisplayMember="NAME"
                                        ValueMember="GUID" />
                                </custom:GridColumnEx.EditSettings>
                                <custom:GridColumnEx.CellTemplate>
                                    <DataTemplate>
                                        <dxe:ComboBoxEdit Name="PART_Editor"
                                                          ItemsSource="{Binding DataContext.WORKPACKCollection, ElementName=userControl}"
                                                          IsTextEditable="True" AutoComplete="True"
                                                          DisplayMember="NAME" ValueMember="GUID"
                                                          IsEnabled="{Binding RowData.Row.IsReadOnly, Converter={StaticResource BooleanNegationConverter}}" />
                                    </DataTemplate>
                                </custom:GridColumnEx.CellTemplate>
                            </custom:GridColumnEx>
                            <custom:GridColumnEx FieldName="Entity.Entity.Entity.GUID_AREA" Header="AREA" Tag="True;True;Autofill subjob">
                                <custom:GridColumnEx.EditSettings>
                                    <dxe:ComboBoxEditSettings
                                        ItemsSource="{Binding DataContext.AREACollection, ElementName=userControl}"
                                        IsTextEditable="True" AutoComplete="True" DisplayMember="INTERNAL_NUM"
                                        ValueMember="GUID" />
                                </custom:GridColumnEx.EditSettings>
                                <custom:GridColumnEx.CellTemplate>
                                    <DataTemplate>
                                        <dxe:ComboBoxEdit Name="PART_Editor"
                                                          ItemsSource="{Binding DataContext.AREACollection, ElementName=userControl}"
                                                          IsTextEditable="True" AutoComplete="True"
                                                          DisplayMember="INTERNAL_NUM" ValueMember="GUID"
                                                          IsEnabled="{Binding RowData.Row.IsReadOnly, Converter={StaticResource BooleanNegationConverter}}" />
                                    </DataTemplate>
                                </custom:GridColumnEx.CellTemplate>
                            </custom:GridColumnEx>
                            <custom:GridColumnEx FieldName="Entity.Entity.Entity.SubAreaGuid" Header="SUBAREA" ColumnFilterMode="DisplayText" Tag="True;True;Autofill from subjob">
                                <custom:GridColumnEx.CellTemplate>
                                    <DataTemplate>
                                        <dxe:ComboBoxEdit 
                                                  x:Name="PART_Editor"
                                                  ItemsSource="{Binding RowData.Row.Entity.Entity.Entity.SubAreaCollection}"
                                                  DisplayMember="INTERNAL_NUM" 
                                                  IsEnabled="{Binding RowData.Row.IsReadOnly, Converter={StaticResource BooleanNegationConverter}}"
                                                  ValueMember="GUID"
                                                  ValidateOnTextInput="True"
                                                  ValidateOnEnterKeyPressed="True"
                                                  IncrementalFiltering="True"
                                                  NullValueButtonPlacement="Popup"
                                                  ImmediatePopup="True">
                                        </dxe:ComboBoxEdit>
                                    </DataTemplate>
                                </custom:GridColumnEx.CellTemplate>
                                <!--For Filtering-->
                                <custom:GridColumnEx.EditSettings>
                                    <dxe:ComboBoxEditSettings NullValueButtonPlacement="EditBox"
                                                              ItemsSource="{Binding DataContext.SUBAREACollection, ElementName=userControl}"
                                                              IsTextEditable="True" AutoComplete="True"
                                                              DisplayMember="INTERNAL_NUM" ValueMember="GUID" />
                                </custom:GridColumnEx.EditSettings>
                            </custom:GridColumnEx>
                            <custom:GridColumnEx FieldName="Entity.Entity.Entity.GUID_DOCTYPE" Header="DOCTYPE">
                                <custom:GridColumnEx.EditSettings>
                                    <dxe:ComboBoxEditSettings
                                        ItemsSource="{Binding DataContext.DOCTYPECollection, ElementName=userControl}"
                                        IsTextEditable="True" AutoComplete="True" DisplayMember="NAME"
                                        ValueMember="GUID" />
                                </custom:GridColumnEx.EditSettings>
                                <custom:GridColumnEx.CellTemplate>
                                    <DataTemplate>
                                        <dxe:ComboBoxEdit Name="PART_Editor"
                                                          ItemsSource="{Binding DataContext.DOCTYPECollection, ElementName=userControl}"
                                                          IsTextEditable="True" AutoComplete="True"
                                                          DisplayMember="NAME" ValueMember="GUID"
                                                          IsEnabled="{Binding RowData.Row.IsReadOnly, Converter={StaticResource BooleanNegationConverter}}" />
                                    </DataTemplate>
                                </custom:GridColumnEx.CellTemplate>
                            </custom:GridColumnEx>
                            <custom:GridColumnEx FieldName="Entity.Entity.Entity.GUID_DISCIPLINE" Header="DISCIPLINE">
                                <custom:GridColumnEx.EditSettings>
                                    <dxe:ComboBoxEditSettings
                                        ItemsSource="{Binding DataContext.DISCIPLINECollection, ElementName=userControl}"
                                        IsTextEditable="True" AutoComplete="True" DisplayMember="NAME"
                                        ValueMember="GUID" />
                                </custom:GridColumnEx.EditSettings>
                                <custom:GridColumnEx.CellTemplate>
                                    <DataTemplate>
                                        <dxe:ComboBoxEdit Name="PART_Editor"
                                                          ItemsSource="{Binding DataContext.DISCIPLINECollection, ElementName=userControl}"
                                                          IsTextEditable="True" AutoComplete="True"
                                                          DisplayMember="NAME" ValueMember="GUID"
                                                          IsEnabled="{Binding RowData.Row.IsReadOnly, Converter={StaticResource BooleanNegationConverter}}" />
                                    </DataTemplate>
                                </custom:GridColumnEx.CellTemplate>
                            </custom:GridColumnEx>
                            <custom:GridColumnEx FieldName="Entity.Entity.Entity.DISCIPLINE_NUM" Header="DISC. NUM" >
                                <custom:GridColumnEx.CellTemplate>
                                    <DataTemplate>
                                        <dxe:SpinEdit Name="PART_Editor" IsTextEditable="True" IsFloatValue="False"
                                                                      Increment="1" MinValue="1" MaxValue="99"
                                                                      MaskType="Numeric" Mask="n0"
                                                                      IsEnabled="{Binding RowData.Row.IsEnabled}"
                                                                      MaskUseAsDisplayFormat="True" />
                                    </DataTemplate>
                                </custom:GridColumnEx.CellTemplate>
                            </custom:GridColumnEx>
                            <custom:GridColumnEx FieldName="Entity.Entity.Entity.GUID_DEPARTMENT" Header="DEPARTMENT">
                                <custom:GridColumnEx.EditSettings>
                                    <dxe:ComboBoxEditSettings
                                        ItemsSource="{Binding DataContext.DEPARTMENTCollection, ElementName=userControl}"
                                        IsTextEditable="True" AutoComplete="True" DisplayMember="NAME"
                                        ValueMember="GUID" />
                                </custom:GridColumnEx.EditSettings>
                                <custom:GridColumnEx.CellTemplate>
                                    <DataTemplate>
                                        <dxe:ComboBoxEdit Name="PART_Editor"
                                                          ItemsSource="{Binding DataContext.DEPARTMENTCollection, ElementName=userControl}"
                                                          IsTextEditable="True" AutoComplete="True"
                                                          DisplayMember="NAME" ValueMember="GUID"
                                                          IsEnabled="{Binding RowData.Row.IsReadOnly, Converter={StaticResource BooleanNegationConverter}}" />
                                    </DataTemplate>
                                </custom:GridColumnEx.CellTemplate>
                            </custom:GridColumnEx>
                            <custom:GridColumnEx FieldName="Entity.Entity.Entity.INTERNAL_NUM" Header="INTERNAL NUM" Tag="True;False;Autofill from area, department, discipline and doc-type">
                                <custom:GridColumnEx.CellTemplate>
                                    <DataTemplate>
                                        <!-- Use IsEnabled because when textEdit is invoked the 2nd time IsReadOnly didn't get picked up in the binding -->
                                        <dxe:TextEdit Name="PART_Editor" IsEnabled="{Binding RowData.Row.IsEnabled}" />
                                    </DataTemplate>
                                </custom:GridColumnEx.CellTemplate>
                            </custom:GridColumnEx>
                            <custom:GridColumnEx FieldName="Entity.Entity.Entity.CLIENT_NUM" Header="CLIENT NUM">
                                <custom:GridColumnEx.CellTemplate>
                                    <DataTemplate>
                                        <dxe:TextEdit Name="PART_Editor" IsEnabled="{Binding RowData.Row.IsEnabled}" />
                                    </DataTemplate>
                                </custom:GridColumnEx.CellTemplate>
                            </custom:GridColumnEx>
                            <custom:GridColumnEx FieldName="Entity.Entity.Entity.REVISION_NUMBER" Header="REVISION NUM">
                                <custom:GridColumnEx.CellTemplate>
                                    <DataTemplate>
                                        <dxe:TextEdit Name="PART_Editor" IsEnabled="{Binding RowData.Row.IsEnabled}" />
                                    </DataTemplate>
                                </custom:GridColumnEx.CellTemplate>
                            </custom:GridColumnEx>
                            <custom:GridColumnEx FieldName="Entity.Entity.Entity.DELIVERABLE_TYPE" Header="TYPE">
                                <custom:GridColumnEx.EditSettings>
                                    <dxe:ComboBoxEditSettings Name="PART_Editor"
                                                              ItemsSource="{dxe:EnumItemsSource EnumType={x:Type common:DeliverableType}}"
                                                              IsTextEditable="True" AutoComplete="True" />
                                </custom:GridColumnEx.EditSettings>
                                <custom:GridColumnEx.CellTemplate>
                                    <DataTemplate>
                                        <dxe:ComboBoxEdit Name="PART_Editor"
                                                          ItemsSource="{dxe:EnumItemsSource EnumType={x:Type common:DeliverableType}}"
                                                          IsTextEditable="True" AutoComplete="True"
                                                          IsEnabled="{Binding RowData.Row.IsReadOnly, Converter={StaticResource BooleanNegationConverter}}" />
                                    </DataTemplate>
                                </custom:GridColumnEx.CellTemplate>
                            </custom:GridColumnEx>
                            <custom:GridColumnEx FieldName="Entity.Entity.Entity.PRIMARY_TITLE" Header="PRIMARY TITLE">
                                <custom:GridColumnEx.CellTemplate>
                                    <DataTemplate>
                                        <dxe:TextEdit Name="PART_Editor" IsEnabled="{Binding RowData.Row.IsEnabled}" />
                                    </DataTemplate>
                                </custom:GridColumnEx.CellTemplate>
                            </custom:GridColumnEx>
                            <custom:GridColumnEx FieldName="Entity.Entity.Entity.SECONDARY_TITLE" Header="SECONDARY TITLE">
                                <custom:GridColumnEx.CellTemplate>
                                    <DataTemplate>
                                        <dxe:TextEdit Name="PART_Editor" IsEnabled="{Binding RowData.Row.IsEnabled}" />
                                    </DataTemplate>
                                </custom:GridColumnEx.CellTemplate>
                            </custom:GridColumnEx>
                            <custom:GridColumnEx FieldName="Entity.Entity.Entity.COMMENTS" Header="COMMENTS">
                                <custom:GridColumnEx.CellTemplate>
                                    <DataTemplate>
                                        <dxe:TextEdit Name="PART_Editor" IsEnabled="{Binding RowData.Row.IsEnabled}" />
                                    </DataTemplate>
                                </custom:GridColumnEx.CellTemplate>
                            </custom:GridColumnEx>
                            <custom:GridColumnEx FieldName="Entity.Entity.Entity.BY_DURATION" Header="BY DURATION" >
                                <custom:GridColumnEx.CellTemplate>
                                    <DataTemplate>
                                        <dxe:CheckEdit Name="PART_Editor" IsEnabled="{Binding RowData.Row.IsEnabled}" />
                                    </DataTemplate>
                                </custom:GridColumnEx.CellTemplate>
                            </custom:GridColumnEx>
                            <custom:GridColumnEx FieldName="Total_Units" Header="TOTAL HOURS" ReadOnly="True" IsEnabled="False" SortMode="Custom">
                                <custom:GridColumnEx.EditSettings>
                                    <dxe:SpinEditSettings MaskType="Numeric" Mask="n" MinValue="0" Increment="1" MaskUseAsDisplayFormat="True" />
                                </custom:GridColumnEx.EditSettings>
                            </custom:GridColumnEx>
                            <custom:GridColumnEx FieldName="Variation_Units" Header="ADJUST HOURS" SortMode="Custom">
                                <custom:GridColumnEx.CellTemplate>
                                    <DataTemplate>
                                        <dxe:SpinEdit Name="PART_Editor" MaskType="Numeric" Mask="n" Increment="1"
                                                      MaskUseAsDisplayFormat="True"
                                                      MinValue="{Binding RowData.Row.MinNegativeUnits}"
                                                      IsReadOnly="{Binding RowData.Row.AdjustUnitsReadOnly}" />
                                    </DataTemplate>
                                </custom:GridColumnEx.CellTemplate>
                            </custom:GridColumnEx>
                            <custom:GridColumnEx FieldName="Total_Cost" ReadOnly="True" Header="COSTS"
                                            AllowSearchPanel="False" SortMode="Custom">
                                <custom:GridColumnEx.CellTemplate>
                                    <DataTemplate>
                                        <dxe:TextEdit Name="PART_Editor" MaskUseAsDisplayFormat="True"
                                                      MaskType="Numeric" Mask="c" />
                                    </DataTemplate>
                                </custom:GridColumnEx.CellTemplate>
                            </custom:GridColumnEx>
                            <custom:GridColumnEx FieldName="Forecast_Units" Header="VARIATION UNITS" ReadOnly="True" SortMode="Custom">
                                <custom:GridColumnEx.CellTemplate>
                                    <DataTemplate>
                                        <dxe:SpinEdit Name="PART_Editor" MaskType="Numeric" Mask="n" Increment="1"
                                                      MaskUseAsDisplayFormat="True"
                                                      IsReadOnly="True" />
                                    </DataTemplate>
                                </custom:GridColumnEx.CellTemplate>
                            </custom:GridColumnEx>
                            <custom:GridColumnEx FieldName="Variation_Cost" ReadOnly="True" Header="VARIATION COSTS"
                                            AllowSearchPanel="False" SortMode="Custom">
                                <custom:GridColumnEx.CellTemplate>
                                    <DataTemplate>
                                        <dxe:TextEdit Name="PART_Editor" MaskUseAsDisplayFormat="True"
                                                      MaskType="Numeric" Mask="c" />
                                    </DataTemplate>
                                </custom:GridColumnEx.CellTemplate>
                            </custom:GridColumnEx>
                            <custom:GridColumnEx Header="ACTION" FieldName="Variation_Action" ReadOnly="True" IsEnabled="False">
                                <custom:GridColumnEx.EditSettings>
                                    <dxe:ComboBoxEditSettings IsTextEditable="True" AutoComplete="True"
                                                              ItemsSource="{dxe:EnumItemsSource EnumType={x:Type common:VariationAction}}"
                                                              AllowDrop="False" />
                                </custom:GridColumnEx.EditSettings>
                            </custom:GridColumnEx>
                            <custom:GridColumnEx FieldName="UNBOUND_CANCEL" Header="CANCEL" ReadOnly="True"
                                            UnboundType="Boolean" AllowEditing="False"
                                            >
                                <custom:GridColumnEx.CellTemplate>
                                    <DataTemplate>
                                        <Button Height="18"
                                                Command="{Binding DataContext.CancelDeliverableCommand, ElementName=userControl}"
                                                CommandParameter="{Binding RowData.Row}" IsEnabled="{Binding RowData.Row.IsCancellable}">
                                            <StackPanel Orientation="Horizontal">
                                                <Image
                                                    Source="{Binding Path=RowData.Row.Variation_Action, Converter={StaticResource VariationActionToImageConverter}}"
                                                    Margin="0, 0, 3, 0" />
                                                <TextBlock
                                                    Text="{Binding Path=RowData.Row.Variation_Action, Converter={StaticResource VariationActionToStringConverter}}"
                                                    VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </custom:GridColumnEx.CellTemplate>
                            </custom:GridColumnEx>
                        </dxg:GridControl.Columns>
                        <dxg:GridControl.GroupSummary>
                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" FieldName="Entity.Total_Units"
                                                 SummaryType="SUM"
                                                 ShowInColumn="Entity.Total_Units"
                                                 DisplayFormat="Total: {0:n}" />
                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" FieldName="Variation_Units" SummaryType="SUM"
                                                 ShowInColumn="Variation_Units"
                                                 DisplayFormat="Total: {0:n}" />
                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" FieldName="Total_Cost" SummaryType="SUM" ShowInColumn="Total_Cost"
                                                 DisplayFormat="Total: {0:c}" />
                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" FieldName="Forecast_Units" SummaryType="SUM" ShowInColumn="Forecast_Units"
                                                 DisplayFormat="Total: {0:n}" />
                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" FieldName="Variation_Cost" SummaryType="SUM" ShowInColumn="Variation_Cost"
                                                 DisplayFormat="Total: {0:c}" />
                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" SummaryType="Count" Alignment="Right" />
                        </dxg:GridControl.GroupSummary>
                        <dxg:GridControl.TotalSummary>
                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" FieldName="Entity.Total_Units"
                                                 SummaryType="SUM"
                                                 ShowInColumn="Entity.Total_Units"
                                                 DisplayFormat="Total: {0:n}" />
                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" FieldName="Variation_Units" SummaryType="SUM"
                                                 ShowInColumn="Variation_Units"
                                                 DisplayFormat="Total: {0:n}" />
                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" FieldName="Total_Cost" SummaryType="SUM" ShowInColumn="Total_Cost"
                                                 DisplayFormat="Total: {0:c}" />
                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" FieldName="Forecast_Units" SummaryType="SUM" ShowInColumn="Forecast_Units"
                                                 DisplayFormat="Total: {0:n}" />
                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" FieldName="Variation_Cost" SummaryType="SUM" ShowInColumn="Variation_Cost"
                                                 DisplayFormat="Total: {0:c}" />
                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" SummaryType="Count" />
                        </dxg:GridControl.TotalSummary>
                        <dxg:GridControl.View>
                            <dxg:TableView x:Name="tableView" Style="{StaticResource DefaultTableViewTemplate}" ShowGridMenu="tableView_ShowGridMenu"
                                           NewItemRowPosition="{Binding DataContext.NewItemRowPosition, ElementName=userControl}"
                                           ShowTotalSummary="True" GroupSummaryDisplayMode="AlignByColumns">
                                <dxg:TableView.RowCellMenuCustomizations>
                                    <dxb:BarButtonItem Content="Copy With Headers" Command="{Binding DataContext.CopyWithHeaderCommand, ElementName=userControl}" Glyph="{dx:DXImageOffice2013 Image=AlignHorizontalTop_16x16.png}" />
                                    <dxb:BarButtonItem Name="contextMenuBulkEdit" Content="Bulk Edit"
                                                       Command="{Binding View.DataContext.BulkColumnEditCommand}"
                                                       CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                                                       Glyph="{dx:DXImageOffice2013 Image=CustomizeGrid_16x16.png}" />
                                    <dxb:BarButtonItem Name="contextFindReplace" Content="Find and Replace"
                                                       Command="{Binding DataContext.FindReplaceCommand, ElementName=userControl}"
                                                       CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                                                       Glyph="{dx:DXImageOffice2013 Image=Replace_16x16.png}" />
                                    <dxb:BarButtonItem Name="contextMenuFillUp" Content="Fill Up"
                                                       Glyph="{dx:DXImageOffice2013 Image=MoveUp_16x16.png}"
                                                       Command="{Binding View.DataContext.FillUpCommand}"
                                                       CommandParameter="{Binding RelativeSource={RelativeSource Self}}" />
                                    <dxb:BarButtonItem Name="contextMenuFillDown" Content="Fill Down"
                                                       Glyph="{dx:DXImageOffice2013 Image=MoveDown_16x16.png}"
                                                       Command="{Binding View.DataContext.FillDownCommand}"
                                                       CommandParameter="{Binding RelativeSource={RelativeSource Self}}" />
                                    <dxb:BarButtonItem Name="contextMenuPopulate" Content="Populate"
                                                       Glyph="{dx:DXImageOffice2013 Image=PictureShapeFillColor_16x16.png}"
                                                       Command="{Binding DataContext.AutoPopulateCommand, ElementName=userControl}"
                                                       CommandParameter="{Binding RelativeSource={RelativeSource Self}}" />
                                    <dxb:BarButtonItem x:Name="contextMenuDuplicate" Content="Duplicate"
                                                       Command="{Binding DataContext.DuplicateCommand, ElementName=userControl}"
                                                       Glyph="{dx:DXImageOffice2013 Image=Paste_16x16.png}" />
                                    <dxb:BarSubItem x:Name="contextMenuDuplicateMulti" Content="Duplicate Multiple"
                                                    Glyph="{dx:DXImageOffice2013 Image=Parameters_16x16.png}">
