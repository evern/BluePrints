<UserControl x:Name="userControl" x:Class="BluePrints.Views.SiteDirectVariationCollectionView" xmlns:view="clr-namespace:BluePrints.Views" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/presentation" xmlns:converter="clr-namespace:BluePrints.Common.ViewModel.Converters" xmlns:custom="clr-namespace:BaseModel.Misc;assembly=BaseModel" xmlns:common="clr-namespace:BluePrints.Common" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon" xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" xmlns:dxrudex="http://schemas.devexpress.com/winfx/2008/xaml/reports/userdesignerextensions" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:viewmodel="clr-namespace:BluePrints.ViewModels" mc:Ignorable="d" d:DesignHeight="400" d:DesignWidth="600" DataContext="{dxmvvm:ViewModelSource viewmodel:SiteDirectVariationCollectionViewModelWrapper}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BaseModel;component/View/ResourceDictionaries/DefaultControlResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/ConverterResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Style="{StaticResource CollectionView.RootContainer}">
        <dxmvvm:Interaction.Behaviors>
            <dx:DialogService x:Name="StockCodeDialogService">
                <dx:DialogService.DialogStyle>
                    <Style TargetType="dx:DXDialogWindow">
                        <Setter Property="SizeToContent" Value="WidthAndHeight" />
                    </Style>
                </dx:DialogService.DialogStyle>
            </dx:DialogService>
        </dxmvvm:Interaction.Behaviors>
        <Grid DataContext="{Binding MainViewModel}">
            <DockPanel>
                <dxr:RibbonControl RibbonStyle="Office2010" DockPanel.Dock="Top" AllowCustomization="False" MDIMergeStyle="Always">
                    <dxr:RibbonDefaultPageCategory Caption="defaultCategory">
                        <dxr:RibbonPage Caption="Home">
                            <dxr:RibbonPageGroup Caption="VARIATION ITEM Tasks">
                                <dxb:BarButtonItem Content="Refresh" Command="{Binding DataContext.FullRefreshCommand, ElementName=userControl}" LargeGlyph="{dx:DXImage Image=Refresh_32x32.png}" Glyph="{dx:DXImage Image=Refresh_16x16.png}" />
                                <dxb:BarButtonItem Content="Delete Row" Command="{Binding BulkDeleteCommand}" LargeGlyph="{dx:DXImage Image=Delete_32x32.png}" Glyph="{dx:DXImage Image=Delete_16x16.png}" />
                                <dxb:BarButtonItem Content="Undo" Command="{Binding UndoCommand}" LargeGlyph="{dx:DXImage Image=Undo_32x32.png}" Glyph="{dx:DXImage Image=Undo_16x16.png}" />
                                <dxb:BarButtonItem Content="Redo" Command="{Binding RedoCommand}" LargeGlyph="{dx:DXImage Image=Redo_32x32.png}" Glyph="{dx:DXImage Image=Redo_16x16.png}" />
                                <dxb:BarButtonItem Content="Save Layout" Command="{Binding DataContext.SaveLayoutCommand, ElementName=userControl}" LargeGlyph="{dx:DXImage Image=Save_32x32.png}" Glyph="{dx:DXImage Image=Save_16x16.png}" />
                                <dxb:BarButtonItem Content="Reset Layout" Command="{Binding DataContext.ResetLayoutCommand, ElementName=userControl}" LargeGlyph="{dx:DXImage Image=SaveAndClose_32x32.png}" Glyph="{dx:DXImage Image=SaveAndClose_16x16.png}" />
                                <dxb:BarCheckItem Content="Cell Selection" IsChecked="{Binding IsPasteCellLevel, Mode=TwoWay}" Glyph="{dx:DXImage Image=SplitTableCells_16x16.png}" LargeGlyph="{dx:DXImage Image=SplitTableCells_32x32.png}" />
                                <dxb:BarButtonItem Content="Export" Command="{Binding DataContext.ExportToExcelCommand, ElementName=userControl}" LargeGlyph="{dx:DXImage Image=ExportToXLSX_32x32.png}" Glyph="{dx:DXImage Image=ExportToXLSX_16x16.png}" />
                            </dxr:RibbonPageGroup>
                        </dxr:RibbonPage>
                    </dxr:RibbonDefaultPageCategory>
                </dxr:RibbonControl>
                <dxr:RibbonStatusBarControl DockPanel.Dock="Bottom">
                    <dxr:RibbonStatusBarControl.LeftItems>
                        <dxb:BarStaticItem Content="{Binding Entities.Count, Converter={dxmvvm:FormatStringConverter FormatString='RECORDS: {0}'}}" />
                    </dxr:RibbonStatusBarControl.LeftItems>
                </dxr:RibbonStatusBarControl>
                <Grid>
                    <dxmvvm:Interaction.Behaviors>
                        <dxmvvm:LayoutSerializationService />
                    </dxmvvm:Interaction.Behaviors>
                    <custom:GridControlEx x:Name="GridControl" dx:DXSerializer.SerializationID="GridControlVARIATION_ITEM" dx:DXSerializer.StoreLayoutMode="All" Style="{StaticResource DefaultGridControlTemplate}">
                        <dxg:GridControl.Bands>
                            <dxg:GridControlBand Name="bandGeneral" Header="General">
                                <dxg:GridColumn Name="colSUBJOB" FieldName="Entity.Entity.Entity.GUID_SUBJOB" Header="SUBJOB" ReadOnly="True">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings ItemsSource="{Binding DataContext.SUBJOBCollection, ElementName=userControl}" IsTextEditable="True" AutoComplete="True" DisplayMember="INTERNAL_NAME1" ValueMember="GUID" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="Entity.Entity.Entity.GUID_PHASE" Header="PHASE" VisibleIndex="0">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings ItemsSource="{Binding DataContext.PHASECollection, ElementName=userControl}" IsTextEditable="True" AutoComplete="True" DisplayMember="INTERNAL_NUM" ValueMember="GUID" />
                                    </dxg:GridColumn.EditSettings>
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:ComboBoxEdit Name="PART_Editor" ItemsSource="{Binding DataContext.PHASECollection, ElementName=userControl}" IsTextEditable="True" AutoComplete="True" DisplayMember="INTERNAL_NUM" ValueMember="GUID" IsEnabled="{Binding RowData.Row.IsReadOnly, Converter={StaticResource BooleanNegationConverter}}" />
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn Name="colAREA" FieldName="Entity.Entity.Entity.GUID_AREA" Header="AREA">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings ItemsSource="{Binding DataContext.AREACollection, ElementName=userControl}" IsTextEditable="True" AutoComplete="True" DisplayMember="INTERNAL_NUM" ValueMember="GUID" />
                                    </dxg:GridColumn.EditSettings>
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:ComboBoxEdit Name="PART_Editor" ItemsSource="{Binding DataContext.AREACollection, ElementName=userControl}" IsTextEditable="True" AutoComplete="True" DisplayMember="INTERNAL_NUM" IsEnabled="{Binding RowData.Row.IsEnabled}" ValueMember="GUID" />
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn Name="colSUBAREA" FieldName="Entity.Entity.Entity.SubAreaGuid" Header="SUBAREA" ColumnFilterMode="DisplayText">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:ComboBoxEdit x:Name="PART_Editor" ItemsSource="{Binding RowData.Row.Entity.Entity.Entity.SubAreaCollection}" DisplayMember="INTERNAL_NUM" ValueMember="GUID" ValidateOnTextInput="True" ValidateOnEnterKeyPressed="True" IncrementalFiltering="True" NullValueButtonPlacement="Popup" IsEnabled="{Binding RowData.Row.IsEnabled}" ImmediatePopup="True"></dxe:ComboBoxEdit>
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                    <!--For Filtering-->
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings NullValueButtonPlacement="EditBox" ItemsSource="{Binding DataContext.SUBAREACollection, ElementName=userControl}" IsTextEditable="True" AutoComplete="True" DisplayMember="INTERNAL_NUM" ValueMember="GUID" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn Name="colSTOCK_CODE" FieldName="Entity.Entity.StockCodeGuid" Header="STOCK CODE">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings ItemsSource="{Binding DataContext.STOCK_CODECollection, ElementName=userControl}" IsTextEditable="True" AutoComplete="True" DisplayMember="CODE" ValueMember="GUID" />
                                    </dxg:GridColumn.EditSettings>
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <!--took this out because stock code is no longer filtered by discipline-->
                                            <!--ItemsSource="{Binding RowData.Row.StockCodeCollection}"-->
                                            <dxg:LookUpEdit Name="PART_Editor" AutoComplete="True" ValueMember="GUID" DisplayMember="CODE" IsTextEditable="true" PopupMinWidth="1500" IsEnabled="{Binding RowData.Row.IsEnabled}" AutoPopulateColumns="False" NullValueButtonPlacement="None" ItemsSource="{Binding DataContext.STOCK_CODECollection, ElementName=userControl}">
                                                <dxg:LookUpEdit.StyleSettings>
                                                    <dxg:SearchLookUpEditStyleSettings />
                                                </dxg:LookUpEdit.StyleSettings>
                                                <dxg:LookUpEdit.PopupContentTemplate>
                                                    <ControlTemplate TargetType="ContentControl">
                                                        <dxg:GridControl x:Name="PART_GridControl" ShowBorder="False" SelectionMode="Row">
                                                            <dxg:GridControl.Columns>
                                                                <dxg:GridColumn FieldName="CODE" ReadOnly="True" />
                                                                <dxg:GridColumn FieldName="ProjectNumber" ReadOnly="True" />
                                                                <dxg:GridColumn FieldName="NAME" ReadOnly="True" />
                                                                <dxg:GridColumn FieldName="TYPE" ReadOnly="True" />
                                                                <dxg:GridColumn FieldName="SPEC" ReadOnly="True" />
                                                                <dxg:GridColumn FieldName="DESCRIPTION" ReadOnly="True" />
                                                                <dxg:GridColumn FieldName="UOM" ReadOnly="True" />
                                                                <dxg:GridColumn FieldName="RATE_SUPPLY" ReadOnly="True">
                                                                    <dxg:GridColumn.EditSettings>
                                                                        <dxe:SpinEditSettings MinValue="0" MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True" Increment="10" />
                                                                    </dxg:GridColumn.EditSettings>
                                                                </dxg:GridColumn>
                                                                <dxg:GridColumn FieldName="HOURS_INSTALL" ReadOnly="True">
                                                                    <dxg:GridColumn.EditSettings>
                                                                        <dxe:SpinEditSettings MinValue="0" MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True" Increment="10" />
                                                                    </dxg:GridColumn.EditSettings>
                                                                </dxg:GridColumn>
                                                            </dxg:GridControl.Columns>
                                                            <dxg:GridControl.View>
                                                                <dxg:TableView ShowSelectionRectangle="True" ShowFocusedRectangle="True" ShowSearchPanelMode="Always" ShowGroupPanel="True" ShowSearchPanelNavigationButtons="True" />
                                                            </dxg:GridControl.View>
                                                        </dxg:GridControl>
                                                    </ControlTemplate>
                                                </dxg:LookUpEdit.PopupContentTemplate>
                                            </dxg:LookUpEdit>
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn Header="COMMODITY CODE" FieldName="Entity.Entity.Entity.GUID_COMMODITY_CODE">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:ComboBoxEdit Name="PART_Editor" ItemsSource="{Binding DataContext.COMMODITY_CODECollection, ElementName=userControl}" DisplayMember="CODE" ValueMember="GUID" ValidateOnTextInput="True" ValidateOnEnterKeyPressed="True" IncrementalFiltering="True" NullValueButtonPlacement="Popup" IsEnabled="{Binding RowData.Row.IsEnabled}" ImmediatePopup="True"></dxe:ComboBoxEdit>
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings ItemsSource="{Binding DataContext.COMMODITY_CODECollection, ElementName=userControl}" IsTextEditable="True" AutoComplete="True" DisplayMember="CODE" ValueMember="GUID" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn Name="colDISCIPLINE" FieldName="Entity.Entity.Entity.GUID_DISCIPLINE" Header="DISCIPLINE">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:ComboBoxEdit Name="PART_Editor" ItemsSource="{Binding DataContext.DISCIPLINECollection, ElementName=userControl}" IsTextEditable="True" AutoComplete="True" DisplayMember="NAME" IsEnabled="{Binding RowData.Row.IsEnabled}" ValueMember="GUID" />
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings ItemsSource="{Binding DataContext.DISCIPLINECollection, ElementName=userControl}" IsTextEditable="True" AutoComplete="True" DisplayMember="NAME" ValueMember="GUID" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn Name="colDISCIPLINE_NUM" FieldName="Entity.Entity.Entity.DISCIPLINE_NUM" Header="DISC. NUM">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:SpinEdit Name="PART_Editor" IsTextEditable="True" IsFloatValue="False" Increment="1" MinValue="1" MaxValue="99" MaskType="Numeric" Mask="n0" IsEnabled="{Binding RowData.Row.IsEnabled}" MaskUseAsDisplayFormat="True" />
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn Name="colTRUCK_PERCENTAGE" FieldName="Entity.Entity.Entity.TRUCK_PERCENTAGE" Header="TRUCK % PER QTY">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:SpinEdit Name="PART_Editor" IsTextEditable="True" IsFloatValue="True" Increment="0.1" MinValue="0" MaxValue="1" MaskType="Numeric" Mask="p0" MaskUseAsDisplayFormat="True" IsEnabled="{Binding RowData.Row.IsEnabled}" />
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn Name="colRATE_OVERRIDE" FieldName="Entity.Entity.Entity.RATE_OVERRIDE" Header="RATE OVERRIDE" FilterPopupMode="CheckedList">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:SpinEdit Name="PART_Editor" IsFloatValue="True" Increment="1" MinValue="0" MaskType="Numeric" Mask="n2" NullValueButtonPlacement="EditBox" MaskUseAsDisplayFormat="True" IsEnabled="{Binding RowData.Row.IsEnabled}" />
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn Name="colCOMMENTS" FieldName="Entity.Entity.Entity.COMMENTS" Header="COMMENTS">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:TextEdit Name="PART_Editor" IsEnabled="{Binding RowData.Row.IsEnabled}" />
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                            </dxg:GridControlBand>
                            <dxg:GridControlBand Name="bandProgressSpecification" Header="Progress Specifications">
                                <dxg:GridColumn Header="STOCK GROUP" FieldName="Entity.Entity.Entity.GUID_STOCK_GROUP">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:ComboBoxEdit x:Name="PART_Editor" ItemsSource="{Binding DataContext.STOCK_GROUPCollection, ElementName=userControl}" IsEnabled="{Binding RowData.Row.IsEnabled}" DisplayMember="CODE" ValueMember="GUID" ValidateOnTextInput="True" ValidateOnEnterKeyPressed="True" IncrementalFiltering="True" NullValueButtonPlacement="Popup" ImmediatePopup="True"></dxe:ComboBoxEdit>
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings ItemsSource="{Binding DataContext.STOCK_GROUPCollection, ElementName=userControl}" IsTextEditable="True" AutoComplete="True" DisplayMember="CODE" ValueMember="GUID" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn Name="colPROGRESS_TYPE" FieldName="Entity.Entity.PROGRESS_TYPE" Header="PROGRESS_TYPE">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:ComboBoxEdit x:Name="PART_Editor" ItemsSource="{dxe:EnumItemsSource EnumType={x:Type common:Estimation_DirectProgressType}}" IsEnabled="{Binding RowData.Row.IsEnabled}" NullValueButtonPlacement="Popup" ImmediatePopup="True"></dxe:ComboBoxEdit>
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings IsTextEditable="True" AutoComplete="True" ItemsSource="{dxe:EnumItemsSource EnumType={x:Type common:Estimation_DirectProgressType}}" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                            </dxg:GridControlBand>
                            <dxg:GridControlBand Name="bandVariation" Header="Variation">
                                <dxg:GridColumn FieldName="Variation_Units" Header="ADJUST QUANTITY">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:SpinEdit Name="PART_Editor" MaskType="Numeric" Mask="n" Increment="1" MaskUseAsDisplayFormat="True" MinValue="{Binding RowData.Row.MinNegativeUnits}" IsReadOnly="{Binding RowData.Row.AdjustUnitsReadOnly}" />
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="Forecast_Units" Header="VAR QUANTITY">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:SpinEdit Name="PART_Editor" MaskType="Numeric" Mask="n" Increment="1" MaskUseAsDisplayFormat="True" IsReadOnly="True" />
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="Variation_Install_Hours" ReadOnly="True" Header="VAR INSTALL HOURS" AllowSearchPanel="False">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:TextEdit Name="PART_Editor" MaskUseAsDisplayFormat="True" MaskType="Numeric" Mask="c" />
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="Variation_Freight_Cost" ReadOnly="True" Header="VAR FREIGHT COST" AllowSearchPanel="False">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:TextEdit Name="PART_Editor" MaskUseAsDisplayFormat="True" MaskType="Numeric" Mask="c" />
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="Variation_Install_Cost" ReadOnly="True" Header="VAR INSTALL COST" AllowSearchPanel="False">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:TextEdit Name="PART_Editor" MaskUseAsDisplayFormat="True" MaskType="Numeric" Mask="c" />
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="Variation_Supply_Cost" ReadOnly="True" Header="VAR SUPPLY COST" AllowSearchPanel="False">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:TextEdit Name="PART_Editor" MaskUseAsDisplayFormat="True" MaskType="Numeric" Mask="c" />
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="Variation_Total_Cost" ReadOnly="True" Header="VAR TOTAL COST" AllowSearchPanel="False">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:TextEdit Name="PART_Editor" MaskUseAsDisplayFormat="True" MaskType="Numeric" Mask="c" />
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn Header="ACTION" FieldName="Variation_Action" ReadOnly="True" IsEnabled="False">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings IsTextEditable="True" AutoComplete="True" ItemsSource="{dxe:EnumItemsSource EnumType={x:Type common:VariationAction}}" AllowDrop="False" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="UNBOUND_CANCEL" Header="CANCEL" ReadOnly="True" UnboundType="Boolean" AllowEditing="False">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Height="18" Command="{Binding DataContext.CancelDeliverableCommand, ElementName=userControl}" CommandParameter="{Binding RowData.Row}" IsEnabled="{Binding RowData.Row.IsCancellable}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Source="{Binding Path=RowData.Row.Variation_Action, Converter={StaticResource VariationActionToImageConverter}}" Margin="0, 0, 3, 0" />
                                                    <TextBlock Text="{Binding Path=RowData.Row.Variation_Action, Converter={StaticResource VariationActionToStringConverter}}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                            </dxg:GridControlBand>
                            <dxg:GridControlBand Name="bandTotals" Header="Totals">
                                <dxg:GridColumn FieldName="Total_Units" Header="TOTAL QUANTITY" ReadOnly="True" IsEnabled="False">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:SpinEditSettings MaskType="Numeric" Mask="n" MinValue="0" Increment="1" MaskUseAsDisplayFormat="True" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn Header="INSTALL HOURS" FieldName="Total_Install_Hours" ReadOnly="True">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings MaskType="Numeric" Mask="n" MaskUseAsDisplayFormat="True" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn Header="FREIGHT COST" FieldName="Total_Freight_Cost" ReadOnly="True">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings MaskType="Numeric" Mask="c" MaskUseAsDisplayFormat="True" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn Header="INSTALL COST" FieldName="Total_Install_Cost" ReadOnly="True">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings MaskType="Numeric" Mask="c" MaskUseAsDisplayFormat="True" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn Header="SUPPLY COST" FieldName="Total_Supply_Cost" ReadOnly="True">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings MaskType="Numeric" Mask="c" MaskUseAsDisplayFormat="True" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn Header="TOTAL COST" FieldName="Total_Cost" ReadOnly="True">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings MaskType="Numeric" Mask="c" MaskUseAsDisplayFormat="True" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                            </dxg:GridControlBand>
                            <dxg:GridControlBand Name="bandStock" Header="Stock Code Details">
                                <dxg:GridColumn Header="SUPPLY RATE" FieldName="Entity.Entity.STOCK_CODE.RATE_SUPPLY">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:SpinEdit Name="PART_Editor" MinValue="0" MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True" Increment="10" />
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn Header="INSTALL HOURS" FieldName="Entity.Entity.STOCK_CODE.HOURS_INSTALL">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:SpinEdit Name="PART_Editor" MinValue="0" MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True" Increment="1" />
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn Header="UOM" FieldName="Entity.Entity.STOCK_CODE.UOM" ReadOnly="True" />
                                <dxg:GridColumn Header="NAME" FieldName="Entity.Entity.STOCK_CODE.NAME" ReadOnly="True" />
                                <dxg:GridColumn Header="TYPE" FieldName="Entity.Entity.STOCK_CODE.TYPE" ReadOnly="True" />
                                <dxg:GridColumn Header="SPEC" FieldName="Entity.Entity.STOCK_CODE.SPEC" ReadOnly="True" />
                                <dxg:GridColumn Header="DESCRIPTION" FieldName="Entity.Entity.STOCK_CODE.DESCRIPTION" ReadOnly="True" />
                            </dxg:GridControlBand>
                        </dxg:GridControl.Bands>
                        <dxg:GridControl.GroupSummary>
                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" FieldName="Entity.Total_Units" SummaryType="SUM" ShowInColumn="Entity.Total_Units" DisplayFormat="Total: {0:n}" />
                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" FieldName="Variation_Units" SummaryType="SUM" ShowInColumn="Variation_Units" DisplayFormat="Total: {0:n}" />
                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" FieldName="Total_Cost" SummaryType="SUM" ShowInColumn="Total_Cost" DisplayFormat="Total: {0:c}" />
                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" FieldName="Forecast_Units" SummaryType="SUM" ShowInColumn="Forecast_Units" DisplayFormat="Total: {0:n}" />
                            <dxg:GridSummaryItem dx:DXSerializer.Enabled="False" FieldName="Variation_Install_Hours" SummaryType="SUM" ShowInColumn="Variation_Install_Hours" DisplayFormat="Total: {0:n}" />
