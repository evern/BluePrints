<custom:ViewStateRestoreUserControl x:Name="userControl" 
             x:Class="BluePrints.Views.SiteDirectVariationCollectionView"
             xmlns:view="clr-namespace:BluePrints.Views"
             xmlns="http://schemas.microsoft.com/netfx/2009/xaml/presentation"
             xmlns:converter="clr-namespace:BluePrints.Common.ViewModel.Converters"
             xmlns:custom="clr-namespace:BaseModel.Misc;assembly=BaseModel"
             xmlns:common="clr-namespace:BluePrints.Common"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxrudex="http://schemas.devexpress.com/winfx/2008/xaml/reports/userdesignerextensions"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:viewmodel="clr-namespace:BluePrints.ViewModels"
             mc:Ignorable="d" d:DesignHeight="400" d:DesignWidth="600"
             DataContext="{dxmvvm:ViewModelSource viewmodel:SiteDirectVariationCollectionViewModelWrapper}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BaseModel;component/View/ResourceDictionaries/DefaultControlResourceDictionary.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/ConverterResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Style="{StaticResource CollectionView.RootContainer}">
        <Grid DataContext="{Binding MainViewModel}">
            <DockPanel>
                <dxr:RibbonControl RibbonStyle="Office2010" DockPanel.Dock="Top" AllowCustomization="False" MDIMergeStyle="Always">
                    <dxr:RibbonDefaultPageCategory Caption="defaultCategory">
                        <dxr:RibbonPage Caption="Home">
                            <dxr:RibbonPageGroup Caption="VARIATION ITEM Tasks">
                                <dxb:BarButtonItem Content="Refresh" Command="{Binding DataContext.FullRefreshCommand, ElementName=userControl}"
                                                   LargeGlyph="{dx:DXImage Image=Refresh_32x32.png}"
                                                   Glyph="{dx:DXImage Image=Refresh_16x16.png}" />
                                <dxb:BarButtonItem Content="Delete" Command="{Binding BulkDeleteCommand}"
                                                   LargeGlyph="{dx:DXImage Image=Delete_32x32.png}"
                                                   Glyph="{dx:DXImage Image=Delete_16x16.png}" />
                                <dxb:BarButtonItem Content="Undo" Command="{Binding UndoCommand}"
                                                   LargeGlyph="{dx:DXImage Image=Undo_32x32.png}"
                                                   Glyph="{dx:DXImage Image=Undo_16x16.png}" />
                                <dxb:BarButtonItem Content="Redo" Command="{Binding RedoCommand}"
                                                   LargeGlyph="{dx:DXImage Image=Redo_32x32.png}"
                                                   Glyph="{dx:DXImage Image=Redo_16x16.png}" />
                                <dxb:BarButtonItem Content="Save Layout"
                                                   Command="{Binding DataContext.SaveLayoutCommand, ElementName=userControl}"
                                                   LargeGlyph="{dx:DXImage Image=Save_32x32.png}"
                                                   Glyph="{dx:DXImage Image=Save_16x16.png}" />
                                <dxb:BarButtonItem Content="Reset Layout"
                                                   Command="{Binding DataContext.ResetLayoutCommand, ElementName=userControl}"
                                                   LargeGlyph="{dx:DXImage Image=SaveAndClose_32x32.png}"
                                                   Glyph="{dx:DXImage Image=SaveAndClose_16x16.png}" />
                                <dxb:BarButtonItem Content="Export"
                                                   Command="{Binding DataContext.ExportToExcelCommand, ElementName=userControl}"
                                                   LargeGlyph="{dx:DXImage Image=ExportToXLSX_32x32.png}"
                                                   Glyph="{dx:DXImage Image=ExportToXLSX_16x16.png}" />
                            </dxr:RibbonPageGroup>
                        </dxr:RibbonPage>
                    </dxr:RibbonDefaultPageCategory>
                </dxr:RibbonControl>
                <dxr:RibbonStatusBarControl DockPanel.Dock="Bottom">
                    <dxr:RibbonStatusBarControl.LeftItems>
                        <dxb:BarStaticItem
                            Content="{Binding Entities.Count, Converter={dxmvvm:FormatStringConverter FormatString='RECORDS: {0}'}}" />
                    </dxr:RibbonStatusBarControl.LeftItems>
                </dxr:RibbonStatusBarControl>
                <Grid>
                    <dxmvvm:Interaction.Behaviors>
                        <dxmvvm:LayoutSerializationService />
                    </dxmvvm:Interaction.Behaviors>
                    <custom:GridControlEx x:Name="GridControl" dx:DXSerializer.SerializationID="GridControlVARIATION_ITEM"
                                     Style="{StaticResource DefaultGridControlTemplate}">
                        <dxg:GridControl.Bands>
                            <dxg:GridControlBand Name="bandGeneral" Header="General">
                                <dxg:GridColumn Name="colWORKPACK" FieldName="Entity.Entity.Entity.GUID_WORKPACK" Header="WORKPACK" ReadOnly="True">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings
                                        ItemsSource="{Binding DataContext.WORKPACKCollection, ElementName=userControl}"
                                        IsTextEditable="True" AutoComplete="True" DisplayMember="INTERNAL_NAME1"
                                        ValueMember="GUID" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn Name="colAREA" FieldName="Entity.Entity.Entity.GUID_AREA" Header="AREA">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:ComboBoxEdit Name="PART_Editor"
                                            ItemsSource="{Binding DataContext.AREACollection, ElementName=userControl}"
                                            IsTextEditable="True" AutoComplete="True" DisplayMember="INTERNAL_NUM"
                                            IsEnabled="{Binding RowData.Row.IsEnabled}"
                                            ValueMember="GUID" />
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn Name="colSUBAREA" FieldName="Entity.Entity.Entity.SubAreaGuid" Header="SUBAREA" ColumnFilterMode="DisplayText">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:ComboBoxEdit 
                                                  x:Name="PART_Editor"
                                                  ItemsSource="{Binding RowData.Row.Entity.Entity.Entity.SubAreaCollection}"
                                                  DisplayMember="INTERNAL_NUM" 
                                                  ValueMember="GUID"
                                                  ValidateOnTextInput="True"
                                                  ValidateOnEnterKeyPressed="True"
                                                  IncrementalFiltering="True"
                                                  NullValueButtonPlacement="Popup"
                                                  IsEnabled="{Binding RowData.Row.IsEnabled}"
                                                  ImmediatePopup="True">
                                            </dxe:ComboBoxEdit>
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                    <!--For Filtering-->
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings NullValueButtonPlacement="EditBox"
                                                              ItemsSource="{Binding DataContext.SUBAREACollection, ElementName=userControl}"
                                                              IsTextEditable="True" AutoComplete="True"
                                                              DisplayMember="INTERNAL_NUM" ValueMember="GUID" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn Name="colSTOCK_CODE" FieldName="Entity.Entity.StockCodeGuid" Header="STOCK CODE">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <!--took this out because stock code is no longer filtered by discipline-->
                                            <!--ItemsSource="{Binding RowData.Row.StockCodeCollection}"-->
                                            <dxg:LookUpEdit
                                            Name="PART_Editor"
                                            AutoComplete="True"
                                            ValueMember="GUID"
                                            DisplayMember="CODE"
                                            IsTextEditable="true"
                                            PopupMinWidth="1500"
                                            IsEnabled="{Binding RowData.Row.IsEnabled}"
                                            AutoPopulateColumns="False"
                                            NullValueButtonPlacement="None"
                                            ItemsSource="{Binding DataContext.STOCK_CODECollection, ElementName=userControl}">
                                                <dxg:LookUpEdit.StyleSettings>
                                                    <dxg:SearchLookUpEditStyleSettings/>
                                                </dxg:LookUpEdit.StyleSettings>
                                                <dxg:LookUpEdit.PopupContentTemplate>
                                                    <ControlTemplate TargetType="ContentControl">
                                                        <dxg:GridControl x:Name="PART_GridControl" ShowBorder="False" SelectionMode="Row">
                                                            <dxg:GridControl.Columns>
                                                                <dxg:GridColumn FieldName="CODE" ReadOnly="True" />
                                                                <dxg:GridColumn FieldName="ProjectNumber" ReadOnly="True" />
                                                                <dxg:GridColumn FieldName="NAME" ReadOnly="True" />
                                                                <dxg:GridColumn FieldName="TYPE" ReadOnly="True" />
                                                                <dxg:GridColumn FieldName="SPEC" ReadOnly="True" />
                                                                <dxg:GridColumn FieldName="DESCRIPTION" ReadOnly="True" />
                                                                <dxg:GridColumn FieldName="UOM" ReadOnly="True" />
                                                                <dxg:GridColumn FieldName="RATE_SUPPLY" ReadOnly="True">
                                                                    <dxg:GridColumn.EditSettings>
                                                                        <dxe:SpinEditSettings MinValue="0" MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"
                                                                    Increment="10" />
                                                                    </dxg:GridColumn.EditSettings>
                                                                </dxg:GridColumn>
                                                                <dxg:GridColumn FieldName="HOURS_INSTALL" ReadOnly="True">
                                                                    <dxg:GridColumn.EditSettings>
                                                                        <dxe:SpinEditSettings MinValue="0" MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True"
                                                                    Increment="10" />
                                                                    </dxg:GridColumn.EditSettings>
                                                                </dxg:GridColumn>
                                                            </dxg:GridControl.Columns>
                                                            <dxg:GridControl.View>
                                                                <dxg:TableView
                                                            ShowSelectionRectangle="True"
                                                            ShowFocusedRectangle="True"
                                                            ShowSearchPanelMode="Always"
                                                            ShowGroupPanel="True"
                                                            ShowSearchPanelNavigationButtons="True"/>
                                                            </dxg:GridControl.View>
                                                        </dxg:GridControl>
                                                    </ControlTemplate>
                                                </dxg:LookUpEdit.PopupContentTemplate>
                                            </dxg:LookUpEdit>
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn Header="COMMODITY CODE" FieldName="Entity.Entity.CommodityCodeGuid">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:ComboBoxEdit 
                                                  Name="PART_Editor"
                                                  ItemsSource="{Binding RowData.Row.Entity.Entity.CommodityCodeCollection}"
                                                  DisplayMember="CODE" 
                                                  ValueMember="GUID"
                                                  ValidateOnTextInput="True"
                                                  ValidateOnEnterKeyPressed="True"
                                                  IncrementalFiltering="True"
                                                  NullValueButtonPlacement="Popup"
                                                  IsEnabled="{Binding RowData.Row.IsEnabled}"
                                                  ImmediatePopup="True">
                                            </dxe:ComboBoxEdit>
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                    <!--For Filtering-->
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings NullValueButtonPlacement="EditBox"
                                                              ItemsSource="{Binding DataContext.ProjectCOMMODITY_CODECollection, ElementName=userControl}"
                                                              IsTextEditable="True" AutoComplete="True"
                                                              DisplayMember="CODE" ValueMember="GUID" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn Name="colDISCIPLINE" FieldName="Entity.Entity.Entity.GUID_DISCIPLINE"
                                            Header="DISCIPLINE">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:ComboBoxEdit Name="PART_Editor"
                                                ItemsSource="{Binding DataContext.DISCIPLINECollection, ElementName=userControl}"
                                                IsTextEditable="True" AutoComplete="True" DisplayMember="NAME" IsEnabled="{Binding RowData.Row.IsEnabled}"
                                                ValueMember="GUID" />
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn Name="colDISCIPLINE_NUM" FieldName="Entity.Entity.Entity.DISCIPLINE_NUM" Header="DISC. NUM">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:SpinEdit Name="PART_Editor" IsTextEditable="True" IsFloatValue="False"
                                                                          Increment="1" MinValue="1" MaxValue="99"
                                                                          MaskType="Numeric" Mask="n0" IsEnabled="{Binding RowData.Row.IsEnabled}"
                                                                          MaskUseAsDisplayFormat="True" />
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn Name="colPROGRESS_TYPE" FieldName="Entity.Entity.Entity.PROGRESS_TYPE" Header="PROGRESS_TYPE">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:ComboBoxEdit Name="PART_Editor" IsTextEditable="True" AutoComplete="True" IsEnabled="{Binding RowData.Row.IsEnabled}"
                                                              ItemsSource="{dxe:EnumItemsSource EnumType={x:Type common:Estimation_DirectProgressType}}" />
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn Name="colCOMMENTS" FieldName="Entity.Entity.Entity.COMMENTS" Header="COMMENTS">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:TextEdit Name="PART_Editor" IsEnabled="{Binding RowData.Row.IsEnabled}" />
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn Name="colESTIMATED_QUANTITY" FieldName="Entity.Entity.Entity.ESTIMATED_QUANTITY"
                                            Header="ESTIMATED_QUANTITY" ReadOnly="True">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="15" />
                                                    <ColumnDefinition Width="15" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Image
                                                    Source="{Binding Source=DevExpress.Xpf.Core.Editors.Images.info.png, Converter={StaticResource EmbeddedResourceImageConverter}}"
                                                    ToolTip="Cannot reduce anymore because these quantity has already been earned" Grid.Column="0">
                                                    <Image.Visibility>
                                                        <MultiBinding
                                                            Converter="{StaticResource NumericCompareToVisibilityConverter}"
                                                            FallbackValue="Hidden">
                                                            <MultiBinding.ConverterParameter>
                                                                <sys:Boolean>False</sys:Boolean>
                                                            </MultiBinding.ConverterParameter>
                                                            <Binding ElementName="PART_Editor" Path="MinValue" />
                                                            <Binding ElementName="PART_Editor" Path="EditValue" />
                                                        </MultiBinding>
                                                    </Image.Visibility>
                                                </Image>
                                                <Image
                                                    Source="{Binding Source=DevExpress.Xpf.Core.Editors.Images.info.png, Converter={StaticResource EmbeddedResourceImageConverter}}"
                                                    ToolTip="Maximum possible units, please reduce other deliverable units to increase this" Grid.Column="1">
                                                    <Image.Visibility>
                                                        <MultiBinding
                                                            Converter="{StaticResource NumericCompareToVisibilityConverter}"
                                                            FallbackValue="Hidden">
                                                            <MultiBinding.ConverterParameter>
                                                                <sys:Boolean>False</sys:Boolean>
                                                            </MultiBinding.ConverterParameter>
                                                            <Binding ElementName="PART_Editor" Path="MaxValue" />
                                                            <Binding ElementName="PART_Editor" Path="EditValue" />
                                                        </MultiBinding>
                                                    </Image.Visibility>
                                                </Image>
                                                <dxe:SpinEdit Name="PART_Editor" MaskType="Numeric" Mask="n"
                                                              MaskUseAsDisplayFormat="True" Increment="1"
                                                              MinValue="{Binding RowData.Row.Entity.AbsoluteTotalInstalledQuantity}"
                                                              Grid.Column="2">
                                                    <!--<dxe:SpinEdit.MaxValue>
                                                        <MultiBinding Converter="{StaticResource IReportableStatsMaximumUnitsConverter}">
                                                            <Binding ElementName="userControl" Path="DataContext.TotalAllowedUnits" />
                                                            <Binding ElementName="userControl" Path="DataContext.DisplayEntities" />
                                                            <Binding Path="RowData.Row" />
                                                        </MultiBinding>
                                                    </dxe:SpinEdit.MaxValue>-->
                                                </dxe:SpinEdit>
                                            </Grid>
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                            </dxg:GridControlBand>
                            <dxg:GridControlBand Name="bandVariation" Header="Variation">
                                <dxg:GridColumn FieldName="Total_Units"
                                            Header="TOTAL QUANTITY" ReadOnly="True" IsEnabled="False">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:SpinEditSettings MaskType="Numeric" Mask="n" MinValue="0" Increment="1"
                                                          MaskUseAsDisplayFormat="True" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="Variation_Units" Header="ADJUST QUANTITY">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:SpinEdit Name="PART_Editor" MaskType="Numeric" Mask="n" Increment="1"
                                                      MaskUseAsDisplayFormat="True"
                                                      MinValue="{Binding RowData.Row.MinNegativeUnits}"
                                                      IsReadOnly="{Binding RowData.Row.AdjustUnitsReadOnly}" />
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="Total_Cost" ReadOnly="True" Header="COSTS"
                                            AllowSearchPanel="False">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:TextEdit Name="PART_Editor" MaskUseAsDisplayFormat="True"
                                                      MaskType="Numeric" Mask="c" />
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="Forecast_Units" Header="VARIATION QUANTITY">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:SpinEdit Name="PART_Editor" MaskType="Numeric" Mask="n" Increment="1"
                                                      MaskUseAsDisplayFormat="True"
                                                      IsReadOnly="True" />
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="Variation_Cost" ReadOnly="True" Header="VARIATION COSTS"
                                            AllowSearchPanel="False">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:TextEdit Name="PART_Editor" MaskUseAsDisplayFormat="True"
                                                      MaskType="Numeric" Mask="c" />
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn Header="ACTION" FieldName="Variation_Action" ReadOnly="True"
                                            IsEnabled="False">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings IsTextEditable="True" AutoComplete="True"
                                                              ItemsSource="{dxe:EnumItemsSource EnumType={x:Type common:VariationAction}}"
                                                              AllowDrop="False" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="UNBOUND_CANCEL" Header="CANCEL" ReadOnly="True"
                                            UnboundType="Boolean" AllowEditing="False"
                                            >
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Height="18"
                                                Command="{Binding DataContext.CancelDeliverableCommand, ElementName=userControl}"
                                                CommandParameter="{Binding RowData.Row}" IsEnabled="{Binding RowData.Row.IsCancellable}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Image
                                                    Source="{Binding Path=RowData.Row.Variation_Action, Converter={StaticResource VariationActionToImageConverter}}"
                                                    Margin="0, 0, 3, 0" />
                                                    <TextBlock
                                                    Text="{Binding Path=RowData.Row.Variation_Action, Converter={StaticResource VariationActionToStringConverter}}"
                                                    VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                            </dxg:GridControlBand>
                            <dxg:GridControlBand Name="bandCustomization" Header="Stock Code Customization">
                                <dxg:GridColumn Header="SUPPLY RATE" FieldName="Entity.Entity.STOCK_CODE.RATE_SUPPLY">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:SpinEdit Name="PART_Editor" MinValue="0" MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True" Increment="10" />
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn Header="INSTALL HOURS" FieldName="Entity.Entity.STOCK_CODE.HOURS_INSTALL">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:SpinEdit Name="PART_Editor" MinValue="0" MaskType="Numeric" Mask="n2" MaskUseAsDisplayFormat="True" Increment="1" />
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                            </dxg:GridControlBand>
                            <dxg:GridControlBand Name="bandStock" Header="Stock Code Details">
                                <dxg:GridColumn Header="TOTAL INSTALL HOURS" FieldName="Entity.Entity.Total_Units" ReadOnly="True">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings MaskType="Numeric" Mask="n" MaskUseAsDisplayFormat="True" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn Header="SUPPLY COST" FieldName="Entity.Entity.Supply_Cost" ReadOnly="True">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings MaskType="Numeric" Mask="c" MaskUseAsDisplayFormat="True" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn Header="INSTALL COST" FieldName="Entity.Entity.Install_Cost" ReadOnly="True">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings MaskType="Numeric" Mask="c" MaskUseAsDisplayFormat="True" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn Header="UOM"  FieldName="Entity.Entity.STOCK_CODE.UOM" ReadOnly="True" />
                                <dxg:GridColumn Header="NAME" FieldName="Entity.Entity.STOCK_CODE.NAME" ReadOnly="True" />
                                <dxg:GridColumn Header="TYPE" FieldName="Entity.Entity.STOCK_CODE.TYPE" ReadOnly="True" />
                                <dxg:GridColumn Header="SPEC" FieldName="Entity.Entity.STOCK_CODE.SPEC" ReadOnly="True" />
                                <dxg:GridColumn Header="DESCRIPTION" FieldName="Entity.Entity.STOCK_CODE.DESCRIPTION" ReadOnly="True" />
                            </dxg:GridControlBand>
                        </dxg:GridControl.Bands>
                        <dxg:GridControl.GroupSummary>
                            <dxg:GridSummaryItem FieldName="Entity.Entity.Entity.COMMENTS" SummaryType="Count"
                                                 Alignment="Right" DisplayFormat="Total {0} Records" />
                            <dxg:GridSummaryItem FieldName="Entity.Entity.Entity.ESTIMATED_QUANTITY" SummaryType="Sum"
                                                 ShowInColumn="Entity.Entity.Entity.ESTIMATED_QUANTITY"
                                                 DisplayFormat="Total: {0:n}" />
                            <dxg:GridSummaryItem FieldName="Total_Install_Hours" SummaryType="Sum"
                                                 ShowInColumn="Total_Install_Hours"
                                                 DisplayFormat="Total: {0:n}" />
                            <dxg:GridSummaryItem FieldName="Supply_Cost" SummaryType="Sum"
                                                 ShowInColumn="Supply_Cost"
                                                 DisplayFormat="Total: {0:c}" />
                            <dxg:GridSummaryItem FieldName="Install_Cost" SummaryType="Sum"
                                                 ShowInColumn="Install_Cost"
                                                 DisplayFormat="Total: {0:c}" />
                        </dxg:GridControl.GroupSummary>
                        <dxg:GridControl.TotalSummary>
                            <dxg:GridSummaryItem FieldName="Entity.Entity.Entity.COMMENTS" SummaryType="Count"
                                                 Alignment="Right" DisplayFormat="Total {0} Records" />
                            <dxg:GridSummaryItem FieldName="Entity.Entity.Entity.ESTIMATED_QUANTITY" SummaryType="Sum"
                                                 ShowInColumn="Entity.Entity.Entity.ESTIMATED_QUANTITY"
                                                 DisplayFormat="Total: {0:n}" />
                            <dxg:GridSummaryItem FieldName="Total_Install_Hours" SummaryType="Sum"
                                                 ShowInColumn="Total_Install_Hours"
                                                 DisplayFormat="Total: {0:n}" />
                            <dxg:GridSummaryItem FieldName="Supply_Cost" SummaryType="Sum"
                                                 ShowInColumn="Supply_Cost"
                                                 DisplayFormat="Total: {0:c}" />
                            <dxg:GridSummaryItem FieldName="Install_Cost" SummaryType="Sum"
                                                 ShowInColumn="Install_Cost"
                                                 DisplayFormat="Total: {0:c}" />
                        </dxg:GridControl.TotalSummary>
                        <dxg:GridControl.View>
                            <custom:TableViewEx x:Name="tableView" Style="{StaticResource DefaultTableViewTemplate}"
                                           NewItemRowPosition="{Binding DataContext.NewItemRowPosition, ElementName=userControl}"
                                           ShowTotalSummary="True" ShowFixedTotalSummary="True" GroupSummaryDisplayMode="AlignByColumns">
                                <custom:TableViewEx.RowCellMenuCustomizations>
                                    <dxb:BarButtonItem Content="Bulk Edit"
                                                       Command="{Binding View.DataContext.BulkColumnEditCommand}"
                                                       CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                                                       Glyph="{dx:DXImageOffice2013 Image=CustomizeGrid_16x16.png}" />
                                    <dxb:BarButtonItem Content="Fill Up"
                                                       Glyph="{dx:DXImageOffice2013 Image=MoveUp_16x16.png}"
                                                       Command="{Binding View.DataContext.FillUpCommand}"
                                                       CommandParameter="{Binding RelativeSource={RelativeSource Self}}" />
                                    <dxb:BarButtonItem Content="Fill Down"
                                                       Glyph="{dx:DXImageOffice2013 Image=MoveDown_16x16.png}"
                                                       Command="{Binding View.DataContext.FillDownCommand}"
                                                       CommandParameter="{Binding RelativeSource={RelativeSource Self}}" />
                                    <dxb:BarButtonItem Name="contextMenuPopulate" Content="Populate"
                                                       Glyph="{dx:DXImageOffice2013 Image=PictureShapeFillColor_16x16.png}"
                                                       Command="{Binding DataContext.AutoPopulateCommand, ElementName=userControl}"
                                                       CommandParameter="{Binding RelativeSource={RelativeSource Self}}" />
                                    <dxb:BarButtonItem x:Name="contextMenuDuplicate" Content="Duplicate"
                                                       Command="{Binding DataContext.DuplicateCommand, ElementName=userControl}"
                                                       Glyph="{dx:DXImageOffice2013 Image=Paste_16x16.png}" />
                                    <dxb:BarSubItem x:Name="contextMenuDuplicateMulti" Content="Duplicate Multiple"
                                                    Glyph="{dx:DXImageOffice2013 Image=Parameters_16x16.png}">
                                        <dxb:BarEditItem x:Name="contextMenuDuplicateMultiCount" Content="Count"
                                                         EditValue="2">
                                            <dxb:BarEditItem.EditSettings>
                                                <dxe:SpinEditSettings IsTextEditable="True" IsFloatValue="False"
                                                                      Increment="1" MinValue="2" MaxValue="99"
                                                                      MaskType="Numeric" Mask="n0"
                                                                      MaskUseAsDisplayFormat="True">
                                                    <dxe:SpinEditSettings.Buttons>
                                                        <dxe:ButtonInfo x:Name="contextMenuPasteMultiCountBtn"
                                                                        GlyphKind="Apply">
                                                            <dxmvvm:Interaction.Behaviors>
                                                                <dxmvvm:EventToCommand
                                                                    Command="{Binding DataContext.DuplicateMultipleCommand, ElementName=userControl}"
                                                                    CommandParameter="{Binding ElementName=contextMenuDuplicateMultiCount}"
                                                                    EventName="Click" />
                                                            </dxmvvm:Interaction.Behaviors>
                                                        </dxe:ButtonInfo>
                                                    </dxe:SpinEditSettings.Buttons>
                                                </dxe:SpinEditSettings>
                                            </dxb:BarEditItem.EditSettings>
                                        </dxb:BarEditItem>
                                    </dxb:BarSubItem>
                                    <dxb:BarButtonItem Content="Delete"
                                                       Command="{Binding View.DataContext.BulkDeleteCommand}"
                                                       CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                                                       Glyph="{dx:DXImage Image=Delete_16x16.png}" />
                                    <dxb:BarButtonItem Content="Refresh"
                                                       Command="{Binding DataContext.FullRefreshCommand, ElementName=userControl}"
                                                       Glyph="{dx:DXImage Image=Refresh_16x16.png}" />
                                </custom:TableViewEx.RowCellMenuCustomizations>
                            </custom:TableViewEx>
                        </dxg:GridControl.View>
                    </custom:GridControlEx>
                </Grid>
            </DockPanel>
        </Grid>
    </Grid>
</custom:ViewStateRestoreUserControl>
