        <Setter Property="dxsc:SpellingSettings.SpellChecker"
                Value="{Binding DataContext.SpellCheckerModule.SpellChecker, ElementName=userControl}" />
        <Setter Property="dxmvvm:Interaction.BehaviorsTemplate">
