<UserControl x:Class="BluePrints.Views.EXO_DesignSubjobCollectionView" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/presentation" xmlns:services="clr-namespace:BaseModel.ViewModel.Services;assembly=BaseModel" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:custom="clr-namespace:BaseModel.Misc;assembly=BaseModel" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon" xmlns:dxrudex="http://schemas.devexpress.com/winfx/2008/xaml/reports/userdesignerextensions" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:viewmodel="clr-namespace:BluePrints.ViewModels" x:Name="userControl" d:DesignHeight="400" d:DesignWidth="1600" DataContext="{dxmvvm:ViewModelSource viewmodel:EXO_DesignSubjobCollectionViewModelWrapper}" mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <dxmvvm:BooleanNegationConverter x:Key="BooleanNegationConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BaseModel;component/View/ResourceDictionaries/DefaultControlResourceDictionary.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Common/View/ResourceDictionaries/DefaultBluePrintsResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Style="{StaticResource CollectionView.RootContainer}">
        <dxmvvm:Interaction.Behaviors>
            <services:TableViewService x:Name="PermissionTableViewService" TableView="{Binding ElementName=tableViewPermission}" />
        </dxmvvm:Interaction.Behaviors>
        <dxb:BarManager>
            <dxb:BarManager.Items>
                <dxb:BarSubItem ItemLinksSource="{StaticResource RibbonDefaultGridButtons}" />
                <dxb:BarButtonItem x:Name="biBulkAssignUsers" Command="{Binding BulkAssignCommand}" Content="Bulk Assign Users" LargeGlyph="{dxc:DXImage Images/Actions/Apply_32x32.png}" ToolTip="Bulk assign selected users" Glyph="{dxc:DXImage Images/Actions/Apply_16x16.png}" />
                <dxb:BarButtonItem x:Name="biBulkUnassignUsers" Command="{Binding BulkUnassignCommand}" Content="Bulk Unassign Users" LargeGlyph="{dxc:DXImage Image=Images/Actions/Cancel_32x32.png}" ToolTip="Bulk unassign selected users" Glyph="{dxc:DXImage Images/Actions/Cancel_16x16.png}" />
                <dxb:BarButtonItem x:Name="biUploadToExo" Command="{Binding UploadToExoCommand}" Content="Upload Selected to Exo" Glyph="{dxc:DXImage Image=Satellite_16x16.png}" LargeGlyph="{dxc:DXImage Image=Satellite_32x32.png}" ToolTip="Add any missing subjob, discipline code, commodity code and available lines into exo" />
                <dxb:BarButtonItem x:Name="biAlignBudget" Command="{Binding AlignExoBudgetCommand}" Content="Align Selected Budget" Glyph="{dxc:DXImage Images/Actions/ConvertToRange_16x16.png}" LargeGlyph="{dxc:DXImage Images/Actions/ConvertToRange_32x32.png}" ToolTip="Align selected exo budget with budget calculated from deliverable's list" />
                <dxb:BarCheckItem x:Name="biShowPreferred" Content="Show Preferred User Only" IsEnabled="{Binding IsLoading, Converter={dxmvvm:BooleanNegationConverter}}" Glyph="{dxc:DXImage Image=BOUser_16x16.png}" IsChecked="{Binding ShowPreferred}" LargeGlyph="{dxc:DXImage Image=BOUser_32x32.png}" ToolTip="Show preferred user only (based on role)" />
            </dxb:BarManager.Items>
            <DockPanel>
                <dxr:RibbonControl Style="{StaticResource DefaultRibbonControlStyle}">
                    <dxr:RibbonDefaultPageCategory MergeType="Replace" Caption="defaultCategory">
                        <dxr:RibbonPage MergeType="Replace" Caption="Grid">
                            <dxr:RibbonPageGroup MergeType="Replace" Caption="Grid" SmallGlyph="{dxc:DXImage Image=Satellite_32x32.png}">
                                <dxb:BarButtonItemLink BarItemName="biFullRefresh1" />
                                <dxb:BarButtonItemLink BarItemName="biBulkDelete1" />
                                <dxb:BarButtonItemLink BarItemName="biKeyboardCopy1"/>
                                <dxb:BarButtonItemLink BarItemName="biKeyboardPaste1" />
                                <dxb:BarCheckItemLink BarItemName="biCellSelection1" />
                                <dxb:BarButtonItemLink BarItemName="biSaveLayout1" />
                                <dxb:BarButtonItemLink BarItemName="biResetLayout1" />
                                <dxb:BarButtonItemLink BarItemName="biExpandAllGroups1" />
                                <dxb:BarButtonItemLink BarItemName="biCollapseAllGroups1" />
                                <dxb:BarButtonItemLink BarItemName="biExportToExcel1" />
                                <dxb:BarButtonItemLink BarItemName="biExportToPDF1" />
                                <dxb:BarButtonItemLink BarItemName="biAlignBudget" />
                            </dxr:RibbonPageGroup>
                        </dxr:RibbonPage>
                        <dxr:RibbonPage MergeType="Replace" Caption="Permissions">
                            <dxr:RibbonPageGroup MergeType="Replace" Caption="Permissions" SmallGlyph="{dxc:DXImage Image=Satellite_32x32.png}">
                                <dxb:BarCheckItemLink BarItemName="biShowPreferred" />
                                <dxb:BarButtonItemLink BarItemName="biBulkAssignUsers"/>
                                <dxb:BarButtonItemLink BarItemName="biBulkUnassignUsers"/>
                                <dxb:BarButtonItemLink BarItemName="biUploadToExo"/>
                            </dxr:RibbonPageGroup>
                        </dxr:RibbonPage>
                    </dxr:RibbonDefaultPageCategory>
                </dxr:RibbonControl>
                <dxlc:LayoutControl x:Name="layoutControl" Orientation="Vertical">
                    <dxlc:LayoutGroup Name="LayoutGroupMain" Orientation="Horizontal" >
                        <dxlc:LayoutGroup Name="LayoutGroupGrid" Width="1000" dxlc:LayoutControl.AllowHorizontalSizing="True" Orientation="Horizontal" View="Group">
                            <dxg:GridControl x:Name="GridControlSubJob" dxc:DXSerializer.SerializationID="GridControlEXOSUBJOB" dxc:DXSerializer.StoreLayoutMode="All" SelectionMode="Row" Style="{StaticResource DefaultGridControlTemplate}">
                                <dxg:GridControl.Columns>
                                    <dxg:GridColumn AllowBestFit="false" Width="110" FieldName="SubJobCode" Header="Subjob" HeaderToolTip="Personnel permission is set per subjob, however recommended personnel depends on document types assigned to role" ReadOnly="True" />
                                    <dxg:GridColumn AllowBestFit="false" Width="*" FieldName="SubJobTitle" Header="Subjob Title" HeaderToolTip="Subjob title in exo" ReadOnly="False" >
                                        <dxg:GridColumn.CellTemplate>
                                            <DataTemplate>
                                                <dxe:TextEdit x:Name="PART_Editor" NullText="{Binding RowData.Row.NullText}" ShowNullText="True" IsReadOnly="{Binding RowData.Row.IsLineExistsInExo, Converter={StaticResource BooleanNegationConverter}}" />
                                            </DataTemplate>
                                        </dxg:GridColumn.CellTemplate>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="DisciplineCode" Header="Discipline Code" AllowBestFit="false" Width="50" HeaderToolTip="Discipline code in Blueprints means cost group in exo " ReadOnly="True" />
                                    <dxg:GridColumn AllowBestFit="false" Width="150" FieldName="DisciplineName" Header="Discipline Code Title" HeaderToolTip="Discipline code title in exo" ReadOnly="False" />
                                    <dxg:GridColumn FieldName="CommodityCode" Header="Commodity Code" AllowBestFit="false" Width="50" HeaderToolTip="Document type in Blueprints means cost type in exo" ReadOnly="True" />
                                    <dxg:GridColumn FieldName="VariationCode" AllowBestFit="false" Width="70" Header="Variation" ReadOnly="True" />
                                    <dxg:GridColumn FieldName="ExoBudget" Header="Exo Budget" AllowBestFit="false" Width="90" HeaderToolTip="Budget in Exo">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:SpinEditSettings Increment="100" IsFloatValue="False" IsTextEditable="True" Mask="c0" MaskType="Numeric" MaskUseAsDisplayFormat="True" MinValue="0" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="Budget" Header="Budget Cost" AllowBestFit="false" Width="90" HeaderToolTip="Budget calculated from from deliverable's">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:SpinEditSettings Increment="100" IsFloatValue="False" IsTextEditable="True" Mask="c0" MaskType="Numeric" MaskUseAsDisplayFormat="True" MinValue="0" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="IsLineExistsInExo" Header="Bookable" AllowBestFit="false" Width="60" HeaderToolTip="Is this line available to be booked by authorised personnel" />
                                    <dxg:GridColumn FieldName="Category" Visible="False" AllowBestFit="True" Width="50" Header="Category" HeaderToolTip="Sub job category">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:ComboBoxEditSettings AutoComplete="False" IsTextEditable="False" DisplayMember="CATDESC" ItemsSource="{Binding JOB_CATEGORIESCollection}" ValueMember="CATNO" NullText="Leave empty to auto populate" ShowNullText="True"  />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                </dxg:GridControl.Columns>
                                <dxg:GridControl.TotalSummary>
                                    <dxg:GridSummaryItem FieldName="SubJobCode" dxc:DXSerializer.Enabled="False" DisplayFormat="{}{0} Record(s)" SummaryType="Count" />
                                    <dxg:GridSummaryItem dxc:DXSerializer.Enabled="False" DisplayFormat="c0" FieldName="Budget" SummaryType="Sum" />
                                    <dxg:GridSummaryItem dxc:DXSerializer.Enabled="False" DisplayFormat="c0" FieldName="ExoBudget" SummaryType="Sum" />
                                </dxg:GridControl.TotalSummary>
                                <dxg:GridControl.GroupSummary>
                                    <dxg:GridSummaryItem FieldName="SubJobCode" dxc:DXSerializer.Enabled="False" DisplayFormat="{}{0} Record(s)" SummaryType="Count" />
                                    <dxg:GridSummaryItem dxc:DXSerializer.Enabled="False" DisplayFormat="c0" FieldName="Budget" SummaryType="Sum" />
                                    <dxg:GridSummaryItem dxc:DXSerializer.Enabled="False" DisplayFormat="c0" FieldName="ExoBudget" SummaryType="Sum" />
                                </dxg:GridControl.GroupSummary>
                                <dxg:GridControl.View>
                                    <dxg:TableView x:Name="tableView" Style="{StaticResource DefaultMinimalTableViewTemplate}">
                                        <dxmvvm:Interaction.Behaviors>
                                            <dxmvvm:EventToCommand Command="{Binding ValidateCellCommand}" EventName="ValidateCell" PassEventArgsToCommand="True" />
                                            <dxmvvm:EventToCommand Command="{Binding CellValueChangingCommand}" EventName="CellValueChanging" PassEventArgsToCommand="True" />
                                            <dxmvvm:EventToCommand Command="{Binding CellValueChangedCommand}" EventName="CellValueChanged" PassEventArgsToCommand="True" />
                                        </dxmvvm:Interaction.Behaviors>
                                        <dxg:TableView.RowCellMenuCustomizations>
                                            <dxb:BarLinkContainerItem ItemLinksSource="{StaticResource ContextMenuDefaultHeaderButtons}" />
                                            <dxb:BarItemLinkSeparator />
                                            <dxb:BarButtonItemLink BarItemName="biAlignBudget" />
                                            <dxb:BarItemLinkSeparator />
                                            <dxb:BarButtonItemLink BarItemName="biUploadToExo"/>
                                            <dxb:BarItemLinkSeparator />
                                            <dxb:BarButtonItemLink BarItemName="biFullRefresh1" />
                                        </dxg:TableView.RowCellMenuCustomizations>
                                    </dxg:TableView>
                                </dxg:GridControl.View>
                            </dxg:GridControl>
                        </dxlc:LayoutGroup>
                        <dxc:LoadingDecorator IsSplashScreenShown="{Binding IsPermissionLoading}">
                            <dxlc:LayoutGroup Name="LayoutGroupPermission" Orientation="Vertical" View="Group">
                                <dxlc:LayoutItem Height="50">
                                    <TextBlock TextWrapping="Wrap" Padding="15" Text="Permissions are assigned by SubJob. User will be assigned/unassigned for all lines on the left with the same Subjob" />
                                </dxlc:LayoutItem>
                                <custom:GridControlEx x:Name="GridControl" MaxHeight="2000" dxc:DXSerializer.SerializationID="GridControlExoSubjobUsers" dxc:DXSerializer.StoreLayoutMode="All" IsEnabled="{Binding IsPermissionGridEnabled}" ItemsSource="{Binding BluePrintsUsers}" SelectedItem="{Binding SelectedUser, Mode=TwoWay}" SelectedItems="{Binding SelectedUsers}" SelectionMode="Row">
                                    <dxg:GridControl.Columns>
                                        <dxg:GridColumn FieldName="IsAssigned" Header="Can Book" AllowBestFit="false" Width="50" HeaderToolTip="Indicate whether user have permission to book the selected time in exo">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:CheckEditSettings />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn AllowEditing="False" FieldName="User.Full_Name" Header="User" AllowBestFit="false" Width="*"/>
                                        <dxg:GridColumn AllowEditing="False" FieldName="User.ROLE.NAME" Header="Role" AllowBestFit="false" Width="200" />
                                        <!--<dxg:GridColumn AllowEditing="False" FieldName="ShouldAssign" AllowBestFit="false" Width="50" HeaderToolTip="Is user recommended for selected subjob, based on document type assigned to role">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:CheckEditSettings />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>-->
                                    </dxg:GridControl.Columns>
                                    <dxg:GridControl.TotalSummary>
                                        <dxg:GridSummaryItem dxc:DXSerializer.Enabled="False" Alignment="Right" SummaryType="Count" />
                                    </dxg:GridControl.TotalSummary>
                                    <dxg:GridControl.GroupSummary>
                                        <dxg:GridSummaryItem dxc:DXSerializer.Enabled="False" SummaryType="Count" />
                                    </dxg:GridControl.GroupSummary>
                                    <dxg:GridControl.View>
                                        <dxg:TableView x:Name="tableViewPermission" Style="{StaticResource DefaultMinimalTableViewTemplate}">
                                            <dxg:TableView.RowCellMenuCustomizations>
                                                <dxb:BarButtonItemLink BarItemName="biBulkAssignUsers" />
                                                <dxb:BarButtonItemLink BarItemName="biBulkUnassignUsers" />
                                            </dxg:TableView.RowCellMenuCustomizations>
                                            <dxmvvm:Interaction.Behaviors>
                                                <dxmvvm:EventToCommand Command="{Binding PermissionCellValueChangingCommand}" EventName="CellValueChanging" PassEventArgsToCommand="True" />
                                                <dxmvvm:EventToCommand Command="{Binding ValidatePermissionCellCommand}" EventName="ValidateCell"  PassEventArgsToCommand="True" />
                                                <dxmvvm:EventToCommand Command="{Binding PermissionCellValueChangedCommand}" EventName="CellValueChanged" PassEventArgsToCommand="True" />
                                            </dxmvvm:Interaction.Behaviors>
                                        </dxg:TableView>
                                    </dxg:GridControl.View>
                                </custom:GridControlEx>
                            </dxlc:LayoutGroup>
                        </dxc:LoadingDecorator>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutControl>
            </DockPanel>
        </dxb:BarManager>
    </Grid>
</UserControl>